#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Espressione regolare non valida: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "Livelli superiori (per valori numerici)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "Livelli inferiori (per valori numerici)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "Corrispondenza di stringhe"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr "Come trasformare un valore stringa in uno stato di servizio Checkmk."

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "Il valore deve corrispondere a un'espressione regolare"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "Valore atteso (regex)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Per i valori stringa: il valore deve corrispondere completamente a questa "
"espressione regolare (ad es. 'UP|ok')."

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "Stato quando il valore non corrisponde"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Associa il valore a uno stato (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Per i valori stringa con più stati noti: ogni modello è un'espressione "
"regolare confrontata con l'intero valore. Vengono provati nell'ordine OK, "
"WARN, CRIT e vince la prima corrispondenza."

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "OK quando il valore corrisponde (regex)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "WARN quando il valore corrisponde (regex)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "CRIT quando il valore corrisponde (regex)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "Stato quando non corrisponde nulla"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:82
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "Espressione aritmetica non valida: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:88
msgid ""
"Only the variables 'value' and 'other', numbers, parentheses and + - * / are "
"allowed."
msgstr ""
"Sono consentite solo le variabili 'value' e 'other', numeri, parentesi e + - "
"* /."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:94
#, python-format
msgid "Unknown variable '%s' - only 'value' and 'other' are available."
msgstr "Variabile sconosciuta '%s' - sono disponibili solo 'value' e 'other'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:99
msgid "Only numeric constants are allowed."
msgstr "Sono consentite solo costanti numeriche."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:137
msgid ""
"A metric name must consist of letters, digits and underscores only, and "
"start with a letter or a digit."
msgstr ""
"Un nome di metrica può contenere solo lettere, cifre e trattini bassi e deve "
"iniziare con una lettera o una cifra."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:144
#, python-format
msgid ""
"'%s' is one of this plugin's own metrics. A field given that name inherits "
"its unit, colour and Perf-O-Meter, which is almost never what is meant - a "
"percentage named 'json_api_bytes' is rendered as bytes. Choose a name of "
"your own, or leave this empty to get the right one automatically."
msgstr ""
"'%s' è una delle metriche proprie di questo plugin. Un campo con quel nome "
"ne eredita unità, colore e Perf-O-Meter, il che non è quasi mai ciò che si "
"intende: una percentuale chiamata 'json_api_bytes' viene mostrata in byte. "
"Scegli un nome tuo, oppure lascia vuoto per ottenere automaticamente quello "
"giusto."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:240
#, python-format
msgid ""
"The fields %s of the shared service '%s' would all be recorded as the metric "
"'%s'. Give them names that differ by more than punctuation, or set 'Metric "
"name' on all but one."
msgstr ""
"I campi %s del servizio condiviso '%s' verrebbero registrati tutti come la "
"metrica '%s'. Dai loro nomi che differiscano per qualcosa di più della "
"punteggiatura, oppure imposta 'Nome della metrica' su tutti tranne uno."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:266
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Ogni URL dell'endpoint deve essere univoco. Duplicato: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:275
#, python-format
msgid "Each endpoint name must be unique. Duplicated: %s"
msgstr "Ogni nome dell'endpoint deve essere univoco. Duplicato: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:285
msgid "The URL must not contain whitespace."
msgstr "L'URL non deve contenere spazi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:289
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Inserire un URL http(s) valido, ad es. 'https://host/percorso'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:305
msgid "Enter a valid HTTP header name, e.g. 'X-API-Key'."
msgstr "Inserisci un nome di intestazione HTTP valido, ad es. 'X-API-Key'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:314
msgid "Enter a valid query parameter name, e.g. 'api_key'."
msgstr "Inserisci un nome di parametro di query valido, ad es. 'api_key'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:332
msgid ""
"The collection to merge must name the collection itself, without a '[*]' "
"wildcard - e.g. 'data.items' rather than 'data.items[*]'."
msgstr ""
"La raccolta da unire deve indicare la raccolta stessa, senza un carattere "
"jolly '[*]' - ad esempio 'data.items' invece di 'data.items[*]'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:342
msgid "The path to the next page's URL must not contain a '[*]' wildcard."
msgstr ""
"Il percorso all'URL della pagina successiva non può contenere un carattere "
"jolly '[*]'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:358
msgid ""
"Prefixing the field service names needs an endpoint name. Set 'Endpoint "
"name', or turn the prefix off."
msgstr ""
"Anteporre il nome dell'endpoint ai nomi dei servizi dei campi richiede un "
"nome dell'endpoint. Imposta 'Nome dell'endpoint' oppure disattiva il "
"prefisso."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:382
#, python-format
msgid ""
"The header '%s' carries the API key and must not also be set under "
"'Additional request headers'."
msgstr ""
"L'intestazione '%s' contiene la chiave API e non deve essere impostata anche "
"in 'Intestazioni della richiesta aggiuntive'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:442
msgid ""
"'element' is the column the table rows of a '[*]' wildcard are keyed by, so "
"it cannot also name a column. Choose another attribute name."
msgstr ""
"'element' è la colonna che identifica le righe di tabella di un carattere "
"jolly '[*]', quindi non può nominare anche una colonna. Scegli un altro nome "
"di attributo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:450
msgid ""
"A field written to the inventory creates no service, so it cannot report "
"into a shared one. Tick 'Also create a service for this field', or clear "
"'Report in a shared service named'."
msgstr ""
"Un campo scritto nell'inventario non crea alcun servizio, quindi non può "
"essere riportato in uno condiviso. Spunta 'Crea anche un servizio per questo "
"campo' oppure svuota 'Riporta in un servizio condiviso chiamato'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:463
msgid ""
"'Labels for the created host' needs 'Create one host per element, named by "
"this field' - without it the element stays a service on this host and there "
"is no host to label."
msgstr "Etichette per l'host creato"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:474
msgid ""
"The transform uses 'other', so 'Second path for the transform' must be set "
"to say where that value comes from."
msgstr ""
"La trasformazione usa 'other', quindi 'Secondo percorso per la "
"trasformazione' deve essere impostato per indicare da dove proviene quel "
"valore."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:481
msgid ""
"'Second path for the transform' is only used through the variable 'other' - "
"add it to the transform (e.g. 'value / other * 100') or clear the path."
msgstr ""
"'Secondo percorso per la trasformazione' è usato solo tramite la variabile "
"'other' - aggiungila alla trasformazione (ad esempio 'value / other * 100') "
"oppure svuota il percorso."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:500
msgid ""
"Without a 'JSON path' the label is described by the rule alone, so both a "
"'Label key' and a literal 'Label value' are needed."
msgstr ""
"Senza un 'Percorso JSON' l'etichetta è descritta solo dalla regola, quindi "
"servono sia una 'Chiave dell'etichetta' sia un 'Valore dell'etichetta' "
"letterale."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:512
msgid ""
"Set either a literal 'Label value' or a 'Value field' to read it from, not "
"both."
msgstr ""
"Imposta un 'Valore dell'etichetta' letterale oppure un 'Campo del valore' da "
"cui leggerlo, non entrambi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:530
msgid "Give at least one end of the range, or leave the range unset."
msgstr ""
"Indicare almeno un estremo dell'intervallo, oppure lasciare l'intervallo non "
"impostato."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:534
msgid "The lowest value must be smaller than the highest value."
msgstr "Il valore più basso deve essere minore del valore più alto."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:547
#, python-brace-format
msgid ""
"Use '{path}' to insert a field, e.g. '{message} (leader {leader})'. Braces "
"must be paired and cannot be nested or empty."
msgstr ""
"Usa '{path}' per inserire un campo, ad es. '{message} (leader {leader})'. Le "
"parentesi graffe devono essere accoppiate e non possono essere annidate o "
"vuote."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:568
msgid ""
"Enter a dotted inventory path of at least two segments, using lower-case "
"letters, digits and '_' - e.g. 'software.applications.json_api'."
msgstr ""
"Inserisci un percorso di inventario con punti e almeno due segmenti, usando "
"minuscole, cifre e '_' - ad es. 'software.applications.json_api'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:575
msgid ""
"The inventory path must start with 'hardware', 'software' or 'networking'."
msgstr ""
"Il percorso di inventario deve iniziare con 'hardware', 'software' o "
"'networking'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:583
msgid ""
"Use lower-case letters, digits and '_' for the attribute name, e.g. "
"'version'."
msgstr ""
"Usa minuscole, cifre e '_' per il nome dell'attributo, ad es. 'version'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:590
msgid "Write into the HW/SW inventory"
msgstr "Scrivi nell'inventario HW/SW"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:592
msgid ""
"Put this field into the host's inventory tree instead of making it a "
"service. Meant for facts rather than states - a version, a build, a region, "
"a licence tier - which are not worth a service that is OK forever, and which "
"the inventory can do something with that services cannot: it is searchable "
"ACROSS hosts ('which hosts still run a version below 4.2?') and keeps a "
"history of its own. For a '[*]' wildcard the elements become one table row "
"each, keyed by an 'element' column holding the element's name. Point this at "
"values that rarely change: every change is recorded in the inventory "
"history, so a counter here grows those files without bound. Inventory runs "
"on its own (slower) schedule, not at every check interval."
msgstr ""
"Inserisce questo campo nell'albero di inventario dell'host invece di "
"renderlo un servizio. Pensato per fatti più che per stati - una versione, "
"una build, una regione, un livello di licenza - che non meritano un servizio "
"sempre OK e con cui l'inventario può fare qualcosa che i servizi non "
"possono: è ricercabile TRA gli host ('quali host usano ancora una versione "
"inferiore alla 4.2?') e mantiene una cronologia propria. Con un carattere "
"jolly '[*]' ogni elemento diventa una riga di tabella, identificata da una "
"colonna 'element' che contiene il nome dell'elemento. Usalo per valori che "
"cambiano di rado: ogni modifica viene registrata nella cronologia "
"dell'inventario, quindi un contatore qui fa crescere quei file senza limiti. "
"L'inventario segue una propria pianificazione (più lenta), non ogni "
"intervallo di controllo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:609
msgid "Inventory tree node"
msgstr "Nodo dell'albero di inventario"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:611
msgid ""
"Dotted path of the node the value is written to, e.g. 'software.applications."
"json_api'. Must start with 'hardware', 'software' or 'networking'."
msgstr ""
"Percorso con punti del nodo in cui viene scritto il valore, ad es. 'software."
"applications.json_api'. Deve iniziare con 'hardware', 'software' o "
"'networking'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:622
msgid "Attribute name"
msgstr "Nome dell'attributo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:624
msgid ""
"Name of the attribute (or, for a '[*]' wildcard, the column). Defaults to "
"the JSON path's last segment. For a '[*]' wildcard it cannot be 'element': "
"that is the column the table rows themselves are keyed by."
msgstr ""
"Nome dell'attributo (o della colonna, con un carattere jolly '[*]'). Per "
"impostazione predefinita l'ultimo segmento del percorso JSON. Con un "
"carattere jolly '[*]' non può essere 'element': è la colonna che identifica "
"le righe stesse della tabella."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:635
msgid "Also create a service for this field"
msgstr "Crea anche un servizio per questo campo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:637
msgid ""
"Off by default: an inventory field creates NO service, which is the point - "
"it does not consume a service slot or a check interval to report something "
"that changes twice a year. Turn it on for a value you want in the inventory "
"AND want to alert on, e.g. a version you also match against a regex."
msgstr ""
"Disattivato per impostazione predefinita: un campo di inventario NON crea "
"alcun servizio, ed è proprio questo il punto - non consuma né uno spazio "
"servizio né un intervallo di controllo per riportare qualcosa che cambia due "
"volte l'anno. Attivalo per un valore che vuoi nell'inventario E su cui vuoi "
"ricevere allarmi, ad es. una versione che confronti anche con un'espressione "
"regolare."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:653
msgid "Authentication"
msgstr "Autenticazione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:658
msgid "Basic authentication (username / password)"
msgstr "Autenticazione di base (nome utente / password)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:664
msgid "Username"
msgstr "Nome utente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:671
msgid "Password"
msgstr "Password"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:680
msgid "Bearer token"
msgstr "Token Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:686
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:687
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Inviato come 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:696
msgid "OAuth 2.0 (client credentials)"
msgstr "OAuth 2.0 (credenziali client)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:699
msgid ""
"The machine-to-machine OAuth 2.0 grant: the agent exchanges a client ID and "
"secret for a short-lived access token and sends it as 'Authorization: Bearer "
"<token>'. The token is cached until shortly before it expires, so a rule "
"polling every minute does not ask the identity provider every minute. No "
"browser and no user consent are involved - if your API only works with a "
"token obtained by a person logging in, this is not the right mode."
msgstr ""
"Il flusso OAuth 2.0 da macchina a macchina: l'agente scambia un ID client e "
"un segreto con un token di accesso di breve durata e lo invia come "
"'Authorization: Bearer <token>'. Il token viene memorizzato nella cache fino "
"a poco prima della scadenza, così una regola che interroga ogni minuto non "
"chiede ogni minuto all'identity provider. Non sono coinvolti né un browser "
"né il consenso dell'utente: se la tua API funziona solo con un token "
"ottenuto da una persona che effettua l'accesso, questa non è la modalità "
"giusta."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:712
msgid "Token URL"
msgstr "URL del token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:714
msgid ""
"The identity provider's token endpoint, e.g. 'https://login.example.com/"
"oauth2/v2.0/token'. This is NOT the API URL above."
msgstr ""
"L'endpoint del token dell'identity provider, ad esempio 'https://login."
"example.com/oauth2/v2.0/token'. NON è l'URL dell'API qui sopra."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:725
msgid "Client ID"
msgstr "ID client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:732
msgid "Client secret"
msgstr "Segreto client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:739
msgid "Scope"
msgstr "Ambito (scope)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:741
msgid ""
"Space-separated scopes to request, if the provider needs them - e.g. 'api://"
"monitoring/.default'."
msgstr ""
"Ambiti separati da spazi da richiedere, se il provider li richiede - ad "
"esempio 'api://monitoring/.default'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:749
msgid "Audience"
msgstr "Audience"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:751
msgid ""
"Sent as the 'audience' parameter. Required by some providers (Auth0, for "
"instance) to say which API the token is for; leave empty otherwise."
msgstr ""
"Inviato come parametro 'audience'. Richiesto da alcuni provider (Auth0, ad "
"esempio) per indicare a quale API è destinato il token; altrimenti lascia "
"vuoto."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:760
msgid "How to send the client credentials"
msgstr "Come inviare le credenziali client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:762
msgid ""
"RFC 6749 allows both, and providers disagree about which they accept - a "
"wrong choice here shows up as an unhelpful 401 from the token URL. Try the "
"Authorization header first; switch to the request body if the provider "
"rejects it."
msgstr ""
"La RFC 6749 li consente entrambi e i provider non concordano su quale "
"accettino: una scelta sbagliata qui si manifesta come un 401 poco utile "
"dall'URL del token. Prova prima l'intestazione Authorization; passa al corpo "
"della richiesta se il provider la rifiuta."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:771
msgid "In the Authorization header (HTTP basic)"
msgstr "Nell'intestazione Authorization (HTTP basic)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:775
msgid "In the request body"
msgstr "Nel corpo della richiesta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:786
msgid "API key in a request header"
msgstr "Chiave API in un'intestazione della richiesta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:792
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1568
msgid "Header name"
msgstr "Nome dell'intestazione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:794
msgid ""
"Name of the header carrying the key, e.g. 'X-API-Key', 'apikey' or 'PRIVATE-"
"TOKEN'. For 'Authorization: Bearer <token>' use the bearer token choice "
"instead."
msgstr ""
"Nome dell'intestazione che contiene la chiave, ad es. 'X-API-Key', 'apikey' "
"o 'PRIVATE-TOKEN'. Per 'Authorization: Bearer <token>' usa invece la scelta "
"token Bearer."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:806
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:845
msgid "API key"
msgstr "Chiave API"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:808
msgid ""
"Kept in the Checkmk password store. Unlike a key typed into 'Additional "
"request headers' it is never written to the configuration or to the agent's "
"command line in clear text, and it can be rotated in one place."
msgstr ""
"Conservata nell'archivio password di Checkmk. A differenza di una chiave "
"digitata in 'Intestazioni della richiesta aggiuntive', non viene mai scritta "
"in chiaro nella configurazione o nella riga di comando dell'agente e può "
"essere ruotata in un unico punto."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:822
msgid "API key in a query parameter"
msgstr "Chiave API in un parametro di query"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:828
msgid "Parameter name"
msgstr "Nome del parametro"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:830
msgid ""
"Name of the query parameter carrying the key, e.g. 'api_key'. It is appended "
"to the URL for the request only: the key is redacted wherever the agent "
"reports a URL, and it never appears in the service name. Prefer a header "
"where the API offers one - a key in the URL is visible to proxies and server "
"logs along the way."
msgstr ""
"Nome del parametro di query che contiene la chiave, ad es. 'api_key'. Viene "
"aggiunto all'URL solo per la richiesta: la chiave viene oscurata ovunque "
"l'agente riporti un URL e non compare mai nel nome del servizio. Preferisci "
"un'intestazione se l'API ne offre una: una chiave nell'URL è visibile ai "
"proxy e ai log dei server lungo il percorso."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:847
msgid ""
"Kept in the Checkmk password store, so it is not written to the "
"configuration or to the agent's command line in clear text - unlike a key "
"typed into the URL."
msgstr ""
"Conservata nell'archivio password di Checkmk, quindi non viene scritta in "
"chiaro nella configurazione o nella riga di comando dell'agente, a "
"differenza di una chiave digitata nell'URL."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:911
msgid "Field path (within each element)"
msgstr "Percorso del campo (all'interno di ciascun elemento)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:913
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr ""
"Risolto all'interno di ciascun elemento, ad es. 'status' o 'metadata.phase'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:921
msgid "Condition"
msgstr "Condizione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:923
msgid "equals"
msgstr "è uguale a"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:924
msgid "does not equal"
msgstr "è diverso da"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:925
msgid "matches regex"
msgstr "corrisponde alla regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:926
msgid "does not match regex"
msgstr "non corrisponde alla regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:934
msgid "Comparison value / pattern"
msgstr "Valore di confronto / pattern"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:936
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr ""
"Il valore con cui confrontare, o l'espressione regolare per le condizioni "
"regex."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:947
msgid "Field to monitor"
msgstr "Campo da monitorare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:954
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:152
msgid "Service name"
msgstr "Nome del servizio"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:956
msgid ""
"Becomes the Checkmk service description for this field - or, where the field "
"reports into a shared service, the name of its line within that service."
msgstr ""
"Diventa la descrizione del servizio Checkmk per questo campo – oppure, se il "
"campo viene riportato in un servizio condiviso, il nome della sua riga in "
"quel servizio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:966
msgid "Report in a shared service named"
msgstr "Riporta in un servizio condiviso chiamato"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:968
msgid ""
"By default every field becomes a service of its own. Name a shared service "
"here and this field reports into that one service as a LINE instead, "
"alongside the other fields naming it - so a small API of 'status', "
"'component' and 'timestamp' can be one service rather than three. The "
"service's state is the WORST of its lines, which is how Checkmk aggregates "
"any check, and 'Service name' above then names the line rather than the "
"service. Each line keeps its own levels, string matching and transform from "
"this rule. Two things change, both because one service now holds several "
"fields: a 'Generic JSON API' check-parameters rule cannot describe it and is "
"not applied to it, so thresholds for these fields live here; and each line's "
"metric is named after the line ('json_api_bytes_root_used'), which keeps the "
"history of several fields apart but renders as a plain number rather than in "
"the field's unit. That runtime name also decides which dashboard widgets can "
"use the field: a Graph widget draws whatever the service carries and is "
"unaffected, but Gauge, Single metric and Bar chart are bound to one metric "
"CHOSEN BY NAME, and their dropdown only offers a service's real names once "
"the widget is filtered to a host and a service - set 'Metric name' below to "
"pick the name yourself instead. A field that needs its unit on the graph, or "
"per-service thresholds, is better off with a service of its own."
msgstr ""
"Per impostazione predefinita ogni campo diventa un servizio a sé. Indica qui "
"un servizio condiviso e questo campo verrà riportato in quell'unico servizio "
"come RIGA, insieme agli altri campi che lo nominano: così una piccola API "
"con 'status', 'component' e 'timestamp' diventa un servizio invece di tre. "
"Lo stato del servizio è il PEGGIORE delle sue righe, che è il modo in cui "
"Checkmk aggrega qualsiasi check, e 'Nome del servizio' qui sopra nomina "
"allora la riga anziché il servizio. Ogni riga mantiene le proprie soglie, la "
"propria corrispondenza testuale e la propria trasformazione da questa "
"regola. Cambiano due cose, entrambe perché un servizio contiene ora più "
"campi: una regola di parametri del check 'Generic JSON API' non può "
"descriverlo e non gli viene applicata, quindi le soglie di questi campi "
"stanno qui; e la metrica di ogni riga prende il nome dalla riga, il che "
"tiene separati gli storici di più campi ma viene mostrata come numero "
"semplice anziché nell'unità del campo. Questo nome generato a runtime (ad "
"es. 'json_api_bytes_root_used') decide anche quali elementi della dashboard "
"possono usare il campo: un elemento Grafico disegna ciò che il servizio "
"contiene e non ne è interessato, mentre Indicatore, Metrica singola e "
"Grafico a barre sono legati a una sola metrica SCELTA PER NOME, e il loro "
"menu a discesa offre i nomi reali di un servizio solo dopo che l'elemento è "
"stato filtrato su un host e un servizio; imposta invece 'Nome della metrica' "
"qui sotto per scegliere tu stesso il nome. Un campo che ha bisogno della sua "
"unità sul grafico, o di soglie per servizio, sta meglio con un servizio "
"proprio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1002
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1090
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1168
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2080
msgid "JSON path"
msgstr "Percorso JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1004
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\". To monitor a RESPONSE HEADER instead of a field of the body, prefix "
"its name with '@header.', e.g. '@header.X-RateLimit-Remaining' for an API "
"quota or '@header.Last-Modified' with 'Interpret the value as' set to a "
"timestamp for the age of the data. Header names are matched case-"
"insensitively and none of the path syntax above applies to them."
msgstr ""
"Percorso con notazione a punti nella risposta JSON, ad es. 'status', "
"'components.db.status' o 'items[0].count'. Utilizza un carattere jolly "
"'[*]' (ad es. 'nodes[*].health') per creare un servizio per ogni elemento "
"dell'array - oppure, quando il carattere jolly ricade su un oggetto JSON "
"(una mappa indicizzata per nome, come un '/health' di Spring Boot Actuator "
"'components[*].status'), un servizio per chiave. Più caratteri jolly "
"'[*]' (ad es. 'pods[*].containers[*].ready') espandono il prodotto "
"cartesiano, un servizio per ogni combinazione. Un '$.' iniziale è "
"facoltativo. Le chiavi che contengono a loro volta '.' o '[' possono essere "
"indirizzate con segmenti tra parentesi quadre e virgolette, ad es. "
"\"data['foo.bar'].value\". Per monitorare un'INTESTAZIONE DI RISPOSTA invece "
"di un campo del corpo, anteponi '@header.' al suo nome, ad esempio '@header."
"X-RateLimit-Remaining' per una quota API o '@header.Last-Modified' con "
"'Interpretare il valore come' impostato su un timestamp per l'età dei dati. "
"I nomi delle intestazioni sono confrontati senza distinzione tra maiuscole e "
"minuscole e nessuna delle sintassi di percorso sopra indicate si applica a "
"essi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1030
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "Suffisso del nome per elemento (per i caratteri jolly '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1032
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"Quando il percorso JSON contiene un carattere jolly '[*]', viene creato un "
"servizio per ogni elemento. Questo percorso facoltativo - relativo a ciascun "
"elemento, ad es. 'name' o 'id' - viene aggiunto al nome del servizio per "
"distinguere tali servizi. NON sostituisce il nome del servizio. Per "
"impostazione predefinita è l'indice dell'array (o, per un oggetto, la "
"chiave). Con più caratteri jolly '[*]' viene risolto a ogni livello e le "
"parti vengono unite con ' / ' (ad es. '<pod> / <container>'). Scegli un "
"campo univoco e stabile tra le esecuzioni."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1047
msgid "Create one host per element, named by this field"
msgstr "Crea un host per elemento, denominato in base a questo campo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1049
msgid ""
"When the JSON path contains a '[*]' wildcard, this turns every element into "
"a Checkmk host of its own instead of one more service on this host. Give a "
"path relative to each element that holds the host name, e.g. 'name' or "
"'hostname'. The service then keeps its plain name, because the host already "
"says which element it is. Set the same field on several fields of this "
"endpoint to collect them all on the same hosts. Only characters valid in a "
"Checkmk host name are kept (letters, digits, '-', '_', '.'); anything else "
"becomes '_'. An element whose field is missing keeps its service on this "
"host, so nothing is lost. IMPORTANT: Checkmk holds piggyback data for hosts "
"that do not exist yet - create the hosts (manually or with Dynamic host "
"management) or the data is never monitored."
msgstr ""
"Quando il percorso JSON contiene un carattere jolly '[*]', ogni elemento "
"diventa un host Checkmk a sé stante invece di un ulteriore servizio su "
"questo host. Indicare un percorso relativo a ciascun elemento che contenga "
"il nome host, ad es. 'name' o 'hostname'. Il servizio mantiene quindi il suo "
"nome semplice, perché l'host indica già di quale elemento si tratta. "
"Impostare lo stesso campo su più campi di questo endpoint per raccoglierli "
"tutti sugli stessi host. Vengono mantenuti solo i caratteri validi in un "
"nome host Checkmk (lettere, cifre, '-', '_', '.'); tutto il resto diventa "
"'_'. Un elemento il cui campo è assente mantiene il suo servizio su questo "
"host, così non va perso nulla. IMPORTANTE: Checkmk trattiene i dati "
"piggyback degli host non ancora esistenti: creare gli host (manualmente o "
"con la gestione dinamica degli host), altrimenti i dati non verranno mai "
"monitorati."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1070
msgid "Labels for the created host"
msgstr "Etichette per l'host creato"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1072
msgid ""
"Checkmk HOST labels for the host each '[*]' element becomes, built from "
"fields within that element - so the 50 hosts a 'nodes[*]' rule creates can "
"carry their own region, role or tier and be targeted by folder rules, views "
"and filters. Needs 'Create one host per element' above; without it the "
"element stays a service on this host and there is nothing to label. Each key "
"is prefixed with 'json_api/'. A label can also be a classification rather "
"than a field: a condition on the element plus a literal value tags only the "
"hosts the condition holds for. These are HOST labels, unlike 'Service "
"labels' below, which describe the individual service."
msgstr ""
"Etichette HOST di Checkmk per l'host in cui si trasforma ogni elemento "
"'[*]', costruite da campi all'interno di quell'elemento - così i 50 host "
"creati da una regola 'nodes[*]' possono portare la propria regione, ruolo o "
"livello ed essere selezionati da regole di cartella, viste e filtri. "
"Richiede 'Crea un host per elemento' sopra; senza di esso l'elemento resta "
"un servizio su questo host e non c'è nulla da etichettare. A ogni chiave "
"viene anteposto 'json_api/'. Un'etichetta può anche essere una "
"classificazione anziché un campo: una condizione sull'elemento più un valore "
"letterale contrassegna solo gli host per cui è vera. Queste sono etichette "
"HOST, a differenza delle 'Etichette di servizio' più sotto, che descrivono "
"il singolo servizio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1092
msgid ""
"Relative to each '[*]' element, e.g. 'region'. Can be left empty only where "
"a condition and a literal value describe the label on their own."
msgstr ""
"Relativo a ogni elemento '[*]', ad esempio 'region'. Può restare vuoto solo "
"quando una condizione e un valore letterale descrivono l'etichetta da soli."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1102
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1180
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2094
msgid "Label key (optional)"
msgstr "Chiave dell'etichetta (facoltativa)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1104
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1182
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"Per impostazione predefinita, l'ultimo segmento del percorso. Il prefisso "
"'json_api/' viene aggiunto automaticamente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1112
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2119
msgid "Label value (literal)"
msgstr "Valore dell'etichetta (letterale)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1114
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2121
msgid ""
"A value written here instead of read from the response ('yes', "
"'production', ...). With it a '[*]' path produces ONE label for the whole "
"collection rather than one per element, so the key is used exactly as given "
"- no '<key>/<element>' suffix. Combined with the condition below this is the "
"classification case: 'if any element matches, tag the host'."
msgstr ""
"Un valore scritto qui invece di essere letto dalla risposta ('yes', "
"'production', ...). Con esso un percorso '[*]' produce UNA etichetta per "
"l'intera collezione anziché una per elemento, quindi la chiave è usata "
"esattamente come indicata, senza il suffisso '<key>/<element>'. Insieme alla "
"condizione qui sotto è il caso della classificazione: 'se un elemento "
"qualsiasi corrisponde, contrassegna l'host'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1129
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1221
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2136
msgid "Only elements matching a condition"
msgstr "Solo elementi che soddisfano una condizione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1131
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2138
msgid ""
"Emit the label only for the elements whose sub-field matches this condition "
"- e.g. 'name' matching '^MyApp' over a 'services[*]' path. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar never matches. Without a '[*]' wildcard the condition is checked "
"once, in the same scope the path is read from, so the label is set only when "
"it holds."
msgstr ""
"Emettere l'etichetta solo per gli elementi il cui sottocampo soddisfa questa "
"condizione - ad es. 'name' che corrisponde a '^MyApp' su un percorso "
"'services[*]'. Il percorso del campo è risolto all'interno di ogni elemento; "
"un elemento il cui campo manca o non è uno scalare non corrisponde mai. "
"Senza un carattere jolly '[*]' la condizione è verificata una sola volta, "
"nello stesso ambito da cui viene letto il percorso, quindi l'etichetta è "
"impostata solo se è vera."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1151
msgid "Service labels"
msgstr "Etichette del servizio"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1153
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"Applica etichette del servizio Checkmk a QUESTO servizio, create dai campi "
"della risposta. Ogni chiave riceve il prefisso 'json_api/'. Per un percorso "
"'[*]' il valore è risolto all'interno di ogni elemento (ad es. 'name'), così "
"ogni servizio per elemento ottiene la propria etichetta; per un percorso "
"senza caratteri jolly è risolto dalla radice della risposta. Le informazioni "
"valide per l'intero host vanno invece nelle 'Etichette dell'host' "
"dell'endpoint. Le etichette vengono impostate durante il rilevamento, quindi "
"scegli campi stabili e a bassa cardinalità: un valore che cambia fa variare "
"continuamente l'etichetta."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1170
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"Relativo a ciascun elemento '[*]' (come il suffisso del nome), oppure alla "
"radice della risposta per un percorso senza caratteri jolly."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1194
msgid "Aggregate a collection into one value"
msgstr "Aggregare una raccolta in un unico valore"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1196
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"Riduce una raccolta di elementi a un unico numero invece di monitorare un "
"solo valore (o, con un carattere jolly '[*]', un servizio per elemento). Il "
"percorso JSON punta a un array / oggetto (ad es. 'jobs') oppure a un "
"carattere jolly '[*]' sui valori da aggregare (ad es. 'nodes[*].load'). "
"'Numero di elementi' li conta soltanto; le altre funzioni richiedono valori "
"numerici. Il risultato è un numero, quindi unità, livelli, trasformazione e "
"metrica si applicano ad esso. In combinazione con la condizione sottostante "
"vengono aggregati solo gli elementi corrispondenti. Un percorso che non "
"contiene né un array né un oggetto rende il servizio UNKNOWN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1209
msgid "Number of elements"
msgstr "Numero di elementi"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1210
msgid "Sum of the values"
msgstr "Somma dei valori"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1211
msgid "Average of the values"
msgstr "Media dei valori"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1212
msgid "Smallest of the values"
msgstr "Il minore dei valori"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1213
msgid "Largest of the values"
msgstr "Il maggiore dei valori"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1223
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"Per un carattere jolly '[*]' o un percorso aggregato: mantenere solo gli "
"elementi il cui sottocampo soddisfa questa condizione, ad es. un servizio "
"per ogni nodo il cui 'status' non è 'ok', oppure contare solo i pod che non "
"sono 'Running'. Il percorso del campo viene risolto all'interno di ogni "
"elemento; un elemento il cui campo è assente o non è uno scalare viene "
"scartato. Senza un carattere jolly '[*]' o un'aggregazione questo non ha "
"effetto."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1236
msgid "Interpret the value as"
msgstr "Interpretare il valore come"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1238
msgid ""
"By default the extracted value is monitored as it stands. Two common API "
"values are worth deriving something else from: a counter that only ever "
"grows (its rate of change is what matters, not the total), and a timestamp "
"(its age is what matters, not the date). The derived number is what the "
"transform, the levels, the metric and the summary then use."
msgstr ""
"Per impostazione predefinita il valore estratto viene monitorato così com'è. "
"Per due valori API molto comuni conviene derivarne un altro: un contatore "
"che cresce sempre (conta la sua variazione nel tempo, non il totale) e un "
"timestamp (conta la sua età, non la data). Il numero derivato è quello che "
"poi usano trasformazione, livelli, metrica e riepilogo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1250
msgid "A counter - monitor its per-second rate"
msgstr "Un contatore: monitorare il suo tasso al secondo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1253
msgid "Per-second rate"
msgstr "Tasso al secondo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1255
msgid "The difference to the previous check is divided by the elapsed time"
msgstr ""
"La differenza rispetto al controllo precedente è divisa per il tempo "
"trascorso"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1259
msgid ""
"For monotonically growing counters such as 'requests_total' or 'bytes_sent': "
"the check monitors the change per second instead of the absolute total. The "
"first check after a restart of the counter cannot compute a rate yet and "
"keeps the service's previous state."
msgstr ""
"Per contatori monotonicamente crescenti come 'requests_total' o "
"'bytes_sent': il controllo monitora la variazione al secondo invece del "
"totale assoluto. Il primo controllo dopo un riavvio del contatore non può "
"ancora calcolare un tasso e mantiene lo stato precedente del servizio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1270
msgid "A timestamp - monitor its age"
msgstr "Un timestamp: monitorare la sua età"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1273
msgid ""
"For values such as 'last_backup' or 'updated_at': the check monitors the "
"number of seconds since that point in time, so upper levels alert on stale "
"data. A timestamp in the future yields a negative age. The age graphs and "
"reads as a duration on its own; choose a unit below only to override that (e."
"g. after a transform into hours)."
msgstr ""
"Per valori come 'last_backup' o 'updated_at': il controllo monitora il "
"numero di secondi trascorsi da quel momento, così i livelli superiori "
"avvisano in caso di dati obsoleti. Un timestamp nel futuro produce un'età "
"negativa. L'età viene mostrata e rappresentata come una durata di per sé; "
"scegli un'unità qui sotto solo per sovrascriverla (ad es. dopo una "
"trasformazione in ore)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1286
msgid "Timestamp format"
msgstr "Formato del timestamp"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1288
msgid ""
"'Detect automatically' reads a number as Unix epoch seconds (milliseconds "
"when it is far too large for seconds) and anything else as ISO 8601. A "
"timestamp without a time zone is read as UTC."
msgstr ""
"'Rileva automaticamente' legge un numero come secondi epoch Unix "
"(millisecondi se è troppo grande per essere in secondi) e tutto il resto "
"come ISO 8601. Un timestamp senza fuso orario viene letto come UTC."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1297
msgid "Detect automatically"
msgstr "Rileva automaticamente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1300
msgid "Unix epoch seconds"
msgstr "Secondi epoch Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1304
msgid "Unix epoch milliseconds"
msgstr "Millisecondi epoch Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1309
msgid "ISO 8601 / RFC 3339, e.g. '2026-07-28T02:00:00Z'"
msgstr "ISO 8601 / RFC 3339, ad es. '2026-07-28T02:00:00Z'"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1326
msgid "Unit (for numeric values)"
msgstr "Unità (per valori numerici)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1328
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Visualizza la metrica e il grafico con questa unità. Lascia vuoto per un "
"valore semplice, senza unità. Riguarda solo i valori numerici."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1332
msgid "Count (integer)"
msgstr "Conteggio (intero)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1333
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Byte (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1334
msgid "Seconds (duration)"
msgstr "Secondi (durata)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1335
msgid "Percent"
msgstr "Percentuale"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1337
msgid "No unit"
msgstr "Nessuna unità"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1343
msgid "Value range (for graphs and gauges)"
msgstr "Intervallo di valori (per grafici e indicatori)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1345
msgid ""
"The range this value moves in, when it has one: a battery percentage is 0 to "
"100, a queue with a cap is 0 to that cap. It changes nothing about the state "
"- it tells Checkmk what 'full' means, so the graph keeps a steady scale "
"instead of rescaling to whatever the last hour happened to contain, a gauge "
"dashboard widget has a dial to draw, and the service list's bar is filled "
"against the real maximum. Leave it unset for a value with no natural limit; "
"the bar is then scaled to the critical level instead, where one is "
"configured."
msgstr ""
"L'intervallo in cui si muove questo valore, quando ne ha uno: una "
"percentuale di batteria va da 0 a 100, una coda con un limite va da 0 a quel "
"limite. Non cambia nulla dello stato: indica a Checkmk che cosa significa "
"\"pieno\", così il grafico mantiene una scala stabile invece di riscalarsi "
"su quanto capitava di contenere nell'ultima ora, un elemento del cruscotto "
"di tipo indicatore ha un quadrante da disegnare e la barra nell'elenco dei "
"servizi si riempie rispetto al massimo reale. Lasciare non impostato per un "
"valore senza limite naturale; la barra viene allora scalata sul livello "
"critico, se ne è configurato uno."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1361
msgid "Lowest possible value"
msgstr "Valore minimo possibile"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1368
msgid "Highest possible value"
msgstr "Valore massimo possibile"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1378
msgid "Metric name"
msgstr "Nome della metrica"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1380
msgid ""
"The name Checkmk stores this field's metric under. Leave it unset and the "
"plugin picks one: the unit's metric for a field with a service of its own "
"('json_api_bytes'), or that name plus the line's own name for a field in a "
"shared service ('json_api_bytes_root_used'). Set it where you need to KNOW "
"the name in advance - the Gauge, Single metric and Bar chart dashboard "
"widgets are bound to one metric chosen by name, and their dropdown only "
"lists the names a service really has once the widget is filtered to a host "
"and a service. Letters, digits and underscores only, starting with a letter "
"or a digit, and not one of this plugin's own metric names. Two costs: the "
"service loses its Perf-O-Meter, because every bar this plugin draws is "
"declared against one of its own metrics and a name of your own matches none; "
"and changing the name later starts a new history under it, so pick it before "
"the service has data worth keeping. A field that needs its bar is better off "
"keeping the derived name and filtering the widget to a host and a service "
"instead."
msgstr ""
"Il nome con cui Checkmk salva la metrica di questo campo. Se non impostato, "
"il plugin ne sceglie uno: la metrica dell'unità per un campo con un servizio "
"proprio ('json_api_bytes'), oppure quel nome più il nome della riga per un "
"campo in un servizio condiviso ('json_api_bytes_root_used'). Impostalo "
"quando devi CONOSCERE il nome in anticipo: gli elementi della dashboard "
"Indicatore, Metrica singola e Grafico a barre sono legati a una sola metrica "
"scelta per nome, e il loro menu a discesa elenca i nomi reali di un servizio "
"solo dopo che l'elemento è stato filtrato su un host e un servizio. Solo "
"lettere, cifre e trattini bassi, con iniziale una lettera o una cifra, e "
"nessuno dei nomi di metrica propri di questo plugin. Questo costa due cose: "
"il servizio perde il suo Perf-O-Meter, perché ogni barra disegnata da questo "
"plugin è legata a una delle sue metriche e un nome scelto da te non ne "
"incontra nessuna; e cambiarlo in seguito avvia uno storico nuovo sotto il "
"nuovo nome, quindi scegli il nome prima che il servizio abbia dati da "
"conservare. Un campo che ha bisogno della sua barra fa meglio a mantenere il "
"nome derivato e a filtrare invece l'elemento della dashboard su un host e un "
"servizio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1415
msgid "Transform the numeric value"
msgstr "Trasforma il valore numerico"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1417
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius). A second field can be brought in as 'other' - see below - which is "
"what turns a used/total pair into a percentage: 'value / other * 100'."
msgstr ""
"Un'espressione aritmetica applicata a un valore numerico prima dei livelli e "
"della metrica, utilizzando la variabile 'value'. Sono consentiti solo "
"numeri, parentesi e + - * /. Esempi: 'value / 1024 / 1024' (byte in MiB), "
"'value * 1000' (secondi in millisecondi), '(value - 32) * 5 / 9' (Fahrenheit "
"in Celsius). Un secondo campo può essere incluso come 'other' - vedi sotto - "
"ed è ciò che trasforma una coppia usato/totale in una percentuale: 'value / "
"other * 100'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1434
msgid "Second path for the transform ('other')"
msgstr "Secondo percorso per la trasformazione ('other')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1436
msgid ""
"A second field, made available to the transform above as the variable "
"'other'. Most APIs report a used/total or current/limit pair rather than a "
"percentage, so this is what lets one service monitor the ratio: point the "
"JSON path at 'used', this at 'total', and use 'value / other * 100' with the "
"unit set to '%'. It is resolved in the SAME scope as the value - within each "
"'[*]' element, or the response root without a wildcard - so every element is "
"compared against its own total. The transform must actually use 'other', and "
"'other' requires this path; either one alone is rejected."
msgstr ""
"Un secondo campo, reso disponibile alla trasformazione sopra come variabile "
"'other'. La maggior parte delle API riporta una coppia usato/totale o "
"corrente/limite anziché una percentuale, ed è questo che permette a un "
"servizio di monitorare il rapporto: puntare il percorso JSON su 'used', "
"questo su 'total' e usare 'value / other * 100' con l'unità '%'. Viene "
"risolto nello STESSO ambito del valore - all'interno di ogni elemento '[*]', "
"oppure nella radice della risposta senza carattere jolly - così ogni "
"elemento è confrontato con il proprio totale. La trasformazione deve usare "
"davvero 'other' e 'other' richiede questo percorso; ciascuno da solo viene "
"rifiutato."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1458
msgid "Extra text in the service summary"
msgstr "Testo aggiuntivo nel riepilogo del servizio"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1460
#, python-brace-format
msgid ""
"Appended to the summary, after the value. Write '{path}' to insert another "
"field of the same response - resolved within the current element for a '[*]' "
"wildcard, from the response root otherwise. So a service on 'status' can "
"show the reason the API gave next to it, e.g. '{message} (leader {leader})', "
"instead of needing a second service for it. A path that is not in the "
"response renders as '(n/a)'. This is presentation only: it never changes the "
"state, the levels or the metric. The text is put on one line and truncated "
"if it gets long."
msgstr ""
"Viene aggiunto al riepilogo, dopo il valore. Scrivi '{path}' per inserire un "
"altro campo della stessa risposta: viene risolto all'interno dell'elemento "
"corrente per un carattere jolly '[*]', altrimenti dalla radice della "
"risposta. Così un servizio su 'status' può mostrare accanto il motivo che "
"l'API ha già restituito, ad es. '{message} (leader {leader})', invece di "
"richiedere un secondo servizio. Un percorso non presente nella risposta "
"viene mostrato come '(n/a)'. È solo presentazione: non cambia mai lo stato, "
"le soglie o la metrica. Il testo viene messo su una riga e troncato se "
"diventa lungo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1485
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:160
msgid "Endpoint"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1491
msgid "Endpoint name"
msgstr "Nome dell'endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1493
msgid ""
"Optional short name for this endpoint, e.g. 'frontend'. It names the "
"endpoint's own service - 'JSON API <name>', which reports the HTTP status "
"and the response time of the request. Without a name the URL is used. The "
"field service names keep their plain names unless 'Prefix the field service "
"names' below is enabled."
msgstr ""
"Nome breve facoltativo per questo endpoint, ad es. 'frontend'. Dà il nome al "
"servizio proprio dell'endpoint, 'JSON API <nome>', che riporta lo stato HTTP "
"e il tempo di risposta della richiesta. Senza nome viene usato l'URL. I nomi "
"dei servizi dei campi restano invariati, a meno che qui sotto non sia attivo "
"'Anteponi il nome dell'endpoint ai nomi dei servizi dei campi'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1506
msgid "Prefix the field service names with the endpoint name"
msgstr "Anteponi il nome dell'endpoint ai nomi dei servizi dei campi"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1508
msgid ""
"Off by default. Two endpoints extracting the same fields produce two "
"services with the same name - 'JSON Status' twice, the second one "
"disambiguated to 'JSON Status (2)' - and nothing in either name says which "
"application it belongs to. Turn this on and this endpoint's field services "
"are named after it instead: with the endpoint named 'app1-health', 'JSON "
"Status' becomes 'JSON app1-health Status'. Requires an endpoint name. The "
"endpoint's own service follows, from 'JSON API <name>' to 'JSON <name> API', "
"so that it sorts together with the services it describes instead of with "
"every other endpoint's status service. Enabling this RENAMES this endpoint's "
"services: the old ones become stale and the renamed ones have to be "
"discovered, so do it deliberately and re-run a service discovery afterwards."
msgstr ""
"Disattivato per impostazione predefinita. Due endpoint che estraggono gli "
"stessi campi producono due servizi con lo stesso nome – 'JSON Status' due "
"volte, il secondo distinto come 'JSON Status (2)' – e nessuno dei due nomi "
"dice a quale applicazione appartiene. Con questa opzione attiva, i servizi "
"dei campi di questo endpoint prendono il nome da esso: se l'endpoint si "
"chiama 'app1-health', 'JSON Status' diventa 'JSON app1-health Status'. "
"Richiede un nome dell'endpoint. Il servizio proprio dell'endpoint lo segue, "
"da 'JSON API <nome>' a 'JSON <nome> API', così da essere ordinato insieme ai "
"servizi che descrive anziché insieme ai servizi di stato di tutti gli altri "
"endpoint. Attivarlo RINOMINA i servizi di questo endpoint: quelli vecchi "
"diventano obsoleti e quelli rinominati devono essere rilevati, quindi fallo "
"consapevolmente ed esegui poi una nuova rilevazione dei servizi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1530
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1532
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL completo dell'endpoint JSON, incluso lo schema, ad es. 'https://app."
"example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1541
msgid "HTTP method"
msgstr "Metodo HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1543
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1544
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1552
msgid "Request body (for POST)"
msgstr "Corpo della richiesta (per POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1558
msgid "Additional request headers"
msgstr "Intestazioni della richiesta aggiuntive"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1560
msgid ""
"Sent with every request to this endpoint. Values are stored in clear text "
"and travel on the agent's command line, so an API key belongs under "
"'Authentication' - not here."
msgstr ""
"Inviate con ogni richiesta a questo endpoint. I valori sono memorizzati in "
"chiaro e viaggiano nella riga di comando dell'agente, quindi una chiave API "
"va in 'Autenticazione', non qui."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1572
msgid "Header value"
msgstr "Valore dell'intestazione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1585
msgid "Verify the TLS certificate"
msgstr "Verifica il certificato TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1586
msgid "Disabling certificate verification is insecure."
msgstr "Disattivare la verifica del certificato non è sicuro."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1593
msgid "Custom CA bundle file"
msgstr "File del bundle CA personalizzato"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1595
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"Percorso sul server Checkmk a un file PEM contenente il/i certificato/i CA "
"con cui verificare il certificato del server. Usalo per fidarti di una CA "
"interna o privata senza disattivare la verifica. Ignorato quando la verifica "
"TLS è disattivata."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1606
msgid "Client certificate (mutual TLS)"
msgstr "Certificato client (TLS reciproco)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1608
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"Presenta un certificato client al server (TLS reciproco). I file devono "
"esistere sul server Checkmk. La chiave privata deve essere non cifrata."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1616
msgid "Client certificate file"
msgstr "File del certificato client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1618
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"Percorso del certificato client (PEM). Se il file contiene anche la chiave "
"privata, lascia vuoto il campo della chiave."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1628
msgid "Private key file"
msgstr "File della chiave privata"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1630
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr ""
"Percorso della chiave privata del client (PEM), se non è inclusa nel "
"certificato."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1642
msgid "Follow HTTP redirects"
msgstr "Segui i reindirizzamenti HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1644
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Attivo per impostazione predefinita. Disattivalo in ambienti protetti per "
"rafforzare la protezione contro SSRF: una destinazione che reindirizza (ad "
"es. 3xx verso un indirizzo interno) fallirà invece di essere seguita fino "
"alla posizione di reindirizzamento."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1655
msgid "Request timeout (seconds)"
msgstr "Timeout della richiesta (secondi)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1656
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Timeout per singola richiesta. Il valore predefinito è 30 secondi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1664
msgid "Re-read at most every (seconds)"
msgstr "Rileggi al massimo ogni (secondi)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1666
msgid ""
"Reuse the last response for this endpoint instead of requesting it again, as "
"long as it is younger than this. For APIs with a request quota, expensive "
"endpoints, or a rule shared across many hosts - anything where the request "
"RATE is the problem rather than the freshness of the data. Without it, every "
"check interval on every host issues a request, which can exhaust a quota and "
"turn the monitoring itself into the outage. Only a response that parsed as "
"JSON is cached, and a failing request is never answered from an expired "
"cache - a real outage must not hide behind stale data. While a cached body "
"is served the endpoint's own service says so and reports no response time, "
"because no request was made. Leave unset to always fetch fresh."
msgstr ""
"Riutilizzare l'ultima risposta di questo endpoint invece di richiederla di "
"nuovo, purché sia più recente di questo valore. Per API con una quota di "
"richieste, endpoint costosi o una regola condivisa tra molti host: tutti i "
"casi in cui il problema è la FREQUENZA delle richieste e non l'attualità dei "
"dati. Senza questa impostazione, ogni intervallo di controllo su ogni host "
"effettua una richiesta, il che può esaurire una quota e trasformare il "
"monitoraggio stesso nel guasto. Viene memorizzata nella cache solo una "
"risposta che è stato possibile analizzare come JSON, e una richiesta fallita "
"non viene mai soddisfatta da una cache scaduta: un guasto reale non deve "
"nascondersi dietro dati obsoleti. Mentre viene servito un contenuto dalla "
"cache, il servizio proprio dell'endpoint lo segnala e non riporta alcun "
"tempo di risposta, perché non è stata fatta alcuna richiesta. Lasciare non "
"impostato per interrogare sempre in tempo reale."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1688
msgid "Retry a failed request"
msgstr "Riprova una richiesta fallita"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1690
msgid ""
"Repeat this endpoint's request when it fails in a way a repeat could fix - a "
"connection error, a timeout, or an HTTP 429 / 5xx - so a load balancer "
"dropping connections for a second during a rolling restart does not become a "
"CRIT and a notification. A 4xx, a body that is not JSON and an oversized "
"response are never retried: repeating them would only burn time. Nothing is "
"hidden - the endpoint's own service reports that a retry was needed, and can "
"be told to go WARN when one is. Every attempt costs wall-clock time inside "
"the check: the worst case is (1 + retries) times the request timeout, plus "
"the waiting time between attempts. Off by default."
msgstr ""
"Ripete la richiesta a questo endpoint quando fallisce in un modo che una "
"ripetizione può risolvere - un errore di connessione, un timeout o un HTTP "
"429 / 5xx - così che un bilanciatore che interrompe le connessioni per un "
"secondo durante un riavvio progressivo non diventi un CRIT con tanto di "
"notifica. Un 4xx, un corpo che non è JSON e una risposta troppo grande non "
"vengono mai riprovati: ripeterli consumerebbe solo tempo. Non viene nascosto "
"nulla: il servizio dell'endpoint segnala che è servito un nuovo tentativo e "
"può essere impostato su WARN quando accade. Ogni tentativo consuma tempo "
"reale all'interno del check: nel caso peggiore (1 + tentativi) per il "
"timeout della richiesta, più le attese tra i tentativi. Disattivato per "
"impostazione predefinita."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1707
msgid "Number of retries"
msgstr "Numero di tentativi"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1708
msgid "Extra attempts after the first one failed."
msgstr "Tentativi aggiuntivi dopo il fallimento del primo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1718
msgid "Wait before retrying (seconds)"
msgstr "Attesa prima di riprovare (secondi)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1720
msgid ""
"Waiting time before the first retry, doubled for each further one. The total "
"waiting time is capped at 30 seconds however many retries are configured."
msgstr ""
"Tempo di attesa prima del primo nuovo tentativo, raddoppiato per ogni "
"successivo. L'attesa complessiva è limitata a 30 secondi, indipendentemente "
"dal numero di tentativi configurati."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1737
msgid "Additional accepted HTTP status codes"
msgstr "Codici di stato HTTP aggiuntivi accettati"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1739
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"Per impostazione predefinita vengono lette solo le risposte 2xx; qualsiasi "
"altro stato porta i servizi dell'endpoint su UNKNOWN. Aggiungi qui altri "
"codici di stato da accettare, ad esempio 503 per un endpoint di health che "
"segnala i suoi problemi con un 503 e un corpo JSON. Il corpo di una risposta "
"accettata viene analizzato ed estratto come di consueto. 2xx è sempre "
"accettato."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1747
msgid "Status code"
msgstr "Codice di stato"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1755
msgid "Report the raw response"
msgstr "Riporta la risposta grezza"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1757
msgid ""
"Off by default. Put the response itself into the Details of this endpoint's "
"own 'JSON API <name>' service, exactly as it came off the wire. The Details "
"otherwise only link to the URL, which is often not reachable from the "
"browser reading the service (the API may sit behind a firewall or in another "
"network) and always shows the API as it is NOW rather than as it was when "
"the check ran. The body of a REJECTED response is reported too - an "
"unexpected HTTP status or a body that is not JSON - which is the case this "
"exists for: it is where the API explains itself. Credentials are stripped "
"first: 'Set-Cookie' and any authorization header are masked, and the "
"endpoint's own secret is removed wherever it appears. Everything else in the "
"response is reported verbatim, and a service's Details are stored with every "
"check result and travel into notifications - so do not turn this on for a "
"response carrying personal or otherwise sensitive data."
msgstr ""
"Disattivato per impostazione predefinita. Mette la risposta stessa nei "
"Dettagli del servizio proprio di questo endpoint, 'JSON API <nome>', "
"esattamente come è arrivata. Altrimenti i Dettagli rimandano solo all'URL, "
"che spesso non è raggiungibile dal browser da cui si legge il servizio "
"(l'API può stare dietro un firewall o in un'altra rete) e che mostra sempre "
"l'API come è ADESSO e non come era quando il check è stato eseguito. Viene "
"riportato anche il corpo di una risposta RIFIUTATA – uno stato HTTP inatteso "
"o un corpo che non è JSON – ed è proprio il caso per cui questa opzione "
"esiste: è lì che l'API si spiega. Le credenziali vengono rimosse prima: 'Set-"
"Cookie' e qualsiasi header di autorizzazione vengono mascherati, e il "
"segreto dell'endpoint viene rimosso dove compare. Tutto il resto viene "
"riportato alla lettera, e i Dettagli di un servizio vengono memorizzati con "
"ogni risultato del check e viaggiano nelle notifiche: non attivarlo quindi "
"per una risposta con dati personali o comunque sensibili."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1780
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1862
msgid "Report at most (bytes)"
msgstr "Riporta al massimo (byte)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1782
msgid ""
"Longer bodies are cut off at this many bytes and the service says so. Keep "
"it small: this text is stored with every check result of this service."
msgstr ""
"I corpi più lunghi vengono tagliati a questo numero di byte e il servizio lo "
"dice. Tienilo piccolo: questo testo viene memorizzato con ogni risultato del "
"check di questo servizio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1796
msgid "Report the response headers as well"
msgstr "Riporta anche gli header della risposta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1798
msgid ""
"On by default. The headers are what a rate limit, a cache directive or a "
"content type is announced in, and they are small."
msgstr ""
"Attivo per impostazione predefinita. Negli header vengono annunciati un "
"limite di richieste, una direttiva di cache o un content type, e sono "
"piccoli."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1811
msgid "Report the JSON context in the field services"
msgstr "Riporta il contesto JSON nei servizi di campo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1813
msgid ""
"Off by default. The setting above reports the response on the endpoint's OWN "
"service - but the services that go WARN or CRIT, and therefore the ones that "
"notify, are the field services, and their Details say only which path was "
"read. This puts the JSON itself there too, so the alert carries what the API "
"actually said: a service's Details travel into notifications as "
"$LONGSERVICEOUTPUT$, and the person on call often cannot reach the endpoint "
"at all - wrong network, no credentials - while the endpoint's own service "
"stayed OK and notified nobody. Credentials are stripped exactly as they are "
"for the raw response. Note that this text is stored with every check result "
"of EVERY field service of this endpoint, so keep the byte budget small."
msgstr ""
"Disattivato per impostazione predefinita. L'opzione sopra riporta la "
"risposta nel servizio PROPRIO dell'endpoint - ma i servizi che passano a "
"WARN o CRIT, e quindi quelli che notificano, sono i servizi di campo, e i "
"loro dettagli indicano solo quale percorso è stato letto. Questo mette lì "
"anche il JSON stesso, così l'allarme porta con sé ciò che l'API ha davvero "
"detto: i dettagli di un servizio arrivano nelle notifiche come "
"$LONGSERVICEOUTPUT$, e chi è di turno spesso non può raggiungere l'endpoint "
"- rete sbagliata, nessuna credenziale - mentre il servizio proprio "
"dell'endpoint è rimasto OK e non ha notificato nessuno. Le credenziali sono "
"rimosse esattamente come per la risposta grezza. Nota che questo testo è "
"memorizzato con ogni risultato di controllo di OGNI servizio di campo di "
"questo endpoint, quindi mantieni piccolo il budget di byte."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1831
msgid "What to report"
msgstr "Cosa riportare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1835
msgid "The JSON this value was read from"
msgstr "Il JSON da cui è stato letto questo valore"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1839
msgid "The whole response body"
msgstr "L'intero corpo della risposta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1844
msgid ""
"'The JSON this value was read from' is the targeted form: for a '[*]' path "
"that element, otherwise the object holding the value - so the service that "
"alerted shows the element that failed with all its sibling fields, and "
"nothing else. An aggregation has no single element and a '@header.' path is "
"not in the body at all, so both report the whole response. 'The whole "
"response body' always does, repeated on every field service - which is why "
"the cap matters more here than on the endpoint's own service."
msgstr ""
"'Il JSON da cui è stato letto questo valore' è la forma mirata: per un "
"percorso '[*]' quell'elemento, altrimenti l'oggetto che contiene il valore - "
"così il servizio che ha segnalato mostra l'elemento fallito con tutti i suoi "
"campi fratelli, e nient'altro. Un'aggregazione non ha un singolo elemento e "
"un percorso '@header.' non è affatto nel corpo, quindi entrambi riportano "
"l'intera risposta. 'L'intero corpo della risposta' lo fa sempre, ripetuto su "
"ogni servizio di campo - ed è per questo che il limite conta qui più che sul "
"servizio proprio dell'endpoint."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1864
msgid ""
"Longer context is cut off at this many bytes and the service says so. Keep "
"it small: this text is stored with every check result of every field service "
"of this endpoint."
msgstr ""
"Un contesto più lungo viene troncato a questo numero di byte e il servizio "
"lo dice. Mantienilo piccolo: questo testo è memorizzato con ogni risultato "
"di controllo di ogni servizio di campo di questo endpoint."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1881
msgid "Follow pagination"
msgstr "Seguire la paginazione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1884
msgid ""
"Off by default: one request, one page. An API that answers a collection one "
"page at a time then leaves every service built from it describing the FIRST "
"page only - 'count' over a queue that pages at 25 reports 25 however long "
"the queue is, and a '[*]' wildcard creates services for the first page's "
"elements alone. Nothing says so, which is why this is worth configuring: the "
"answer is not missing, it is wrong. With this set the agent follows the "
"API's own next-page link and appends each page's collection to the first "
"page's, so the wildcards, the aggregations, the filters and the host labels "
"all see the whole thing. Every page is requested exactly like the first one "
"(same method, headers, authentication and timeout), and each one costs a "
"request inside the check - so cap the pages, and consider a cache TTL for a "
"collection that does not change every check interval. A page that cannot be "
"read fails the endpoint rather than silently truncating the collection; "
"where a further page exists but is not followed - a cap, or a link the agent "
"refuses - the endpoint's own service reports it and goes WARN."
msgstr ""
"Disattivato per impostazione predefinita: una richiesta, una pagina. Se "
"un'API restituisce una raccolta una pagina alla volta, ogni servizio "
"costruito su di essa descrive solo la PRIMA pagina - 'count' su una coda "
"paginata a 25 riporta 25 per quanto lunga sia la coda, e un carattere jolly "
"'[*]' crea servizi solo per gli elementi della prima pagina. Nulla lo "
"segnala, ed è proprio per questo che vale la pena configurarlo: la risposta "
"non è mancante, è sbagliata. Con questa impostazione l'agente segue il "
"collegamento alla pagina successiva fornito dall'API e accoda la raccolta di "
"ogni pagina a quella della prima, così che caratteri jolly, aggregazioni, "
"condizioni ed etichette host vedano l'insieme completo. Ogni pagina viene "
"richiesta esattamente come la prima (stesso metodo, header, autenticazione e "
"timeout) e ognuna costa una richiesta all'interno del check - limitate "
"quindi le pagine e valutate un TTL di cache per una raccolta che non cambia "
"a ogni intervallo di controllo. Una pagina che non può essere letta fa "
"fallire l'endpoint invece di troncare silenziosamente la raccolta; se esiste "
"un'altra pagina che non viene seguita - per un limite o per un collegamento "
"che l'agente rifiuta - il servizio proprio dell'endpoint lo segnala e passa "
"a WARN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1910
msgid "Where the next page's URL comes from"
msgstr "Da dove proviene l'URL della pagina successiva"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1912
msgid ""
"Both forms are common; the API's documentation says which one it uses. A "
"page that carries no next link (an absent field, a JSON 'null', an empty "
"string, no 'Link' header) is the last one, which is how pagination ends."
msgstr ""
"Entrambe le forme sono comuni; la documentazione dell'API indica quale "
"utilizza. Una pagina senza collegamento alla successiva (campo assente, un "
"'null' JSON, una stringa vuota, nessun header 'Link') è l'ultima: è così che "
"la paginazione termina."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1922
msgid "A field in the response body"
msgstr "Un campo nel corpo della risposta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1924
msgid "JSON path to the next page's URL"
msgstr "Percorso JSON all'URL della pagina successiva"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1926
msgid ""
"From the response root, e.g. 'links.next', 'next' or 'meta.next_page_url'. A "
"relative URL ('/api/v1/jobs?page=2') is resolved against the page it came "
"from."
msgstr ""
"Dalla radice della risposta, ad esempio 'links.next', 'next' o 'meta."
"next_page_url'. Un URL relativo ('/api/v1/jobs?page=2') viene risolto "
"rispetto alla pagina da cui proviene."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1940
msgid "The 'Link' response header (rel=\"next\")"
msgstr "L'header di risposta 'Link' (rel=\"next\")"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1944
msgid "Read from the 'Link' header, as RFC 8288 defines it"
msgstr "Leggere dall'header 'Link', come lo definisce l'RFC 8288"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1948
msgid ""
"The convention of the GitHub, GitLab and Jenkins style APIs: 'Link: <https://"
"host/jobs?page=2>; rel=\"next\"'. The link with rel=\"next\" is followed; "
"the others ('last', 'prev') are ignored."
msgstr ""
"La convenzione delle API in stile GitHub, GitLab e Jenkins: 'Link: <https://"
"host/jobs?page=2>; rel=\"next\"'. Viene seguito il collegamento con "
"rel=\"next\"; gli altri ('last', 'prev') vengono ignorati."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1965
msgid "JSON path to the collection to merge"
msgstr "Percorso JSON alla raccolta da unire"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1967
msgid ""
"The array (or object) each page carries a slice of - e.g. 'items', 'data."
"jobs' or 'results'. Use '$' where the response IS the array. Each page's "
"collection is appended to the first page's, and the rest of the document "
"stays as the first page sent it: a 'total' or a 'generated_at' next to the "
"collection still resolves, and every path configured below is unchanged. No "
"'[*]' wildcard here - this names the collection itself, not the elements in "
"it."
msgstr ""
"L'array (o l'oggetto) di cui ogni pagina porta una porzione - ad esempio "
"'items', 'data.jobs' o 'results'. Usate '$' quando la risposta È l'array. La "
"raccolta di ogni pagina viene accodata a quella della prima e il resto del "
"documento rimane come lo ha inviato la prima pagina: un 'total' o un "
"'generated_at' accanto alla raccolta si risolve ancora e ogni percorso "
"configurato più sotto resta invariato. Nessun carattere jolly '[*]' qui: "
"questo indica la raccolta stessa, non gli elementi al suo interno."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1985
msgid "Read at most this many pages"
msgstr "Leggere al massimo questo numero di pagine"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1987
msgid ""
"Including the first one, so '1' disables following entirely. Each page is a "
"request made while the check runs, and a special agent that overruns is "
"killed - so this is the setting that keeps a collection which grew a "
"hundredfold from turning the monitoring into the outage. When the limit is "
"reached while a further page still exists, the endpoint's own service says "
"so and goes WARN instead of quietly reporting part of the collection."
msgstr ""
"Compresa la prima, quindi '1' disattiva del tutto il proseguimento. Ogni "
"pagina è una richiesta effettuata durante l'esecuzione del check e un agente "
"speciale che sfora viene terminato: è quindi questa impostazione a impedire "
"che una raccolta cresciuta di cento volte trasformi il monitoraggio stesso "
"nel guasto. Se il limite viene raggiunto mentre esiste ancora un'altra "
"pagina, il servizio proprio dell'endpoint lo segnala e passa a WARN invece "
"di riportare in silenzio una parte della raccolta."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2008
msgid "And at most this many elements"
msgstr "E al massimo questo numero di elementi"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2010
msgid ""
"Optional second cap, for a page size that is not known in advance. Checked "
"between pages, so a page is never cut in half and the collection can end "
"slightly above this. Like the page limit, reaching it while more pages exist "
"is reported on the endpoint's own service. Remember that a '[*]' wildcard "
"creates one SERVICE per element."
msgstr ""
"Secondo limite facoltativo, per una dimensione di pagina non nota in "
"anticipo. Viene verificato tra le pagine, quindi una pagina non viene mai "
"tagliata a metà e la raccolta può superarlo di poco. Come per il limite di "
"pagine, il suo raggiungimento mentre esistono altre pagine viene segnalato "
"sul servizio proprio dell'endpoint. Ricordate che un carattere jolly '[*]' "
"crea un SERVIZIO per ogni elemento."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2029
msgid "HTTP proxy"
msgstr "Proxy HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2031
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"Instrada la richiesta di questo endpoint attraverso un proxy HTTP - utile "
"quando il server Checkmk raggiunge l'API solo tramite un proxy di uscita "
"aziendale. Scegli le variabili d'ambiente HTTP_PROXY / HTTPS_PROXY, un URL "
"di proxy esplicito, oppure 'nessun proxy' per ignorare qualsiasi proxy "
"impostato nell'ambiente. Senza questa impostazione vengono rispettate le "
"variabili di proxy dell'ambiente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2045
msgid "Fields to monitor"
msgstr "Campi da monitorare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2047
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Ogni voce diventa un servizio Checkmk, costruito a partire dal valore "
"trovato nel percorso JSON indicato."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2057
msgid "Host labels"
msgstr "Etichette dell'host"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2059
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Or classify the host from a "
"collection instead: a condition plus a literal value turns 'any element of "
"services[*] whose name matches ^MyApp' into the single label 'json_api/"
"MyApp: yes', which folder rules, thresholds, contact groups and views can "
"then target. Set at discovery, so pick stable, low-cardinality fields."
msgstr ""
"Applica etichette dell'host Checkmk all'host monitorato, create dai campi "
"della risposta di questo endpoint. Ogni chiave riceve il prefisso "
"'json_api/' e il valore è risolto dalla radice della risposta - sono quindi "
"informazioni valide per l'intero host (ad es. un ambiente, una regione o una "
"versione) e NON richiedono alcun servizio. Un percorso può contenere un "
"carattere jolly '[*]' (ad es. 'components[*]') per emettere un'etichetta per "
"elemento, con la chiave '<key>/<element>' in modo che le chiavi restino "
"univoche. Oppure classifica l'host a partire da una collezione: una "
"condizione più un valore letterale trasforma 'un qualsiasi elemento di "
"services[*] il cui name corrisponde a ^MyApp' nell'unica etichetta 'json_api/"
"MyApp: yes', a cui regole di cartella, soglie, gruppi di contatto e viste "
"possono poi fare riferimento. Impostate durante il rilevamento, quindi "
"scegli campi stabili e a bassa cardinalità."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2082
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element. Can be left empty "
"only where a condition and a literal value describe the label on their own."
msgstr ""
"Dalla radice della risposta, ad es. 'version', 'cluster.region', o un "
"carattere jolly '[*]' come 'components[*]' per un'etichetta per elemento. "
"Può restare vuoto solo quando una condizione e un valore letterale "
"descrivono l'etichetta da soli."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2096
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"Per impostazione predefinita, l'ultimo segmento del percorso. Per un "
"percorso '[*]' viene aggiunto l'id dell'elemento ('<key>/<element>'). Il "
"prefisso 'json_api/' viene aggiunto automaticamente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2106
msgid "Value field (for '[*]' wildcards)"
msgstr "Campo del valore (per i caratteri jolly '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2108
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"Per un percorso '[*]': un percorso all'interno di ogni elemento per il "
"valore dell'etichetta (ad es. 'status'). Per impostazione predefinita "
"'true' (un'etichetta di appartenenza). Ignorato senza carattere jolly."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2181
msgid "Endpoints"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2183
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Uno o più endpoint HTTP/JSON. Ciascuno viene interrogato con le proprie "
"impostazioni di connessione ed estrazioni; tutti i risultati vengono uniti "
"in un'unica sezione. Un endpoint non raggiungibile influisce solo sui propri "
"servizi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2198
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:149
msgid "Generic JSON API"
msgstr "API JSON generica"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:66
msgid "Upper levels for the response time"
msgstr "Livelli superiori per il tempo di risposta"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:68
msgid ""
"How long the request to this endpoint may take, in seconds. Measured from "
"sending the request to having read the whole response body. Without levels "
"the response time is only recorded as a metric."
msgstr ""
"Quanto può durare la richiesta a questo endpoint, in secondi. Misurata "
"dall'invio della richiesta alla lettura completa del corpo della risposta. "
"Senza livelli, il tempo di risposta viene solo registrato come metrica."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:81
msgid "Lower levels for the TLS certificate's remaining validity"
msgstr "Livelli inferiori per la validità residua del certificato TLS"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:83
msgid ""
"How many days the endpoint's TLS certificate must still be valid for. Read "
"from the connection the agent already makes, so no second check against the "
"same URL is needed. Only available for HTTPS endpoints with certificate "
"verification enabled; otherwise the certificate is not reported and these "
"levels never apply. Without levels the remaining validity is only recorded "
"as a metric."
msgstr ""
"Per quanti giorni il certificato TLS dell'endpoint deve essere ancora "
"valido. Viene letto dalla connessione che l'agente stabilisce comunque, "
"quindi non serve un secondo controllo sullo stesso URL. Disponibile solo per "
"endpoint HTTPS con la verifica del certificato attiva; in caso contrario il "
"certificato non viene riportato e questi livelli non si applicano mai. Senza "
"livelli, la validità residua viene solo registrata come metrica."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:99
msgid "State when the request needed a retry"
msgstr "Stato quando la richiesta ha richiesto un nuovo tentativo"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:101
msgid ""
"Applies when the endpoint's retry policy absorbed a failed attempt: the "
"request did succeed, but not on the first try. OK by default - a retry doing "
"its job is not itself a problem. Raise it for an endpoint whose flakiness is "
"worth knowing about, so retries never quietly turn a degrading API into a "
"permanently green service."
msgstr ""
"Si applica quando la politica di ripetizione dell'endpoint ha assorbito un "
"tentativo fallito: la richiesta è riuscita, ma non al primo colpo. OK per "
"impostazione predefinita: un nuovo tentativo che fa il suo lavoro non è di "
"per sé un problema. Alzalo per un endpoint la cui instabilità vale la pena "
"conoscere, così che i tentativi non trasformino silenziosamente un'API che "
"peggiora in un servizio sempre verde."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:114
msgid "State when the collection was read incompletely"
msgstr "Stato quando la raccolta è stata letta in modo incompleto"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:116
msgid ""
"Applies when the endpoint follows the API's pagination and a further page "
"existed that was not read - a page or element limit was reached, or the API "
"offered a link the agent refuses to follow (another host, or one it had "
"already fetched). Every service built from that collection - a count, an "
"aggregation, a '[*]' wildcard - is then describing part of it. WARN by "
"default, because a collection quietly missing its tail is exactly what "
"following the pages was meant to prevent. Lower it to OK for an endpoint "
"where reading the first N pages is deliberate."
msgstr ""
"Si applica quando l'endpoint segue la paginazione dell'API ed esisteva "
"un'altra pagina che non è stata letta: è stato raggiunto un limite di pagine "
"o di elementi, oppure l'API ha offerto un collegamento che l'agente rifiuta "
"di seguire (un altro host, o uno già recuperato). Ogni servizio costruito su "
"quella raccolta - un conteggio, un'aggregazione, un carattere jolly '[*]' - "
"descrive allora solo una parte di essa. WARN per impostazione predefinita, "
"perché una raccolta a cui manca silenziosamente la coda è esattamente ciò "
"che seguire le pagine deve evitare. Abbassatelo a OK per un endpoint in cui "
"leggere le prime N pagine è intenzionale."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:134
msgid "State when the endpoint cannot be read"
msgstr "Stato quando l'endpoint non può essere letto"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:136
msgid ""
"Applies when the request fails outright: connection refused, a TLS error, a "
"timeout, an HTTP status that is not accepted, or a response that is not JSON."
msgstr ""
"Si applica quando la richiesta fallisce del tutto: connessione rifiutata, un "
"errore TLS, un timeout, uno stato HTTP non accettato o una risposta che non "
"è JSON."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:157
msgid "Generic JSON API endpoint"
msgstr "Endpoint API JSON generico"

