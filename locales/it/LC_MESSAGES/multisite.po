#: cmk_addons/plugins/json_api/rulesets/special_agent.py:43
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Espressione regolare non valida: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:60
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Ogni URL dell'endpoint deve essere univoco. Duplicato: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:70
msgid "The URL must not contain whitespace."
msgstr "L'URL non deve contenere spazi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:74
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Inserire un URL http(s) valido, ad es. 'https://host/percorso'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:80
msgid "Authentication"
msgstr "Autenticazione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:85
msgid "Basic authentication (username / password)"
msgstr "Autenticazione di base (nome utente / password)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:91
msgid "Username"
msgstr "Nome utente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:98
msgid "Password"
msgstr "Password"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:107
msgid "Bearer token"
msgstr "Token Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:113
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:114
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Inviato come 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:127
msgid "String matching"
msgstr "Corrispondenza di stringhe"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:128
msgid "How to turn a string value into a Checkmk service state."
msgstr "Come trasformare un valore stringa in uno stato di servizio Checkmk."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:133
msgid "Value must match a regular expression"
msgstr "Il valore deve corrispondere a un'espressione regolare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:139
msgid "Expected value (regex)"
msgstr "Valore atteso (regex)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:141
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Per i valori stringa: il valore deve corrispondere completamente a questa "
"espressione regolare (ad es. 'UP|ok')."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:150
msgid "State when the value does not match"
msgstr "Stato quando il valore non corrisponde"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:159
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Associa il valore a uno stato (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:162
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Per i valori stringa con più stati noti: ogni modello è un'espressione "
"regolare confrontata con l'intero valore. Vengono provati nell'ordine OK, "
"WARN, CRIT e vince la prima corrispondenza."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:171
msgid "OK when the value matches (regex)"
msgstr "OK quando il valore corrisponde (regex)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:178
msgid "WARN when the value matches (regex)"
msgstr "WARN quando il valore corrisponde (regex)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:185
msgid "CRIT when the value matches (regex)"
msgstr "CRIT quando il valore corrisponde (regex)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:192
msgid "State when nothing matches"
msgstr "Stato quando non corrisponde nulla"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:222
msgid "Field to monitor"
msgstr "Campo da monitorare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:228
msgid "Service name"
msgstr "Nome del servizio"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:229
msgid "Becomes the Checkmk service description for this field."
msgstr "Diventa la descrizione del servizio Checkmk per questo campo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:236
msgid "JSON path"
msgstr "Percorso JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:238
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\"."
msgstr ""
"Percorso con notazione a punti nella risposta JSON, ad es. 'status', "
"'components.db.status' o 'items[0].count'. Utilizza un carattere jolly "
"'[*]' (ad es. 'nodes[*].health') per creare un servizio per ogni elemento "
"dell'array - oppure, quando il carattere jolly ricade su un oggetto JSON "
"(una mappa indicizzata per nome, come un '/health' di Spring Boot Actuator "
"'components[*].status'), un servizio per chiave. Più caratteri jolly "
"'[*]' (ad es. 'pods[*].containers[*].ready') espandono il prodotto "
"cartesiano, un servizio per ogni combinazione. Un '$.' iniziale è "
"facoltativo. Le chiavi che contengono a loro volta '.' o '[' possono essere "
"indirizzate con segmenti tra parentesi quadre e virgolette, ad es. "
"\"data['foo.bar'].value\"."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:258
msgid "Item label path (for '[*]' wildcards)"
msgstr "Percorso dell'etichetta dell'elemento (per i caratteri jolly '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:260
msgid ""
"When the path contains a '[*]' wildcard, this optional path - relative to "
"each array element, e.g. 'name' or 'id' - provides the label appended to the "
"service name. Defaults to the array index (or, for an object, the key). With "
"multiple '[*]' wildcards it is resolved at every level and the labels are "
"joined with ' / ' (e.g. '<pod> / <container>'). Pick a field that is unique "
"and stable across runs."
msgstr ""
"Quando il percorso contiene un carattere jolly '[*]', questo percorso "
"facoltativo - relativo a ciascun elemento dell'array, ad es. 'name' o 'id' - "
"fornisce l'etichetta aggiunta al nome del servizio. Per impostazione "
"predefinita è l'indice dell'array (o, per un oggetto, la chiave). Con più "
"caratteri jolly '[*]' viene risolto a ogni livello e le etichette vengono "
"unite con ' / ' (ad es. '<pod> / <container>'). Scegli un campo univoco e "
"stabile tra le esecuzioni."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:274
msgid "Unit (for numeric values)"
msgstr "Unità (per valori numerici)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:276
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Visualizza la metrica e il grafico con questa unità. Lascia vuoto per un "
"valore semplice, senza unità. Riguarda solo i valori numerici."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:280
msgid "Count (integer)"
msgstr "Conteggio (intero)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:281
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Byte (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:282
msgid "Seconds (duration)"
msgstr "Secondi (durata)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:283
msgid "Percent"
msgstr "Percentuale"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:285
msgid "No unit"
msgstr "Nessuna unità"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:291
msgid "Upper levels (for numeric values)"
msgstr "Livelli superiori (per valori numerici)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:300
msgid "Lower levels (for numeric values)"
msgstr "Livelli inferiori (per valori numerici)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:316
msgid "Endpoint"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:321
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:323
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL completo dell'endpoint JSON, incluso lo schema, ad es. 'https://app."
"example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:332
msgid "HTTP method"
msgstr "Metodo HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:334
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:335
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:343
msgid "Request body (for POST)"
msgstr "Corpo della richiesta (per POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:349
msgid "Additional request headers"
msgstr "Intestazioni della richiesta aggiuntive"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:354
msgid "Header name"
msgstr "Nome dell'intestazione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:358
msgid "Header value"
msgstr "Valore dell'intestazione"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:371
msgid "Verify the TLS certificate"
msgstr "Verifica il certificato TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:372
msgid "Disabling certificate verification is insecure."
msgstr "Disattivare la verifica del certificato non è sicuro."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:379
msgid "Follow HTTP redirects"
msgstr "Segui i reindirizzamenti HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:381
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Attivo per impostazione predefinita. Disattivalo in ambienti protetti per "
"rafforzare la protezione contro SSRF: una destinazione che reindirizza (ad "
"es. 3xx verso un indirizzo interno) fallirà invece di essere seguita fino "
"alla posizione di reindirizzamento."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:392
msgid "Request timeout (seconds)"
msgstr "Timeout della richiesta (secondi)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:393
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Timeout per singola richiesta. Il valore predefinito è 30 secondi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:401
msgid "Fields to monitor"
msgstr "Campi da monitorare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:403
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Ogni voce diventa un servizio Checkmk, costruito a partire dal valore "
"trovato nel percorso JSON indicato."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:430
msgid "Endpoints"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:432
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Uno o più endpoint HTTP/JSON. Ciascuno viene interrogato con le proprie "
"impostazioni di connessione ed estrazioni; tutti i risultati vengono uniti "
"in un'unica sezione. Un endpoint non raggiungibile influisce solo sui propri "
"servizi."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:447
msgid "Generic JSON API"
msgstr "API JSON generica"

#: cmk_addons/plugins/json_api/graphing/json_api.py:19
msgid "Value"
msgstr "Valore"

#: cmk_addons/plugins/json_api/graphing/json_api.py:26
msgid "Count"
msgstr "Conteggio"

#: cmk_addons/plugins/json_api/graphing/json_api.py:33
msgid "Size"
msgstr "Dimensione"

#: cmk_addons/plugins/json_api/graphing/json_api.py:40
msgid "Duration"
msgstr "Durata"

#: cmk_addons/plugins/json_api/graphing/json_api.py:47
msgid "Percentage"
msgstr "Percentuale"

