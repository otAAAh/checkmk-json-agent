#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Expressão regular inválida: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "Níveis superiores (para valores numéricos)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "Níveis inferiores (para valores numéricos)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "Correspondência de cadeias de caracteres"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr ""
"Como converter um valor de cadeia de caracteres num estado de serviço do "
"Checkmk."

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "O valor deve corresponder a uma expressão regular"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "Valor esperado (regex)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Para valores de cadeia de caracteres: o valor deve corresponder "
"completamente a esta expressão regular (por ex. 'UP|ok')."

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "Estado quando o valor não corresponde"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Mapear o valor para um estado (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Para valores de cadeia de caracteres com vários estados conhecidos: cada "
"padrão é uma expressão regular comparada com o valor completo. São testados "
"pela ordem OK, WARN, CRIT e a primeira correspondência prevalece."

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "OK quando o valor corresponde (regex)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "WARN quando o valor corresponde (regex)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "CRIT quando o valor corresponde (regex)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "Estado quando nada corresponde"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:82
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "Expressão aritmética inválida: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:88
msgid ""
"Only the variables 'value' and 'other', numbers, parentheses and + - * / are "
"allowed."
msgstr ""
"Apenas as variáveis 'value' e 'other', números, parênteses e + - * / são "
"permitidos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:94
#, python-format
msgid "Unknown variable '%s' - only 'value' and 'other' are available."
msgstr ""
"Variável desconhecida '%s' - apenas 'value' e 'other' estão disponíveis."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:99
msgid "Only numeric constants are allowed."
msgstr "Apenas são permitidas constantes numéricas."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:137
msgid ""
"A metric name must consist of letters, digits and underscores only, and "
"start with a letter or a digit."
msgstr ""
"Um nome de métrica só pode conter letras, dígitos e sublinhados, e tem de "
"começar por uma letra ou um dígito."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:144
#, python-format
msgid ""
"'%s' is one of this plugin's own metrics. A field given that name inherits "
"its unit, colour and Perf-O-Meter, which is almost never what is meant - a "
"percentage named 'json_api_bytes' is rendered as bytes. Choose a name of "
"your own, or leave this empty to get the right one automatically."
msgstr ""
"'%s' é uma das métricas do próprio plugin. Um campo com esse nome herda a "
"sua unidade, cor e Perf-O-Meter, o que quase nunca é o pretendido: uma "
"percentagem chamada 'json_api_bytes' é apresentada em bytes. Escolha um nome "
"seu, ou deixe vazio para obter automaticamente o correto."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:240
#, python-format
msgid ""
"The fields %s of the shared service '%s' would all be recorded as the metric "
"'%s'. Give them names that differ by more than punctuation, or set 'Metric "
"name' on all but one."
msgstr ""
"Os campos %s do serviço partilhado '%s' seriam todos registados como a "
"métrica '%s'. Dê-lhes nomes que difiram em mais do que a pontuação, ou "
"defina 'Nome da métrica' em todos menos um."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:266
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Cada URL de endpoint deve ser único. Duplicado: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:275
#, python-format
msgid "Each endpoint name must be unique. Duplicated: %s"
msgstr "Cada nome de endpoint deve ser único. Duplicado: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:285
msgid "The URL must not contain whitespace."
msgstr "O URL não pode conter espaços em branco."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:289
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Introduza um URL http(s) válido, p. ex. 'https://host/caminho'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:305
msgid "Enter a valid HTTP header name, e.g. 'X-API-Key'."
msgstr "Introduza um nome de cabeçalho HTTP válido, p. ex. 'X-API-Key'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:314
msgid "Enter a valid query parameter name, e.g. 'api_key'."
msgstr "Introduza um nome de parâmetro de consulta válido, p. ex. 'api_key'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:332
msgid ""
"The collection to merge must name the collection itself, without a '[*]' "
"wildcard - e.g. 'data.items' rather than 'data.items[*]'."
msgstr ""
"A coleção a fundir deve indicar a própria coleção, sem um caractere "
"universal '[*]' - por exemplo 'data.items' em vez de 'data.items[*]'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:343
msgid "The path to the next page's URL must not contain a '[*]' wildcard."
msgstr ""
"O caminho para o URL da página seguinte não pode conter um caractere "
"universal '[*]'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:360
msgid ""
"A page size parameter needs a page size to send. Set 'Page size', or remove "
"the parameter."
msgstr ""
"Um parâmetro de tamanho de página precisa de um tamanho de página para "
"enviar. Defina 'Tamanho de página' ou remova o parâmetro."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:366
msgid "The position and the page size need two different parameters."
msgstr ""
"A posição e o tamanho de página precisam de dois parâmetros diferentes."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:371
msgid "The path to the total must not contain a '[*]' wildcard."
msgstr "O caminho para o total não pode conter um caractere universal '[*]'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:385
msgid "Number of the first page"
msgstr "Número da primeira página"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:386
msgid "1 for most APIs; 0 where the API counts from zero."
msgstr "1 para a maioria das APIs; 0 quando a API conta a partir de zero."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:396
msgid "Query parameter"
msgstr "Parâmetro de consulta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:398
msgid ""
"The name the API reads the position from, e.g. 'page', 'p', 'offset' or "
"'skip'. A misspelt name is recognised by the API answering the same page "
"again, which stops pagination and is reported on the endpoint's own service."
msgstr ""
"O nome de onde a API lê a posição, p. ex. 'page', 'p', 'offset' ou 'skip'. "
"Um nome mal escrito reconhece-se porque a API devolve de novo a mesma "
"página, o que para a paginação e é comunicado no serviço próprio do endpoint."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:411
msgid "Page size"
msgstr "Tamanho de página"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:413
msgid ""
"How many elements a full page carries. A page with fewer is the last one, "
"which saves the request for the empty page after it. Leave it unset where "
"the API decides and does not say: then an empty page is what ends pagination."
msgstr ""
"Quantos elementos contém uma página completa. Uma página com menos é a "
"última, o que poupa o pedido da página vazia seguinte. Deixe por definir "
"quando é a API que decide sem o dizer: então é uma página vazia que termina "
"a paginação."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:425
msgid "Send the page size as"
msgstr "Enviar o tamanho de página como"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:427
msgid ""
"The query parameter that asks the API for that page size, e.g. 'limit', "
"'per_page' or 'size'. Sent on every page, the first one included."
msgstr ""
"O parâmetro de consulta que pede à API esse tamanho de página, p. ex. "
"'limit', 'per_page' ou 'size'. Enviado em todas as páginas, incluindo a "
"primeira."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:438
msgid "JSON path to the total number of elements"
msgstr "Caminho JSON para o número total de elementos"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:440
msgid ""
"Where the API states how many elements the whole collection holds, e.g. "
"'total' or 'meta.total_count'. Once that many have been read, pagination "
"ends without asking for another page. A value that is absent or not a number "
"is ignored."
msgstr ""
"Onde a API indica quantos elementos contém a coleção inteira, p. ex. 'total' "
"ou 'meta.total_count'. Depois de lidos tantos, a paginação termina sem pedir "
"outra página. Um valor ausente ou não numérico é ignorado."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:464
msgid ""
"Prefixing the field service names needs an endpoint name. Set 'Endpoint "
"name', or turn the prefix off."
msgstr ""
"Prefixar os nomes dos serviços dos campos requer um nome do endpoint. Defina "
"'Nome do endpoint' ou desative o prefixo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:488
#, python-format
msgid ""
"The header '%s' carries the API key and must not also be set under "
"'Additional request headers'."
msgstr ""
"O cabeçalho '%s' transporta a chave de API e não pode ser definido também em "
"'Cabeçalhos de pedido adicionais'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:548
msgid ""
"'element' is the column the table rows of a '[*]' wildcard are keyed by, so "
"it cannot also name a column. Choose another attribute name."
msgstr ""
"'element' é a coluna que identifica as linhas de tabela de um carácter "
"universal '[*]', pelo que não pode nomear também uma coluna. Escolha outro "
"nome de atributo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:556
msgid ""
"A field written to the inventory creates no service, so it cannot report "
"into a shared one. Tick 'Also create a service for this field', or clear "
"'Report in a shared service named'."
msgstr ""
"Um campo escrito no inventário não cria nenhum serviço, pelo que não pode "
"reportar num serviço partilhado. Marque 'Criar também um serviço para este "
"campo' ou limpe 'Reportar num serviço partilhado chamado'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:569
msgid ""
"'Labels for the created host' needs 'Create one host per element, named by "
"this field' - without it the element stays a service on this host and there "
"is no host to label."
msgstr ""
"«Etiquetas para o anfitrião criado» precisa de «Criar um host por elemento, "
"com o nome deste campo»: sem isso o elemento continua a ser um serviço neste "
"host e não há nenhum host para etiquetar."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:580
msgid ""
"The transform uses 'other', so 'Second path for the transform' must be set "
"to say where that value comes from."
msgstr ""
"A transformação usa 'other', pelo que 'Segundo caminho para a transformação' "
"tem de estar definido para indicar de onde vem esse valor."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:587
msgid ""
"'Second path for the transform' is only used through the variable 'other' - "
"add it to the transform (e.g. 'value / other * 100') or clear the path."
msgstr ""
"'Segundo caminho para a transformação' só é usado através da variável "
"'other' - adicione-a à transformação (por exemplo 'value / other * 100') ou "
"limpe o caminho."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:606
msgid ""
"Without a 'JSON path' the label is described by the rule alone, so both a "
"'Label key' and a literal 'Label value' are needed."
msgstr ""
"Sem um 'Caminho JSON' a etiqueta é descrita apenas pela regra, pelo que são "
"necessárias tanto uma 'Chave da etiqueta' como um 'Valor da etiqueta' "
"literal."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:618
msgid ""
"Set either a literal 'Label value' or a 'Value field' to read it from, not "
"both."
msgstr ""
"Defina um 'Valor da etiqueta' literal ou um 'Campo de valor' de onde o ler, "
"mas não ambos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:636
msgid "Give at least one end of the range, or leave the range unset."
msgstr ""
"Indique pelo menos um extremo do intervalo, ou deixe o intervalo por definir."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:640
msgid "The lowest value must be smaller than the highest value."
msgstr "O valor mais baixo tem de ser menor do que o valor mais alto."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:653
#, python-brace-format
msgid ""
"Use '{path}' to insert a field, e.g. '{message} (leader {leader})'. Braces "
"must be paired and cannot be nested or empty."
msgstr ""
"Utilize '{path}' para inserir um campo, p. ex. '{message} (leader "
"{leader})'. As chavetas têm de estar emparelhadas e não podem ser aninhadas "
"nem vazias."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:674
msgid ""
"Enter a dotted inventory path of at least two segments, using lower-case "
"letters, digits and '_' - e.g. 'software.applications.json_api'."
msgstr ""
"Introduza um caminho de inventário com pontos e pelo menos dois segmentos, "
"usando minúsculas, dígitos e '_' - p. ex. 'software.applications.json_api'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:681
msgid ""
"The inventory path must start with 'hardware', 'software' or 'networking'."
msgstr ""
"O caminho de inventário tem de começar por 'hardware', 'software' ou "
"'networking'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:689
msgid ""
"Use lower-case letters, digits and '_' for the attribute name, e.g. "
"'version'."
msgstr ""
"Use minúsculas, dígitos e '_' para o nome do atributo, p. ex. 'version'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:696
msgid "Write into the HW/SW inventory"
msgstr "Escrever no inventário de HW/SW"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:698
msgid ""
"Put this field into the host's inventory tree instead of making it a "
"service. Meant for facts rather than states - a version, a build, a region, "
"a licence tier - which are not worth a service that is OK forever, and which "
"the inventory can do something with that services cannot: it is searchable "
"ACROSS hosts ('which hosts still run a version below 4.2?') and keeps a "
"history of its own. For a '[*]' wildcard the elements become one table row "
"each, keyed by an 'element' column holding the element's name. Point this at "
"values that rarely change: every change is recorded in the inventory "
"history, so a counter here grows those files without bound. Inventory runs "
"on its own (slower) schedule, not at every check interval."
msgstr ""
"Coloca este campo na árvore de inventário do host em vez de o transformar "
"num serviço. Destina-se a factos e não a estados - uma versão, uma "
"compilação, uma região, um nível de licença -, que não justificam um serviço "
"eternamente OK e com os quais o inventário faz algo que os serviços não "
"conseguem: é pesquisável ENTRE hosts («que hosts ainda têm uma versão "
"inferior à 4.2?») e mantém um histórico próprio. Com um carácter universal "
"'[*]', cada elemento passa a ser uma linha de tabela, identificada por uma "
"coluna 'element' que contém o nome do elemento. Utilize-o para valores que "
"raramente mudam: cada alteração fica registada no histórico do inventário, "
"pelo que um contador aqui faz crescer esses ficheiros sem limite. O "
"inventário corre segundo o seu próprio calendário (mais lento) e não em cada "
"intervalo de verificação."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:715
msgid "Inventory tree node"
msgstr "Nó da árvore de inventário"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:717
msgid ""
"Dotted path of the node the value is written to, e.g. 'software.applications."
"json_api'. Must start with 'hardware', 'software' or 'networking'."
msgstr ""
"Caminho com pontos do nó onde o valor é escrito, p. ex. 'software."
"applications.json_api'. Tem de começar por 'hardware', 'software' ou "
"'networking'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:728
msgid "Attribute name"
msgstr "Nome do atributo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:730
msgid ""
"Name of the attribute (or, for a '[*]' wildcard, the column). Defaults to "
"the JSON path's last segment. For a '[*]' wildcard it cannot be 'element': "
"that is the column the table rows themselves are keyed by."
msgstr ""
"Nome do atributo (ou da coluna, com um carácter universal '[*]'). Por "
"predefinição, o último segmento do caminho JSON. Com um carácter universal "
"'[*]' não pode ser 'element': essa é a coluna que identifica as próprias "
"linhas da tabela."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:741
msgid "Also create a service for this field"
msgstr "Criar também um serviço para este campo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:743
msgid ""
"Off by default: an inventory field creates NO service, which is the point - "
"it does not consume a service slot or a check interval to report something "
"that changes twice a year. Turn it on for a value you want in the inventory "
"AND want to alert on, e.g. a version you also match against a regex."
msgstr ""
"Desativado por predefinição: um campo de inventário NÃO cria qualquer "
"serviço, e é esse o objetivo - não ocupa um lugar de serviço nem um "
"intervalo de verificação para comunicar algo que muda duas vezes por ano. "
"Ative-o para um valor que queira no inventário E sobre o qual queira "
"alertas, p. ex. uma versão que também compara com uma expressão regular."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:759
msgid "Authentication"
msgstr "Autenticação"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:764
msgid "Basic authentication (username / password)"
msgstr "Autenticação básica (nome de utilizador / palavra-passe)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:770
msgid "Username"
msgstr "Nome de utilizador"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:777
msgid "Password"
msgstr "Palavra-passe"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:786
msgid "Bearer token"
msgstr "Token Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:792
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:793
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Enviado como 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:802
msgid "OAuth 2.0 (client credentials)"
msgstr "OAuth 2.0 (credenciais de cliente)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:805
msgid ""
"The machine-to-machine OAuth 2.0 grant: the agent exchanges a client ID and "
"secret for a short-lived access token and sends it as 'Authorization: Bearer "
"<token>'. The token is cached until shortly before it expires, so a rule "
"polling every minute does not ask the identity provider every minute. No "
"browser and no user consent are involved - if your API only works with a "
"token obtained by a person logging in, this is not the right mode."
msgstr ""
"A concessão OAuth 2.0 máquina-a-máquina: o agente troca um ID de cliente e "
"um segredo por um token de acesso de curta duração e envia-o como "
"'Authorization: Bearer <token>'. O token fica em cache até pouco antes de "
"expirar, para que uma regra que consulta a cada minuto não pergunte ao "
"fornecedor de identidade a cada minuto. Não há browser nem consentimento do "
"utilizador envolvidos - se a sua API só funcionar com um token obtido por "
"uma pessoa ao iniciar sessão, este não é o modo certo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:818
msgid "Token URL"
msgstr "URL do token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:820
msgid ""
"The identity provider's token endpoint, e.g. 'https://login.example.com/"
"oauth2/v2.0/token'. This is NOT the API URL above."
msgstr ""
"O endpoint de token do fornecedor de identidade, por exemplo 'https://login."
"example.com/oauth2/v2.0/token'. NÃO é o URL da API acima."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:831
msgid "Client ID"
msgstr "ID do cliente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:838
msgid "Client secret"
msgstr "Segredo do cliente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:845
msgid "Scope"
msgstr "Âmbito (scope)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:847
msgid ""
"Space-separated scopes to request, if the provider needs them - e.g. 'api://"
"monitoring/.default'."
msgstr ""
"Âmbitos separados por espaços a pedir, se o fornecedor precisar deles - por "
"exemplo 'api://monitoring/.default'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:855
msgid "Audience"
msgstr "Audiência"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:857
msgid ""
"Sent as the 'audience' parameter. Required by some providers (Auth0, for "
"instance) to say which API the token is for; leave empty otherwise."
msgstr ""
"Enviado como o parâmetro 'audience'. Exigido por alguns fornecedores (Auth0, "
"por exemplo) para indicar a que API se destina o token; caso contrário, "
"deixe vazio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:866
msgid "How to send the client credentials"
msgstr "Como enviar as credenciais do cliente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:868
msgid ""
"RFC 6749 allows both, and providers disagree about which they accept - a "
"wrong choice here shows up as an unhelpful 401 from the token URL. Try the "
"Authorization header first; switch to the request body if the provider "
"rejects it."
msgstr ""
"O RFC 6749 permite ambos e os fornecedores discordam sobre qual aceitam - "
"uma escolha errada aqui manifesta-se como um 401 pouco útil vindo do URL do "
"token. Experimente primeiro o cabeçalho Authorization; mude para o corpo do "
"pedido se o fornecedor o rejeitar."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:877
msgid "In the Authorization header (HTTP basic)"
msgstr "No cabeçalho Authorization (HTTP basic)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:881
msgid "In the request body"
msgstr "No corpo do pedido"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:892
msgid "API key in a request header"
msgstr "Chave de API num cabeçalho do pedido"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:898
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1674
msgid "Header name"
msgstr "Nome do cabeçalho"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:900
msgid ""
"Name of the header carrying the key, e.g. 'X-API-Key', 'apikey' or 'PRIVATE-"
"TOKEN'. For 'Authorization: Bearer <token>' use the bearer token choice "
"instead."
msgstr ""
"Nome do cabeçalho que transporta a chave, p. ex. 'X-API-Key', 'apikey' ou "
"'PRIVATE-TOKEN'. Para 'Authorization: Bearer <token>' utilize antes a opção "
"de token Bearer."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:912
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:951
msgid "API key"
msgstr "Chave de API"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:914
msgid ""
"Kept in the Checkmk password store. Unlike a key typed into 'Additional "
"request headers' it is never written to the configuration or to the agent's "
"command line in clear text, and it can be rotated in one place."
msgstr ""
"Guardada no cofre de palavras-passe do Checkmk. Ao contrário de uma chave "
"escrita em 'Cabeçalhos de pedido adicionais', nunca é escrita em texto "
"simples na configuração nem na linha de comandos do agente, e pode ser "
"rodada num único sítio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:928
msgid "API key in a query parameter"
msgstr "Chave de API num parâmetro de consulta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:934
msgid "Parameter name"
msgstr "Nome do parâmetro"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:936
msgid ""
"Name of the query parameter carrying the key, e.g. 'api_key'. It is appended "
"to the URL for the request only: the key is redacted wherever the agent "
"reports a URL, and it never appears in the service name. Prefer a header "
"where the API offers one - a key in the URL is visible to proxies and server "
"logs along the way."
msgstr ""
"Nome do parâmetro de consulta que transporta a chave, p. ex. 'api_key'. É "
"acrescentado ao URL apenas para o pedido: a chave é ocultada em qualquer URL "
"que o agente comunique e nunca aparece no nome do serviço. Prefira um "
"cabeçalho se a API oferecer um - uma chave no URL é visível para os proxies "
"e os registos dos servidores pelo caminho."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:953
msgid ""
"Kept in the Checkmk password store, so it is not written to the "
"configuration or to the agent's command line in clear text - unlike a key "
"typed into the URL."
msgstr ""
"Guardada no cofre de palavras-passe do Checkmk, pelo que não é escrita em "
"texto simples na configuração nem na linha de comandos do agente - ao "
"contrário de uma chave escrita no URL."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1017
msgid "Field path (within each element)"
msgstr "Caminho do campo (dentro de cada elemento)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1019
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr ""
"Resolvido dentro de cada elemento, p. ex. 'status' ou 'metadata.phase'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1027
msgid "Condition"
msgstr "Condição"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1029
msgid "equals"
msgstr "é igual a"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1030
msgid "does not equal"
msgstr "não é igual a"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1031
msgid "matches regex"
msgstr "corresponde à regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1032
msgid "does not match regex"
msgstr "não corresponde à regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1040
msgid "Comparison value / pattern"
msgstr "Valor de comparação / padrão"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1042
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr "O valor a comparar, ou a expressão regular para as condições regex."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1053
msgid "Field to monitor"
msgstr "Campo a monitorizar"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1060
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:152
msgid "Service name"
msgstr "Nome do serviço"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1062
msgid ""
"Becomes the Checkmk service description for this field - or, where the field "
"reports into a shared service, the name of its line within that service."
msgstr ""
"Torna-se a descrição do serviço Checkmk para este campo – ou, quando o campo "
"reporta num serviço partilhado, o nome da sua linha dentro desse serviço."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1072
msgid "Report in a shared service named"
msgstr "Reportar num serviço partilhado chamado"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1074
msgid ""
"By default every field becomes a service of its own. Name a shared service "
"here and this field reports into that one service as a LINE instead, "
"alongside the other fields naming it - so a small API of 'status', "
"'component' and 'timestamp' can be one service rather than three. The "
"service's state is the WORST of its lines, which is how Checkmk aggregates "
"any check, and 'Service name' above then names the line rather than the "
"service. Each line keeps its own levels, string matching and transform from "
"this rule. Two things change, both because one service now holds several "
"fields: a 'Generic JSON API' check-parameters rule cannot describe it and is "
"not applied to it, so thresholds for these fields live here; and each line's "
"metric is named after the line ('json_api_bytes_root_used'), which keeps the "
"history of several fields apart but renders as a plain number rather than in "
"the field's unit. That runtime name also decides which dashboard widgets can "
"use the field: a Graph widget draws whatever the service carries and is "
"unaffected, but Gauge, Single metric and Bar chart are bound to one metric "
"CHOSEN BY NAME, and their dropdown only offers a service's real names once "
"the widget is filtered to a host and a service - set 'Metric name' below to "
"pick the name yourself instead. A field that needs its unit on the graph, or "
"per-service thresholds, is better off with a service of its own."
msgstr ""
"Por omissão cada campo torna-se um serviço próprio. Indique aqui um serviço "
"partilhado e este campo passa a reportar nesse único serviço como uma LINHA, "
"ao lado dos outros campos que o nomeiam – assim uma pequena API com "
"'status', 'component' e 'timestamp' é um serviço em vez de três. O estado do "
"serviço é o PIOR das suas linhas, que é como o Checkmk agrega qualquer "
"check, e 'Nome do serviço' acima passa a nomear a linha em vez do serviço. "
"Cada linha mantém os seus próprios limiares, a sua correspondência de texto "
"e a sua transformação desta regra. Mudam duas coisas, ambas porque um "
"serviço passa a conter vários campos: uma regra de parâmetros de check "
"'Generic JSON API' não o consegue descrever e não lhe é aplicada, por isso "
"os limiares destes campos ficam aqui; e a métrica de cada linha recebe o "
"nome da linha, o que mantém separados os históricos de vários campos mas é "
"apresentada como um número simples em vez de na unidade do campo. Esse nome "
"gerado em tempo de execução (p. ex. 'json_api_bytes_root_used') também "
"decide que elementos do painel podem usar o campo: um elemento Gráfico "
"desenha o que o serviço traz e não é afetado, ao passo que Indicador, "
"Métrica única e Gráfico de barras estão ligados a uma só métrica ESCOLHIDA "
"PELO NOME, e a sua lista pendente só oferece os nomes reais de um serviço "
"depois de o elemento ser filtrado por um anfitrião e um serviço; defina "
"antes 'Nome da métrica' abaixo para escolher o nome você mesmo. Um campo que "
"precise da sua unidade no gráfico, ou de limiares por serviço, fica melhor "
"com um serviço próprio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1108
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1196
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1274
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2210
msgid "JSON path"
msgstr "Caminho JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1110
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\". To monitor a RESPONSE HEADER instead of a field of the body, prefix "
"its name with '@header.', e.g. '@header.X-RateLimit-Remaining' for an API "
"quota or '@header.Last-Modified' with 'Interpret the value as' set to a "
"timestamp for the age of the data. Header names are matched case-"
"insensitively and none of the path syntax above applies to them."
msgstr ""
"Caminho com pontos para a resposta JSON, p. ex. 'status', 'components.db."
"status' ou 'items[0].count'. Utilize um carácter universal '[*]' (p. ex. "
"'nodes[*].health') para criar um serviço por elemento do array - ou, quando "
"o carácter universal recai sobre um objeto JSON (um mapa indexado por nome, "
"como um '/health' do Spring Boot Actuator 'components[*].status'), um "
"serviço por chave. Vários caracteres universais '[*]' (p. ex. 'pods[*]."
"containers[*].ready') expandem o produto cartesiano, um serviço por "
"combinação. Um '$.' inicial é opcional. As chaves que contêm '.' ou '[' "
"podem ser referenciadas com segmentos entre parênteses retos e aspas, p. ex. "
"\"data['foo.bar'].value\". Para monitorizar um CABEÇALHO DE RESPOSTA em vez "
"de um campo do corpo, prefixe o seu nome com '@header.', por exemplo "
"'@header.X-RateLimit-Remaining' para uma quota de API ou '@header.Last-"
"Modified' com 'Interpretar o valor como' definido como uma marca temporal "
"para a idade dos dados. Os nomes dos cabeçalhos são comparados sem distinção "
"entre maiúsculas e minúsculas e nenhuma das sintaxes de caminho acima se "
"lhes aplica."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1136
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "Sufixo de nome por elemento (para caracteres universais '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1138
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"Quando o caminho JSON contém um carácter universal '[*]', é criado um "
"serviço por cada elemento. Este caminho opcional - relativo a cada elemento, "
"p. ex. 'name' ou 'id' - é acrescentado ao nome do serviço para distinguir "
"esses serviços. NÃO substitui o nome do serviço. Por predefinição, utiliza o "
"índice do array (ou, para um objeto, a chave). Com vários caracteres "
"universais '[*]', é resolvido em cada nível e as partes são unidas com ' / "
"' (p. ex. '<pod> / <container>'). Escolha um campo que seja único e estável "
"entre execuções."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1153
msgid "Create one host per element, named by this field"
msgstr "Criar um host por elemento, com o nome deste campo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1155
msgid ""
"When the JSON path contains a '[*]' wildcard, this turns every element into "
"a Checkmk host of its own instead of one more service on this host. Give a "
"path relative to each element that holds the host name, e.g. 'name' or "
"'hostname'. The service then keeps its plain name, because the host already "
"says which element it is. Set the same field on several fields of this "
"endpoint to collect them all on the same hosts. Only characters valid in a "
"Checkmk host name are kept (letters, digits, '-', '_', '.'); anything else "
"becomes '_'. An element whose field is missing keeps its service on this "
"host, so nothing is lost. IMPORTANT: Checkmk holds piggyback data for hosts "
"that do not exist yet - create the hosts (manually or with Dynamic host "
"management) or the data is never monitored."
msgstr ""
"Quando o caminho JSON contém um carácter universal '[*]', cada elemento "
"passa a ser um host Checkmk próprio, em vez de mais um serviço neste host. "
"Indique um caminho relativo a cada elemento que contenha o nome do host, p. "
"ex. 'name' ou 'hostname'. O serviço mantém então o seu nome simples, porque "
"o host já indica de que elemento se trata. Defina o mesmo campo em vários "
"campos deste endpoint para os reunir todos nos mesmos hosts. Apenas os "
"caracteres válidos num nome de host Checkmk são mantidos (letras, dígitos, "
"'-', '_', '.'); todo o resto passa a '_'. Um elemento cujo campo esteja "
"ausente mantém o seu serviço neste host, para que nada se perca. IMPORTANTE: "
"o Checkmk retém os dados piggyback de hosts que ainda não existem - crie os "
"hosts (manualmente ou com a gestão dinâmica de hosts), ou os dados nunca "
"serão monitorizados."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1176
msgid "Labels for the created host"
msgstr "Etiquetas para o anfitrião criado"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1178
msgid ""
"Checkmk HOST labels for the host each '[*]' element becomes, built from "
"fields within that element - so the 50 hosts a 'nodes[*]' rule creates can "
"carry their own region, role or tier and be targeted by folder rules, views "
"and filters. Needs 'Create one host per element' above; without it the "
"element stays a service on this host and there is nothing to label. Each key "
"is prefixed with 'json_api/'. A label can also be a classification rather "
"than a field: a condition on the element plus a literal value tags only the "
"hosts the condition holds for. These are HOST labels, unlike 'Service "
"labels' below, which describe the individual service."
msgstr ""
"Etiquetas de ANFITRIÃO do Checkmk para o anfitrião em que cada elemento "
"'[*]' se torna, construídas a partir de campos dentro desse elemento - assim "
"os 50 anfitriões que uma regra 'nodes[*]' cria podem ter a sua própria "
"região, função ou nível e ser visados por regras de pasta, vistas e filtros. "
"Requer 'Criar um anfitrião por elemento' acima; sem isso o elemento continua "
"a ser um serviço neste anfitrião e não há nada para etiquetar. A cada chave "
"é anteposto 'json_api/'. Uma etiqueta também pode ser uma classificação em "
"vez de um campo: uma condição sobre o elemento mais um valor literal marca "
"apenas os anfitriões em que se verifica. Estas são etiquetas de ANFITRIÃO, "
"ao contrário das 'Etiquetas de serviço' abaixo, que descrevem o serviço "
"individual."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1198
msgid ""
"Relative to each '[*]' element, e.g. 'region'. Can be left empty only where "
"a condition and a literal value describe the label on their own."
msgstr ""
"Relativo a cada elemento '[*]', por exemplo 'region'. Só pode ficar vazio "
"quando uma condição e um valor literal descrevem a etiqueta por si sós."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1208
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1286
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2224
msgid "Label key (optional)"
msgstr "Chave da etiqueta (opcional)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1210
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1288
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"Por predefinição, o último segmento do caminho. O prefixo 'json_api/' é "
"adicionado automaticamente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1218
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2249
msgid "Label value (literal)"
msgstr "Valor da etiqueta (literal)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1220
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2251
msgid ""
"A value written here instead of read from the response ('yes', "
"'production', ...). With it a '[*]' path produces ONE label for the whole "
"collection rather than one per element, so the key is used exactly as given "
"- no '<key>/<element>' suffix. Combined with the condition below this is the "
"classification case: 'if any element matches, tag the host'."
msgstr ""
"Um valor escrito aqui em vez de lido da resposta ('yes', 'production', ...). "
"Com ele, um caminho '[*]' produz UMA etiqueta para toda a coleção em vez de "
"uma por elemento, pelo que a chave é usada exatamente como indicada - sem o "
"sufixo '<key>/<element>'. Combinado com a condição abaixo, este é o caso da "
"classificação: 'se algum elemento corresponder, marca o anfitrião'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1235
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1327
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2266
msgid "Only elements matching a condition"
msgstr "Apenas elementos que correspondem a uma condição"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1237
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2268
msgid ""
"Emit the label only for the elements whose sub-field matches this condition "
"- e.g. 'name' matching '^MyApp' over a 'services[*]' path. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar never matches. Without a '[*]' wildcard the condition is checked "
"once, in the same scope the path is read from, so the label is set only when "
"it holds."
msgstr ""
"Emitir a etiqueta apenas para os elementos cujo subcampo corresponda a esta "
"condição - p. ex. 'name' a corresponder a '^MyApp' num caminho "
"'services[*]'. O caminho do campo é resolvido dentro de cada elemento; um "
"elemento cujo campo falte ou não seja escalar nunca corresponde. Sem um "
"carácter universal '[*]' a condição é verificada uma só vez, no mesmo âmbito "
"a partir do qual o caminho é lido, pelo que a etiqueta só é definida quando "
"se verifica."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1257
msgid "Service labels"
msgstr "Etiquetas de serviço"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1259
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"Anexa etiquetas de serviço do Checkmk a ESTE serviço, criadas a partir de "
"campos da resposta. Cada chave recebe o prefixo 'json_api/'. Para um caminho "
"'[*]' o valor é resolvido dentro de cada elemento (p. ex. 'name'), pelo que "
"cada serviço por elemento obtém a sua própria etiqueta; para um caminho sem "
"caracteres universais é resolvido a partir da raiz da resposta. Os dados de "
"todo o host vão antes nas 'Etiquetas de host' do endpoint. As etiquetas são "
"definidas durante a deteção, por isso escolha campos estáveis e de baixa "
"cardinalidade - um valor que muda faz a etiqueta variar constantemente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1276
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"Relativa a cada elemento '[*]' (como o sufixo de nome), ou a raiz da "
"resposta para um caminho sem caracteres universais."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1300
msgid "Aggregate a collection into one value"
msgstr "Agregar uma coleção num único valor"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1302
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"Reduz uma coleção de elementos a um único número em vez de monitorizar um só "
"valor (ou, com um caráter universal '[*]', um serviço por elemento). Aponte "
"o caminho JSON para um array / objeto (p. ex. 'jobs') ou para um caráter "
"universal '[*]' sobre os valores a agregar (p. ex. 'nodes[*].load'). 'Número "
"de elementos' apenas os conta; as outras funções exigem valores numéricos. O "
"resultado é um número, pelo que a unidade, os níveis, a transformação e a "
"métrica se lhe aplicam. Em conjunto com a condição abaixo, só os elementos "
"correspondentes são agregados. Um caminho que não contém um array nem um "
"objeto deixa o serviço em UNKNOWN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1315
msgid "Number of elements"
msgstr "Número de elementos"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1316
msgid "Sum of the values"
msgstr "Soma dos valores"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1317
msgid "Average of the values"
msgstr "Média dos valores"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1318
msgid "Smallest of the values"
msgstr "O menor dos valores"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1319
msgid "Largest of the values"
msgstr "O maior dos valores"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1329
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"Para um caráter universal '[*]' ou um caminho agregado: manter apenas os "
"elementos cujo subcampo cumpre esta condição – p. ex. um serviço por nó cujo "
"'status' não é 'ok', ou contar apenas os pods que não estão 'Running'. O "
"caminho do campo é resolvido dentro de cada elemento; um elemento cujo campo "
"falta ou não é um escalar é descartado. Sem um caráter universal '[*]' ou "
"uma agregação isto não tem efeito."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1342
msgid "Interpret the value as"
msgstr "Interpretar o valor como"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1344
msgid ""
"By default the extracted value is monitored as it stands. Two common API "
"values are worth deriving something else from: a counter that only ever "
"grows (its rate of change is what matters, not the total), and a timestamp "
"(its age is what matters, not the date). The derived number is what the "
"transform, the levels, the metric and the summary then use."
msgstr ""
"Por predefinição, o valor extraído é monitorizado tal como está. Em dois "
"valores de API frequentes vale a pena derivar outra coisa: um contador que "
"apenas cresce (o que importa é a sua taxa de variação, não o total) e uma "
"marca temporal (o que importa é a sua idade, não a data). O número derivado "
"é o que a transformação, os níveis, a métrica e o resumo passam a usar."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1356
msgid "A counter - monitor its per-second rate"
msgstr "Um contador – monitorizar a sua taxa por segundo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1359
msgid "Per-second rate"
msgstr "Taxa por segundo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1361
msgid "The difference to the previous check is divided by the elapsed time"
msgstr ""
"A diferença em relação à verificação anterior é dividida pelo tempo decorrido"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1365
msgid ""
"For monotonically growing counters such as 'requests_total' or 'bytes_sent': "
"the check monitors the change per second instead of the absolute total. The "
"first check after a restart of the counter cannot compute a rate yet and "
"keeps the service's previous state."
msgstr ""
"Para contadores que crescem monotonamente, como 'requests_total' ou "
"'bytes_sent': a verificação monitoriza a variação por segundo em vez do "
"total absoluto. A primeira verificação após um reinício do contador ainda "
"não consegue calcular uma taxa e mantém o estado anterior do serviço."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1376
msgid "A timestamp - monitor its age"
msgstr "Uma marca temporal – monitorizar a sua idade"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1379
msgid ""
"For values such as 'last_backup' or 'updated_at': the check monitors the "
"number of seconds since that point in time, so upper levels alert on stale "
"data. A timestamp in the future yields a negative age. The age graphs and "
"reads as a duration on its own; choose a unit below only to override that (e."
"g. after a transform into hours)."
msgstr ""
"Para valores como 'last_backup' ou 'updated_at': a verificação monitoriza o "
"número de segundos desde esse momento, pelo que os níveis superiores alertam "
"sobre dados desatualizados. Uma marca temporal no futuro dá uma idade "
"negativa. A idade é apresentada e representada como uma duração por si "
"mesma; escolha uma unidade abaixo apenas para substituir isso (p. ex. após "
"uma transformação em horas)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1392
msgid "Timestamp format"
msgstr "Formato da marca temporal"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1394
msgid ""
"'Detect automatically' reads a number as Unix epoch seconds (milliseconds "
"when it is far too large for seconds) and anything else as ISO 8601. A "
"timestamp without a time zone is read as UTC."
msgstr ""
"'Detetar automaticamente' lê um número como segundos de época Unix "
"(milissegundos quando é demasiado grande para segundos) e todo o resto como "
"ISO 8601. Uma marca temporal sem fuso horário é lida como UTC."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1403
msgid "Detect automatically"
msgstr "Detetar automaticamente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1406
msgid "Unix epoch seconds"
msgstr "Segundos de época Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1410
msgid "Unix epoch milliseconds"
msgstr "Milissegundos de época Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1415
msgid "ISO 8601 / RFC 3339, e.g. '2026-07-28T02:00:00Z'"
msgstr "ISO 8601 / RFC 3339, p. ex. '2026-07-28T02:00:00Z'"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1432
msgid "Unit (for numeric values)"
msgstr "Unidade (para valores numéricos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1434
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Representa a métrica e o gráfico com esta unidade. Deixe por definir para um "
"valor simples, sem unidade. Afeta apenas valores numéricos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1438
msgid "Count (integer)"
msgstr "Contagem (inteiro)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1439
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Bytes (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1440
msgid "Seconds (duration)"
msgstr "Segundos (duração)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1441
msgid "Percent"
msgstr "Percentagem"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1443
msgid "No unit"
msgstr "Sem unidade"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1449
msgid "Value range (for graphs and gauges)"
msgstr "Intervalo de valores (para gráficos e indicadores)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1451
msgid ""
"The range this value moves in, when it has one: a battery percentage is 0 to "
"100, a queue with a cap is 0 to that cap. It changes nothing about the state "
"- it tells Checkmk what 'full' means, so the graph keeps a steady scale "
"instead of rescaling to whatever the last hour happened to contain, a gauge "
"dashboard widget has a dial to draw, and the service list's bar is filled "
"against the real maximum. Leave it unset for a value with no natural limit; "
"the bar is then scaled to the critical level instead, where one is "
"configured."
msgstr ""
"O intervalo em que este valor se move, quando tem um: uma percentagem de "
"bateria vai de 0 a 100, uma fila com limite vai de 0 até esse limite. Não "
"altera nada do estado: diz ao Checkmk o que significa \"cheio\", de modo que "
"o gráfico mantém uma escala estável em vez de se reescalar conforme o que a "
"última hora continha, um elemento de painel do tipo indicador tem um "
"mostrador para desenhar, e a barra na lista de serviços enche-se em relação "
"ao máximo real. Deixe por definir para um valor sem limite natural; a barra "
"passa então a ser escalada pelo nível crítico, quando existe um configurado."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1467
msgid "Lowest possible value"
msgstr "Valor mais baixo possível"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1474
msgid "Highest possible value"
msgstr "Valor mais alto possível"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1484
msgid "Metric name"
msgstr "Nome da métrica"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1486
msgid ""
"The name Checkmk stores this field's metric under. Leave it unset and the "
"plugin picks one: the unit's metric for a field with a service of its own "
"('json_api_bytes'), or that name plus the line's own name for a field in a "
"shared service ('json_api_bytes_root_used'). Set it where you need to KNOW "
"the name in advance - the Gauge, Single metric and Bar chart dashboard "
"widgets are bound to one metric chosen by name, and their dropdown only "
"lists the names a service really has once the widget is filtered to a host "
"and a service. Letters, digits and underscores only, starting with a letter "
"or a digit, and not one of this plugin's own metric names. Two costs: the "
"service loses its Perf-O-Meter, because every bar this plugin draws is "
"declared against one of its own metrics and a name of your own matches none; "
"and changing the name later starts a new history under it, so pick it before "
"the service has data worth keeping. A field that needs its bar is better off "
"keeping the derived name and filtering the widget to a host and a service "
"instead."
msgstr ""
"O nome sob o qual o Checkmk guarda a métrica deste campo. Se não for "
"definido, o plugin escolhe um: a métrica da unidade para um campo com "
"serviço próprio ('json_api_bytes'), ou esse nome mais o nome da linha para "
"um campo num serviço partilhado ('json_api_bytes_root_used'). Defina-o "
"quando precisar de SABER o nome de antemão: os elementos do painel "
"Indicador, Métrica única e Gráfico de barras estão ligados a uma só métrica "
"escolhida pelo nome, e a sua lista pendente só apresenta os nomes reais de "
"um serviço depois de o elemento ser filtrado por um anfitrião e um serviço. "
"Apenas letras, dígitos e sublinhados, a começar por uma letra ou um dígito, "
"e nenhum dos nomes de métrica do próprio plugin. Isto tem dois custos: o "
"serviço perde o seu Perf-O-Meter, porque cada barra que este plugin desenha "
"está ligada a uma das suas próprias métricas e um nome seu não corresponde a "
"nenhuma; e alterá-lo mais tarde inicia um histórico novo com o nome novo, "
"por isso escolha-o antes de o serviço ter dados que valha a pena guardar. Um "
"campo que precise da sua barra fica melhor mantendo o nome derivado e "
"filtrando antes o elemento do painel por um anfitrião e um serviço."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1521
msgid "Transform the numeric value"
msgstr "Transformar o valor numérico"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1523
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius). A second field can be brought in as 'other' - see below - which is "
"what turns a used/total pair into a percentage: 'value / other * 100'."
msgstr ""
"Uma expressão aritmética aplicada a um valor numérico antes dos níveis e da "
"métrica, utilizando a variável 'value'. Apenas são permitidos números, "
"parênteses e + - * /. Exemplos: 'value / 1024 / 1024' (bytes para MiB), "
"'value * 1000' (segundos para milissegundos), '(value - 32) * 5 / "
"9' (Fahrenheit para Celsius). Um segundo campo pode ser trazido como 'other' "
"- ver abaixo -, que é o que transforma um par usado/total numa percentagem: "
"'value / other * 100'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1540
msgid "Second path for the transform ('other')"
msgstr "Segundo caminho para a transformação ('other')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1542
msgid ""
"A second field, made available to the transform above as the variable "
"'other'. Most APIs report a used/total or current/limit pair rather than a "
"percentage, so this is what lets one service monitor the ratio: point the "
"JSON path at 'used', this at 'total', and use 'value / other * 100' with the "
"unit set to '%'. It is resolved in the SAME scope as the value - within each "
"'[*]' element, or the response root without a wildcard - so every element is "
"compared against its own total. The transform must actually use 'other', and "
"'other' requires this path; either one alone is rejected."
msgstr ""
"Um segundo campo, disponibilizado à transformação acima como a variável "
"'other'. A maioria das API devolve um par usado/total ou atual/limite em vez "
"de uma percentagem, e é isto que permite a um serviço monitorizar a "
"proporção: aponte o caminho JSON para 'used', este para 'total' e use "
"'value / other * 100' com a unidade '%'. É resolvido no MESMO âmbito que o "
"valor - dentro de cada elemento '[*]', ou na raiz da resposta sem caráter "
"universal - para que cada elemento seja comparado com o seu próprio total. A "
"transformação tem de usar realmente 'other', e 'other' exige este caminho; "
"qualquer um deles sozinho é rejeitado."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1564
msgid "Extra text in the service summary"
msgstr "Texto adicional no resumo do serviço"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1566
#, python-brace-format
msgid ""
"Appended to the summary, after the value. Write '{path}' to insert another "
"field of the same response - resolved within the current element for a '[*]' "
"wildcard, from the response root otherwise. So a service on 'status' can "
"show the reason the API gave next to it, e.g. '{message} (leader {leader})', "
"instead of needing a second service for it. A path that is not in the "
"response renders as '(n/a)'. This is presentation only: it never changes the "
"state, the levels or the metric. The text is put on one line and truncated "
"if it gets long."
msgstr ""
"É acrescentado ao resumo, depois do valor. Escreva '{path}' para inserir "
"outro campo da mesma resposta - resolvido dentro do elemento atual num "
"carácter universal '[*]' e a partir da raiz da resposta caso contrário. "
"Assim, um serviço sobre 'status' pode mostrar ao lado o motivo que a API já "
"devolveu, p. ex. '{message} (leader {leader})', em vez de precisar de um "
"segundo serviço para isso. Um caminho que não existe na resposta é "
"apresentado como '(n/a)'. Isto é apenas apresentação: nunca altera o estado, "
"os limiares nem a métrica. O texto é colocado numa só linha e truncado se "
"ficar longo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1591
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:160
msgid "Endpoint"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1597
msgid "Endpoint name"
msgstr "Nome do endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1599
msgid ""
"Optional short name for this endpoint, e.g. 'frontend'. It names the "
"endpoint's own service - 'JSON API <name>', which reports the HTTP status "
"and the response time of the request. Without a name the URL is used. The "
"field service names keep their plain names unless 'Prefix the field service "
"names' below is enabled."
msgstr ""
"Nome curto opcional para este endpoint, p. ex. 'frontend'. Dá nome ao "
"serviço próprio do endpoint – 'JSON API <nome>', que reporta o estado HTTP e "
"o tempo de resposta do pedido. Sem nome é usado o URL. Os nomes dos serviços "
"dos campos mantêm-se, a não ser que 'Prefixar os nomes dos serviços dos "
"campos com o nome do endpoint' esteja ativado abaixo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1612
msgid "Prefix the field service names with the endpoint name"
msgstr "Prefixar os nomes dos serviços dos campos com o nome do endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1614
msgid ""
"Off by default. Two endpoints extracting the same fields produce two "
"services with the same name - 'JSON Status' twice, the second one "
"disambiguated to 'JSON Status (2)' - and nothing in either name says which "
"application it belongs to. Turn this on and this endpoint's field services "
"are named after it instead: with the endpoint named 'app1-health', 'JSON "
"Status' becomes 'JSON app1-health Status'. Requires an endpoint name. The "
"endpoint's own service follows, from 'JSON API <name>' to 'JSON <name> API', "
"so that it sorts together with the services it describes instead of with "
"every other endpoint's status service. Enabling this RENAMES this endpoint's "
"services: the old ones become stale and the renamed ones have to be "
"discovered, so do it deliberately and re-run a service discovery afterwards."
msgstr ""
"Desativado por omissão. Dois endpoints que extraem os mesmos campos produzem "
"dois serviços com o mesmo nome – 'JSON Status' duas vezes, o segundo "
"distinguido como 'JSON Status (2)' – e nenhum dos nomes diz a que aplicação "
"pertence. Com esta opção ativada, os serviços dos campos deste endpoint "
"passam a ter o nome dele: se o endpoint se chamar 'app1-health', 'JSON "
"Status' torna-se 'JSON app1-health Status'. Requer um nome do endpoint. O "
"serviço próprio do endpoint acompanha, de 'JSON API <nome>' para 'JSON "
"<nome> API', para que seja ordenado junto dos serviços que descreve e não "
"junto dos serviços de estado de todos os outros endpoints. Ativá-la MUDA O "
"NOME dos serviços deste endpoint: os antigos ficam obsoletos e os renomeados "
"têm de ser descobertos, por isso faça-o de forma deliberada e execute depois "
"uma nova deteção de serviços."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1636
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1638
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL completo do endpoint JSON, incluindo o esquema, p. ex. 'https://app."
"example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1647
msgid "HTTP method"
msgstr "Método HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1649
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1650
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1658
msgid "Request body (for POST)"
msgstr "Corpo do pedido (para POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1664
msgid "Additional request headers"
msgstr "Cabeçalhos de pedido adicionais"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1666
msgid ""
"Sent with every request to this endpoint. Values are stored in clear text "
"and travel on the agent's command line, so an API key belongs under "
"'Authentication' - not here."
msgstr ""
"Enviados com cada pedido a este endpoint. Os valores são guardados em texto "
"simples e circulam na linha de comandos do agente, por isso uma chave de API "
"pertence a 'Autenticação' - não aqui."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1678
msgid "Header value"
msgstr "Valor do cabeçalho"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1691
msgid "Verify the TLS certificate"
msgstr "Verificar o certificado TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1692
msgid "Disabling certificate verification is insecure."
msgstr "Desativar a verificação do certificado é inseguro."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1699
msgid "Custom CA bundle file"
msgstr "Ficheiro de pacote de CA personalizado"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1701
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"Caminho no servidor Checkmk para um ficheiro PEM com o(s) certificado(s) de "
"CA para verificar o certificado do servidor. Utilize-o para confiar numa CA "
"interna ou privada sem desativar a verificação. Ignorado quando a "
"verificação de TLS está desativada."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1712
msgid "Client certificate (mutual TLS)"
msgstr "Certificado de cliente (TLS mútuo)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1714
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"Apresente um certificado de cliente ao servidor (TLS mútuo). Os ficheiros "
"têm de existir no servidor Checkmk. A chave privada tem de estar não cifrada."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1722
msgid "Client certificate file"
msgstr "Ficheiro de certificado de cliente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1724
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"Caminho para o certificado de cliente (PEM). Se o ficheiro também contiver a "
"chave privada, deixe o campo da chave vazio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1734
msgid "Private key file"
msgstr "Ficheiro de chave privada"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1736
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr ""
"Caminho para a chave privada do cliente (PEM), se não estiver incluída no "
"certificado."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1748
msgid "Follow HTTP redirects"
msgstr "Seguir redirecionamentos HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1750
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Ativado por predefinição. Desative em ambientes restritos para reforçar a "
"proteção contra SSRF: um destino que redireciona (p. ex. 3xx para um "
"endereço interno) passa a falhar em vez de ser seguido até ao local de "
"redirecionamento."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1761
msgid "Request timeout (seconds)"
msgstr "Tempo limite do pedido (segundos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1762
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Tempo limite por pedido. Por predefinição, 30 segundos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1770
msgid "Re-read at most every (seconds)"
msgstr "Reler no máximo a cada (segundos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1772
msgid ""
"Reuse the last response for this endpoint instead of requesting it again, as "
"long as it is younger than this. For APIs with a request quota, expensive "
"endpoints, or a rule shared across many hosts - anything where the request "
"RATE is the problem rather than the freshness of the data. Without it, every "
"check interval on every host issues a request, which can exhaust a quota and "
"turn the monitoring itself into the outage. Only a response that parsed as "
"JSON is cached, and a failing request is never answered from an expired "
"cache - a real outage must not hide behind stale data. While a cached body "
"is served the endpoint's own service says so and reports no response time, "
"because no request was made. Leave unset to always fetch fresh."
msgstr ""
"Reutilizar a última resposta deste endpoint em vez de a pedir novamente, "
"desde que seja mais recente do que este valor. Para APIs com uma quota de "
"pedidos, endpoints dispendiosos ou uma regra partilhada por muitos hosts - "
"sempre que o problema seja a TAXA de pedidos e não a actualidade dos dados. "
"Sem isto, cada intervalo de verificação em cada host faz um pedido, o que "
"pode esgotar uma quota e transformar a própria monitorização na falha. Só é "
"colocada em cache uma resposta que tenha sido analisada como JSON, e um "
"pedido falhado nunca é respondido a partir de uma cache expirada - uma falha "
"real não se pode esconder atrás de dados desactualizados. Enquanto um "
"conteúdo em cache é servido, o serviço próprio do endpoint indica-o e não "
"comunica qualquer tempo de resposta, porque não foi feito nenhum pedido. "
"Deixe sem definir para consultar sempre em directo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1794
msgid "Retry a failed request"
msgstr "Repetir um pedido falhado"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1796
msgid ""
"Repeat this endpoint's request when it fails in a way a repeat could fix - a "
"connection error, a timeout, or an HTTP 429 / 5xx - so a load balancer "
"dropping connections for a second during a rolling restart does not become a "
"CRIT and a notification. A 4xx, a body that is not JSON and an oversized "
"response are never retried: repeating them would only burn time. Nothing is "
"hidden - the endpoint's own service reports that a retry was needed, and can "
"be told to go WARN when one is. Every attempt costs wall-clock time inside "
"the check: the worst case is (1 + retries) times the request timeout, plus "
"the waiting time between attempts. Off by default."
msgstr ""
"Repete o pedido a este endpoint quando falha de uma forma que uma repetição "
"pode resolver - um erro de ligação, um tempo limite ou um HTTP 429 / 5xx -, "
"para que um balanceador de carga que corta ligações durante um segundo num "
"reinício progressivo não se torne um CRIT com notificação. Um 4xx, um corpo "
"que não é JSON e uma resposta demasiado grande nunca são repetidos: repeti-"
"los só gastaria tempo. Nada fica escondido - o próprio serviço do endpoint "
"indica que foi preciso repetir e pode ser configurado para passar a WARN "
"quando isso acontece. Cada tentativa consome tempo real dentro da "
"verificação: no pior caso (1 + repetições) vezes o tempo limite do pedido, "
"mais as esperas entre tentativas. Desativado por predefinição."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1813
msgid "Number of retries"
msgstr "Número de repetições"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1814
msgid "Extra attempts after the first one failed."
msgstr "Tentativas adicionais depois de a primeira falhar."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1824
msgid "Wait before retrying (seconds)"
msgstr "Esperar antes de repetir (segundos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1826
msgid ""
"Waiting time before the first retry, doubled for each further one. The total "
"waiting time is capped at 30 seconds however many retries are configured."
msgstr ""
"Tempo de espera antes da primeira repetição, duplicado em cada uma das "
"seguintes. A espera total está limitada a 30 segundos, independentemente do "
"número de repetições configuradas."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1843
msgid "Additional accepted HTTP status codes"
msgstr "Códigos de estado HTTP adicionais aceites"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1845
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"Por predefinição, apenas as respostas 2xx são lidas; qualquer outro estado "
"coloca os serviços do endpoint em UNKNOWN. Adicione aqui códigos de estado "
"adicionais a aceitar — por exemplo, 503 para um endpoint de saúde que "
"comunica os seus problemas com um 503 e um corpo JSON. O corpo de uma "
"resposta aceite é analisado e extraído como habitualmente. 2xx é sempre "
"aceite."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1853
msgid "Status code"
msgstr "Código de estado"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1861
msgid "Report the raw response"
msgstr "Reportar a resposta em bruto"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1863
msgid ""
"Off by default. Put the response itself into the Details of this endpoint's "
"own 'JSON API <name>' service, exactly as it came off the wire. The Details "
"otherwise only link to the URL, which is often not reachable from the "
"browser reading the service (the API may sit behind a firewall or in another "
"network) and always shows the API as it is NOW rather than as it was when "
"the check ran. The body of a REJECTED response is reported too - an "
"unexpected HTTP status or a body that is not JSON - which is the case this "
"exists for: it is where the API explains itself. Credentials are stripped "
"first: 'Set-Cookie' and any authorization header are masked, and the "
"endpoint's own secret is removed wherever it appears. Everything else in the "
"response is reported verbatim, and a service's Details are stored with every "
"check result and travel into notifications - so do not turn this on for a "
"response carrying personal or otherwise sensitive data."
msgstr ""
"Desativado por omissão. Coloca a própria resposta nos Detalhes do serviço "
"próprio deste endpoint, 'JSON API <nome>', exatamente como chegou. De outro "
"modo, os Detalhes apenas remetem para o URL, que muitas vezes não é "
"alcançável a partir do browser onde o serviço é lido (a API pode estar atrás "
"de uma firewall ou noutra rede) e que mostra sempre a API como está AGORA e "
"não como estava quando o check correu. O corpo de uma resposta REJEITADA "
"também é reportado – um estado HTTP inesperado ou um corpo que não é JSON – "
"e é precisamente para isso que esta opção existe: é aí que a API se explica. "
"As credenciais são removidas antes: 'Set-Cookie' e qualquer cabeçalho de "
"autorização são mascarados, e o segredo do próprio endpoint é removido onde "
"aparecer. Todo o resto é reportado literalmente, e os Detalhes de um serviço "
"são guardados com cada resultado do check e viajam nas notificações – por "
"isso não ative isto para uma resposta com dados pessoais ou de outra forma "
"sensíveis."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1886
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1968
msgid "Report at most (bytes)"
msgstr "Reportar no máximo (bytes)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1888
msgid ""
"Longer bodies are cut off at this many bytes and the service says so. Keep "
"it small: this text is stored with every check result of this service."
msgstr ""
"Corpos maiores são cortados neste número de bytes e o serviço di-lo. "
"Mantenha o valor pequeno: este texto é guardado com cada resultado do check "
"deste serviço."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1902
msgid "Report the response headers as well"
msgstr "Reportar também os cabeçalhos da resposta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1904
msgid ""
"On by default. The headers are what a rate limit, a cache directive or a "
"content type is announced in, and they are small."
msgstr ""
"Ativado por omissão. É nos cabeçalhos que são anunciados um limite de "
"pedidos, uma diretiva de cache ou um tipo de conteúdo, e são pequenos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1917
msgid "Report the JSON context in the field services"
msgstr "Reportar o contexto JSON nos serviços de campo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1919
msgid ""
"Off by default. The setting above reports the response on the endpoint's OWN "
"service - but the services that go WARN or CRIT, and therefore the ones that "
"notify, are the field services, and their Details say only which path was "
"read. This puts the JSON itself there too, so the alert carries what the API "
"actually said: a service's Details travel into notifications as "
"$LONGSERVICEOUTPUT$, and the person on call often cannot reach the endpoint "
"at all - wrong network, no credentials - while the endpoint's own service "
"stayed OK and notified nobody. Credentials are stripped exactly as they are "
"for the raw response. Note that this text is stored with every check result "
"of EVERY field service of this endpoint, so keep the byte budget small."
msgstr ""
"Desativado por predefinição. A definição acima reporta a resposta no serviço "
"PRÓPRIO do endpoint - mas os serviços que passam a WARN ou CRIT, e por isso "
"os que notificam, são os serviços de campo, e os seus detalhes indicam "
"apenas que caminho foi lido. Isto coloca lá também o próprio JSON, para que "
"o alerta transporte o que a API realmente disse: os detalhes de um serviço "
"chegam às notificações como $LONGSERVICEOUTPUT$, e quem está de piquete "
"muitas vezes não consegue sequer alcançar o endpoint - rede errada, sem "
"credenciais - enquanto o serviço próprio do endpoint continuou OK e não "
"notificou ninguém. As credenciais são removidas exatamente como na resposta "
"em bruto. Note que este texto é guardado com cada resultado de verificação "
"de TODOS os serviços de campo deste endpoint, por isso mantenha o orçamento "
"de bytes pequeno."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1937
msgid "What to report"
msgstr "O que reportar"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1941
msgid "The JSON this value was read from"
msgstr "O JSON de onde este valor foi lido"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1945
msgid "The whole response body"
msgstr "Todo o corpo da resposta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1950
msgid ""
"'The JSON this value was read from' is the targeted form: for a '[*]' path "
"that element, otherwise the object holding the value - so the service that "
"alerted shows the element that failed with all its sibling fields, and "
"nothing else. An aggregation has no single element and a '@header.' path is "
"not in the body at all, so both report the whole response. 'The whole "
"response body' always does, repeated on every field service - which is why "
"the cap matters more here than on the endpoint's own service."
msgstr ""
"'O JSON de onde este valor foi lido' é a forma dirigida: para um caminho "
"'[*]', esse elemento; caso contrário, o objeto que contém o valor - assim o "
"serviço que alertou mostra o elemento que falhou com todos os seus campos "
"irmãos, e mais nada. Uma agregação não tem um elemento único e um caminho "
"'@header.' nem sequer está no corpo, por isso ambos reportam a resposta "
"inteira. 'Todo o corpo da resposta' fá-lo sempre, repetido em cada serviço "
"de campo - e é por isso que o limite importa aqui mais do que no serviço "
"próprio do endpoint."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1970
msgid ""
"Longer context is cut off at this many bytes and the service says so. Keep "
"it small: this text is stored with every check result of every field service "
"of this endpoint."
msgstr ""
"Um contexto mais longo é cortado a este número de bytes e o serviço indica-"
"o. Mantenha-o pequeno: este texto é guardado com cada resultado de "
"verificação de cada serviço de campo deste endpoint."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1987
msgid "Follow pagination"
msgstr "Seguir a paginação"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1990
msgid ""
"Off by default: one request, one page. An API that answers a collection one "
"page at a time then leaves every service built from it describing the FIRST "
"page only - 'count' over a queue that pages at 25 reports 25 however long "
"the queue is, and a '[*]' wildcard creates services for the first page's "
"elements alone. Nothing says so, which is why this is worth configuring: the "
"answer is not missing, it is wrong. With this set the agent follows the "
"API's own next-page link - or, for an API without one, counts the pages "
"itself - and appends each page's collection to the first page's, so the "
"wildcards, the aggregations, the filters and the host labels all see the "
"whole thing. Every page is requested exactly like the first one (same "
"method, headers, authentication and timeout), and each one costs a request "
"inside the check - so cap the pages, and consider a cache TTL for a "
"collection that does not change every check interval. A page that cannot be "
"read fails the endpoint rather than silently truncating the collection; "
"where a further page exists but is not followed - a cap, or a link the agent "
"refuses - the endpoint's own service reports it and goes WARN."
msgstr ""
"Desativado por predefinição: um pedido, uma página. Se uma API devolver uma "
"coleção página a página, cada serviço construído a partir dela descreve "
"apenas a PRIMEIRA página - 'count' sobre uma fila paginada a 25 comunica 25 "
"por mais longa que a fila seja, e um caractere universal '[*]' cria serviços "
"só para os elementos da primeira página. Nada o indica, e é precisamente por "
"isso que vale a pena configurar isto: a resposta não está em falta, está "
"errada. Com esta definição o agente segue a ligação para a página seguinte "
"fornecida pela própria API - ou, numa API sem ela, conta as páginas por si "
"próprio - e acrescenta a coleção de cada página à da primeira, de modo que "
"os caracteres universais, as agregações, as condições e as etiquetas de "
"anfitrião veem o conjunto completo. Cada página é pedida exatamente como a "
"primeira (mesmo método, cabeçalhos, autenticação e tempo limite) e cada uma "
"custa um pedido dentro do check - limite portanto as páginas e considere um "
"TTL de cache para uma coleção que não muda a cada intervalo de verificação. "
"Uma página que não possa ser lida faz falhar o endpoint em vez de truncar a "
"coleção em silêncio; quando existe outra página que não é seguida - um "
"limite, ou uma ligação que o agente recusa -, o serviço próprio do endpoint "
"comunica-o e passa a WARN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2017
msgid "Where the next page's URL comes from"
msgstr "De onde vem o URL da página seguinte"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2019
msgid ""
"The API's documentation says which form it uses. Where the API links to the "
"next page, a page that carries no next link (an absent field, a JSON 'null', "
"an empty string, no 'Link' header) is the last one, which is how pagination "
"ends. Where it offers no link and takes the position as a query parameter "
"instead, the agent counts: the page number goes up by one per page, the "
"offset by the number of elements the previous page carried. The parameter is "
"set on the first request too, replacing one of that name in the URL."
msgstr ""
"A documentação da API indica que forma utiliza. Quando a API liga para a "
"página seguinte, uma página sem ligação para a seguinte (um campo ausente, "
"um 'null' JSON, uma cadeia vazia, nenhum cabeçalho 'Link') é a última: é "
"assim que a paginação termina. Quando não oferece ligação e recebe a posição "
"como parâmetro de consulta, o agente conta: o número de página sobe um por "
"página, o deslocamento tantos quantos os elementos da página anterior. O "
"parâmetro é também definido no primeiro pedido, substituindo um com o mesmo "
"nome no URL."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2036
msgid "A field in the response body"
msgstr "Um campo no corpo da resposta"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2038
msgid "JSON path to the next page's URL"
msgstr "Caminho JSON para o URL da página seguinte"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2040
msgid ""
"From the response root, e.g. 'links.next', 'next' or 'meta.next_page_url'. A "
"relative URL ('/api/v1/jobs?page=2') is resolved against the page it came "
"from."
msgstr ""
"A partir da raiz da resposta, por exemplo 'links.next', 'next' ou 'meta."
"next_page_url'. Um URL relativo ('/api/v1/jobs?page=2') é resolvido em "
"relação à página de onde veio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2054
msgid "The 'Link' response header (rel=\"next\")"
msgstr "O cabeçalho de resposta 'Link' (rel=\"next\")"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2058
msgid "Read from the 'Link' header, as RFC 8288 defines it"
msgstr "Ler do cabeçalho 'Link', tal como o RFC 8288 o define"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2062
msgid ""
"The convention of the GitHub, GitLab and Jenkins style APIs: 'Link: <https://"
"host/jobs?page=2>; rel=\"next\"'. The link with rel=\"next\" is followed; "
"the others ('last', 'prev') are ignored."
msgstr ""
"A convenção das API no estilo do GitHub, do GitLab e do Jenkins: 'Link: "
"<https://host/jobs?page=2>; rel=\"next\"'. É seguida a ligação com "
"rel=\"next\"; as restantes ('last', 'prev') são ignoradas."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2074
msgid "No link: count the pages ('?page=2')"
msgstr "Sem ligação: contar as páginas ('?page=2')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2082
msgid "No link: count the elements ('?offset=50')"
msgstr "Sem ligação: contar os elementos ('?offset=50')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2095
msgid "JSON path to the collection to merge"
msgstr "Caminho JSON para a coleção a fundir"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2097
msgid ""
"The array (or object) each page carries a slice of - e.g. 'items', 'data."
"jobs' or 'results'. Use '$' where the response IS the array. Each page's "
"collection is appended to the first page's, and the rest of the document "
"stays as the first page sent it: a 'total' or a 'generated_at' next to the "
"collection still resolves, and every path configured below is unchanged. No "
"'[*]' wildcard here - this names the collection itself, not the elements in "
"it."
msgstr ""
"O array (ou objeto) de que cada página traz uma parte - por exemplo 'items', "
"'data.jobs' ou 'results'. Utilize '$' quando a resposta FOR o array. A "
"coleção de cada página é acrescentada à da primeira e o resto do documento "
"mantém-se como a primeira página o enviou: um 'total' ou um 'generated_at' "
"ao lado da coleção continua a resolver-se e todos os caminhos configurados "
"abaixo ficam inalterados. Aqui não se usa o caractere universal '[*]': isto "
"indica a própria coleção, não os elementos nela contidos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2115
msgid "Read at most this many pages"
msgstr "Ler no máximo este número de páginas"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2117
msgid ""
"Including the first one, so '1' disables following entirely. Each page is a "
"request made while the check runs, and a special agent that overruns is "
"killed - so this is the setting that keeps a collection which grew a "
"hundredfold from turning the monitoring into the outage. When the limit is "
"reached while a further page still exists, the endpoint's own service says "
"so and goes WARN instead of quietly reporting part of the collection."
msgstr ""
"Incluindo a primeira, pelo que '1' desativa completamente o seguimento. Cada "
"página é um pedido feito enquanto o check é executado, e um agente especial "
"que exceda o tempo é terminado - por isso é esta definição que evita que uma "
"coleção que cresceu cem vezes transforme a própria monitorização na falha. "
"Se o limite for atingido enquanto ainda existe outra página, o serviço "
"próprio do endpoint indica-o e passa a WARN em vez de comunicar em silêncio "
"uma parte da coleção."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2138
msgid "And at most this many elements"
msgstr "E no máximo este número de elementos"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2140
msgid ""
"Optional second cap, for a page size that is not known in advance. Checked "
"between pages, so a page is never cut in half and the collection can end "
"slightly above this. Like the page limit, reaching it while more pages exist "
"is reported on the endpoint's own service. Remember that a '[*]' wildcard "
"creates one SERVICE per element."
msgstr ""
"Segundo limite opcional, para um tamanho de página que não se conhece de "
"antemão. É verificado entre páginas, pelo que uma página nunca é cortada ao "
"meio e a coleção pode terminar ligeiramente acima deste valor. Tal como com "
"o limite de páginas, alcançá-lo enquanto existem mais páginas é comunicado "
"no serviço próprio do endpoint. Não se esqueça de que um caractere universal "
"'[*]' cria um SERVIÇO por elemento."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2159
msgid "HTTP proxy"
msgstr "Proxy HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2161
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"Encaminhe o pedido deste endpoint através de um proxy HTTP - útil quando o "
"servidor Checkmk só alcança a API através de um proxy de saída empresarial. "
"Escolha as variáveis de ambiente HTTP_PROXY / HTTPS_PROXY, um URL de proxy "
"explícito, ou 'sem proxy' para ignorar qualquer proxy definido no ambiente. "
"Sem esta definição, as variáveis de proxy do ambiente são respeitadas."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2175
msgid "Fields to monitor"
msgstr "Campos a monitorizar"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2177
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Cada entrada torna-se um serviço Checkmk, criado a partir do valor "
"encontrado no caminho JSON indicado."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2187
msgid "Host labels"
msgstr "Etiquetas de host"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2189
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Or classify the host from a "
"collection instead: a condition plus a literal value turns 'any element of "
"services[*] whose name matches ^MyApp' into the single label 'json_api/"
"MyApp: yes', which folder rules, thresholds, contact groups and views can "
"then target. Set at discovery, so pick stable, low-cardinality fields."
msgstr ""
"Anexa etiquetas de host do Checkmk ao host monitorizado, criadas a partir de "
"campos da resposta deste endpoint. Cada chave recebe o prefixo 'json_api/' e "
"o valor é resolvido a partir da raiz da resposta - por isso são dados de "
"todo o host (p. ex. um ambiente, região ou versão) e NÃO necessitam de "
"nenhum serviço. Um caminho pode conter um carácter universal '[*]' (p. ex. "
"'components[*]') para emitir uma etiqueta por elemento, com a chave '<key>/"
"<element>' para que as chaves se mantenham únicas. Ou classifique antes o "
"anfitrião a partir de uma coleção: uma condição mais um valor literal "
"transforma 'qualquer elemento de services[*] cujo name corresponda a ^MyApp' "
"na única etiqueta 'json_api/MyApp: yes', a que regras de pasta, limiares, "
"grupos de contacto e vistas podem depois dirigir-se. Definidas durante a "
"deteção, por isso escolha campos estáveis e de baixa cardinalidade."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2212
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element. Can be left empty "
"only where a condition and a literal value describe the label on their own."
msgstr ""
"A partir da raiz da resposta, p. ex. 'version', 'cluster.region', ou um "
"carácter universal '[*]' como 'components[*]' para uma etiqueta por "
"elemento. Só pode ficar vazio quando uma condição e um valor literal "
"descrevem a etiqueta por si sós."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2226
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"Por predefinição, o último segmento do caminho. Para um caminho '[*]' é "
"acrescentado o id do elemento ('<key>/<element>'). O prefixo 'json_api/' é "
"adicionado automaticamente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2236
msgid "Value field (for '[*]' wildcards)"
msgstr "Campo de valor (para caracteres universais '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2238
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"Para um caminho '[*]': um caminho dentro de cada elemento para o valor da "
"etiqueta (p. ex. 'status'). Por predefinição 'true' (uma etiqueta de "
"pertença). Ignorado sem carácter universal."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2311
msgid "Endpoints"
msgstr "Endpoints"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2313
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Um ou mais endpoints HTTP/JSON. Cada um é obtido com as suas próprias "
"definições de ligação e extrações; todos os resultados são combinados numa "
"única secção. Um endpoint que não possa ser alcançado afeta apenas os seus "
"próprios serviços."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2328
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:149
msgid "Generic JSON API"
msgstr "API JSON genérica"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:66
msgid "Upper levels for the response time"
msgstr "Níveis superiores para o tempo de resposta"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:68
msgid ""
"How long the request to this endpoint may take, in seconds. Measured from "
"sending the request to having read the whole response body. Without levels "
"the response time is only recorded as a metric."
msgstr ""
"Quanto tempo o pedido a este endpoint pode levar, em segundos. Medido desde "
"o envio do pedido até ter lido todo o corpo da resposta. Sem níveis, o tempo "
"de resposta é apenas registado como métrica."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:81
msgid "Lower levels for the TLS certificate's remaining validity"
msgstr "Níveis inferiores para a validade restante do certificado TLS"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:83
msgid ""
"How many days the endpoint's TLS certificate must still be valid for. Read "
"from the connection the agent already makes, so no second check against the "
"same URL is needed. Only available for HTTPS endpoints with certificate "
"verification enabled; otherwise the certificate is not reported and these "
"levels never apply. Without levels the remaining validity is only recorded "
"as a metric."
msgstr ""
"Quantos dias o certificado TLS do endpoint tem de continuar válido. É lido "
"da ligação que o agente já estabelece, pelo que não é necessária uma segunda "
"verificação ao mesmo URL. Apenas disponível para endpoints HTTPS com a "
"verificação de certificado activada; caso contrário o certificado não é "
"comunicado e estes níveis nunca se aplicam. Sem níveis, a validade restante "
"é apenas registada como métrica."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:99
msgid "State when the request needed a retry"
msgstr "Estado quando o pedido precisou de ser repetido"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:101
msgid ""
"Applies when the endpoint's retry policy absorbed a failed attempt: the "
"request did succeed, but not on the first try. OK by default - a retry doing "
"its job is not itself a problem. Raise it for an endpoint whose flakiness is "
"worth knowing about, so retries never quietly turn a degrading API into a "
"permanently green service."
msgstr ""
"Aplica-se quando a política de repetição do endpoint absorveu uma tentativa "
"falhada: o pedido teve êxito, mas não à primeira. OK por predefinição - uma "
"repetição a fazer o seu trabalho não é, em si, um problema. Aumente-o para "
"um endpoint cuja instabilidade vale a pena conhecer, para que as repetições "
"nunca transformem em silêncio uma API que se degrada num serviço "
"permanentemente verde."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:114
msgid "State when the collection was read incompletely"
msgstr "Estado quando a coleção foi lida de forma incompleta"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:116
msgid ""
"Applies when the endpoint follows the API's pagination and a further page "
"existed that was not read - a page or element limit was reached, or the API "
"offered a link the agent refuses to follow (another host, or one it had "
"already fetched). Every service built from that collection - a count, an "
"aggregation, a '[*]' wildcard - is then describing part of it. WARN by "
"default, because a collection quietly missing its tail is exactly what "
"following the pages was meant to prevent. Lower it to OK for an endpoint "
"where reading the first N pages is deliberate."
msgstr ""
"Aplica-se quando o endpoint segue a paginação da API e existia outra página "
"que não foi lida - foi alcançado um limite de páginas ou de elementos, ou a "
"API ofereceu uma ligação que o agente se recusa a seguir (outro anfitrião, "
"ou uma que já tinha obtido). Cada serviço construído a partir dessa coleção "
"- uma contagem, uma agregação, um caractere universal '[*]' - descreve então "
"apenas parte dela. WARN por predefinição, porque uma coleção à qual falta o "
"fim em silêncio é precisamente o que seguir as páginas pretende evitar. "
"Baixe-o para OK num endpoint em que ler as primeiras N páginas é intencional."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:134
msgid "State when the endpoint cannot be read"
msgstr "Estado quando o endpoint não pode ser lido"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:136
msgid ""
"Applies when the request fails outright: connection refused, a TLS error, a "
"timeout, an HTTP status that is not accepted, or a response that is not JSON."
msgstr ""
"Aplica-se quando o pedido falha por completo: conexão recusada, um erro TLS, "
"um tempo limite excedido, um estado HTTP não aceite ou uma resposta que não "
"é JSON."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:157
msgid "Generic JSON API endpoint"
msgstr "Endpoint de API JSON genérica"

