#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Expression régulière invalide : %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "Seuils supérieurs (pour les valeurs numériques)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "Seuils inférieurs (pour les valeurs numériques)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "Correspondance de chaînes"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr "Comment convertir une valeur de chaîne en un état de service Checkmk."

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "La valeur doit correspondre à une expression régulière"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "Valeur attendue (regex)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Pour les valeurs de chaîne : la valeur doit correspondre entièrement à cette "
"expression régulière (par ex. 'UP|ok')."

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "État lorsque la valeur ne correspond pas"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Associer la valeur à un état (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Pour les valeurs de chaîne avec plusieurs états connus : chaque motif est "
"une expression régulière comparée à la valeur entière. Ils sont essayés dans "
"l'ordre OK, WARN, CRIT et la première correspondance l'emporte."

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "OK lorsque la valeur correspond (regex)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "WARN lorsque la valeur correspond (regex)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "CRIT lorsque la valeur correspond (regex)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "État lorsque rien ne correspond"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:81
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "Expression arithmétique invalide : %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:87
msgid ""
"Only the variables 'value' and 'other', numbers, parentheses and + - * / are "
"allowed."
msgstr ""
"Seules les variables 'value' et 'other', les nombres, les parenthèses et + - "
"* / sont autorisés."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:93
#, python-format
msgid "Unknown variable '%s' - only 'value' and 'other' are available."
msgstr "Variable inconnue '%s' - seules 'value' et 'other' sont disponibles."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:98
msgid "Only numeric constants are allowed."
msgstr "Seules les constantes numériques sont autorisées."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:118
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Chaque URL de point de terminaison doit être unique. En double : %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:127
#, python-format
msgid "Each endpoint name must be unique. Duplicated: %s"
msgstr "Chaque nom de point de terminaison doit être unique. En double : %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:137
msgid "The URL must not contain whitespace."
msgstr "L'URL ne doit pas contenir d'espaces."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:141
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Saisissez une URL http(s) valide, p. ex. 'https://host/chemin'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:157
msgid "Enter a valid HTTP header name, e.g. 'X-API-Key'."
msgstr "Saisissez un nom d'en-tête HTTP valide, p. ex. 'X-API-Key'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:166
msgid "Enter a valid query parameter name, e.g. 'api_key'."
msgstr "Saisissez un nom de paramètre de requête valide, p. ex. 'api_key'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:184
msgid ""
"The collection to merge must name the collection itself, without a '[*]' "
"wildcard - e.g. 'data.items' rather than 'data.items[*]'."
msgstr ""
"La collection à fusionner doit désigner la collection elle-même, sans joker "
"'[*]' - par exemple 'data.items' plutôt que 'data.items[*]'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:194
msgid "The path to the next page's URL must not contain a '[*]' wildcard."
msgstr ""
"Le chemin vers l'URL de la page suivante ne doit pas contenir de joker '[*]'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:210
msgid ""
"Prefixing the field service names needs an endpoint name. Set 'Endpoint "
"name', or turn the prefix off."
msgstr ""
"Préfixer les noms des services de champs nécessite un nom du point de "
"terminaison. Renseignez 'Nom du point de terminaison' ou désactivez le "
"préfixe."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:234
#, python-format
msgid ""
"The header '%s' carries the API key and must not also be set under "
"'Additional request headers'."
msgstr ""
"L'en-tête '%s' porte la clé d'API et ne doit pas être défini en plus sous "
"'En-têtes de requête supplémentaires'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:274
msgid ""
"A field written to the inventory creates no service, so it cannot report "
"into a shared one. Tick 'Also create a service for this field', or clear "
"'Report in a shared service named'."
msgstr ""
"Un champ écrit dans l'inventaire ne crée aucun service et ne peut donc pas "
"être rapporté dans un service partagé. Cochez 'Créer aussi un service pour "
"ce champ' ou videz 'Rapporter dans un service partagé nommé'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:287
msgid ""
"'Labels for the created host' needs 'Create one host per element, named by "
"this field' - without it the element stays a service on this host and there "
"is no host to label."
msgstr "Étiquettes pour l'hôte créé"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:298
msgid ""
"The transform uses 'other', so 'Second path for the transform' must be set "
"to say where that value comes from."
msgstr ""
"La transformation utilise 'other' ; le champ 'Second chemin pour la "
"transformation' doit donc être renseigné pour indiquer d'où vient cette "
"valeur."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:305
msgid ""
"'Second path for the transform' is only used through the variable 'other' - "
"add it to the transform (e.g. 'value / other * 100') or clear the path."
msgstr ""
"'Second chemin pour la transformation' n'est utilisé qu'à travers la "
"variable 'other' - ajoutez-la à la transformation (par exemple 'value / "
"other * 100') ou videz le chemin."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:324
msgid ""
"Without a 'JSON path' the label is described by the rule alone, so both a "
"'Label key' and a literal 'Label value' are needed."
msgstr ""
"Sans 'Chemin JSON', l'étiquette est décrite par la seule règle : une 'Clé de "
"l'étiquette' et une 'Valeur de l'étiquette' littérale sont donc toutes deux "
"nécessaires."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:336
msgid ""
"Set either a literal 'Label value' or a 'Value field' to read it from, not "
"both."
msgstr ""
"Définissez soit une 'Valeur de l'étiquette' littérale, soit un 'Champ de "
"valeur' d'où la lire, mais pas les deux."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:354
msgid "Give at least one end of the range, or leave the range unset."
msgstr ""
"Indiquez au moins une borne de la plage, ou laissez la plage non définie."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:358
msgid "The lowest value must be smaller than the highest value."
msgstr ""
"La valeur la plus basse doit être inférieure à la valeur la plus haute."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:371
#, python-brace-format
msgid ""
"Use '{path}' to insert a field, e.g. '{message} (leader {leader})'. Braces "
"must be paired and cannot be nested or empty."
msgstr ""
"Utilisez '{path}' pour insérer un champ, p. ex. '{message} (leader "
"{leader})'. Les accolades doivent être appariées et ne peuvent être ni "
"imbriquées ni vides."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:392
msgid ""
"Enter a dotted inventory path of at least two segments, using lower-case "
"letters, digits and '_' - e.g. 'software.applications.json_api'."
msgstr ""
"Saisissez un chemin d'inventaire pointé d'au moins deux segments, en "
"minuscules, chiffres et '_' - p. ex. 'software.applications.json_api'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:399
msgid ""
"The inventory path must start with 'hardware', 'software' or 'networking'."
msgstr ""
"Le chemin d'inventaire doit commencer par 'hardware', 'software' ou "
"'networking'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:407
msgid ""
"Use lower-case letters, digits and '_' for the attribute name, e.g. "
"'version'."
msgstr ""
"Utilisez des minuscules, des chiffres et '_' pour le nom de l'attribut, p. "
"ex. 'version'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:414
msgid "Write into the HW/SW inventory"
msgstr "Écrire dans l'inventaire HW/SW"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:416
msgid ""
"Put this field into the host's inventory tree instead of making it a "
"service. Meant for facts rather than states - a version, a build, a region, "
"a licence tier - which are not worth a service that is OK forever, and which "
"the inventory can do something with that services cannot: it is searchable "
"ACROSS hosts ('which hosts still run a version below 4.2?') and keeps a "
"history of its own. For a '[*]' wildcard the elements become one table row "
"each, keyed by the element's name. Point this at values that rarely change: "
"every change is recorded in the inventory history, so a counter here grows "
"those files without bound. Inventory runs on its own (slower) schedule, not "
"at every check interval."
msgstr ""
"Place ce champ dans l'arbre d'inventaire de l'hôte au lieu d'en faire un "
"service. Prévu pour des faits plutôt que des états - une version, un build, "
"une région, un niveau de licence -, qui ne méritent pas un service "
"éternellement OK et dont l'inventaire sait faire quelque chose que les "
"services ne peuvent pas : il est interrogeable ENTRE hôtes (« quels hôtes "
"utilisent encore une version inférieure à 4.2 ? ») et conserve un historique "
"propre. Avec un joker '[*]', chaque élément devient une ligne de tableau, "
"identifiée par le nom de l'élément. À réserver aux valeurs qui changent "
"rarement : chaque changement est consigné dans l'historique d'inventaire, un "
"compteur ferait donc grossir ces fichiers sans fin. L'inventaire s'exécute "
"selon son propre calendrier (plus lent), pas à chaque intervalle de "
"vérification."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:432
msgid "Inventory tree node"
msgstr "Nœud de l'arbre d'inventaire"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:434
msgid ""
"Dotted path of the node the value is written to, e.g. 'software.applications."
"json_api'. Must start with 'hardware', 'software' or 'networking'."
msgstr ""
"Chemin pointé du nœud où la valeur est écrite, p. ex. 'software.applications."
"json_api'. Doit commencer par 'hardware', 'software' ou 'networking'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:445
msgid "Attribute name"
msgstr "Nom de l'attribut"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:447
msgid ""
"Name of the attribute (or, for a '[*]' wildcard, the column). Defaults to "
"the JSON path's last segment."
msgstr ""
"Nom de l'attribut (ou de la colonne, avec un joker '[*]'). Par défaut, le "
"dernier segment du chemin JSON."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:456
msgid "Also create a service for this field"
msgstr "Créer aussi un service pour ce champ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:458
msgid ""
"Off by default: an inventory field creates NO service, which is the point - "
"it does not consume a service slot or a check interval to report something "
"that changes twice a year. Turn it on for a value you want in the inventory "
"AND want to alert on, e.g. a version you also match against a regex."
msgstr ""
"Désactivé par défaut : un champ d'inventaire ne crée AUCUN service, et c'est "
"tout l'intérêt - il ne consomme ni un emplacement de service ni un "
"intervalle de vérification pour signaler quelque chose qui change deux fois "
"par an. Activez-le pour une valeur que vous voulez à la fois dans "
"l'inventaire ET surveiller, p. ex. une version que vous comparez aussi à une "
"expression régulière."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:474
msgid "Authentication"
msgstr "Authentification"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:479
msgid "Basic authentication (username / password)"
msgstr "Authentification basique (nom d'utilisateur / mot de passe)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:485
msgid "Username"
msgstr "Nom d'utilisateur"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:492
msgid "Password"
msgstr "Mot de passe"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:501
msgid "Bearer token"
msgstr "Jeton Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:507
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:508
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Envoyé sous la forme 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:517
msgid "OAuth 2.0 (client credentials)"
msgstr "OAuth 2.0 (identifiants client)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:520
msgid ""
"The machine-to-machine OAuth 2.0 grant: the agent exchanges a client ID and "
"secret for a short-lived access token and sends it as 'Authorization: Bearer "
"<token>'. The token is cached until shortly before it expires, so a rule "
"polling every minute does not ask the identity provider every minute. No "
"browser and no user consent are involved - if your API only works with a "
"token obtained by a person logging in, this is not the right mode."
msgstr ""
"Le flux OAuth 2.0 de machine à machine : l'agent échange un ID client et un "
"secret contre un jeton d'accès de courte durée et l'envoie sous la forme "
"'Authorization: Bearer <token>'. Le jeton est mis en cache jusqu'à peu avant "
"son expiration, de sorte qu'une règle interrogée chaque minute ne sollicite "
"pas le fournisseur d'identité chaque minute. Aucun navigateur ni "
"consentement utilisateur n'intervient - si votre API ne fonctionne qu'avec "
"un jeton obtenu par une personne qui se connecte, ce n'est pas le bon mode."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:533
msgid "Token URL"
msgstr "URL du jeton"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:535
msgid ""
"The identity provider's token endpoint, e.g. 'https://login.example.com/"
"oauth2/v2.0/token'. This is NOT the API URL above."
msgstr ""
"Le point de terminaison de jeton du fournisseur d'identité, par exemple "
"'https://login.example.com/oauth2/v2.0/token'. Ce n'est PAS l'URL de l'API "
"ci-dessus."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:546
msgid "Client ID"
msgstr "ID client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:553
msgid "Client secret"
msgstr "Secret client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:560
msgid "Scope"
msgstr "Portée (scope)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:562
msgid ""
"Space-separated scopes to request, if the provider needs them - e.g. 'api://"
"monitoring/.default'."
msgstr ""
"Portées séparées par des espaces à demander, si le fournisseur en a besoin - "
"par exemple 'api://monitoring/.default'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:570
msgid "Audience"
msgstr "Audience"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:572
msgid ""
"Sent as the 'audience' parameter. Required by some providers (Auth0, for "
"instance) to say which API the token is for; leave empty otherwise."
msgstr ""
"Envoyé comme paramètre 'audience'. Exigé par certains fournisseurs (Auth0, "
"par exemple) pour indiquer à quelle API le jeton est destiné ; laissez vide "
"sinon."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:581
msgid "How to send the client credentials"
msgstr "Comment envoyer les identifiants client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:583
msgid ""
"RFC 6749 allows both, and providers disagree about which they accept - a "
"wrong choice here shows up as an unhelpful 401 from the token URL. Try the "
"Authorization header first; switch to the request body if the provider "
"rejects it."
msgstr ""
"La RFC 6749 autorise les deux, et les fournisseurs ne s'accordent pas sur "
"celui qu'ils acceptent : un mauvais choix se manifeste ici par un 401 peu "
"explicite renvoyé par l'URL du jeton. Essayez d'abord l'en-tête "
"Authorization ; passez au corps de la requête si le fournisseur le refuse."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:592
msgid "In the Authorization header (HTTP basic)"
msgstr "Dans l'en-tête Authorization (HTTP basic)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:596
msgid "In the request body"
msgstr "Dans le corps de la requête"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:607
msgid "API key in a request header"
msgstr "Clé d'API dans un en-tête de requête"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:613
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1352
msgid "Header name"
msgstr "Nom de l'en-tête"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:615
msgid ""
"Name of the header carrying the key, e.g. 'X-API-Key', 'apikey' or 'PRIVATE-"
"TOKEN'. For 'Authorization: Bearer <token>' use the bearer token choice "
"instead."
msgstr ""
"Nom de l'en-tête qui porte la clé, p. ex. 'X-API-Key', 'apikey' ou 'PRIVATE-"
"TOKEN'. Pour 'Authorization: Bearer <token>', utilisez plutôt l'option jeton "
"Bearer."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:627
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:666
msgid "API key"
msgstr "Clé d'API"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:629
msgid ""
"Kept in the Checkmk password store. Unlike a key typed into 'Additional "
"request headers' it is never written to the configuration or to the agent's "
"command line in clear text, and it can be rotated in one place."
msgstr ""
"Conservée dans le coffre à mots de passe de Checkmk. Contrairement à une clé "
"saisie dans 'En-têtes de requête supplémentaires', elle n'est jamais écrite "
"en clair dans la configuration ni sur la ligne de commande de l'agent, et "
"elle peut être renouvelée à un seul endroit."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:643
msgid "API key in a query parameter"
msgstr "Clé d'API dans un paramètre de requête"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:649
msgid "Parameter name"
msgstr "Nom du paramètre"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:651
msgid ""
"Name of the query parameter carrying the key, e.g. 'api_key'. It is appended "
"to the URL for the request only: the key is redacted wherever the agent "
"reports a URL, and it never appears in the service name. Prefer a header "
"where the API offers one - a key in the URL is visible to proxies and server "
"logs along the way."
msgstr ""
"Nom du paramètre de requête qui porte la clé, p. ex. 'api_key'. Il est "
"ajouté à l'URL uniquement pour la requête : la clé est masquée partout où "
"l'agent indique une URL et n'apparaît jamais dans le nom du service. "
"Préférez un en-tête si l'API en propose un : une clé dans l'URL est visible "
"par les proxys et les journaux des serveurs traversés."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:668
msgid ""
"Kept in the Checkmk password store, so it is not written to the "
"configuration or to the agent's command line in clear text - unlike a key "
"typed into the URL."
msgstr ""
"Conservée dans le coffre à mots de passe de Checkmk, elle n'est donc pas "
"écrite en clair dans la configuration ni sur la ligne de commande de "
"l'agent, contrairement à une clé saisie dans l'URL."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:732
msgid "Field path (within each element)"
msgstr "Chemin du champ (au sein de chaque élément)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:734
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr ""
"Résolu au sein de chaque élément, par ex. 'status' ou 'metadata.phase'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:742
msgid "Condition"
msgstr "Condition"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:744
msgid "equals"
msgstr "est égal à"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:745
msgid "does not equal"
msgstr "n'est pas égal à"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:746
msgid "matches regex"
msgstr "correspond à la regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:747
msgid "does not match regex"
msgstr "ne correspond pas à la regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:755
msgid "Comparison value / pattern"
msgstr "Valeur de comparaison / motif"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:757
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr ""
"La valeur à comparer, ou l'expression régulière pour les conditions regex."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:768
msgid "Field to monitor"
msgstr "Champ à surveiller"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:775
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:152
msgid "Service name"
msgstr "Nom du service"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:777
msgid ""
"Becomes the Checkmk service description for this field - or, where the field "
"reports into a shared service, the name of its line within that service."
msgstr ""
"Devient la description du service Checkmk pour ce champ – ou, lorsque le "
"champ est rapporté dans un service partagé, le nom de sa ligne dans ce "
"service."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:787
msgid "Report in a shared service named"
msgstr "Rapporter dans un service partagé nommé"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:789
msgid ""
"By default every field becomes a service of its own. Name a shared service "
"here and this field reports into that one service as a LINE instead, "
"alongside the other fields naming it - so a small API of 'status', "
"'component' and 'timestamp' can be one service rather than three. The "
"service's state is the WORST of its lines, which is how Checkmk aggregates "
"any check, and 'Service name' above then names the line rather than the "
"service. Each line keeps its own levels, string matching and transform from "
"this rule. Two things change, both because one service now holds several "
"fields: a 'Generic JSON API' check-parameters rule cannot describe it and is "
"not applied to it, so thresholds for these fields live here; and each line's "
"metric is named after the line, which keeps the history of several fields "
"apart but renders as a plain number rather than in the field's unit. A field "
"that needs its unit on the graph, or per-service thresholds, is better off "
"with a service of its own."
msgstr ""
"Par défaut, chaque champ devient un service à lui seul. Indiquez ici un "
"service partagé et ce champ sera rapporté dans ce seul service en tant que "
"LIGNE, aux côtés des autres champs qui le nomment – ainsi une petite API "
"avec 'status', 'component' et 'timestamp' devient un service au lieu de "
"trois. L'état du service est le PIRE de ses lignes, ce qui est la façon dont "
"Checkmk agrège n'importe quel check, et 'Nom du service' ci-dessus nomme "
"alors la ligne plutôt que le service. Chaque ligne conserve ses propres "
"seuils, sa correspondance de texte et sa transformation issus de cette "
"règle. Deux choses changent, toutes deux parce qu'un service contient "
"désormais plusieurs champs : une règle de paramètres de check 'Generic JSON "
"API' ne peut pas le décrire et ne lui est pas appliquée, les seuils de ces "
"champs vivent donc ici ; et la métrique de chaque ligne est nommée d'après "
"la ligne, ce qui sépare l'historique de plusieurs champs mais s'affiche "
"comme un nombre simple plutôt que dans l'unité du champ. Un champ qui a "
"besoin de son unité sur le graphique, ou de seuils par service, est mieux "
"servi par un service à lui."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:815
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:903
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:981
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1863
msgid "JSON path"
msgstr "Chemin JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:817
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\". To monitor a RESPONSE HEADER instead of a field of the body, prefix "
"its name with '@header.', e.g. '@header.X-RateLimit-Remaining' for an API "
"quota or '@header.Last-Modified' with 'Interpret the value as' set to a "
"timestamp for the age of the data. Header names are matched case-"
"insensitively and none of the path syntax above applies to them."
msgstr ""
"Chemin en notation pointée dans la réponse JSON, par exemple 'status', "
"'components.db.status' ou 'items[0].count'. Utilisez un caractère générique "
"'[*]' (par exemple 'nodes[*].health') pour créer un service par élément de "
"tableau - ou, lorsque le caractère générique correspond à un objet JSON (une "
"map indexée par nom, comme un '/health' de Spring Boot Actuator "
"'components[*].status'), un service par clé. Plusieurs caractères génériques "
"'[*]' (par exemple 'pods[*].containers[*].ready') développent le produit "
"cartésien, un service par combinaison. Un préfixe '$.' est facultatif. Les "
"clés qui contiennent elles-mêmes '.' ou '[' peuvent être adressées à l'aide "
"de segments entre crochets et guillemets, par exemple \"data['foo.bar']."
"value\". Pour surveiller un EN-TÊTE DE RÉPONSE plutôt qu'un champ du corps, "
"préfixez son nom par '@header.', par exemple '@header.X-RateLimit-Remaining' "
"pour un quota d'API ou '@header.Last-Modified' avec 'Interpréter la valeur "
"comme' réglé sur un horodatage pour l'âge des données. Les noms d'en-tête "
"sont comparés sans tenir compte de la casse et aucune des syntaxes de chemin "
"ci-dessus ne s'y applique."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:843
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "Suffixe de nom par élément (pour les caractères génériques '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:845
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"Lorsque le chemin JSON contient un caractère générique '[*]', un service est "
"créé par élément. Ce chemin facultatif - relatif à chaque élément, par "
"exemple 'name' ou 'id' - est ajouté au nom du service pour distinguer ces "
"services. Il ne remplace PAS le nom du service. Par défaut, il s'agit de "
"l'indice du tableau (ou, pour un objet, la clé). Avec plusieurs caractères "
"génériques '[*]', il est résolu à chaque niveau et les parties sont jointes "
"par ' / ' (par exemple '<pod> / <container>'). Choisissez un champ unique et "
"stable d'une exécution à l'autre."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:860
msgid "Create one host per element, named by this field"
msgstr "Créer un hôte par élément, nommé d'après ce champ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:862
msgid ""
"When the JSON path contains a '[*]' wildcard, this turns every element into "
"a Checkmk host of its own instead of one more service on this host. Give a "
"path relative to each element that holds the host name, e.g. 'name' or "
"'hostname'. The service then keeps its plain name, because the host already "
"says which element it is. Set the same field on several fields of this "
"endpoint to collect them all on the same hosts. Only characters valid in a "
"Checkmk host name are kept (letters, digits, '-', '_', '.'); anything else "
"becomes '_'. An element whose field is missing keeps its service on this "
"host, so nothing is lost. IMPORTANT: Checkmk holds piggyback data for hosts "
"that do not exist yet - create the hosts (manually or with Dynamic host "
"management) or the data is never monitored."
msgstr ""
"Lorsque le chemin JSON contient un joker '[*]', chaque élément devient un "
"hôte Checkmk à part entière au lieu d'un service supplémentaire sur cet "
"hôte. Indiquez un chemin relatif à chaque élément contenant le nom d'hôte, "
"par exemple 'name' ou 'hostname'. Le service conserve alors son nom simple, "
"car l'hôte indique déjà de quel élément il s'agit. Définissez le même champ "
"sur plusieurs champs de ce point de terminaison pour les regrouper sur les "
"mêmes hôtes. Seuls les caractères valides dans un nom d'hôte Checkmk sont "
"conservés (lettres, chiffres, '-', '_', '.') ; tout le reste devient '_'. Un "
"élément dont le champ est absent conserve son service sur cet hôte, afin que "
"rien ne soit perdu. IMPORTANT : Checkmk conserve les données piggyback des "
"hôtes qui n'existent pas encore - créez les hôtes (manuellement ou avec la "
"gestion dynamique des hôtes), sinon les données ne seront jamais surveillées."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:883
msgid "Labels for the created host"
msgstr "Étiquettes pour l'hôte créé"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:885
msgid ""
"Checkmk HOST labels for the host each '[*]' element becomes, built from "
"fields within that element - so the 50 hosts a 'nodes[*]' rule creates can "
"carry their own region, role or tier and be targeted by folder rules, views "
"and filters. Needs 'Create one host per element' above; without it the "
"element stays a service on this host and there is nothing to label. Each key "
"is prefixed with 'json_api/'. A label can also be a classification rather "
"than a field: a condition on the element plus a literal value tags only the "
"hosts the condition holds for. These are HOST labels, unlike 'Service "
"labels' below, which describe the individual service."
msgstr ""
"Étiquettes d'HÔTE Checkmk pour l'hôte que devient chaque élément '[*]', "
"construites à partir de champs de cet élément - ainsi les 50 hôtes créés par "
"une règle 'nodes[*]' peuvent porter leur propre région, rôle ou niveau et "
"être ciblés par des règles de dossier, des vues et des filtres. Nécessite "
"'Créer un hôte par élément' ci-dessus ; sans cela l'élément reste un service "
"sur cet hôte et il n'y a rien à étiqueter. Chaque clé est préfixée par "
"'json_api/'. Une étiquette peut aussi être une classification plutôt qu'un "
"champ : une condition sur l'élément associée à une valeur littérale "
"n'étiquette que les hôtes pour lesquels elle est vraie. Ce sont des "
"étiquettes d'HÔTE, contrairement aux 'Étiquettes de service' ci-dessous, qui "
"décrivent le service individuel."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:905
msgid ""
"Relative to each '[*]' element, e.g. 'region'. Can be left empty only where "
"a condition and a literal value describe the label on their own."
msgstr ""
"Relatif à chaque élément '[*]', par exemple 'region'. Ne peut être laissé "
"vide que lorsqu'une condition et une valeur littérale décrivent l'étiquette "
"à elles seules."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:915
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:993
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1877
msgid "Label key (optional)"
msgstr "Clé de l'étiquette (facultatif)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:917
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:995
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"Par défaut, le dernier segment du chemin. Le préfixe 'json_api/' est ajouté "
"automatiquement."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:925
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1902
msgid "Label value (literal)"
msgstr "Valeur de l'étiquette (littérale)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:927
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1904
msgid ""
"A value written here instead of read from the response ('yes', "
"'production', ...). With it a '[*]' path produces ONE label for the whole "
"collection rather than one per element, so the key is used exactly as given "
"- no '<key>/<element>' suffix. Combined with the condition below this is the "
"classification case: 'if any element matches, tag the host'."
msgstr ""
"Une valeur saisie ici au lieu d'être lue dans la réponse ('yes', "
"'production', ...). Avec elle, un chemin '[*]' produit UNE étiquette pour "
"toute la collection au lieu d'une par élément : la clé est utilisée telle "
"quelle, sans suffixe '<key>/<element>'. Combinée à la condition ci-dessous, "
"c'est le cas de la classification : 'si un élément correspond, étiqueter "
"l'hôte'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:942
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1034
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1919
msgid "Only elements matching a condition"
msgstr "Uniquement les éléments remplissant une condition"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:944
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1921
msgid ""
"Emit the label only for the elements whose sub-field matches this condition "
"- e.g. 'name' matching '^MyApp' over a 'services[*]' path. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar never matches. Without a '[*]' wildcard the condition is checked "
"once, in the same scope the path is read from, so the label is set only when "
"it holds."
msgstr ""
"N'émettre l'étiquette que pour les éléments dont le sous-champ remplit cette "
"condition - par exemple 'name' correspondant à '^MyApp' sur un chemin "
"'services[*]'. Le chemin du champ est résolu dans chaque élément ; un "
"élément dont le champ est absent ou n'est pas un scalaire ne correspond "
"jamais. Sans caractère générique '[*]', la condition est vérifiée une seule "
"fois, dans la portée d'où le chemin est lu : l'étiquette n'est donc définie "
"que si elle est vraie."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:964
msgid "Service labels"
msgstr "Étiquettes de service"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:966
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"Rattache des étiquettes de service Checkmk à CE service, construites à "
"partir de champs de la réponse. Chaque clé est préfixée par 'json_api/'. "
"Pour un chemin '[*]', la valeur est résolue dans chaque élément (par exemple "
"'name'), de sorte que chaque service par élément a sa propre étiquette ; "
"pour un chemin sans caractère générique, elle est résolue depuis la racine "
"de la réponse. Les informations valables pour tout l'hôte vont plutôt dans "
"les 'Étiquettes d'hôte' du point de terminaison. Les étiquettes sont "
"définies lors de la découverte ; choisissez donc des champs stables et de "
"faible cardinalité - une valeur qui change fait constamment varier "
"l'étiquette."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:983
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"Relative à chaque élément '[*]' (comme le suffixe de nom), ou à la racine de "
"la réponse pour un chemin sans caractère générique."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1007
msgid "Aggregate a collection into one value"
msgstr "Agréger une collection en une seule valeur"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1009
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"Réduit une collection d'éléments à un seul nombre au lieu de surveiller une "
"valeur unique (ou, avec un joker '[*]', un service par élément). Faites "
"pointer le chemin JSON soit vers un tableau / objet (p. ex. 'jobs'), soit "
"vers un joker '[*]' sur les valeurs à agréger (p. ex. 'nodes[*].load'). "
"'Nombre d'éléments' ne fait que les compter ; les autres fonctions exigent "
"des valeurs numériques. Le résultat est un nombre : l'unité, les seuils, la "
"transformation et la métrique s'y appliquent. Combinez-le avec la condition "
"ci-dessous pour n'agréger que les éléments correspondants. Un chemin qui ne "
"contient ni tableau ni objet met le service en UNKNOWN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1022
msgid "Number of elements"
msgstr "Nombre d'éléments"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1023
msgid "Sum of the values"
msgstr "Somme des valeurs"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1024
msgid "Average of the values"
msgstr "Moyenne des valeurs"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1025
msgid "Smallest of the values"
msgstr "La plus petite des valeurs"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1026
msgid "Largest of the values"
msgstr "La plus grande des valeurs"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1036
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"Pour un joker '[*]' ou un chemin agrégé : ne conserver que les éléments dont "
"le sous-champ satisfait cette condition – p. ex. un service par nœud dont le "
"'status' n'est pas 'ok', ou ne compter que les pods qui ne sont pas "
"'Running'. Le chemin du champ est résolu dans chaque élément ; un élément "
"dont le champ est absent ou n'est pas un scalaire est ignoré. Sans joker "
"'[*]' ni agrégation, ceci n'a aucun effet."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1049
msgid "Interpret the value as"
msgstr "Interpréter la valeur comme"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1051
msgid ""
"By default the extracted value is monitored as it stands. Two common API "
"values are worth deriving something else from: a counter that only ever "
"grows (its rate of change is what matters, not the total), and a timestamp "
"(its age is what matters, not the date). The derived number is what the "
"transform, the levels, the metric and the summary then use."
msgstr ""
"Par défaut, la valeur extraite est surveillée telle quelle. Pour deux "
"valeurs d'API courantes, il vaut mieux en dériver autre chose : un compteur "
"qui ne fait que croître (c'est son taux de variation qui compte, pas le "
"total) et un horodatage (c'est son âge qui compte, pas la date). Le nombre "
"dérivé est ensuite celui utilisé par la transformation, les seuils, la "
"métrique et le résumé."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1063
msgid "A counter - monitor its per-second rate"
msgstr "Un compteur – surveiller son taux par seconde"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1066
msgid "Per-second rate"
msgstr "Taux par seconde"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1068
msgid "The difference to the previous check is divided by the elapsed time"
msgstr ""
"La différence par rapport au contrôle précédent est divisée par le temps "
"écoulé"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1072
msgid ""
"For monotonically growing counters such as 'requests_total' or 'bytes_sent': "
"the check monitors the change per second instead of the absolute total. The "
"first check after a restart of the counter cannot compute a rate yet and "
"keeps the service's previous state."
msgstr ""
"Pour les compteurs croissant de façon monotone comme 'requests_total' ou "
"'bytes_sent' : le contrôle surveille la variation par seconde au lieu du "
"total absolu. Le premier contrôle après un redémarrage du compteur ne peut "
"pas encore calculer de taux et conserve l'état précédent du service."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1083
msgid "A timestamp - monitor its age"
msgstr "Un horodatage – surveiller son âge"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1086
msgid ""
"For values such as 'last_backup' or 'updated_at': the check monitors the "
"number of seconds since that point in time, so upper levels alert on stale "
"data. A timestamp in the future yields a negative age. The age graphs and "
"reads as a duration on its own; choose a unit below only to override that (e."
"g. after a transform into hours)."
msgstr ""
"Pour des valeurs comme 'last_backup' ou 'updated_at' : le contrôle surveille "
"le nombre de secondes écoulées depuis cet instant, de sorte que les seuils "
"supérieurs alertent sur des données obsolètes. Un horodatage dans le futur "
"donne un âge négatif. L'âge s'affiche et se trace de lui-même comme une "
"durée ; ne choisissez une unité ci-dessous que pour remplacer cela (p. ex. "
"après une transformation en heures)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1099
msgid "Timestamp format"
msgstr "Format de l'horodatage"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1101
msgid ""
"'Detect automatically' reads a number as Unix epoch seconds (milliseconds "
"when it is far too large for seconds) and anything else as ISO 8601. A "
"timestamp without a time zone is read as UTC."
msgstr ""
"'Détecter automatiquement' lit un nombre comme des secondes epoch Unix (des "
"millisecondes s'il est bien trop grand pour des secondes) et tout le reste "
"comme de l'ISO 8601. Un horodatage sans fuseau horaire est lu comme de l'UTC."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1110
msgid "Detect automatically"
msgstr "Détecter automatiquement"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1113
msgid "Unix epoch seconds"
msgstr "Secondes epoch Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1117
msgid "Unix epoch milliseconds"
msgstr "Millisecondes epoch Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1122
msgid "ISO 8601 / RFC 3339, e.g. '2026-07-28T02:00:00Z'"
msgstr "ISO 8601 / RFC 3339, p. ex. '2026-07-28T02:00:00Z'"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1139
msgid "Unit (for numeric values)"
msgstr "Unité (pour les valeurs numériques)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1141
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Affiche la métrique et le graphique avec cette unité. Laissez vide pour une "
"valeur simple, sans unité. N'affecte que les valeurs numériques."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1145
msgid "Count (integer)"
msgstr "Nombre (entier)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1146
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Octets (IEC : KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1147
msgid "Seconds (duration)"
msgstr "Secondes (durée)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1148
msgid "Percent"
msgstr "Pourcentage"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1150
msgid "No unit"
msgstr "Aucune unité"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1156
msgid "Value range (for graphs and gauges)"
msgstr "Plage de valeurs (pour les graphiques et les jauges)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1158
msgid ""
"The range this value moves in, when it has one: a battery percentage is 0 to "
"100, a queue with a cap is 0 to that cap. It changes nothing about the state "
"- it tells Checkmk what 'full' means, so the graph keeps a steady scale "
"instead of rescaling to whatever the last hour happened to contain, a gauge "
"dashboard widget has a dial to draw, and the service list's bar is filled "
"against the real maximum. Leave it unset for a value with no natural limit; "
"the bar is then scaled to the critical level instead, where one is "
"configured."
msgstr ""
"La plage dans laquelle cette valeur évolue, lorsqu'elle en a une : un "
"pourcentage de batterie va de 0 à 100, une file d'attente plafonnée de 0 à "
"ce plafond. Cela ne change rien à l'état : cela indique à Checkmk ce que « "
"plein » signifie, de sorte que le graphique conserve une échelle stable au "
"lieu de se remettre à l'échelle selon ce que la dernière heure contenait, "
"qu'un élément de tableau de bord de type jauge ait un cadran à dessiner, et "
"que la barre de la liste des services se remplisse par rapport au maximum "
"réel. Laissez vide pour une valeur sans limite naturelle ; la barre est "
"alors mise à l'échelle sur le seuil critique, lorsqu'il en existe un."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1174
msgid "Lowest possible value"
msgstr "Valeur minimale possible"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1181
msgid "Highest possible value"
msgstr "Valeur maximale possible"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1199
msgid "Transform the numeric value"
msgstr "Transformer la valeur numérique"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1201
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius). A second field can be brought in as 'other' - see below - which is "
"what turns a used/total pair into a percentage: 'value / other * 100'."
msgstr ""
"Une expression arithmétique appliquée à une valeur numérique avant les "
"seuils et la métrique, en utilisant la variable 'value'. Seuls les nombres, "
"les parenthèses et + - * / sont autorisés. Exemples : 'value / 1024 / "
"1024' (octets en MiB), 'value * 1000' (secondes en millisecondes), '(value - "
"32) * 5 / 9' (Fahrenheit en Celsius). Un second champ peut être introduit "
"sous le nom 'other' - voir ci-dessous -, ce qui transforme un couple utilisé/"
"total en pourcentage : 'value / other * 100'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1218
msgid "Second path for the transform ('other')"
msgstr "Second chemin pour la transformation ('other')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1220
msgid ""
"A second field, made available to the transform above as the variable "
"'other'. Most APIs report a used/total or current/limit pair rather than a "
"percentage, so this is what lets one service monitor the ratio: point the "
"JSON path at 'used', this at 'total', and use 'value / other * 100' with the "
"unit set to '%'. It is resolved in the SAME scope as the value - within each "
"'[*]' element, or the response root without a wildcard - so every element is "
"compared against its own total. The transform must actually use 'other', and "
"'other' requires this path; either one alone is rejected."
msgstr ""
"Un second champ, mis à disposition de la transformation ci-dessus sous le "
"nom 'other'. La plupart des API renvoient un couple utilisé/total ou courant/"
"limite plutôt qu'un pourcentage ; c'est ce qui permet à un service de "
"surveiller le rapport : pointez le chemin JSON sur 'used', celui-ci sur "
"'total' et utilisez 'value / other * 100' avec l'unité '%'. Il est résolu "
"dans la MÊME portée que la valeur - à l'intérieur de chaque élément '[*]', "
"ou à la racine de la réponse sans joker - de sorte que chaque élément est "
"comparé à son propre total. La transformation doit réellement utiliser "
"'other', et 'other' exige ce chemin ; l'un sans l'autre est rejeté."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1242
msgid "Extra text in the service summary"
msgstr "Texte supplémentaire dans le résumé du service"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1244
#, python-brace-format
msgid ""
"Appended to the summary, after the value. Write '{path}' to insert another "
"field of the same response - resolved within the current element for a '[*]' "
"wildcard, from the response root otherwise. So a service on 'status' can "
"show the reason the API gave next to it, e.g. '{message} (leader {leader})', "
"instead of needing a second service for it. A path that is not in the "
"response renders as '(n/a)'. This is presentation only: it never changes the "
"state, the levels or the metric. The text is put on one line and truncated "
"if it gets long."
msgstr ""
"Ajouté au résumé, après la valeur. Écrivez '{path}' pour insérer un autre "
"champ de la même réponse : il est résolu dans l'élément courant pour un "
"joker '[*]', depuis la racine de la réponse sinon. Un service portant sur "
"'status' peut ainsi afficher à côté la raison que l'API a déjà renvoyée, p. "
"ex. '{message} (leader {leader})', au lieu d'exiger un second service. Un "
"chemin absent de la réponse s'affiche « (n/a) ». C'est purement de la "
"présentation : l'état, les seuils et la métrique ne changent jamais. Le "
"texte est mis sur une seule ligne et tronqué s'il devient long."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1269
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:160
msgid "Endpoint"
msgstr "Point de terminaison"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1275
msgid "Endpoint name"
msgstr "Nom du point de terminaison"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1277
msgid ""
"Optional short name for this endpoint, e.g. 'frontend'. It names the "
"endpoint's own service - 'JSON API <name>', which reports the HTTP status "
"and the response time of the request. Without a name the URL is used. The "
"field service names keep their plain names unless 'Prefix the field service "
"names' below is enabled."
msgstr ""
"Nom court facultatif pour ce point de terminaison, p. ex. 'frontend'. Il "
"nomme le service propre du point de terminaison – 'JSON API <nom>' –, qui "
"rapporte le statut HTTP et le temps de réponse de la requête. Sans nom, "
"l'URL est utilisée. Les noms des services de champs restent inchangés, sauf "
"si 'Préfixer les noms des services de champs avec le nom du point de "
"terminaison' est activé ci-dessous."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1290
msgid "Prefix the field service names with the endpoint name"
msgstr ""
"Préfixer les noms des services de champs avec le nom du point de terminaison"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1292
msgid ""
"Off by default. Two endpoints extracting the same fields produce two "
"services with the same name - 'JSON Status' twice, the second one "
"disambiguated to 'JSON Status (2)' - and nothing in either name says which "
"application it belongs to. Turn this on and this endpoint's field services "
"are named after it instead: with the endpoint named 'app1-health', 'JSON "
"Status' becomes 'JSON app1-health Status'. Requires an endpoint name. The "
"endpoint's own service follows, from 'JSON API <name>' to 'JSON <name> API', "
"so that it sorts together with the services it describes instead of with "
"every other endpoint's status service. Enabling this RENAMES this endpoint's "
"services: the old ones become stale and the renamed ones have to be "
"discovered, so do it deliberately and re-run a service discovery afterwards."
msgstr ""
"Désactivé par défaut. Deux points de terminaison qui extraient les mêmes "
"champs produisent deux services portant le même nom – 'JSON Status' deux "
"fois, le second distingué en 'JSON Status (2)' – et aucun des deux noms ne "
"dit à quelle application il appartient. Avec cette option, les services de "
"champs de ce point de terminaison sont nommés d'après lui : si le point de "
"terminaison s'appelle 'app1-health', 'JSON Status' devient 'JSON app1-health "
"Status'. Nécessite un nom du point de terminaison. Le service propre du "
"point de terminaison suit, de 'JSON API <nom>' à 'JSON <nom> API', afin "
"qu'il soit trié avec les services qu'il décrit plutôt qu'avec les services "
"d'état de tous les autres points de terminaison. L'activer RENOMME les "
"services de ce point de terminaison : les anciens deviennent obsolètes et "
"les services renommés doivent être découverts. Faites-le donc délibérément "
"et relancez ensuite une découverte de services."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1314
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1316
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL complète du point de terminaison JSON, y compris le schéma, par exemple "
"'https://app.example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1325
msgid "HTTP method"
msgstr "Méthode HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1327
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1328
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1336
msgid "Request body (for POST)"
msgstr "Corps de la requête (pour POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1342
msgid "Additional request headers"
msgstr "En-têtes de requête supplémentaires"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1344
msgid ""
"Sent with every request to this endpoint. Values are stored in clear text "
"and travel on the agent's command line, so an API key belongs under "
"'Authentication' - not here."
msgstr ""
"Envoyés avec chaque requête vers ce point de terminaison. Les valeurs sont "
"stockées en clair et figurent sur la ligne de commande de l'agent : une clé "
"d'API a donc sa place sous 'Authentification', pas ici."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1356
msgid "Header value"
msgstr "Valeur de l'en-tête"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1369
msgid "Verify the TLS certificate"
msgstr "Vérifier le certificat TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1370
msgid "Disabling certificate verification is insecure."
msgstr "Désactiver la vérification du certificat n'est pas sécurisé."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1377
msgid "Custom CA bundle file"
msgstr "Fichier de bundle CA personnalisé"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1379
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"Chemin sur le serveur Checkmk vers un fichier PEM contenant le(s) "
"certificat(s) CA servant à vérifier le certificat du serveur. Utilisez-le "
"pour faire confiance à une CA interne ou privée sans désactiver la "
"vérification. Ignoré lorsque la vérification TLS est désactivée."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1390
msgid "Client certificate (mutual TLS)"
msgstr "Certificat client (TLS mutuel)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1392
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"Présentez un certificat client au serveur (TLS mutuel). Les fichiers doivent "
"exister sur le serveur Checkmk. La clé privée doit être non chiffrée."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1400
msgid "Client certificate file"
msgstr "Fichier de certificat client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1402
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"Chemin vers le certificat client (PEM). Si le fichier contient aussi la clé "
"privée, laissez le champ de la clé vide."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1412
msgid "Private key file"
msgstr "Fichier de clé privée"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1414
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr ""
"Chemin vers la clé privée du client (PEM), si elle n'est pas incluse dans le "
"certificat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1426
msgid "Follow HTTP redirects"
msgstr "Suivre les redirections HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1428
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Activé par défaut. Désactivez cette option dans les environnements "
"verrouillés pour renforcer la protection contre le SSRF : une cible qui "
"redirige (par exemple 3xx vers une adresse interne) échouera alors au lieu "
"d'être suivie jusqu'à l'emplacement de redirection."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1439
msgid "Request timeout (seconds)"
msgstr "Délai d'expiration de la requête (secondes)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1440
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Délai d'expiration par requête. Par défaut, 30 secondes."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1448
msgid "Re-read at most every (seconds)"
msgstr "Relire au plus toutes les (secondes)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1450
msgid ""
"Reuse the last response for this endpoint instead of requesting it again, as "
"long as it is younger than this. For APIs with a request quota, expensive "
"endpoints, or a rule shared across many hosts - anything where the request "
"RATE is the problem rather than the freshness of the data. Without it, every "
"check interval on every host issues a request, which can exhaust a quota and "
"turn the monitoring itself into the outage. Only a response that parsed as "
"JSON is cached, and a failing request is never answered from an expired "
"cache - a real outage must not hide behind stale data. While a cached body "
"is served the endpoint's own service says so and reports no response time, "
"because no request was made. Leave unset to always fetch fresh."
msgstr ""
"Réutiliser la dernière réponse de ce point de terminaison au lieu de la "
"redemander, tant qu'elle est plus récente que cette valeur. Pour les API "
"avec un quota de requêtes, les points de terminaison coûteux ou une règle "
"partagée entre de nombreux hôtes - partout où le problème est le DÉBIT de "
"requêtes et non la fraîcheur des données. Sans cela, chaque intervalle de "
"contrôle sur chaque hôte émet une requête, ce qui peut épuiser un quota et "
"faire de la surveillance elle-même la panne. Seule une réponse ayant pu être "
"analysée comme du JSON est mise en cache, et une requête en échec n'est "
"jamais servie depuis un cache expiré - une panne réelle ne doit pas se "
"cacher derrière des données obsolètes. Pendant qu'un contenu en cache est "
"servi, le service propre du point de terminaison l'indique et ne rapporte "
"aucun temps de réponse, puisqu'aucune requête n'a été faite. Laissez vide "
"pour toujours interroger en direct."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1472
msgid "Retry a failed request"
msgstr "Réessayer une requête ayant échoué"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1474
msgid ""
"Repeat this endpoint's request when it fails in a way a repeat could fix - a "
"connection error, a timeout, or an HTTP 429 / 5xx - so a load balancer "
"dropping connections for a second during a rolling restart does not become a "
"CRIT and a notification. A 4xx, a body that is not JSON and an oversized "
"response are never retried: repeating them would only burn time. Nothing is "
"hidden - the endpoint's own service reports that a retry was needed, and can "
"be told to go WARN when one is. Every attempt costs wall-clock time inside "
"the check: the worst case is (1 + retries) times the request timeout, plus "
"the waiting time between attempts. Off by default."
msgstr ""
"Répète la requête vers ce point de terminaison lorsqu'elle échoue d'une "
"manière qu'une nouvelle tentative peut corriger - erreur de connexion, délai "
"dépassé ou HTTP 429 / 5xx -, afin qu'un répartiteur de charge coupant les "
"connexions pendant une seconde lors d'un redémarrage progressif ne devienne "
"pas un CRIT assorti d'une notification. Un 4xx, un corps qui n'est pas du "
"JSON et une réponse trop volumineuse ne sont jamais réessayés : les répéter "
"ne ferait que consommer du temps. Rien n'est masqué : le service du point de "
"terminaison indique qu'une nouvelle tentative a été nécessaire, et peut "
"passer en WARN dans ce cas. Chaque tentative consomme du temps réel dans le "
"check : au pire (1 + tentatives) fois le délai de la requête, plus les "
"attentes entre les tentatives. Désactivé par défaut."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1491
msgid "Number of retries"
msgstr "Nombre de nouvelles tentatives"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1492
msgid "Extra attempts after the first one failed."
msgstr "Tentatives supplémentaires après l'échec de la première."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1502
msgid "Wait before retrying (seconds)"
msgstr "Attente avant de réessayer (secondes)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1504
msgid ""
"Waiting time before the first retry, doubled for each further one. The total "
"waiting time is capped at 30 seconds however many retries are configured."
msgstr ""
"Temps d'attente avant la première nouvelle tentative, doublé à chaque "
"suivante. L'attente totale est plafonnée à 30 secondes, quel que soit le "
"nombre de tentatives configurées."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1521
msgid "Additional accepted HTTP status codes"
msgstr "Codes de statut HTTP supplémentaires acceptés"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1523
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"Par défaut, seules les réponses 2xx sont lues ; tout autre statut place les "
"services du point de terminaison sur UNKNOWN. Ajoutez ici des codes de "
"statut supplémentaires à accepter, par exemple 503 pour un point de "
"terminaison de santé qui signale ses problèmes avec un 503 et un corps JSON. "
"Le corps d'une réponse acceptée est analysé et extrait comme d'habitude. 2xx "
"est toujours accepté."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1531
msgid "Status code"
msgstr "Code de statut"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1539
msgid "Report the raw response"
msgstr "Rapporter la réponse brute"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1541
msgid ""
"Off by default. Put the response itself into the Details of this endpoint's "
"own 'JSON API <name>' service, exactly as it came off the wire. The Details "
"otherwise only link to the URL, which is often not reachable from the "
"browser reading the service (the API may sit behind a firewall or in another "
"network) and always shows the API as it is NOW rather than as it was when "
"the check ran. The body of a REJECTED response is reported too - an "
"unexpected HTTP status or a body that is not JSON - which is the case this "
"exists for: it is where the API explains itself. Credentials are stripped "
"first: 'Set-Cookie' and any authorization header are masked, and the "
"endpoint's own secret is removed wherever it appears. Everything else in the "
"response is reported verbatim, and a service's Details are stored with every "
"check result and travel into notifications - so do not turn this on for a "
"response carrying personal or otherwise sensitive data."
msgstr ""
"Désactivé par défaut. Place la réponse elle-même dans les Détails du service "
"propre de ce point de terminaison, 'JSON API <nom>', exactement telle "
"qu'elle est arrivée. Sinon, les Détails ne font que renvoyer à l'URL, qui "
"n'est souvent pas joignable depuis le navigateur qui lit le service (l'API "
"peut se trouver derrière un pare-feu ou dans un autre réseau) et qui montre "
"toujours l'API telle qu'elle est MAINTENANT, et non telle qu'elle était lors "
"du check. Le corps d'une réponse REJETÉE est rapporté aussi – un statut HTTP "
"inattendu ou un corps qui n'est pas du JSON –, et c'est précisément le cas "
"pour lequel cette option existe : c'est là que l'API s'explique. Les "
"identifiants sont retirés au préalable : 'Set-Cookie' et tout en-tête "
"d'autorisation sont masqués, et le secret du point de terminaison est "
"supprimé partout où il apparaît. Tout le reste est rapporté mot pour mot, et "
"les Détails d'un service sont enregistrés avec chaque résultat de check et "
"voyagent dans les notifications : n'activez donc pas ceci pour une réponse "
"contenant des données personnelles ou sensibles."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1564
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1646
msgid "Report at most (bytes)"
msgstr "Rapporter au maximum (octets)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1566
msgid ""
"Longer bodies are cut off at this many bytes and the service says so. Keep "
"it small: this text is stored with every check result of this service."
msgstr ""
"Les corps plus longs sont coupés à ce nombre d'octets, et le service le "
"signale. Gardez une valeur faible : ce texte est enregistré avec chaque "
"résultat de check de ce service."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1580
msgid "Report the response headers as well"
msgstr "Rapporter aussi les en-têtes de la réponse"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1582
msgid ""
"On by default. The headers are what a rate limit, a cache directive or a "
"content type is announced in, and they are small."
msgstr ""
"Activé par défaut. Les en-têtes sont ce dans quoi une limite de débit, une "
"directive de cache ou un type de contenu sont annoncés, et ils sont petits."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1595
msgid "Report the JSON context in the field services"
msgstr "Rapporter le contexte JSON dans les services de champ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1597
msgid ""
"Off by default. The setting above reports the response on the endpoint's OWN "
"service - but the services that go WARN or CRIT, and therefore the ones that "
"notify, are the field services, and their Details say only which path was "
"read. This puts the JSON itself there too, so the alert carries what the API "
"actually said: a service's Details travel into notifications as "
"$LONGSERVICEOUTPUT$, and the person on call often cannot reach the endpoint "
"at all - wrong network, no credentials - while the endpoint's own service "
"stayed OK and notified nobody. Credentials are stripped exactly as they are "
"for the raw response. Note that this text is stored with every check result "
"of EVERY field service of this endpoint, so keep the byte budget small."
msgstr ""
"Désactivé par défaut. Le réglage ci-dessus rapporte la réponse sur le "
"service PROPRE du point de terminaison - mais les services qui passent en "
"WARN ou CRIT, et donc ceux qui notifient, sont les services de champ, et "
"leurs détails n'indiquent que le chemin lu. Ceci y place aussi le JSON lui-"
"même, pour que l'alerte porte ce que l'API a réellement dit : les détails "
"d'un service arrivent dans les notifications sous $LONGSERVICEOUTPUT$, et la "
"personne d'astreinte ne peut souvent pas joindre le point de terminaison - "
"mauvais réseau, pas d'identifiants - alors que son service propre est resté "
"OK et n'a notifié personne. Les identifiants sont supprimés exactement comme "
"pour la réponse brute. Notez que ce texte est stocké avec chaque résultat de "
"contrôle de CHAQUE service de champ de ce point de terminaison : gardez donc "
"un budget d'octets réduit."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1615
msgid "What to report"
msgstr "Ce qui est rapporté"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1619
msgid "The JSON this value was read from"
msgstr "Le JSON d'où cette valeur a été lue"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1623
msgid "The whole response body"
msgstr "L'intégralité du corps de la réponse"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1628
msgid ""
"'The JSON this value was read from' is the targeted form: for a '[*]' path "
"that element, otherwise the object holding the value - so the service that "
"alerted shows the element that failed with all its sibling fields, and "
"nothing else. An aggregation has no single element and a '@header.' path is "
"not in the body at all, so both report the whole response. 'The whole "
"response body' always does, repeated on every field service - which is why "
"the cap matters more here than on the endpoint's own service."
msgstr ""
"'Le JSON d'où cette valeur a été lue' est la forme ciblée : pour un chemin "
"'[*]', cet élément ; sinon l'objet qui contient la valeur - le service qui a "
"alerté montre donc l'élément en échec avec tous ses champs frères, et rien "
"d'autre. Une agrégation n'a pas d'élément unique et un chemin '@header.' "
"n'est pas du tout dans le corps, donc les deux rapportent la réponse "
"entière. 'L'intégralité du corps de la réponse' le fait toujours, répétée "
"sur chaque service de champ - c'est pourquoi le plafond compte davantage ici "
"que sur le service propre du point de terminaison."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1648
msgid ""
"Longer context is cut off at this many bytes and the service says so. Keep "
"it small: this text is stored with every check result of every field service "
"of this endpoint."
msgstr ""
"Un contexte plus long est coupé à ce nombre d'octets et le service le "
"signale. Gardez-le petit : ce texte est stocké avec chaque résultat de "
"contrôle de chaque service de champ de ce point de terminaison."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1665
msgid "Follow pagination"
msgstr "Suivre la pagination"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1668
msgid ""
"Off by default: one request, one page. An API that answers a collection one "
"page at a time then leaves every service built from it describing the FIRST "
"page only - 'count' over a queue that pages at 25 reports 25 however long "
"the queue is, and a '[*]' wildcard creates services for the first page's "
"elements alone. Nothing says so, which is why this is worth configuring: the "
"answer is not missing, it is wrong. With this set the agent follows the "
"API's own next-page link and appends each page's collection to the first "
"page's, so the wildcards, the aggregations, the filters and the host labels "
"all see the whole thing. Every page is requested exactly like the first one "
"(same method, headers, authentication and timeout), and each one costs a "
"request inside the check - so cap the pages, and consider a cache TTL for a "
"collection that does not change every check interval. A page that cannot be "
"read fails the endpoint rather than silently truncating the collection; "
"where a further page exists but is not followed - a cap, or a link the agent "
"refuses - the endpoint's own service reports it and goes WARN."
msgstr ""
"Désactivé par défaut : une requête, une page. Lorsqu'une API renvoie une "
"collection page par page, chaque service construit à partir d'elle ne décrit "
"que la PREMIÈRE page - 'count' sur une file paginée par 25 rapporte 25 "
"quelle que soit la longueur de la file, et un joker '[*]' ne crée des "
"services que pour les éléments de la première page. Rien ne le signale, et "
"c'est justement pourquoi ce réglage vaut la peine : la réponse n'est pas "
"manquante, elle est fausse. Avec ce réglage, l'agent suit le lien vers la "
"page suivante fourni par l'API et ajoute la collection de chaque page à "
"celle de la première, si bien que les jokers, les agrégations, les "
"conditions et les étiquettes d'hôte voient l'ensemble. Chaque page est "
"demandée exactement comme la première (mêmes méthode, en-têtes, "
"authentification et délai d'attente), et chacune coûte une requête pendant "
"l'exécution du check - limitez donc le nombre de pages et envisagez un TTL "
"de cache pour une collection qui ne change pas à chaque intervalle de "
"contrôle. Une page illisible fait échouer le point de terminaison au lieu de "
"tronquer silencieusement la collection ; lorsqu'une page suivante existe "
"sans être suivie - une limite, ou un lien que l'agent refuse -, le service "
"propre du point de terminaison le signale et passe en WARN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1694
msgid "Where the next page's URL comes from"
msgstr "D'où vient l'URL de la page suivante"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1696
msgid ""
"Both forms are common; the API's documentation says which one it uses. A "
"page that carries no next link (an absent field, a JSON 'null', an empty "
"string, no 'Link' header) is the last one, which is how pagination ends."
msgstr ""
"Les deux formes sont courantes ; la documentation de l'API indique celle "
"qu'elle utilise. Une page sans lien vers la suivante (champ absent, 'null' "
"JSON, chaîne vide, aucun en-tête 'Link') est la dernière : c'est ainsi que "
"la pagination se termine."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1706
msgid "A field in the response body"
msgstr "Un champ dans le corps de la réponse"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1708
msgid "JSON path to the next page's URL"
msgstr "Chemin JSON vers l'URL de la page suivante"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1710
msgid ""
"From the response root, e.g. 'links.next', 'next' or 'meta.next_page_url'. A "
"relative URL ('/api/v1/jobs?page=2') is resolved against the page it came "
"from."
msgstr ""
"Depuis la racine de la réponse, par exemple 'links.next', 'next' ou 'meta."
"next_page_url'. Une URL relative ('/api/v1/jobs?page=2') est résolue par "
"rapport à la page dont elle provient."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1724
msgid "The 'Link' response header (rel=\"next\")"
msgstr "L'en-tête de réponse 'Link' (rel=\"next\")"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1728
msgid "Read from the 'Link' header, as RFC 8288 defines it"
msgstr "Lire l'en-tête 'Link', tel que le définit la RFC 8288"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1732
msgid ""
"The convention of the GitHub, GitLab and Jenkins style APIs: 'Link: <https://"
"host/jobs?page=2>; rel=\"next\"'. The link with rel=\"next\" is followed; "
"the others ('last', 'prev') are ignored."
msgstr ""
"La convention des API de type GitHub, GitLab et Jenkins : 'Link: <https://"
"host/jobs?page=2>; rel=\"next\"'. Le lien portant rel=\"next\" est suivi ; "
"les autres ('last', 'prev') sont ignorés."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1749
msgid "JSON path to the collection to merge"
msgstr "Chemin JSON vers la collection à fusionner"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1751
msgid ""
"The array (or object) each page carries a slice of - e.g. 'items', 'data."
"jobs' or 'results'. Use '$' where the response IS the array. Each page's "
"collection is appended to the first page's, and the rest of the document "
"stays as the first page sent it: a 'total' or a 'generated_at' next to the "
"collection still resolves, and every path configured below is unchanged. No "
"'[*]' wildcard here - this names the collection itself, not the elements in "
"it."
msgstr ""
"Le tableau (ou l'objet) dont chaque page apporte une tranche - par exemple "
"'items', 'data.jobs' ou 'results'. Utilisez '$' lorsque la réponse EST le "
"tableau. La collection de chaque page est ajoutée à celle de la première, et "
"le reste du document reste tel que la première page l'a envoyé : un 'total' "
"ou un 'generated_at' à côté de la collection se résout toujours, et tous les "
"chemins configurés ci-dessous sont inchangés. Pas de joker '[*]' ici : ceci "
"désigne la collection elle-même, pas les éléments qu'elle contient."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1769
msgid "Read at most this many pages"
msgstr "Lire au plus ce nombre de pages"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1771
msgid ""
"Including the first one, so '1' disables following entirely. Each page is a "
"request made while the check runs, and a special agent that overruns is "
"killed - so this is the setting that keeps a collection which grew a "
"hundredfold from turning the monitoring into the outage. When the limit is "
"reached while a further page still exists, the endpoint's own service says "
"so and goes WARN instead of quietly reporting part of the collection."
msgstr ""
"La première incluse : '1' désactive donc entièrement le suivi. Chaque page "
"est une requête émise pendant l'exécution du check, et un agent spécial qui "
"dépasse son temps est tué - c'est donc ce réglage qui empêche une collection "
"devenue cent fois plus grande de transformer la surveillance en panne. Si la "
"limite est atteinte alors qu'une page suivante existe encore, le service "
"propre du point de terminaison le signale et passe en WARN au lieu de "
"rapporter discrètement une partie de la collection."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1792
msgid "And at most this many elements"
msgstr "Et au plus ce nombre d'éléments"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1794
msgid ""
"Optional second cap, for a page size that is not known in advance. Checked "
"between pages, so a page is never cut in half and the collection can end "
"slightly above this. Like the page limit, reaching it while more pages exist "
"is reported on the endpoint's own service. Remember that a '[*]' wildcard "
"creates one SERVICE per element."
msgstr ""
"Seconde limite facultative, pour une taille de page inconnue à l'avance. "
"Elle est vérifiée entre les pages : une page n'est donc jamais coupée en "
"deux et la collection peut dépasser légèrement ce nombre. Comme pour la "
"limite de pages, l'atteindre alors que d'autres pages existent est signalé "
"sur le service propre du point de terminaison. N'oubliez pas qu'un joker "
"'[*]' crée un SERVICE par élément."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1813
msgid "HTTP proxy"
msgstr "Proxy HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1815
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"Acheminez la requête de ce point de terminaison via un proxy HTTP - utile "
"lorsque le serveur Checkmk n'atteint l'API qu'au travers d'un proxy de "
"sortie d'entreprise. Choisissez les variables d'environnement HTTP_PROXY / "
"HTTPS_PROXY, une URL de proxy explicite, ou 'aucun proxy' pour contourner "
"tout proxy défini dans l'environnement. Sans ce réglage, les variables de "
"proxy de l'environnement sont respectées."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1829
msgid "Fields to monitor"
msgstr "Champs à surveiller"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1831
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Chaque entrée devient un service Checkmk, construit à partir de la valeur "
"trouvée au chemin JSON indiqué."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1840
msgid "Host labels"
msgstr "Étiquettes d'hôte"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1842
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Or classify the host from a "
"collection instead: a condition plus a literal value turns 'any element of "
"services[*] whose name matches ^MyApp' into the single label 'json_api/"
"MyApp: yes', which folder rules, thresholds, contact groups and views can "
"then target. Set at discovery, so pick stable, low-cardinality fields."
msgstr ""
"Rattache des étiquettes d'hôte Checkmk à l'hôte surveillé, construites à "
"partir de champs de la réponse de ce point de terminaison. Chaque clé est "
"préfixée par 'json_api/' et la valeur est résolue depuis la racine de la "
"réponse - ce sont donc des informations valables pour tout l'hôte (par "
"exemple un environnement, une région ou une version) qui ne nécessitent "
"AUCUN service. Un chemin peut contenir un caractère générique '[*]' (par "
"exemple 'components[*]') pour émettre une étiquette par élément, avec la clé "
"'<key>/<element>' afin que les clés restent uniques. Ou classez plutôt "
"l'hôte à partir d'une collection : une condition associée à une valeur "
"littérale transforme 'un élément quelconque de services[*] dont le name "
"correspond à ^MyApp' en l'unique étiquette 'json_api/MyApp: yes', que les "
"règles de dossier, les seuils, les groupes de contact et les vues peuvent "
"alors cibler. Définies lors de la découverte ; choisissez des champs stables "
"et de faible cardinalité."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1865
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element. Can be left empty "
"only where a condition and a literal value describe the label on their own."
msgstr ""
"Depuis la racine de la réponse, par exemple 'version', 'cluster.region', ou "
"un caractère générique '[*]' comme 'components[*]' pour une étiquette par "
"élément. Ne peut être laissé vide que lorsqu'une condition et une valeur "
"littérale décrivent l'étiquette à elles seules."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1879
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"Par défaut, le dernier segment du chemin. Pour un chemin '[*]', "
"l'identifiant de l'élément est ajouté ('<key>/<element>'). Le préfixe "
"'json_api/' est ajouté automatiquement."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1889
msgid "Value field (for '[*]' wildcards)"
msgstr "Champ de valeur (pour les caractères génériques '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1891
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"Pour un chemin '[*]' : un chemin dans chaque élément pour la valeur de "
"l'étiquette (par exemple 'status'). Par défaut 'true' (une étiquette "
"d'appartenance). Ignoré sans caractère générique."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1964
msgid "Endpoints"
msgstr "Points de terminaison"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1966
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Un ou plusieurs points de terminaison HTTP/JSON. Chacun est interrogé avec "
"ses propres paramètres de connexion et extractions ; tous les résultats sont "
"fusionnés en une seule section. Un point de terminaison inaccessible "
"n'affecte que ses propres services."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1981
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:149
msgid "Generic JSON API"
msgstr "API JSON générique"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:66
msgid "Upper levels for the response time"
msgstr "Seuils supérieurs pour le temps de réponse"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:68
msgid ""
"How long the request to this endpoint may take, in seconds. Measured from "
"sending the request to having read the whole response body. Without levels "
"the response time is only recorded as a metric."
msgstr ""
"Durée maximale de la requête vers ce point de terminaison, en secondes. "
"Mesurée de l'envoi de la requête à la lecture complète du corps de la "
"réponse. Sans seuils, le temps de réponse n'est enregistré que comme "
"métrique."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:81
msgid "Lower levels for the TLS certificate's remaining validity"
msgstr "Seuils inférieurs pour la validité restante du certificat TLS"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:83
msgid ""
"How many days the endpoint's TLS certificate must still be valid for. Read "
"from the connection the agent already makes, so no second check against the "
"same URL is needed. Only available for HTTPS endpoints with certificate "
"verification enabled; otherwise the certificate is not reported and these "
"levels never apply. Without levels the remaining validity is only recorded "
"as a metric."
msgstr ""
"Nombre de jours pendant lesquels le certificat TLS du point de terminaison "
"doit encore être valide. Il est lu depuis la connexion que l'agent établit "
"de toute façon, aucune seconde vérification sur la même URL n'est donc "
"nécessaire. Disponible uniquement pour les points de terminaison HTTPS avec "
"la vérification du certificat activée ; sinon le certificat n'est pas "
"signalé et ces seuils ne s'appliquent jamais. Sans seuils, la validité "
"restante est seulement enregistrée comme métrique."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:99
msgid "State when the request needed a retry"
msgstr "État lorsque la requête a nécessité une nouvelle tentative"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:101
msgid ""
"Applies when the endpoint's retry policy absorbed a failed attempt: the "
"request did succeed, but not on the first try. OK by default - a retry doing "
"its job is not itself a problem. Raise it for an endpoint whose flakiness is "
"worth knowing about, so retries never quietly turn a degrading API into a "
"permanently green service."
msgstr ""
"S'applique lorsque la politique de nouvelle tentative du point de "
"terminaison a absorbé un échec : la requête a bien abouti, mais pas du "
"premier coup. OK par défaut - une nouvelle tentative qui fait son travail "
"n'est pas un problème en soi. Augmentez-le pour un point de terminaison dont "
"l'instabilité mérite d'être connue, afin que les nouvelles tentatives ne "
"transforment jamais en silence une API qui se dégrade en un service "
"durablement vert."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:114
msgid "State when the collection was read incompletely"
msgstr "État lorsque la collection n'a été lue que partiellement"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:116
msgid ""
"Applies when the endpoint follows the API's pagination and a further page "
"existed that was not read - a page or element limit was reached, or the API "
"offered a link the agent refuses to follow (another host, or one it had "
"already fetched). Every service built from that collection - a count, an "
"aggregation, a '[*]' wildcard - is then describing part of it. WARN by "
"default, because a collection quietly missing its tail is exactly what "
"following the pages was meant to prevent. Lower it to OK for an endpoint "
"where reading the first N pages is deliberate."
msgstr ""
"S'applique lorsque le point de terminaison suit la pagination de l'API et "
"qu'une page suivante existait sans être lue : une limite de pages ou "
"d'éléments a été atteinte, ou l'API a proposé un lien que l'agent refuse de "
"suivre (un autre hôte, ou un lien déjà récupéré). Chaque service construit à "
"partir de cette collection - un décompte, une agrégation, un joker '[*]' - "
"ne décrit alors qu'une partie de celle-ci. WARN par défaut, car une "
"collection dont la fin manque silencieusement est précisément ce que le "
"suivi des pages doit empêcher. Abaissez-le à OK pour un point de terminaison "
"où ne lire que les N premières pages est voulu."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:134
msgid "State when the endpoint cannot be read"
msgstr "État lorsque le point de terminaison ne peut pas être lu"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:136
msgid ""
"Applies when the request fails outright: connection refused, a TLS error, a "
"timeout, an HTTP status that is not accepted, or a response that is not JSON."
msgstr ""
"S'applique lorsque la requête échoue complètement : connexion refusée, "
"erreur TLS, délai dépassé, statut HTTP non accepté ou réponse qui n'est pas "
"du JSON."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:157
msgid "Generic JSON API endpoint"
msgstr "Point de terminaison d'API JSON générique"

#: cmk_addons/plugins/json_api/graphing/json_api.py:23
msgid "Value"
msgstr "Valeur"

#: cmk_addons/plugins/json_api/graphing/json_api.py:30
msgid "Count"
msgstr "Nombre"

#: cmk_addons/plugins/json_api/graphing/json_api.py:37
msgid "Size"
msgstr "Taille"

#: cmk_addons/plugins/json_api/graphing/json_api.py:44
msgid "Duration"
msgstr "Durée"

#: cmk_addons/plugins/json_api/graphing/json_api.py:51
msgid "Percentage"
msgstr "Pourcentage"

#: cmk_addons/plugins/json_api/graphing/json_api.py:58
#: cmk_addons/plugins/json_api/graphing/json_api.py:65
msgid "Rate"
msgstr "Taux"

#: cmk_addons/plugins/json_api/graphing/json_api.py:72
msgid "Throughput"
msgstr "Débit"

#: cmk_addons/plugins/json_api/graphing/json_api.py:79
msgid "Time per second"
msgstr "Temps par seconde"

#: cmk_addons/plugins/json_api/graphing/json_api.py:86
msgid "Percentage per second"
msgstr "Pourcentage par seconde"

#: cmk_addons/plugins/json_api/graphing/json_api.py:93
msgid "Age"
msgstr "Âge"

#: cmk_addons/plugins/json_api/graphing/json_api.py:100
msgid "Response time"
msgstr "Temps de réponse"

#: cmk_addons/plugins/json_api/graphing/json_api.py:107
msgid "Response size"
msgstr "Taille de la réponse"

#: cmk_addons/plugins/json_api/graphing/json_api.py:114
msgid "Certificate expires in"
msgstr "Le certificat expire dans"

#~ msgid "Relative to each '[*]' element, e.g. 'region'."
#~ msgstr "Relatif à chaque élément '[*]', par exemple 'region'."

#~ msgid "Becomes the Checkmk service description for this field."
#~ msgstr "Devient la description du service Checkmk pour ce champ."

#~ msgid "Count the number of elements at this path"
#~ msgstr "Compter le nombre d'éléments à ce chemin"

#~ msgid ""
#~ "When the path points at a JSON array or object, monitor the number of "
