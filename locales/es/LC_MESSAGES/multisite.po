msgstr "La URL debe comenzar con 'http://' o 'https://'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:55
msgid "Authentication"
msgstr "Autenticación"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:60
msgid "Basic authentication (username / password)"
msgstr "Autenticación básica (nombre de usuario / contraseña)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:66
msgid "Username"
msgstr "Nombre de usuario"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:73
msgid "Password"
msgstr "Contraseña"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:82
msgid "Bearer token"
msgstr "Token Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:88
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:89
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Se envía como 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:102
msgid "Field to monitor"
msgstr "Campo a monitorizar"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:107
msgid "Service name"
msgstr "Nombre del servicio"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:108
msgid "Becomes the Checkmk service description for this field."
msgstr ""
"Se convierte en la descripción del servicio de Checkmk para este campo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:115
msgid "JSON path"
msgstr "Ruta JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:117
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element; multiple '[*]' wildcards (e.g. 'pods[*]."
"containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\"."
msgstr ""
"Ruta con puntos dentro de la respuesta JSON, p. ej. 'status', 'components.db."
"status' o 'items[0].count'. Utilice un comodín '[*]' (p. ej. 'nodes[*]."
"health') para crear un servicio por cada elemento del array; varios "
"comodines '[*]' (p. ej. 'pods[*].containers[*].ready') expanden el producto "
"cartesiano, un servicio por cada combinación. El prefijo '$.' es opcional. "
"Las claves que contienen '.' o '[' se pueden indicar mediante segmentos "
"entre corchetes y comillas, p. ej. \"data['foo.bar'].value\"."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:134
msgid "Item label path (for '[*]' wildcards)"
msgstr "Ruta de la etiqueta del elemento (para comodines '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:136
msgid ""
"When the path contains a '[*]' wildcard, this optional path - relative to "
"each array element, e.g. 'name' or 'id' - provides the label appended to the "
"service name. Defaults to the array index. With multiple '[*]' wildcards it "
"is resolved at every level and the labels are joined with ' / ' (e.g. "
"'<pod> / <container>'). Pick a field that is unique and stable across runs."
msgstr ""
"Cuando la ruta contiene un comodín '[*]', esta ruta opcional -relativa a "
"cada elemento del array, p. ej. 'name' o 'id'- proporciona la etiqueta que "
"se añade al nombre del servicio. Por defecto se utiliza el índice del array. "
"Con varios comodines '[*]' se resuelve en cada nivel y las etiquetas se unen "
"con ' / ' (p. ej. '<pod> / <container>'). Elija un campo que sea único y "
"estable entre ejecuciones."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:149
msgid "Unit (for numeric values)"
msgstr "Unidad (para valores numéricos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:151
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Muestra la métrica y el gráfico con esta unidad. Déjelo sin definir para un "
"valor simple, sin unidad. Solo afecta a los valores numéricos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:155
msgid "Count (integer)"
msgstr "Recuento (entero)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:156
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Bytes (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:157
msgid "Seconds (duration)"
msgstr "Segundos (duración)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:158
msgid "Percent"
msgstr "Porcentaje"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:160
msgid "No unit"
msgstr "Sin unidad"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:166
msgid "Upper levels (for numeric values)"
msgstr "Niveles superiores (para valores numéricos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:175
msgid "Lower levels (for numeric values)"
msgstr "Niveles inferiores (para valores numéricos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:184
msgid "Expected value (regex)"
msgstr "Valor esperado (regex)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:186
msgid ""
"For string values: the service is OK only if the value fully matches this "
"regular expression (e.g. 'UP|ok'). Otherwise CRIT."
msgstr ""
"Para valores de cadena: el servicio está en OK solo si el valor coincide por "
"completo con esta expresión regular (p. ej. 'UP|ok'). De lo contrario, CRIT."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:199
msgid "Endpoint"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:204
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:206
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL completa del endpoint JSON, incluido el esquema, p. ej. 'https://app."
"example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:215
msgid "HTTP method"
msgstr "Método HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:217
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:218
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:226
msgid "Request body (for POST)"
msgstr "Cuerpo de la petición (para POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:232
msgid "Additional request headers"
msgstr "Cabeceras adicionales de la petición"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:237
msgid "Header name"
msgstr "Nombre de la cabecera"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:241
msgid "Header value"
msgstr "Valor de la cabecera"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:254
msgid "Verify the TLS certificate"
msgstr "Verificar el certificado TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:255
msgid "Disabling certificate verification is insecure."
msgstr "Deshabilitar la verificación del certificado es inseguro."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:262
msgid "Follow HTTP redirects"
msgstr "Seguir las redirecciones HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:264
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Activado por defecto. Deshabilítelo en entornos restringidos para reforzar "
"la protección contra SSRF: un destino que redirige (p. ej. 3xx a una "
"dirección interna) fallará en lugar de seguirse hasta la ubicación de la "
"redirección."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:275
msgid "Request timeout (seconds)"
msgstr "Tiempo de espera de la petición (segundos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:276
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Tiempo de espera por petición. Por defecto, 30 segundos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:284
msgid "Fields to monitor"
msgstr "Campos a monitorizar"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:286
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Cada entrada se convierte en un servicio de Checkmk, construido a partir del "
"valor encontrado en la ruta JSON indicada."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:313
msgid "Endpoints"
msgstr "Endpoints"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:315
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Uno o varios endpoints HTTP/JSON. Cada uno se consulta con su propia "
"configuración de conexión y sus propias extracciones; todos los resultados "
"se combinan en una sola sección. Un endpoint que no se puede alcanzar solo "
"afecta a sus propios servicios."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:329
msgid "Generic JSON API"
msgstr "API JSON genérica"

#: cmk_addons/plugins/json_api/graphing/json_api.py:19
msgid "Value"
msgstr "Valor"

#: cmk_addons/plugins/json_api/graphing/json_api.py:26
