#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Expresión regular no válida: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "Niveles superiores (para valores numéricos)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "Niveles inferiores (para valores numéricos)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "Coincidencia de cadenas"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr "Cómo convertir un valor de cadena en un estado de servicio de Checkmk."

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "El valor debe coincidir con una expresión regular"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "Valor esperado (regex)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Para valores de cadena: el valor debe coincidir por completo con esta "
"expresión regular (p. ej. 'UP|ok')."

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "Estado cuando el valor no coincide"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Asignar el valor a un estado (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Para valores de cadena con varios estados conocidos: cada patrón es una "
"expresión regular que se compara con el valor completo. Se prueban en el "
"orden OK, WARN, CRIT y gana la primera coincidencia."

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "OK cuando el valor coincide (regex)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "WARN cuando el valor coincide (regex)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "CRIT cuando el valor coincide (regex)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "Estado cuando no coincide nada"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:80
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "Expresión aritmética no válida: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:85
msgid ""
"Only the variable 'value', numbers, parentheses and + - * / are allowed."
msgstr "Solo se permiten la variable 'value', números, paréntesis y + - * /."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:89
#, python-format
msgid "Unknown variable '%s' - only 'value' is available."
msgstr "Variable desconocida '%s' - solo 'value' está disponible."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:94
msgid "Only numeric constants are allowed."
msgstr "Solo se permiten constantes numéricas."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:114
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Cada URL de endpoint debe ser única. Duplicada: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:123
#, python-format
msgid "Each endpoint name must be unique. Duplicated: %s"
msgstr "Cada nombre de endpoint debe ser único. Duplicado: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:133
msgid "The URL must not contain whitespace."
msgstr "La URL no debe contener espacios en blanco."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:137
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Introduzca una URL http(s) válida, p. ej. 'https://host/ruta'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:143
msgid "Authentication"
msgstr "Autenticación"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:148
msgid "Basic authentication (username / password)"
msgstr "Autenticación básica (nombre de usuario / contraseña)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:154
msgid "Username"
msgstr "Nombre de usuario"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:161
msgid "Password"
msgstr "Contraseña"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:170
msgid "Bearer token"
msgstr "Token Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:176
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:177
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Se envía como 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:217
msgid "Field to monitor"
msgstr "Campo a monitorizar"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:223
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:99
msgid "Service name"
msgstr "Nombre del servicio"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:224
msgid "Becomes the Checkmk service description for this field."
msgstr ""
"Se convierte en la descripción del servicio de Checkmk para este campo."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:231
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:287
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:739
msgid "JSON path"
msgstr "Ruta JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:233
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\"."
msgstr ""
"Ruta con puntos dentro de la respuesta JSON, p. ej. 'status', 'components.db."
"status' o 'items[0].count'. Utilice un comodín '[*]' (p. ej. 'nodes[*]."
"health') para crear un servicio por cada elemento del array - o, cuando el "
"comodín recae sobre un objeto JSON (un mapa indexado por nombre, como un '/"
"health' de Spring Boot Actuator 'components[*].status'), un servicio por "
"clave. Varios comodines '[*]' (p. ej. 'pods[*].containers[*].ready') "
"expanden el producto cartesiano, un servicio por cada combinación. El "
"prefijo '$.' es opcional. Las claves que contienen '.' o '[' se pueden "
"indicar mediante segmentos entre corchetes y comillas, p. ej. \"data['foo."
"bar'].value\"."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:253
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "Sufijo de nombre por elemento (para comodines '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:255
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"Cuando la ruta JSON contiene un comodín '[*]', se crea un servicio por cada "
"elemento. Esta ruta opcional -relativa a cada elemento, p. ej. 'name' o "
"'id'- se añade al nombre del servicio para distinguir esos servicios. NO "
"reemplaza el nombre del servicio. Por defecto se utiliza el índice del array "
"(o, para un objeto, la clave). Con varios comodines '[*]' se resuelve en "
"cada nivel y las partes se unen con ' / ' (p. ej. '<pod> / <container>'). "
"Elija un campo que sea único y estable entre ejecuciones."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:270
msgid "Service labels"
msgstr "Etiquetas de servicio"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:272
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"Adjunta etiquetas de servicio de Checkmk a ESTE servicio, creadas a partir "
"de campos de la respuesta. Cada clave lleva el prefijo 'json_api/'. Para una "
"ruta '[*]' el valor se resuelve dentro de cada elemento (p. ej. 'name'), de "
"modo que cada servicio por elemento obtiene su propia etiqueta; para una "
"ruta sin comodines se resuelve desde la raíz de la respuesta. Los datos de "
"todo el host van en las 'Etiquetas de host' del endpoint. Las etiquetas se "
"establecen durante el descubrimiento, así que elija campos estables y de "
"baja cardinalidad: un valor que cambia hace que la etiqueta cambie "
"constantemente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:289
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"Relativa a cada elemento '[*]' (como el sufijo del nombre), o la raíz de la "
"respuesta para una ruta sin comodines."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:299
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:751
msgid "Label key (optional)"
msgstr "Clave de la etiqueta (opcional)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:301
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"Por defecto, el último segmento de la ruta. El prefijo 'json_api/' se añade "
"automáticamente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:313
msgid "Aggregate a collection into one value"
msgstr "Agregar una colección en un solo valor"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:315
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"Reduce una colección de elementos a un único número en lugar de monitorizar "
"un solo valor (o, con un comodín '[*]', un servicio por elemento). Apunta la "
"ruta JSON a un array / objeto (p. ej. 'jobs') o a un comodín '[*]' sobre los "
"valores a agregar (p. ej. 'nodes[*].load'). 'Número de elementos' solo los "
"cuenta; las demás funciones necesitan valores numéricos. El resultado es un "
"número, por lo que la unidad, los niveles, la transformación y la métrica se "
"aplican a él. Combínalo con la condición de abajo para agregar solo los "
"elementos coincidentes. Una ruta que no contiene ni un array ni un objeto "
"deja el servicio en UNKNOWN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:328
msgid "Number of elements"
msgstr "Número de elementos"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:329
msgid "Sum of the values"
msgstr "Suma de los valores"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:330
msgid "Average of the values"
msgstr "Promedio de los valores"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:331
msgid "Smallest of the values"
msgstr "El menor de los valores"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:332
msgid "Largest of the values"
msgstr "El mayor de los valores"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:340
msgid "Only elements matching a condition"
msgstr "Solo elementos que cumplen una condición"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:342
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"Para un comodín '[*]' o una ruta agregada: conservar solo los elementos cuyo "
"subcampo cumple esta condición, p. ej. un servicio por nodo cuyo 'status' no "
"es 'ok', o contar solo los pods que no están 'Running'. La ruta del campo se "
"resuelve dentro de cada elemento; un elemento cuyo campo falta o no es un "
"escalar se descarta. Sin un comodín '[*]' ni una agregación esto no tiene "
"efecto."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:354
msgid "Field path (within each element)"
msgstr "Ruta del campo (dentro de cada elemento)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:356
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr ""
"Se resuelve dentro de cada elemento, p. ej. 'status' o 'metadata.phase'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:365
msgid "Condition"
msgstr "Condición"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:367
msgid "equals"
msgstr "es igual a"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:368
msgid "does not equal"
msgstr "no es igual a"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:369
msgid "matches regex"
msgstr "coincide con regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:370
msgid "does not match regex"
msgstr "no coincide con regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:378
msgid "Comparison value / pattern"
msgstr "Valor de comparación / patrón"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:380
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr ""
"El valor con el que comparar, o la expresión regular para las condiciones "
"regex."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:391
msgid "Interpret the value as"
msgstr "Interpretar el valor como"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:393
msgid ""
"By default the extracted value is monitored as it stands. Two common API "
"values are worth deriving something else from: a counter that only ever "
"grows (its rate of change is what matters, not the total), and a timestamp "
"(its age is what matters, not the date). The derived number is what the "
"transform, the levels, the metric and the summary then use."
msgstr ""
"De forma predeterminada, el valor extraído se monitoriza tal cual. En dos "
"valores de API habituales conviene derivar otra cosa: un contador que solo "
"crece (lo que importa es su tasa de cambio, no el total) y una marca de "
"tiempo (lo que importa es su antigüedad, no la fecha). El número derivado es "
"el que utilizan después la transformación, los niveles, la métrica y el "
"resumen."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:405
msgid "A counter - monitor its per-second rate"
msgstr "Un contador: monitorizar su tasa por segundo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:408
msgid "Per-second rate"
msgstr "Tasa por segundo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:410
msgid "The difference to the previous check is divided by the elapsed time"
msgstr ""
"La diferencia con la comprobación anterior se divide por el tiempo "
"transcurrido"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:414
msgid ""
"For monotonically growing counters such as 'requests_total' or 'bytes_sent': "
"the check monitors the change per second instead of the absolute total. The "
"first check after a restart of the counter cannot compute a rate yet and "
"keeps the service's previous state."
msgstr ""
"Para contadores monótonamente crecientes como 'requests_total' o "
"'bytes_sent': la comprobación monitoriza el cambio por segundo en lugar del "
"total absoluto. La primera comprobación tras un reinicio del contador aún no "
"puede calcular una tasa y mantiene el estado anterior del servicio."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:425
msgid "A timestamp - monitor its age"
msgstr "Una marca de tiempo: monitorizar su antigüedad"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:428
msgid ""
"For values such as 'last_backup' or 'updated_at': the check monitors the "
"number of seconds since that point in time, so upper levels alert on stale "
"data. A timestamp in the future yields a negative age. The age graphs and "
"reads as a duration on its own; choose a unit below only to override that (e."
"g. after a transform into hours)."
msgstr ""
"Para valores como 'last_backup' o 'updated_at': la comprobación monitoriza "
"el número de segundos transcurridos desde ese momento, de modo que los "
"niveles superiores avisan de datos obsoletos. Una marca de tiempo en el "
"futuro da una antigüedad negativa. La antigüedad se representa y se grafica "
"por sí sola como una duración; elige una unidad abajo solo para sobrescribir "
"eso (p. ej. tras una transformación a horas)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:441
msgid "Timestamp format"
msgstr "Formato de la marca de tiempo"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:443
msgid ""
"'Detect automatically' reads a number as Unix epoch seconds (milliseconds "
"when it is far too large for seconds) and anything else as ISO 8601. A "
"timestamp without a time zone is read as UTC."
msgstr ""
"'Detectar automáticamente' lee un número como segundos de época Unix "
"(milisegundos si es demasiado grande para ser segundos) y cualquier otra "
"cosa como ISO 8601. Una marca de tiempo sin zona horaria se lee como UTC."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:452
msgid "Detect automatically"
msgstr "Detectar automáticamente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:455
msgid "Unix epoch seconds"
msgstr "Segundos de época Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:459
msgid "Unix epoch milliseconds"
msgstr "Milisegundos de época Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:464
msgid "ISO 8601 / RFC 3339, e.g. '2026-07-28T02:00:00Z'"
msgstr "ISO 8601 / RFC 3339, p. ej. '2026-07-28T02:00:00Z'"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:481
msgid "Unit (for numeric values)"
msgstr "Unidad (para valores numéricos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:483
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Muestra la métrica y el gráfico con esta unidad. Déjelo sin definir para un "
"valor simple, sin unidad. Solo afecta a los valores numéricos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:487
msgid "Count (integer)"
msgstr "Recuento (entero)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:488
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Bytes (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:489
msgid "Seconds (duration)"
msgstr "Segundos (duración)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:490
msgid "Percent"
msgstr "Porcentaje"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:492
msgid "No unit"
msgstr "Sin unidad"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:506
msgid "Transform the numeric value"
msgstr "Transformar el valor numérico"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:508
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius)."
msgstr ""
"Una expresión aritmética aplicada a un valor numérico antes de los niveles y "
"la métrica, utilizando la variable 'value'. Solo se permiten números, "
"paréntesis y + - * /. Ejemplos: 'value / 1024 / 1024' (bytes a MiB), 'value "
"* 1000' (segundos a milisegundos), '(value - 32) * 5 / 9' (Fahrenheit a "
"Celsius)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:529
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:107
msgid "Endpoint"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:534
msgid "Endpoint name"
msgstr "Nombre del endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:536
msgid ""
"Optional short name for this endpoint, e.g. 'frontend'. It names the "
"endpoint's own service - 'JSON API <name>', which reports the HTTP status "
"and the response time of the request. Without a name the URL is used. It "
"does not change the field service names."
msgstr ""
"Nombre corto opcional para este endpoint, p. ej. 'frontend'. Da nombre al "
"servicio propio del endpoint, 'JSON API <nombre>', que informa del estado "
"HTTP y del tiempo de respuesta de la petición. Sin nombre se usa la URL. No "
"cambia los nombres de los servicios de los campos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:548
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:550
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL completa del endpoint JSON, incluido el esquema, p. ej. 'https://app."
"example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:559
msgid "HTTP method"
msgstr "Método HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:561
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:562
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:570
msgid "Request body (for POST)"
msgstr "Cuerpo de la petición (para POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:576
msgid "Additional request headers"
msgstr "Cabeceras adicionales de la petición"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:581
msgid "Header name"
msgstr "Nombre de la cabecera"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:585
msgid "Header value"
msgstr "Valor de la cabecera"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:598
msgid "Verify the TLS certificate"
msgstr "Verificar el certificado TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:599
msgid "Disabling certificate verification is insecure."
msgstr "Deshabilitar la verificación del certificado es inseguro."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:606
msgid "Custom CA bundle file"
msgstr "Archivo de paquete de CA personalizado"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:608
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"Ruta en el servidor de Checkmk a un archivo PEM con el/los certificado(s) de "
"CA para verificar el certificado del servidor. Úselo para confiar en una CA "
"interna o privada sin desactivar la verificación. Se ignora cuando la "
"verificación TLS está desactivada."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:619
msgid "Client certificate (mutual TLS)"
msgstr "Certificado de cliente (TLS mutuo)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:621
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"Presente un certificado de cliente al servidor (TLS mutuo). Los archivos "
"deben existir en el servidor de Checkmk. La clave privada debe estar sin "
"cifrar."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:629
msgid "Client certificate file"
msgstr "Archivo de certificado de cliente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:631
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"Ruta al certificado de cliente (PEM). Si el archivo también contiene la "
"clave privada, deje vacío el campo de la clave."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:641
msgid "Private key file"
msgstr "Archivo de clave privada"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:643
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr ""
"Ruta a la clave privada del cliente (PEM), si no está incluida en el "
"certificado."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:655
msgid "Follow HTTP redirects"
msgstr "Seguir las redirecciones HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:657
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Activado por defecto. Deshabilítelo en entornos restringidos para reforzar "
"la protección contra SSRF: un destino que redirige (p. ej. 3xx a una "
"dirección interna) fallará en lugar de seguirse hasta la ubicación de la "
"redirección."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:668
msgid "Request timeout (seconds)"
msgstr "Tiempo de espera de la petición (segundos)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:669
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Tiempo de espera por petición. Por defecto, 30 segundos."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:677
msgid "Additional accepted HTTP status codes"
msgstr "Códigos de estado HTTP adicionales aceptados"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:679
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"De forma predeterminada solo se leen las respuestas 2xx; cualquier otro "
"estado deja los servicios del endpoint en UNKNOWN. Añada aquí códigos de "
"estado adicionales a aceptar; por ejemplo, 503 para un endpoint de salud que "
"informa de sus problemas con un 503 y un cuerpo JSON. El cuerpo de una "
"respuesta aceptada se analiza y se extrae como de costumbre. 2xx siempre se "
"acepta."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:687
msgid "Status code"
msgstr "Código de estado"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:695
msgid "HTTP proxy"
msgstr "Proxy HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:697
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"Enrute la petición de este endpoint a través de un proxy HTTP; resulta útil "
"cuando el servidor de Checkmk solo alcanza la API mediante un proxy de "
"salida corporativo. Elija las variables de entorno HTTP_PROXY / HTTPS_PROXY, "
"una URL de proxy explícita o 'sin proxy' para omitir cualquier proxy "
"definido en el entorno. Sin este ajuste se respetan las variables de proxy "
"del entorno."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:711
msgid "Fields to monitor"
msgstr "Campos a monitorizar"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:713
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Cada entrada se convierte en un servicio de Checkmk, construido a partir del "
"valor encontrado en la ruta JSON indicada."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:722
msgid "Host labels"
msgstr "Etiquetas de host"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:724
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Set at discovery, so pick stable, low-"
"cardinality fields."
msgstr ""
"Adjunta etiquetas de host de Checkmk al host monitorizado, creadas a partir "
"de campos de la respuesta de este endpoint. Cada clave lleva el prefijo "
"'json_api/' y el valor se resuelve desde la raíz de la respuesta, así que "
"son datos de todo el host (p. ej. un entorno, región o versión) y NO "
"necesitan ningún servicio. Una ruta puede contener un comodín '[*]' (p. ej. "
"'components[*]') para emitir una etiqueta por elemento, con la clave '<key>/"
"<element>' para que las claves sean únicas. Se establecen durante el "
"descubrimiento, así que elija campos estables y de baja cardinalidad."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:741
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element."
msgstr ""
"Desde la raíz de la respuesta, p. ej. 'version', 'cluster.region', o un "
"comodín '[*]' como 'components[*]' para una etiqueta por elemento."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:753
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"Por defecto, el último segmento de la ruta. Para una ruta '[*]' se añade el "
"id del elemento ('<key>/<element>'). El prefijo 'json_api/' se añade "
"automáticamente."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:763
msgid "Value field (for '[*]' wildcards)"
msgstr "Campo de valor (para comodines '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:765
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"Para una ruta '[*]': una ruta dentro de cada elemento para el valor de la "
"etiqueta (p. ej. 'status'). Por defecto 'true' (una etiqueta de "
"pertenencia). Se ignora sin comodín."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:798
msgid "Endpoints"
msgstr "Endpoints"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:800
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Uno o varios endpoints HTTP/JSON. Cada uno se consulta con su propia "
"configuración de conexión y sus propias extracciones; todos los resultados "
"se combinan en una sola sección. Un endpoint que no se puede alcanzar solo "
"afecta a sus propios servicios."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:815
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:96
msgid "Generic JSON API"
msgstr "API JSON genérica"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:66
msgid "Upper levels for the response time"
msgstr "Niveles superiores para el tiempo de respuesta"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:68
msgid ""
"How long the request to this endpoint may take, in seconds. Measured from "
"sending the request to having read the whole response body. Without levels "
"the response time is only recorded as a metric."
msgstr ""
"Cuánto puede tardar la petición a este endpoint, en segundos. Se mide desde "
"el envío de la petición hasta haber leído todo el cuerpo de la respuesta. "
"Sin niveles, el tiempo de respuesta solo se registra como métrica."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:81
msgid "State when the endpoint cannot be read"
msgstr "Estado cuando no se puede leer el endpoint"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:83
msgid ""
"Applies when the request fails outright: connection refused, a TLS error, a "
"timeout, an HTTP status that is not accepted, or a response that is not JSON."
msgstr ""
"Se aplica cuando la petición falla por completo: conexión rechazada, un "
"error TLS, un tiempo de espera agotado, un estado HTTP no aceptado o una "
"respuesta que no es JSON."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:104
msgid "Generic JSON API endpoint"
msgstr "Endpoint de API JSON genérica"

