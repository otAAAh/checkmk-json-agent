#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "無効な正規表現: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "上限レベル (数値の場合)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "下限レベル (数値の場合)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "文字列マッチング"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr "文字列値を Checkmk のサービス状態に変換する方法。"

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "値が正規表現に一致する必要がある"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "期待値 (正規表現)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"文字列値の場合: 値がこの正規表現に完全に一致する必要があります (例: 'UP|"
"ok')。"

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "値が一致しない場合の状態"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "値を状態にマッピングする (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"複数の既知の状態を持つ文字列値の場合: 各パターンは値全体に対して照合される正"
"規表現です。OK、WARN、CRIT の順に試行され、最初に一致したものが優先されます。"

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "値が一致した場合に OK (正規表現)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "値が一致した場合に WARN (正規表現)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "値が一致した場合に CRIT (正規表現)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "何も一致しない場合の状態"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:79
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "無効な算術式: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:84
msgid ""
"Only the variable 'value', numbers, parentheses and + - * / are allowed."
msgstr "変数 'value'、数字、括弧、および + - * / のみが使用できます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:88
#, python-format
msgid "Unknown variable '%s' - only 'value' is available."
msgstr "不明な変数 '%s' - 'value' のみが使用できます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:93
msgid "Only numeric constants are allowed."
msgstr "数値定数のみが使用できます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:109
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "各エンドポイント URL は一意である必要があります。重複: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:119
msgid "The URL must not contain whitespace."
msgstr "URL に空白を含めることはできません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:123
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "有効な http(s) URL を入力してください（例: 'https://host/path'）。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:129
msgid "Authentication"
msgstr "認証"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:134
msgid "Basic authentication (username / password)"
msgstr "基本認証 (ユーザー名 / パスワード)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:140
msgid "Username"
msgstr "ユーザー名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:147
msgid "Password"
msgstr "パスワード"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:156
msgid "Bearer token"
msgstr "Bearer トークン"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:162
msgid "Token"
msgstr "トークン"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:163
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "'Authorization: Bearer <token>' として送信されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:203
msgid "Field to monitor"
msgstr "監視するフィールド"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:209
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:51
msgid "Service name"
msgstr "サービス名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:210
msgid "Becomes the Checkmk service description for this field."
msgstr "このフィールドの Checkmk サービス説明になります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:217
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:273
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:621
msgid "JSON path"
msgstr "JSON パス"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:219
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\"."
msgstr ""
"JSON レスポンスへのドット区切りパス。例: 'status'、'components.db."
"status'、'items[0].count'。'[*]' ワイルドカード (例: 'nodes[*].health') を使"
"うと、配列の要素ごとに 1 つのサービスが作成されます。ワイルドカードが JSON オ"
"ブジェクト (名前をキーとするマップ。例: Spring Boot Actuator の '/health' の "
"'components[*].status') に該当する場合は、キーごとに 1 つのサービスが作成され"
"ます。複数の '[*]' ワイルドカード (例: 'pods[*].containers[*].ready') を使う"
"とデカルト積に展開され、組み合わせごとに 1 つのサービスが作成されます。先頭"
"の '$.' は省略可能です。キー自体に '.' または '[' が含まれる場合は、角括弧で"
"囲んだセグメントで指定できます。例: \"data['foo.bar'].value\"。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:239
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "要素ごとの名前のサフィックス ('[*]' ワイルドカード用)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:241
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"JSON パスに '[*]' ワイルドカードが含まれる場合、要素ごとに 1 つのサービスが作"
"成されます。この省略可能なパス (各要素からの相対パス。例: 'name' または "
"'id') は、これらのサービスを区別するためにサービス名に付加されます。サービス"
"名を置き換えることはありません。既定では配列のインデックス (オブジェクトの場"
"合はキー) が使われます。複数の '[*]' ワイルドカードがある場合は各レベルで解決"
"され、各部分は ' / ' で結合されます (例: '<pod> / <container>')。実行間で一意"
"かつ安定したフィールドを選んでください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:256
msgid "Service labels"
msgstr "サービスラベル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:258
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"応答のフィールドから作成した Checkmk サービスラベルをこのサービスに付与しま"
"す。各キーには 'json_api/' の接頭辞が付きます。'[*]' パスの場合、値は各要素内"
"で解決されるため (例: 'name')、要素ごとのサービスがそれぞれ独自のラベルを持ち"
"ます。ワイルドカードのないパスの場合は応答のルートから解決されます。ホスト全"
"体に関する情報は、代わりにエンドポイントの「ホストラベル」に指定してくださ"
"い。ラベルはサービス検出時に設定されるため、安定していてカーディナリティの低"
"いフィールドを選んでください。値が変わるとラベルが頻繁に変化します。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:275
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"各 '[*]' 要素からの相対パス (名前のサフィックスと同様)、またはワイルドカード"
"のないパスの場合は応答のルート。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:285
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:633
msgid "Label key (optional)"
msgstr "ラベルキー (省略可能)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:287
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"既定ではパスの最後のセグメント。接頭辞 'json_api/' は自動的に付加されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:299
msgid "Aggregate a collection into one value"
msgstr "コレクションを 1 つの値に集約する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:301
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"1 つの値を監視する (または '[*]' ワイルドカードで要素ごとに 1 サービスを作"
"る) のではなく、要素のコレクションを 1 つの数値にまとめます。JSON パスは配"
"列 / オブジェクト (例: 'jobs') か、集約対象の値を指す '[*]' ワイルドカード "
"(例: 'nodes[*].load') を指定します。「要素数」は数えるだけですが、他の関数は"
"数値が 必要です。結果は数値なので、単位・レベル・変換・メトリックがすべて適用"
"されます。 下の条件と組み合わせると、一致する要素だけを集約できます。配列でも"
"オブジェクト でもないパスの場合、サービスは UNKNOWN になります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:314
msgid "Number of elements"
msgstr "要素数"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:315
msgid "Sum of the values"
msgstr "値の合計"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:316
msgid "Average of the values"
msgstr "値の平均"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:317
msgid "Smallest of the values"
msgstr "値の最小"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:318
msgid "Largest of the values"
msgstr "値の最大"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:326
msgid "Only elements matching a condition"
msgstr "条件に一致する要素のみ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:328
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"'[*]' ワイルドカードまたは集約されたパスの場合: サブフィールドがこの条件に 一"
"致する要素だけを残します。たとえば 'status' が 'ok' でないノードごとに 1 サー"
"ビス、または 'Running' でない Pod だけを数える、といった用途です。フィールド "
"パスは各要素の内部で解決され、フィールドが存在しない要素やスカラーでない要素"
"は 除外されます。'[*]' ワイルドカードも集約もない場合、これは効果がありませ"
"ん。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:340
msgid "Field path (within each element)"
msgstr "フィールドパス（各要素内）"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:342
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr "各要素内で解決されます。例: 'status' や 'metadata.phase'。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:351
msgid "Condition"
msgstr "条件"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:353
msgid "equals"
msgstr "等しい"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:354
msgid "does not equal"
msgstr "等しくない"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:355
msgid "matches regex"
msgstr "正規表現に一致"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:356
msgid "does not match regex"
msgstr "正規表現に一致しない"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:364
msgid "Comparison value / pattern"
msgstr "比較値 / パターン"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:366
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr "比較対象の値、または正規表現条件で使用する正規表現。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:377
msgid "Unit (for numeric values)"
msgstr "単位 (数値の場合)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:379
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"この単位でメトリックとグラフを表示します。単位のないプレーンな値の場合は未設"
"定のままにします。数値にのみ影響します。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:383
msgid "Count (integer)"
msgstr "カウント (整数)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:384
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "バイト (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:385
msgid "Seconds (duration)"
msgstr "秒 (期間)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:386
msgid "Percent"
msgstr "パーセント"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:388
msgid "No unit"
msgstr "単位なし"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:402
msgid "Transform the numeric value"
msgstr "数値を変換する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:404
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius)."
msgstr ""
"レベルとメトリックの前に数値に適用される算術式で、変数 'value' を使用します。"
"数字、括弧、および + - * / のみが使用できます。例: 'value / 1024 / 1024' (バ"
"イトから MiB へ)、'value * 1000' (秒からミリ秒へ)、'(value - 32) * 5 / 9' (華"
"氏から摂氏へ)。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:425
msgid "Endpoint"
msgstr "エンドポイント"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:430
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:432
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"スキームを含む JSON エンドポイントの完全な URL。例: 'https://app.example.com/"
"actuator/health'。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:441
msgid "HTTP method"
msgstr "HTTP メソッド"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:443
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:444
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:452
msgid "Request body (for POST)"
msgstr "リクエストボディ (POST の場合)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:458
msgid "Additional request headers"
msgstr "追加のリクエストヘッダー"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:463
msgid "Header name"
msgstr "ヘッダー名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:467
msgid "Header value"
msgstr "ヘッダー値"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:480
msgid "Verify the TLS certificate"
msgstr "TLS 証明書を検証する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:481
msgid "Disabling certificate verification is insecure."
msgstr "証明書の検証を無効にすると安全ではありません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:488
msgid "Custom CA bundle file"
msgstr "カスタム CA バンドルファイル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:490
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"サーバー証明書の検証に使用する CA 証明書を含む PEM ファイルの、Checkmk サー"
"バー上のパスです。検証を無効にすることなく、社内 CA やプライベート CA を信頼"
"するために使用します。TLS 証明書の検証が無効の場合は無視されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:501
msgid "Client certificate (mutual TLS)"
msgstr "クライアント証明書（相互 TLS）"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:503
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"サーバーにクライアント証明書を提示します（相互 TLS）。ファイルは Checkmk サー"
"バー上に存在する必要があります。秘密鍵は暗号化されていない必要があります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:511
msgid "Client certificate file"
msgstr "クライアント証明書ファイル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:513
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"クライアント証明書（PEM）へのパス。ファイルに秘密鍵も含まれている場合は、鍵"
"フィールドは空のままにします。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:523
msgid "Private key file"
msgstr "秘密鍵ファイル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:525
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr "証明書に含まれていない場合の、クライアント秘密鍵（PEM）へのパス。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:537
msgid "Follow HTTP redirects"
msgstr "HTTP リダイレクトに従う"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:539
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"既定で有効です。SSRF に対して堅牢にするため、制限された環境では無効にしてくだ"
"さい。リダイレクトを行うターゲット (例: 内部アドレスへの 3xx) は、リダイレク"
"ト先に追従されずに失敗するようになります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:550
msgid "Request timeout (seconds)"
msgstr "リクエストのタイムアウト (秒)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:551
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "リクエストごとのタイムアウト。既定は 30 秒です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:559
msgid "Additional accepted HTTP status codes"
msgstr "追加で許可する HTTP ステータスコード"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:561
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"デフォルトでは 2xx 応答のみが読み取られ、それ以外のステータスではエンドポイン"
"トのサービスが UNKNOWN になります。ここに追加で許可するステータスコードを指定"
"します。たとえば、問題を 503 と JSON 本文で報告するヘルスエンドポイントには "
"503 を指定します。許可された応答の本文は通常どおり解析・抽出されます。2xx は"
"常に許可されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:569
msgid "Status code"
msgstr "ステータスコード"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:577
msgid "HTTP proxy"
msgstr "HTTP プロキシ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:579
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"このエンドポイントのリクエストを HTTP プロキシ経由でルーティングします。"
"Checkmk サーバーが企業の送信プロキシ経由でしか API に到達できない場合に便利で"
"す。環境変数 HTTP_PROXY / HTTPS_PROXY、明示的なプロキシ URL、または環境で設定"
"されたプロキシを回避する「プロキシなし」から選択します。この設定がない場合"
"は、環境のプロキシ変数が使用されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:593
msgid "Fields to monitor"
msgstr "監視するフィールド"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:595
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"各エントリは、指定した JSON パスで見つかった値から構築される 1 つの Checkmk "
"サービスになります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:604
msgid "Host labels"
msgstr "ホストラベル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:606
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Set at discovery, so pick stable, low-"
"cardinality fields."
msgstr ""
"このエンドポイントの応答のフィールドから作成した Checkmk ホストラベルを監視対"
"象ホストに付与します。各キーには 'json_api/' の接頭辞が付き、値は応答のルート"
"から解決されます。したがって、これらはホスト全体に関する情報 (環境、リージョ"
"ン、バージョンなど) であり、サービスは不要です。パスには '[*]' ワイルドカー"
"ド (例: 'components[*]') を含めることができ、要素ごとに 1 つのラベルを "
"'<key>/<element>' というキーで生成してキーの一意性を保ちます。サービス検出時"
"に設定されるため、安定していてカーディナリティの低いフィールドを選んでくださ"
"い。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:623
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element."
msgstr ""
"応答のルートから。例: 'version'、'cluster.region'、または要素ごとに 1 つのラ"
"ベルを付ける 'components[*]' のような '[*]' ワイルドカード。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:635
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"既定ではパスの最後のセグメント。'[*]' パスの場合は要素 ID が付加されます "
"('<key>/<element>')。接頭辞 'json_api/' は自動的に付加されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:645
msgid "Value field (for '[*]' wildcards)"
msgstr "値フィールド ('[*]' ワイルドカード用)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:647
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"'[*]' パスの場合: 各要素内のラベル値へのパス (例: 'status')。既定は "
"'true' (所属を示すタグ) です。ワイルドカードがない場合は無視されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:680
msgid "Endpoints"
msgstr "エンドポイント"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:682
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"1 つ以上の HTTP/JSON エンドポイント。各エンドポイントは独自の接続設定と抽出設"
"定で取得され、すべての結果は 1 つのセクションにマージされます。到達できないエ"
"ンドポイントは、それ自身のサービスにのみ影響します。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:697
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:48
msgid "Generic JSON API"
msgstr "汎用 JSON API"

#: cmk_addons/plugins/json_api/graphing/json_api.py:19
msgid "Value"
msgstr "値"

#: cmk_addons/plugins/json_api/graphing/json_api.py:26
msgid "Count"
msgstr "カウント"

#: cmk_addons/plugins/json_api/graphing/json_api.py:33
msgid "Size"
msgstr "サイズ"

#: cmk_addons/plugins/json_api/graphing/json_api.py:40
msgid "Duration"
msgstr "期間"

#: cmk_addons/plugins/json_api/graphing/json_api.py:47
msgid "Percentage"
msgstr "割合"

