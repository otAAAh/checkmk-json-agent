#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "無効な正規表現: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "上限レベル (数値の場合)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "下限レベル (数値の場合)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "文字列マッチング"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr "文字列値を Checkmk のサービス状態に変換する方法。"

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "値が正規表現に一致する必要がある"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "期待値 (正規表現)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"文字列値の場合: 値がこの正規表現に完全に一致する必要があります (例: 'UP|"
"ok')。"

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "値が一致しない場合の状態"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "値を状態にマッピングする (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"複数の既知の状態を持つ文字列値の場合: 各パターンは値全体に対して照合される正"
"規表現です。OK、WARN、CRIT の順に試行され、最初に一致したものが優先されます。"

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "値が一致した場合に OK (正規表現)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "値が一致した場合に WARN (正規表現)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "値が一致した場合に CRIT (正規表現)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "何も一致しない場合の状態"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:82
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "無効な算術式: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:88
msgid ""
"Only the variables 'value' and 'other', numbers, parentheses and + - * / are "
"allowed."
msgstr ""
"使用できるのは変数 'value' と 'other'、数値、括弧、および + - * / のみです。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:94
#, python-format
msgid "Unknown variable '%s' - only 'value' and 'other' are available."
msgstr "不明な変数 '%s' - 'value' と 'other' のみが使用できます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:99
msgid "Only numeric constants are allowed."
msgstr "数値定数のみが使用できます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:143
msgid ""
"A metric name must consist of letters, digits and underscores only, and "
"start with a letter or a digit."
msgstr ""
"メトリック名に使用できるのは英数字とアンダースコアのみで、先頭は英字または数"
"字でなければなりません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:150
#, python-format
msgid ""
"'%s' is one of this plugin's own metrics. A field given that name inherits "
"its unit, colour and Perf-O-Meter, which is almost never what is meant - a "
"percentage named 'json_api_bytes' is rendered as bytes. Choose a name of "
"your own, or leave this empty to get the right one automatically."
msgstr ""
"'%s' はこのプラグイン自身のメトリックの 1 つです。この名前を付けたフィールド"
"はそのメトリックの単位、色、Perf-O-Meter を引き継ぎます。これが意図どおりであ"
"ることはほとんどなく、'json_api_bytes' という名前のパーセント値はバイトとして"
"表示されます。独自の名前を選ぶか、空のままにして自動的に正しい名前を使ってく"
"ださい。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:254
#, python-format
msgid ""
"The fields %s of the shared service '%s' would all be recorded as the metric "
"'%s'. Give them names that differ by more than punctuation, or set 'Metric "
"name' on all but one."
msgstr ""
"フィールド %s は、共有サービス '%s' において、いずれもメトリック '%s' として"
"記録されてしまいます。句読点以外でも異なる名前を付けるか、1 つを除くすべてに"
"「メトリック名」を設定してください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:280
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "各エンドポイント URL は一意である必要があります。重複: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:289
#, python-format
msgid "Each endpoint name must be unique. Duplicated: %s"
msgstr "各エンドポイント名は一意である必要があります。重複: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:299
msgid "The URL must not contain whitespace."
msgstr "URL に空白を含めることはできません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:303
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "有効な http(s) URL を入力してください（例: 'https://host/path'）。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:319
msgid "Enter a valid HTTP header name, e.g. 'X-API-Key'."
msgstr "有効な HTTP ヘッダー名を入力してください (例: 'X-API-Key')。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:328
msgid "Enter a valid query parameter name, e.g. 'api_key'."
msgstr "有効なクエリパラメーター名を入力してください (例: 'api_key')。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:346
msgid ""
"The collection to merge must name the collection itself, without a '[*]' "
"wildcard - e.g. 'data.items' rather than 'data.items[*]'."
msgstr ""
"マージするコレクションは、'[*]' ワイルドカードを付けずにコレクション自体を指"
"定してください。たとえば 'data.items[*]' ではなく 'data.items' です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:357
msgid "The path to the next page's URL must not contain a '[*]' wildcard."
msgstr ""
"次のページの URL へのパスに '[*]' ワイルドカードを含めることはできません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:374
msgid ""
"A page size parameter needs a page size to send. Set 'Page size', or remove "
"the parameter."
msgstr ""
"ページサイズのパラメーターには送信するページサイズが必要です。'ページサイズ' "
"を設定するか、パラメーターを削除してください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:380
msgid "The position and the page size need two different parameters."
msgstr "位置とページサイズには別々のパラメーターが必要です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:385
msgid "The path to the total must not contain a '[*]' wildcard."
msgstr "合計へのパスに '[*]' ワイルドカードを含めることはできません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:401
msgid "Query parameter"
msgstr "クエリパラメーター"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:403
msgid ""
"The name the API reads the position from, e.g. 'page', 'p', 'offset' or "
"'skip'. A misspelt name is recognised by the API answering the same page "
"again, which stops pagination and is reported on the endpoint's own service."
msgstr ""
"API が位置を読み取るパラメーター名 (例: 'page'、'p'、'offset'、'skip')。名前"
"の綴りが間違っていると API が同じページを再び返すため検出され、ページングは停"
"止し、エンドポイント自身のサービスで報告されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:416
msgid "Page size"
msgstr "ページサイズ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:418
msgid ""
"How many elements a full page carries. A page with fewer - and fewer than a "
"page before it, since an API may cap the size it is asked for - is the last "
"one, which saves the request for the empty page after it. Leave it unset "
"where the API decides and does not say: then an empty page is what ends "
"pagination."
msgstr ""
"満杯のページに含まれる要素数。これより少なく、かつそれ以前のページよりも少な"
"いページが最後のページとなり (API は要求されたサイズに上限を設けることがある"
"ため)、その後の空ページへのリクエストを省けます。API が決めていて明示しない場"
"合は未設定のままにしてください。その場合は空のページでページングが終わりま"
"す。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:432
msgid "Send the page size as"
msgstr "ページサイズを送るパラメーター"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:434
msgid ""
"The query parameter that asks the API for that page size, e.g. 'limit', "
"'per_page' or 'size'. Sent on every page, the first one included."
msgstr ""
"API にそのページサイズを要求するクエリパラメーター (例: "
"'limit'、'per_page'、'size')。最初のページを含むすべてのページで送信されま"
"す。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:445
msgid "JSON path to the total number of elements"
msgstr "要素の総数への JSON パス"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:447
msgid ""
"Where the API states how many elements the whole collection holds, e.g. "
"'total' or 'meta.total_count'. Once that many have been read, pagination "
"ends without asking for another page. A value that is absent or not a number "
"is ignored."
msgstr ""
"コレクション全体の要素数を API が示す場所 (例: 'total'、'meta.total_count')。"
"その数を読み終えると、次のページを要求せずにページングが終わります。値がない"
"場合や数値でない場合は無視されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:471
msgid ""
"Prefixing the field service names needs an endpoint name. Set 'Endpoint "
"name', or turn the prefix off."
msgstr ""
"フィールドのサービス名に接頭辞を付けるには、エンドポイント名が必要です。「エ"
"ンドポイント名」を設定するか、接頭辞を無効にしてください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:495
#, python-format
msgid ""
"The header '%s' carries the API key and must not also be set under "
"'Additional request headers'."
msgstr ""
"ヘッダー '%s' は API キーを運ぶため、'追加のリクエストヘッダー' にも設定する"
"ことはできません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:555
msgid ""
"'element' is the column the table rows of a '[*]' wildcard are keyed by, so "
"it cannot also name a column. Choose another attribute name."
msgstr ""
"'element' は '[*]' ワイルドカードのテーブル行をキーとして識別する列なので、列"
"名としては使えません。別の属性名を選んでください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:563
msgid ""
"A field written to the inventory creates no service, so it cannot report "
"into a shared one. Tick 'Also create a service for this field', or clear "
"'Report in a shared service named'."
msgstr ""
"インベントリに書き込まれるフィールドはサービスを作成しないため、共有サービス"
"に報告することはできません。「このフィールドのサービスも作成する」にチェック"
"を入れるか、「共有サービスに報告する (名前)」を空にしてください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:576
msgid ""
"'Labels for the created host' needs 'Create one host per element, named by "
"this field' - without it the element stays a service on this host and there "
"is no host to label."
msgstr ""
"「作成されたホストのラベル」には「要素ごとに 1 つのホストを作成し、このフィー"
"ルドで名前を付ける」が必要です。それがないと要素はこのホスト上のサービスのま"
"まで、ラベルを付けるホストが存在しません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:595
msgid ""
"A counter is read as a rate per second, and this unit is not one that is "
"counted - it is already a rate, or a measurement such as a temperature. "
"Choose 'Count', 'Bytes', 'Seconds', 'Percent' or no unit, or read the value "
"as it stands."
msgstr ""
"カウンターは毎秒のレートとして読み取られますが、この単位は数えるための単位で"
"はありません。すでにレートであるか、温度のような測定値です。「カウント」「バ"
"イト」「秒」「パーセント」または単位なしを選択するか、値をそのまま読み取って"
"ください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:607
msgid ""
"The transform uses 'other', so 'Second path for the transform' must be set "
"to say where that value comes from."
msgstr ""
"変換が 'other' を使用しているため、その値の取得元を示す '変換用の 2 つ目のパ"
"ス' を設定する必要があります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:614
msgid ""
"'Second path for the transform' is only used through the variable 'other' - "
"add it to the transform (e.g. 'value / other * 100') or clear the path."
msgstr ""
"'変換用の 2 つ目のパス' は変数 'other' を通じてのみ使用されます。変換に "
"'other' を追加する (例: 'value / other * 100') か、パスを空にしてください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:633
msgid ""
"Without a 'JSON path' the label is described by the rule alone, so both a "
"'Label key' and a literal 'Label value' are needed."
msgstr ""
"'JSON パス' がない場合、ラベルはルールだけで記述されるため、'ラベルキー' とリ"
"テラルの 'ラベル値' の両方が必要です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:645
msgid ""
"Set either a literal 'Label value' or a 'Value field' to read it from, not "
"both."
msgstr ""
"リテラルの 'ラベル値' か、値を読み取る '値フィールド' のどちらか一方を設定し"
"てください (両方は指定できません)。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:663
msgid "Give at least one end of the range, or leave the range unset."
msgstr ""
"範囲の少なくとも一方の端を指定するか、範囲を未設定のままにしてください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:667
msgid "The lowest value must be smaller than the highest value."
msgstr "最小値は最大値より小さくなければなりません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:680
#, python-brace-format
msgid ""
"Use '{path}' to insert a field, e.g. '{message} (leader {leader})'. Braces "
"must be paired and cannot be nested or empty."
msgstr ""
"フィールドを挿入するには '{path}' と書きます (例: '{message} (leader "
"{leader})')。波かっこは対にする必要があり、入れ子や空にすることはできません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:701
msgid ""
"Enter a dotted inventory path of at least two segments, using lower-case "
"letters, digits and '_' - e.g. 'software.applications.json_api'."
msgstr ""
"ドットで区切られた 2 セグメント以上のインベントリパスを、小文字・数字・'_' で"
"入力してください (例: 'software.applications.json_api')。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:708
msgid ""
"The inventory path must start with 'hardware', 'software' or 'networking'."
msgstr ""
"インベントリパスは 'hardware'、'software'、'networking' のいずれかで始まる必"
"要があります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:716
msgid ""
"Use lower-case letters, digits and '_' for the attribute name, e.g. "
"'version'."
msgstr "属性名には小文字・数字・'_' を使用してください (例: 'version')。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:723
msgid "Write into the HW/SW inventory"
msgstr "ハードウェア/ソフトウェアインベントリに書き込む"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:725
msgid ""
"Put this field into the host's inventory tree instead of making it a "
"service. Meant for facts rather than states - a version, a build, a region, "
"a licence tier - which are not worth a service that is OK forever, and which "
"the inventory can do something with that services cannot: it is searchable "
"ACROSS hosts ('which hosts still run a version below 4.2?') and keeps a "
"history of its own. For a '[*]' wildcard the elements become one table row "
"each, keyed by an 'element' column holding the element's name. Point this at "
"values that rarely change: every change is recorded in the inventory "
"history, so a counter here grows those files without bound. Inventory runs "
"on its own (slower) schedule, not at every check interval."
msgstr ""
"このフィールドをサービスにするのではなく、ホストのインベントリツリーに書き込"
"みます。状態ではなく事実 (バージョン、ビルド、リージョン、ライセンス階層な"
"ど) を対象としています。こうした値は常時 OK のサービスにする価値がなく、また"
"インベントリにはサービスにはできないことができます。ホストをまたいで検索でき "
"(「バージョン 4.2 未満のホストはどれか?」)、独自の履歴も保持します。'[*]' ワ"
"イルドカードの場合、各要素は、要素名を保持する 'element' 列をキーとするテーブ"
"ル行になります。めったに変化しない値に使ってください。変更はすべてインベント"
"リ履歴に記録されるため、カウンターを指定するとファイルが際限なく増えます。イ"
"ンベントリはチェック間隔ごとではなく、独自の (より長い) スケジュールで実行さ"
"れます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:742
msgid "Inventory tree node"
msgstr "インベントリツリーのノード"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:744
msgid ""
"Dotted path of the node the value is written to, e.g. 'software.applications."
"json_api'. Must start with 'hardware', 'software' or 'networking'."
msgstr ""
"値を書き込むノードのドット区切りパスです (例: 'software.applications."
"json_api')。'hardware'、'software'、'networking' のいずれかで始まる必要があり"
"ます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:755
msgid "Attribute name"
msgstr "属性名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:757
msgid ""
"Name of the attribute (or, for a '[*]' wildcard, the column). Defaults to "
"the JSON path's last segment. For a '[*]' wildcard it cannot be 'element': "
"that is the column the table rows themselves are keyed by."
msgstr ""
"属性の名前です ('[*]' ワイルドカードの場合は列名)。既定では JSON パスの最後の"
"セグメントになります。 '[*]' ワイルドカードの場合、'element' は使えません。"
"テーブル行自体のキーとなる列名です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:768
msgid "Also create a service for this field"
msgstr "このフィールドのサービスも作成する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:770
msgid ""
"Off by default: an inventory field creates NO service, which is the point - "
"it does not consume a service slot or a check interval to report something "
"that changes twice a year. Turn it on for a value you want in the inventory "
"AND want to alert on, e.g. a version you also match against a regex."
msgstr ""
"既定ではオフです。インベントリフィールドはサービスを作成しません。それがこの"
"機能の目的です。年に 2 回しか変わらない値を報告するために、サービス枠やチェッ"
"ク間隔を消費しません。インベントリに入れたうえでアラートも出したい値 (正規表"
"現で照合するバージョンなど) の場合にオンにしてください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:786
msgid "Authentication"
msgstr "認証"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:791
msgid "Basic authentication (username / password)"
msgstr "基本認証 (ユーザー名 / パスワード)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:797
msgid "Username"
msgstr "ユーザー名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:804
msgid "Password"
msgstr "パスワード"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:813
msgid "Bearer token"
msgstr "Bearer トークン"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:819
msgid "Token"
msgstr "トークン"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:820
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "'Authorization: Bearer <token>' として送信されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:829
msgid "OAuth 2.0 (client credentials)"
msgstr "OAuth 2.0 (クライアントクレデンシャル)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:832
msgid ""
"The machine-to-machine OAuth 2.0 grant: the agent exchanges a client ID and "
"secret for a short-lived access token and sends it as 'Authorization: Bearer "
"<token>'. The token is cached until shortly before it expires, so a rule "
"polling every minute does not ask the identity provider every minute. No "
"browser and no user consent are involved - if your API only works with a "
"token obtained by a person logging in, this is not the right mode."
msgstr ""
"マシン間 (machine-to-machine) の OAuth 2.0 グラントです。エージェントはクライ"
"アント ID とシークレットを短期間有効なアクセストークンと交換"
"し、'Authorization: Bearer <token>' として送信します。トークンは有効期限の直"
"前までキャッシュされるため、毎分ポーリングするルールが毎分 ID プロバイダーに"
"問い合わせることはありません。ブラウザーもユーザーの同意も不要です。API が人"
"によるログインで取得したトークンでしか動作しない場合、このモードは適していま"
"せん。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:845
msgid "Token URL"
msgstr "トークン URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:847
msgid ""
"The identity provider's token endpoint, e.g. 'https://login.example.com/"
"oauth2/v2.0/token'. This is NOT the API URL above."
msgstr ""
"ID プロバイダーのトークンエンドポイントです (例: 'https://login.example.com/"
"oauth2/v2.0/token')。上記の API の URL ではありません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:858
msgid "Client ID"
msgstr "クライアント ID"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:865
msgid "Client secret"
msgstr "クライアントシークレット"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:872
msgid "Scope"
msgstr "スコープ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:874
msgid ""
"Space-separated scopes to request, if the provider needs them - e.g. 'api://"
"monitoring/.default'."
msgstr ""
"プロバイダーが必要とする場合に要求するスコープを、スペース区切りで指定します "
"(例: 'api://monitoring/.default')。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:882
msgid "Audience"
msgstr "オーディエンス"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:884
msgid ""
"Sent as the 'audience' parameter. Required by some providers (Auth0, for "
"instance) to say which API the token is for; leave empty otherwise."
msgstr ""
"'audience' パラメーターとして送信されます。トークンがどの API 向けかを示すた"
"めに一部のプロバイダー (Auth0 など) で必要です。それ以外の場合は空のままにし"
"てください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:893
msgid "How to send the client credentials"
msgstr "クライアントクレデンシャルの送信方法"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:895
msgid ""
"RFC 6749 allows both, and providers disagree about which they accept - a "
"wrong choice here shows up as an unhelpful 401 from the token URL. Try the "
"Authorization header first; switch to the request body if the provider "
"rejects it."
msgstr ""
"RFC 6749 は両方を認めていますが、どちらを受け入れるかはプロバイダーによって異"
"なります。ここで選択を誤ると、トークン URL から分かりにくい 401 が返されま"
"す。まず Authorization ヘッダーを試し、プロバイダーが拒否する場合はリクエスト"
"ボディに切り替えてください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:904
msgid "In the Authorization header (HTTP basic)"
msgstr "Authorization ヘッダー内 (HTTP Basic)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:908
msgid "In the request body"
msgstr "リクエストボディ内"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:919
msgid "API key in a request header"
msgstr "リクエストヘッダー内の API キー"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:925
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1720
msgid "Header name"
msgstr "ヘッダー名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:927
msgid ""
"Name of the header carrying the key, e.g. 'X-API-Key', 'apikey' or 'PRIVATE-"
"TOKEN'. For 'Authorization: Bearer <token>' use the bearer token choice "
"instead."
msgstr ""
"キーを運ぶヘッダーの名前です (例: 'X-API-Key'、'apikey'、'PRIVATE-"
"TOKEN')。'Authorization: Bearer <token>' の場合は、代わりに Bearer トークンの"
"選択肢を使用してください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:939
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:978
msgid "API key"
msgstr "API キー"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:941
msgid ""
"Kept in the Checkmk password store. Unlike a key typed into 'Additional "
"request headers' it is never written to the configuration or to the agent's "
"command line in clear text, and it can be rotated in one place."
msgstr ""
"Checkmk のパスワードストアに保管されます。'追加のリクエストヘッダー' に入力し"
"たキーとは異なり、設定やエージェントのコマンドラインに平文で書き込まれること"
"はなく、1 か所でローテーションできます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:955
msgid "API key in a query parameter"
msgstr "クエリパラメーター内の API キー"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:961
msgid "Parameter name"
msgstr "パラメーター名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:963
msgid ""
"Name of the query parameter carrying the key, e.g. 'api_key'. It is appended "
"to the URL for the request only: the key is redacted wherever the agent "
"reports a URL, and it never appears in the service name. Prefer a header "
"where the API offers one - a key in the URL is visible to proxies and server "
"logs along the way."
msgstr ""
"キーを運ぶクエリパラメーターの名前です (例: 'api_key')。リクエストのときにの"
"み URL に付加されます。エージェントが URL を報告する箇所ではキーは伏せ字にな"
"り、サービス名に現れることもありません。API がヘッダーを提供している場合は"
"ヘッダーを推奨します。URL 内のキーは経路上のプロキシやサーバーのログから見え"
"ます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:980
msgid ""
"Kept in the Checkmk password store, so it is not written to the "
"configuration or to the agent's command line in clear text - unlike a key "
"typed into the URL."
msgstr ""
"Checkmk のパスワードストアに保管されるため、URL に入力したキーとは異なり、設"
"定やエージェントのコマンドラインに平文で書き込まれることはありません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1044
msgid "Field path (within each element)"
msgstr "フィールドパス（各要素内）"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1046
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr "各要素内で解決されます。例: 'status' や 'metadata.phase'。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1054
msgid "Condition"
msgstr "条件"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1056
msgid "equals"
msgstr "等しい"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1057
msgid "does not equal"
msgstr "等しくない"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1058
msgid "matches regex"
msgstr "正規表現に一致"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1059
msgid "does not match regex"
msgstr "正規表現に一致しない"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1067
msgid "Comparison value / pattern"
msgstr "比較値 / パターン"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1069
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr "比較対象の値、または正規表現条件で使用する正規表現。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1080
msgid "Field to monitor"
msgstr "監視するフィールド"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1087
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:152
msgid "Service name"
msgstr "サービス名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1089
msgid ""
"Becomes the Checkmk service description for this field - or, where the field "
"reports into a shared service, the name of its line within that service."
msgstr ""
"このフィールドの Checkmk サービス説明になります。フィールドが共有サービスに報"
"告する場合は、そのサービス内の行の名前になります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1099
msgid "Report in a shared service named"
msgstr "共有サービスに報告する (名前)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1101
msgid ""
"By default every field becomes a service of its own. Name a shared service "
"here and this field reports into that one service as a LINE instead, "
"alongside the other fields naming it - so a small API of 'status', "
"'component' and 'timestamp' can be one service rather than three. The "
"service's state is the WORST of its lines, which is how Checkmk aggregates "
"any check, and 'Service name' above then names the line rather than the "
"service. Each line keeps its own levels, string matching and transform from "
"this rule. Two things change, both because one service now holds several "
"fields: a 'Generic JSON API' check-parameters rule cannot describe it and is "
"not applied to it, so thresholds for these fields live here; and each line's "
"metric is named after the line ('json_api_bytes_root_used'), which keeps the "
"history of several fields apart but renders as a plain number rather than in "
"the field's unit. That runtime name also decides which dashboard widgets can "
"use the field: a Graph widget draws whatever the service carries and is "
"unaffected, but Gauge, Single metric and Bar chart are bound to one metric "
"CHOSEN BY NAME, and their dropdown only offers a service's real names once "
"the widget is filtered to a host and a service - set 'Metric name' below to "
"pick the name yourself instead. A field that needs its unit on the graph, or "
"per-service thresholds, is better off with a service of its own."
msgstr ""
"デフォルトでは、各フィールドはそれぞれ独立したサービスになります。ここに共有"
"サービス名を指定すると、このフィールドは独立したサービスではなく、その 1 つの"
"サービスの中の 1 行として報告され、同じ名前を指定した他のフィールドと並びま"
"す。たとえば 'status'、'component'、'timestamp' からなる小さな API は、3 つで"
"はなく 1 つのサービスになります。サービスの状態はその行のうち最も悪いものにな"
"ります。これは Checkmk があらゆるチェックを集約する方法と同じです。その場合、"
"上の「サービス名」はサービスではなく行の名前になります。各行は、このルールで"
"設定した独自のしきい値、文字列照合、変換をそのまま保持します。1 つのサービス"
"が複数のフィールドを含むため、2 点が変わります。1 つは、'Generic JSON API' の"
"チェックパラメーターのルールではこのサービスを記述できず、適用されないことで"
"す。したがってこれらのフィールドのしきい値はここに置きます。もう 1 つは、各行"
"のメトリックが行の名前を冠して命名されることです。これにより複数フィールドの"
"履歴は分離されますが、フィールドの単位ではなく単なる数値として表示されます。"
"この実行時に決まる名前 (例: 'json_api_bytes_root_used') は、どのダッシュボー"
"ド要素がこのフィールドを使えるかも左右します。グラフ要素はサービスが持つもの"
"をそのまま描画するため影響を受けませんが、ゲージ、単一メトリック、棒グラフは"
"名前で選ばれた 1 つのメトリックに結び付けられており、要素をホストとサービスで"
"絞り込むまで、そのドロップダウンにはサービスの実際の名前が出てきません。代わ"
"りに下の「メトリック名」を設定すれば、名前を自分で決められます。グラフで単位"
"が必要なフィールドや、サービスごとのしきい値が必要なフィールドは、独立した"
"サービスのほうが適しています。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1135
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1223
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1301
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2285
msgid "JSON path"
msgstr "JSON パス"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1137
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\". To monitor a RESPONSE HEADER instead of a field of the body, prefix "
"its name with '@header.', e.g. '@header.X-RateLimit-Remaining' for an API "
"quota or '@header.Last-Modified' with 'Interpret the value as' set to a "
"timestamp for the age of the data. Header names are matched case-"
"insensitively and none of the path syntax above applies to them."
msgstr ""
"JSON レスポンスへのドット区切りパス。例: 'status'、'components.db."
"status'、'items[0].count'。'[*]' ワイルドカード (例: 'nodes[*].health') を使"
"うと、配列の要素ごとに 1 つのサービスが作成されます。ワイルドカードが JSON オ"
"ブジェクト (名前をキーとするマップ。例: Spring Boot Actuator の '/health' の "
"'components[*].status') に該当する場合は、キーごとに 1 つのサービスが作成され"
"ます。複数の '[*]' ワイルドカード (例: 'pods[*].containers[*].ready') を使う"
"とデカルト積に展開され、組み合わせごとに 1 つのサービスが作成されます。先頭"
"の '$.' は省略可能です。キー自体に '.' または '[' が含まれる場合は、角括弧で"
"囲んだセグメントで指定できます。例: \"data['foo.bar'].value\"。 本文のフィー"
"ルドではなくレスポンスヘッダーを監視するには、名前の前に '@header.' を付けま"
"す。例えば API の利用枠には '@header.X-RateLimit-Remaining'、データの経過時間"
"には '値の解釈方法' をタイムスタンプに設定した '@header.Last-Modified' を指定"
"します。ヘッダー名は大文字と小文字を区別せずに照合され、上記のパス構文はいず"
"れも適用されません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1163
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "要素ごとの名前のサフィックス ('[*]' ワイルドカード用)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1165
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"JSON パスに '[*]' ワイルドカードが含まれる場合、要素ごとに 1 つのサービスが作"
"成されます。この省略可能なパス (各要素からの相対パス。例: 'name' または "
"'id') は、これらのサービスを区別するためにサービス名に付加されます。サービス"
"名を置き換えることはありません。既定では配列のインデックス (オブジェクトの場"
"合はキー) が使われます。複数の '[*]' ワイルドカードがある場合は各レベルで解決"
"され、各部分は ' / ' で結合されます (例: '<pod> / <container>')。実行間で一意"
"かつ安定したフィールドを選んでください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1180
msgid "Create one host per element, named by this field"
msgstr "要素ごとに 1 つのホストを作成し、このフィールドで名前を付ける"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1182
msgid ""
"When the JSON path contains a '[*]' wildcard, this turns every element into "
"a Checkmk host of its own instead of one more service on this host. Give a "
"path relative to each element that holds the host name, e.g. 'name' or "
"'hostname'. The service then keeps its plain name, because the host already "
"says which element it is. Set the same field on several fields of this "
"endpoint to collect them all on the same hosts. Only characters valid in a "
"Checkmk host name are kept (letters, digits, '-', '_', '.'); anything else "
"becomes '_'. An element whose field is missing keeps its service on this "
"host, so nothing is lost. IMPORTANT: Checkmk holds piggyback data for hosts "
"that do not exist yet - create the hosts (manually or with Dynamic host "
"management) or the data is never monitored."
msgstr ""
"JSON パスに '[*]' ワイルドカードが含まれる場合、各要素はこのホスト上のもう 1 "
"つのサービスではなく、それぞれ独立した Checkmk ホストになります。ホスト名を保"
"持する、各要素からの相対パス (例: 'name' または 'hostname') を指定してくださ"
"い。ホストがどの要素かを示すため、サービスは単純な名前のままになります。この"
"エンドポイントの複数のフィールドに同じフィールドを設定すると、それらをすべて"
"同じホストにまとめられます。Checkmk のホスト名として有効な文字 (英字、数"
"字、'-'、'_'、'.') のみが保持され、それ以外は '_' になります。フィールドが存"
"在しない要素はサービスをこのホストに残すため、失われるものはありません。重"
"要: Checkmk はまだ存在しないホストの piggyback データを保留します。ホストを作"
"成してください (手動または動的ホスト管理で)。作成しない限りデータは監視されま"
"せん。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1203
msgid "Labels for the created host"
msgstr "作成されたホストのラベル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1205
msgid ""
"Checkmk HOST labels for the host each '[*]' element becomes, built from "
"fields within that element - so the 50 hosts a 'nodes[*]' rule creates can "
"carry their own region, role or tier and be targeted by folder rules, views "
"and filters. Needs 'Create one host per element' above; without it the "
"element stays a service on this host and there is nothing to label. Each key "
"is prefixed with 'json_api/'. A label can also be a classification rather "
"than a field: a condition on the element plus a literal value tags only the "
"hosts the condition holds for. These are HOST labels, unlike 'Service "
"labels' below, which describe the individual service."
msgstr ""
"各 '[*]' 要素が変換されるホストに付与される Checkmk のホストラベルで、その要"
"素内のフィールドから作成されます。これにより 'nodes[*]' ルールが作成する 50 "
"台のホストがそれぞれ独自のリージョン、ロール、階層を持ち、フォルダールール、"
"ビュー、フィルターの対象にできます。上の 'このフィールドを名前として要素ごと"
"にホストを作成' が必要です。指定しない場合、要素はこのホスト上のサービスのま"
"まで、ラベルを付ける対象がありません。各キーには 'json_api/' が付加されます。"
"ラベルはフィールドの写しではなく分類にもできます。要素に対する条件とリテラル"
"値を組み合わせると、条件が成り立つホストだけに印が付きます。これは個々のサー"
"ビスを説明する下の 'サービスラベル' とは異なり、ホストラベルです。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1225
msgid ""
"Relative to each '[*]' element, e.g. 'region'. Can be left empty only where "
"a condition and a literal value describe the label on their own."
msgstr ""
"各 '[*]' 要素からの相対パスです (例: 'region')。条件とリテラル値だけでラベル"
"を記述できる場合に限り、空のままにできます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1235
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1313
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2299
msgid "Label key (optional)"
msgstr "ラベルキー (省略可能)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1237
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1315
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"既定ではパスの最後のセグメント。接頭辞 'json_api/' は自動的に付加されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1245
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2324
msgid "Label value (literal)"
msgstr "ラベル値 (リテラル)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1247
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2326
msgid ""
"A value written here instead of read from the response ('yes', "
"'production', ...). With it a '[*]' path produces ONE label for the whole "
"collection rather than one per element, so the key is used exactly as given "
"- no '<key>/<element>' suffix. Combined with the condition below this is the "
"classification case: 'if any element matches, tag the host'."
msgstr ""
"応答から読み取る代わりにここに記入する値です ('yes'、'production' など)。これ"
"を指定すると '[*]' パスは要素ごとではなくコレクション全体に対して 1 つのラベ"
"ルを生成し、キーは指定どおりに使われます ('<key>/<element>' の接尾辞は付きま"
"せん)。下の条件と組み合わせると、'いずれかの要素が一致したらホストに印を付け"
"る' という分類のケースになります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1262
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1354
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2341
msgid "Only elements matching a condition"
msgstr "条件に一致する要素のみ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1264
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2343
msgid ""
"Emit the label only for the elements whose sub-field matches this condition "
"- e.g. 'name' matching '^MyApp' over a 'services[*]' path. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar never matches. Without a '[*]' wildcard the condition is checked "
"once, in the same scope the path is read from, so the label is set only when "
"it holds."
msgstr ""
"サブフィールドがこの条件に一致する要素に対してのみラベルを生成します (例: "
"'services[*]' パスで 'name' が '^MyApp' に一致するもの)。フィールドパスは各要"
"素の内部で解決され、フィールドが存在しない要素やスカラーでない要素は一致しま"
"せん。'[*]' ワイルドカードがない場合、条件はパスを読み取るのと同じスコープで"
"一度だけ評価され、成り立つ場合にのみラベルが設定されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1284
msgid "Service labels"
msgstr "サービスラベル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1286
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"応答のフィールドから作成した Checkmk サービスラベルをこのサービスに付与しま"
"す。各キーには 'json_api/' の接頭辞が付きます。'[*]' パスの場合、値は各要素内"
"で解決されるため (例: 'name')、要素ごとのサービスがそれぞれ独自のラベルを持ち"
"ます。ワイルドカードのないパスの場合は応答のルートから解決されます。ホスト全"
"体に関する情報は、代わりにエンドポイントの「ホストラベル」に指定してくださ"
"い。ラベルはサービス検出時に設定されるため、安定していてカーディナリティの低"
"いフィールドを選んでください。値が変わるとラベルが頻繁に変化します。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1303
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"各 '[*]' 要素からの相対パス (名前のサフィックスと同様)、またはワイルドカード"
"のないパスの場合は応答のルート。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1327
msgid "Aggregate a collection into one value"
msgstr "コレクションを 1 つの値に集約する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1329
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"1 つの値を監視する (または '[*]' ワイルドカードで要素ごとに 1 サービスを作"
"る) のではなく、要素のコレクションを 1 つの数値にまとめます。JSON パスは配"
"列 / オブジェクト (例: 'jobs') か、集約対象の値を指す '[*]' ワイルドカード "
"(例: 'nodes[*].load') を指定します。「要素数」は数えるだけですが、他の関数は"
"数値が 必要です。結果は数値なので、単位・レベル・変換・メトリックがすべて適用"
"されます。 下の条件と組み合わせると、一致する要素だけを集約できます。配列でも"
"オブジェクト でもないパスの場合、サービスは UNKNOWN になります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1342
msgid "Number of elements"
msgstr "要素数"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1343
msgid "Sum of the values"
msgstr "値の合計"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1344
msgid "Average of the values"
msgstr "値の平均"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1345
msgid "Smallest of the values"
msgstr "値の最小"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1346
msgid "Largest of the values"
msgstr "値の最大"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1356
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"'[*]' ワイルドカードまたは集約されたパスの場合: サブフィールドがこの条件に 一"
"致する要素だけを残します。たとえば 'status' が 'ok' でないノードごとに 1 サー"
"ビス、または 'Running' でない Pod だけを数える、といった用途です。フィールド "
"パスは各要素の内部で解決され、フィールドが存在しない要素やスカラーでない要素"
"は 除外されます。'[*]' ワイルドカードも集約もない場合、これは効果がありませ"
"ん。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1369
msgid "Interpret the value as"
msgstr "値の解釈方法"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1371
msgid ""
"By default the extracted value is monitored as it stands. Two common API "
"values are worth deriving something else from: a counter that only ever "
"grows (its rate of change is what matters, not the total), and a timestamp "
"(its age is what matters, not the date). The derived number is what the "
"transform, the levels, the metric and the summary then use."
msgstr ""
"既定では、抽出した値はそのまま監視されます。API でよくある 2 種類の値について"
"は、別の値を導出したほうが有用です。増加し続けるカウンター (重要なのは合計で"
"はなく変化率) と、タイムスタンプ (重要なのは日付ではなく経過 時間) です。以降"
"の変換・レベル・メトリック・サマリーは、導出された数値を使い ます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1383
msgid "A counter - monitor its per-second rate"
msgstr "カウンター – 1 秒あたりのレートを監視する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1386
msgid "Per-second rate"
msgstr "1 秒あたりのレート"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1388
msgid "The difference to the previous check is divided by the elapsed time"
msgstr "前回のチェックとの差分を経過時間で割ります"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1392
msgid ""
"For monotonically growing counters such as 'requests_total' or 'bytes_sent': "
"the check monitors the change per second instead of the absolute total. The "
"first check after a restart of the counter cannot compute a rate yet and "
"keeps the service's previous state."
msgstr ""
"'requests_total' や 'bytes_sent' のように単調増加するカウンター向けです。 "
"チェックは絶対値の合計ではなく 1 秒あたりの変化を監視します。カウンターが リ"
"セットされた直後の最初のチェックではまだレートを計算できないため、サービスは "
"直前の状態を保ちます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1403
msgid "A timestamp - monitor its age"
msgstr "タイムスタンプ – 経過時間を監視する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1406
msgid ""
"For values such as 'last_backup' or 'updated_at': the check monitors the "
"number of seconds since that point in time, so upper levels alert on stale "
"data. A timestamp in the future yields a negative age. The age graphs and "
"reads as a duration on its own; choose a unit below only to override that (e."
"g. after a transform into hours)."
msgstr ""
"'last_backup' や 'updated_at' のような値向けです。チェックはその時点からの 経"
"過秒数を監視するため、上限レベルで古いデータを検知できます。未来のタイム スタ"
"ンプでは経過時間が負になります。経過時間はそれ自体が期間として表示・ グラフ化"
"されます。下の単位は、それを上書きしたい場合 (例: 時間へ変換した後) にのみ選"
"択してください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1419
msgid "Timestamp format"
msgstr "タイムスタンプの形式"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1421
msgid ""
"'Detect automatically' reads a number as Unix epoch seconds (milliseconds "
"when it is far too large for seconds) and anything else as ISO 8601. A "
"timestamp without a time zone is read as UTC."
msgstr ""
"「自動検出」は、数値を Unix エポック秒 (秒としては大きすぎる場合はミリ秒) と"
"して読み取り、それ以外は ISO 8601 として読み取ります。タイムゾーンのない タイ"
"ムスタンプは UTC として扱われます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1430
msgid "Detect automatically"
msgstr "自動検出"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1433
msgid "Unix epoch seconds"
msgstr "Unix エポック秒"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1437
msgid "Unix epoch milliseconds"
msgstr "Unix エポックミリ秒"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1442
msgid "ISO 8601 / RFC 3339, e.g. '2026-07-28T02:00:00Z'"
msgstr "ISO 8601 / RFC 3339 (例: '2026-07-28T02:00:00Z')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1459
msgid "Unit (for numeric values)"
msgstr "単位 (数値の場合)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1461
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values.<br><br>The value is not converted: "
"levels and the value range are entered in the unit the API reports. For a "
"unit the API does not use as it stands, convert it with the transform - a "
"latency in milliseconds is 'Seconds' with the transform 'value / 1000'."
msgstr ""
"この単位でメトリックとグラフを表示します。単位のないプレーンな値の場合は未設"
"定のままにします。数値にのみ影響します。<br><br>値は変換されません。しきい値"
"と値の範囲は API が返す単位で入力します。API がそのまま使っていない単位は変換"
"式で変換してください。ミリ秒単位のレイテンシーは、変換式 'value / 1000' を指"
"定した「秒」になります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1470
msgid "Count (integer)"
msgstr "カウント (整数)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1471
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "バイト (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1472
msgid "Seconds (duration)"
msgstr "秒 (期間)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1473
msgid "Percent"
msgstr "パーセント"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1475
msgid "Per second (requests, events, ...)"
msgstr "毎秒 (リクエスト、イベントなど)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1478
msgid "Bytes per second (IEC: KiB/s, MiB/s, ...)"
msgstr "毎秒バイト (IEC: KiB/s、MiB/s など)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1481
msgid "Bits per second (SI: kbit/s, Mbit/s, ...)"
msgstr "毎秒ビット (SI: kbit/s、Mbit/s など)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1483
msgid "Degrees Celsius"
msgstr "摂氏度"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1484
msgid "Volts"
msgstr "ボルト"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1485
msgid "Amperes"
msgstr "アンペア"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1486
msgid "Watts"
msgstr "ワット"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1487
msgid "Hertz"
msgstr "ヘルツ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1489
msgid "No unit"
msgstr "単位なし"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1495
msgid "Value range (for graphs and gauges)"
msgstr "値の範囲 (グラフとゲージ用)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1497
msgid ""
"The range this value moves in, when it has one: a battery percentage is 0 to "
"100, a queue with a cap is 0 to that cap. It changes nothing about the state "
"- it tells Checkmk what 'full' means, so the graph keeps a steady scale "
"instead of rescaling to whatever the last hour happened to contain, a gauge "
"dashboard widget has a dial to draw, and the service list's bar is filled "
"against the real maximum. Leave it unset for a value with no natural limit; "
"the bar is then scaled to the critical level instead, where one is "
"configured."
msgstr ""
"この値が動く範囲がある場合に指定します。バッテリーの割合なら 0 から 100、上限"
"のあるキューなら 0 からその上限です。ステータスは変わりません。Checkmk に「満"
"杯」の意味を伝えるもので、グラフは直近 1 時間に含まれていた値に合わせてスケー"
"ルし直すのではなく一定の目盛りを保ち、ゲージのダッシュボード要素は描画する目"
"盛りを得て、サービス一覧のバーは実際の最大値に対して満たされます。自然な上限"
"のない値では未設定のままにしてください。その場合、バーは設定されていれば危険 "
"(CRIT) のしきい値に合わせてスケールされます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1513
msgid "Lowest possible value"
msgstr "取りうる最小値"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1520
msgid "Highest possible value"
msgstr "取りうる最大値"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1530
msgid "Metric name"
msgstr "メトリック名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1532
msgid ""
"The name Checkmk stores this field's metric under. Leave it unset and the "
"plugin picks one: the unit's metric for a field with a service of its own "
"('json_api_bytes'), or that name plus the line's own name for a field in a "
"shared service ('json_api_bytes_root_used'). Set it where you need to KNOW "
"the name in advance - the Gauge, Single metric and Bar chart dashboard "
"widgets are bound to one metric chosen by name, and their dropdown only "
"lists the names a service really has once the widget is filtered to a host "
"and a service. Letters, digits and underscores only, starting with a letter "
"or a digit, and not one of this plugin's own metric names. Two costs: the "
"service loses its Perf-O-Meter, because every bar this plugin draws is "
"declared against one of its own metrics and a name of your own matches none; "
"and changing the name later starts a new history under it, so pick it before "
"the service has data worth keeping. A field that needs its bar is better off "
"keeping the derived name and filtering the widget to a host and a service "
"instead."
msgstr ""
"Checkmk がこのフィールドのメトリックを保存する際の名前です。未設定の場合はプ"
"ラグインが選びます。独立したサービスを持つフィールドでは単位のメトリック "
"('json_api_bytes')、共有サービス内のフィールドではその名前に行の名前を付けた"
"もの ('json_api_bytes_root_used') です。名前を事前に知っておく必要がある場合"
"に設定してください。ダッシュボード要素のゲージ、単一メトリック、棒グラフは名"
"前で選ばれた 1 つのメトリックに結び付けられており、要素をホストとサービスで絞"
"り込むまで、そのドロップダウンにはサービスの実際の名前が表示されません。使用"
"できるのは英数字とアンダースコアのみで、先頭は英字または数字です。また、この"
"プラグイン自身のメトリック名は使えません。代償が 2 つあります。1 つはサービス"
"が Perf-O-Meter を失うことです。このプラグインが描くバーはいずれもプラグイン"
"自身のメトリックに結び付けられているため、独自の名前はどれにも一致しません。"
"もう 1 つは、後から変更すると新しい名前で履歴が作り直されることです。サービス"
"に残したいデータがたまる前に決めてください。バーが必要なフィールドは、導出さ"
"れた名前のままにして、ダッシュボード要素をホストとサービスで絞り込むほうが適"
"しています。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1567
msgid "Transform the numeric value"
msgstr "数値を変換する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1569
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius). A second field can be brought in as 'other' - see below - which is "
"what turns a used/total pair into a percentage: 'value / other * 100'."
msgstr ""
"レベルとメトリックの前に数値に適用される算術式で、変数 'value' を使用します。"
"数字、括弧、および + - * / のみが使用できます。例: 'value / 1024 / 1024' (バ"
"イトから MiB へ)、'value * 1000' (秒からミリ秒へ)、'(value - 32) * 5 / 9' (華"
"氏から摂氏へ)。 2 つ目のフィールドを 'other' として取り込むことができ (下記参"
"照)、これにより使用量/合計の組を割合に変換できます: 'value / other * 100'。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1586
msgid "Second path for the transform ('other')"
msgstr "変換用の 2 つ目のパス ('other')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1588
msgid ""
"A second field, made available to the transform above as the variable "
"'other'. Most APIs report a used/total or current/limit pair rather than a "
"percentage, so this is what lets one service monitor the ratio: point the "
"JSON path at 'used', this at 'total', and use 'value / other * 100' with the "
"unit set to '%'. It is resolved in the SAME scope as the value - within each "
"'[*]' element, or the response root without a wildcard - so every element is "
"compared against its own total. The transform must actually use 'other', and "
"'other' requires this path; either one alone is rejected."
msgstr ""
"上記の変換で変数 'other' として使用できる 2 つ目のフィールドです。多くの API "
"は割合ではなく使用量/合計や現在値/上限の組を返すため、これによって 1 つのサー"
"ビスで比率を監視できます。JSON パスを 'used' に、このフィールドを 'total' に"
"指定し、単位を '%' にして 'value / other * 100' を使用します。値と同じスコー"
"プで解決されます - 各 '[*]' 要素の内部、ワイルドカードがない場合はレスポンス"
"のルート - そのため各要素はそれぞれ自身の合計と比較されます。変換は実際に "
"'other' を使用する必要があり、'other' にはこのパスが必要です。どちらか一方だ"
"けの場合は拒否されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1610
msgid "Extra text in the service summary"
msgstr "サービスサマリーの追加テキスト"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1612
#, python-brace-format
msgid ""
"Appended to the summary, after the value. Write '{path}' to insert another "
"field of the same response - resolved within the current element for a '[*]' "
"wildcard, from the response root otherwise. So a service on 'status' can "
"show the reason the API gave next to it, e.g. '{message} (leader {leader})', "
"instead of needing a second service for it. A path that is not in the "
"response renders as '(n/a)'. This is presentation only: it never changes the "
"state, the levels or the metric. The text is put on one line and truncated "
"if it gets long."
msgstr ""
"値の後ろに続けてサマリーへ追加されます。同じレスポンスの別のフィールドを挿入"
"するには '{path}' と書きます。'[*]' ワイルドカードの場合は現在の要素の中で、"
"そうでない場合はレスポンスのルートから解決されます。そのため 'status' のサー"
"ビスは、API がすでに返している理由をその隣に表示でき (例: '{message} (leader "
"{leader})')、そのために 2 つ目のサービスを用意する必要がありません。レスポン"
"スに存在しないパスは '(n/a)' と表示されます。これは表示だけの機能で、ステータ"
"ス・しきい値・メトリックが変わることはありません。テキストは 1 行にまとめら"
"れ、長い場合は切り詰められます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1637
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:160
msgid "Endpoint"
msgstr "エンドポイント"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1643
msgid "Endpoint name"
msgstr "エンドポイント名"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1645
msgid ""
"Optional short name for this endpoint, e.g. 'frontend'. It names the "
"endpoint's own service - 'JSON API <name>', which reports the HTTP status "
"and the response time of the request. Without a name the URL is used. The "
"field service names keep their plain names unless 'Prefix the field service "
"names' below is enabled."
msgstr ""
"このエンドポイントの短い名前 (省略可、例: 'frontend')。エンドポイント自身の "
"サービス名 'JSON API <名前>' になり、そのサービスはリクエストの HTTP ステータ"
"スと応答時間を報告します。名前を指定しない場合は URL が使われます。下の"
"「フィールドのサービス名にエンドポイント名を接頭辞として付ける」を有効にしな"
"い限り、フィールドのサービス名は変わりません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1658
msgid "Prefix the field service names with the endpoint name"
msgstr "フィールドのサービス名にエンドポイント名を接頭辞として付ける"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1660
msgid ""
"Off by default. Two endpoints extracting the same fields produce two "
"services with the same name - 'JSON Status' twice, the second one "
"disambiguated to 'JSON Status (2)' - and nothing in either name says which "
"application it belongs to. Turn this on and this endpoint's field services "
"are named after it instead: with the endpoint named 'app1-health', 'JSON "
"Status' becomes 'JSON app1-health Status'. Requires an endpoint name. The "
"endpoint's own service follows, from 'JSON API <name>' to 'JSON <name> API', "
"so that it sorts together with the services it describes instead of with "
"every other endpoint's status service. Enabling this RENAMES this endpoint's "
"services: the old ones become stale and the renamed ones have to be "
"discovered, so do it deliberately and re-run a service discovery afterwards."
msgstr ""
"デフォルトでは無効です。同じフィールドを取得する 2 つのエンドポイントは同じ名"
"前のサービスを 2 つ作り、2 つ目は 'JSON Status (2)' として区別されます。どち"
"らの名前もどのアプリケーションのものかを示しません。このオプションを有効にす"
"ると、このエンドポイントのフィールドのサービスはエンドポイント名を冠して命名"
"されます。エンドポイント名が 'app1-health' の場合、'JSON Status' は 'JSON "
"app1-health Status' になります。エンドポイント名が必要です。エンドポイント自"
"身のサービスもこれに合わせて 'JSON API <名前>' から 'JSON <名前> API' に変わ"
"り、他のすべてのエンドポイントのステータスサービスとではなく、それが説明する"
"サービスと並んで表示されます。有効にすると、このエンドポイントのサービス名が"
"変更されます。古いサービスは不要になり、名前が変わったサービスは新たに検出す"
"る必要があるため、意図して有効にし、そのあとサービス検出を実行してください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1682
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1684
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"スキームを含む JSON エンドポイントの完全な URL。例: 'https://app.example.com/"
"actuator/health'。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1693
msgid "HTTP method"
msgstr "HTTP メソッド"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1695
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1696
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1704
msgid "Request body (for POST)"
msgstr "リクエストボディ (POST の場合)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1710
msgid "Additional request headers"
msgstr "追加のリクエストヘッダー"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1712
msgid ""
"Sent with every request to this endpoint. Values are stored in clear text "
"and travel on the agent's command line, so an API key belongs under "
"'Authentication' - not here."
msgstr ""
"このエンドポイントへのすべてのリクエストと共に送信されます。値は平文で保存さ"
"れ、エージェントのコマンドラインにも現れるため、API キーはここではなく '認"
"証' に設定してください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1724
msgid "Header value"
msgstr "ヘッダー値"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1737
msgid "Verify the TLS certificate"
msgstr "TLS 証明書を検証する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1738
msgid "Disabling certificate verification is insecure."
msgstr "証明書の検証を無効にすると安全ではありません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1745
msgid "Custom CA bundle file"
msgstr "カスタム CA バンドルファイル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1747
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"サーバー証明書の検証に使用する CA 証明書を含む PEM ファイルの、Checkmk サー"
"バー上のパスです。検証を無効にすることなく、社内 CA やプライベート CA を信頼"
"するために使用します。TLS 証明書の検証が無効の場合は無視されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1758
msgid "Client certificate (mutual TLS)"
msgstr "クライアント証明書（相互 TLS）"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1760
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"サーバーにクライアント証明書を提示します（相互 TLS）。ファイルは Checkmk サー"
"バー上に存在する必要があります。秘密鍵は暗号化されていない必要があります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1768
msgid "Client certificate file"
msgstr "クライアント証明書ファイル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1770
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"クライアント証明書（PEM）へのパス。ファイルに秘密鍵も含まれている場合は、鍵"
"フィールドは空のままにします。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1780
msgid "Private key file"
msgstr "秘密鍵ファイル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1782
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr "証明書に含まれていない場合の、クライアント秘密鍵（PEM）へのパス。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1794
msgid "Follow HTTP redirects"
msgstr "HTTP リダイレクトに従う"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1796
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"既定で有効です。SSRF に対して堅牢にするため、制限された環境では無効にしてくだ"
"さい。リダイレクトを行うターゲット (例: 内部アドレスへの 3xx) は、リダイレク"
"ト先に追従されずに失敗するようになります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1807
msgid "Request timeout (seconds)"
msgstr "リクエストのタイムアウト (秒)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1808
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "リクエストごとのタイムアウト。既定は 30 秒です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1816
msgid "Re-read at most every (seconds)"
msgstr "再読み込みの最短間隔 (秒)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1818
msgid ""
"Reuse the last response for this endpoint instead of requesting it again, as "
"long as it is younger than this. For APIs with a request quota, expensive "
"endpoints, or a rule shared across many hosts - anything where the request "
"RATE is the problem rather than the freshness of the data. Without it, every "
"check interval on every host issues a request, which can exhaust a quota and "
"turn the monitoring itself into the outage. Only a response that parsed as "
"JSON is cached, and a failing request is never answered from an expired "
"cache - a real outage must not hide behind stale data. While a cached body "
"is served the endpoint's own service says so and reports no response time, "
"because no request was made. Leave unset to always fetch fresh."
msgstr ""
"このエンドポイントの最後の応答が、この値より新しい間は再要求せずに再利用しま"
"す。リクエスト数に上限のある API、コストの高いエンドポイント、多数のホストで"
"共有されるルールなど、データの新しさよりもリクエストの「頻度」が問題になる場"
"合に使用します。設定しない場合、各ホストのチェック間隔ごとにリクエストが発行"
"されるため、上限を使い切って監視自体が障害の原因になることがあります。キャッ"
"シュされるのは JSON として解析できた応答のみで、失敗したリクエストが期限切れ"
"のキャッシュで代替されることはありません。実際の障害が古いデータの陰に隠れて"
"はならないからです。キャッシュされた内容が使われている間は、エンドポイント自"
"身のサービスがそれを示し、リクエストを行っていないため応答時間は報告しませ"
"ん。常に新しく取得するには未設定にしてください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1840
msgid "Retry a failed request"
msgstr "失敗したリクエストを再試行する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1842
msgid ""
"Repeat this endpoint's request when it fails in a way a repeat could fix - a "
"connection error, a timeout, or an HTTP 429 / 5xx - so a load balancer "
"dropping connections for a second during a rolling restart does not become a "
"CRIT and a notification. A 4xx, a body that is not JSON and an oversized "
"response are never retried: repeating them would only burn time. Nothing is "
"hidden - the endpoint's own service reports that a retry was needed, and can "
"be told to go WARN when one is. Every attempt costs wall-clock time inside "
"the check: the worst case is (1 + retries) times the request timeout, plus "
"the waiting time between attempts. Off by default."
msgstr ""
"再試行で解決できる種類の失敗 (接続エラー、タイムアウト、HTTP 429 / 5xx) が起"
"きたときに、このエンドポイントへのリクエストを繰り返します。ローリング再起動"
"中にロードバランサーが 1 秒ほど接続を切っただけで CRIT と通知になる、という事"
"態を防ぎます。4xx、JSON でないボディ、サイズ超過のレスポンスは決して再試行し"
"ません。繰り返しても時間を浪費するだけだからです。何も隠しません。エンドポイ"
"ント自身のサービスが再試行を要したことを報告し、その場合に WARN にすることも"
"できます。試行のたびにチェック内の実時間を消費します。最悪の場合、(1 + 再試行"
"回数) × リクエストタイムアウトに、試行間の待ち時間が加わります。既定ではオフ"
"です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1859
msgid "Number of retries"
msgstr "再試行の回数"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1860
msgid "Extra attempts after the first one failed."
msgstr "最初の試行が失敗した後の追加の試行回数です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1870
msgid "Wait before retrying (seconds)"
msgstr "再試行までの待ち時間 (秒)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1872
msgid ""
"Waiting time before the first retry, doubled for each further one. The total "
"waiting time is capped at 30 seconds however many retries are configured."
msgstr ""
"最初の再試行までの待ち時間で、以降は 1 回ごとに 2 倍になります。設定した再試"
"行回数にかかわらず、待ち時間の合計は 30 秒が上限です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1889
msgid "Additional accepted HTTP status codes"
msgstr "追加で許可する HTTP ステータスコード"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1891
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"デフォルトでは 2xx 応答のみが読み取られ、それ以外のステータスではエンドポイン"
"トのサービスが UNKNOWN になります。ここに追加で許可するステータスコードを指定"
"します。たとえば、問題を 503 と JSON 本文で報告するヘルスエンドポイントには "
"503 を指定します。許可された応答の本文は通常どおり解析・抽出されます。2xx は"
"常に許可されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1899
msgid "Status code"
msgstr "ステータスコード"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1907
msgid "Report the raw response"
msgstr "生のレスポンスを報告する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1909
msgid ""
"Off by default. Put the response itself into the Details of this endpoint's "
"own 'JSON API <name>' service, exactly as it came off the wire. The Details "
"otherwise only link to the URL, which is often not reachable from the "
"browser reading the service (the API may sit behind a firewall or in another "
"network) and always shows the API as it is NOW rather than as it was when "
"the check ran. The body of a REJECTED response is reported too - an "
"unexpected HTTP status or a body that is not JSON - which is the case this "
"exists for: it is where the API explains itself. Credentials are stripped "
"first: 'Set-Cookie' and any authorization header are masked, and the "
"endpoint's own secret is removed wherever it appears. Everything else in the "
"response is reported verbatim, and a service's Details are stored with every "
"check result and travel into notifications - so do not turn this on for a "
"response carrying personal or otherwise sensitive data."
msgstr ""
"デフォルトでは無効です。レスポンスそのものを、このエンドポイント自身のサービ"
"ス 'JSON API <名前>' の詳細に、受信したそのままの形で出力します。詳細には通"
"常 URL へのリンクしかありませんが、その URL はサービスを見ているブラウザーか"
"ら到達できないことが多く (API はファイアウォールの内側や別のネットワークにあ"
"ることがあります)、また 常にチェック実行時ではなく「現在」の API を示します。"
"拒否されたレスポンス (予期しない HTTP ステータス、または JSON でない本文) の"
"本文も報告されます。まさにそのための機能です。API が理由を説明するのはそこだ"
"からです。認証情報は事前に除去されます。'Set-Cookie' と認可ヘッダーはマスクさ"
"れ、エンドポイント自身のシークレットは出現箇所すべてから削除されます。それ以"
"外はそのまま報告されます。サービスの詳細はチェック結果ごとに保存され、通知に"
"も含まれるため、個人情報やその他の機密データを含むレスポンスでは有効にしない"
"でください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1932
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2014
msgid "Report at most (bytes)"
msgstr "報告する最大サイズ (バイト)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1934
msgid ""
"Longer bodies are cut off at this many bytes and the service says so. Keep "
"it small: this text is stored with every check result of this service."
msgstr ""
"これより長い本文はこのバイト数で切り詰められ、サービスがその旨を示します。小"
"さめの値にしてください。このテキストはこのサービスのチェック結果ごとに保存さ"
"れます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1948
msgid "Report the response headers as well"
msgstr "レスポンスヘッダーも報告する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1950
msgid ""
"On by default. The headers are what a rate limit, a cache directive or a "
"content type is announced in, and they are small."
msgstr ""
"デフォルトで有効です。レート制限やキャッシュ指示、コンテンツタイプはヘッダー"
"で通知され、しかもヘッダーは小さいためです。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1963
msgid "Report the JSON context in the field services"
msgstr "フィールドサービスに JSON コンテキストを報告する"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1965
msgid ""
"Off by default. The setting above reports the response on the endpoint's OWN "
"service - but the services that go WARN or CRIT, and therefore the ones that "
"notify, are the field services, and their Details say only which path was "
"read. This puts the JSON itself there too, so the alert carries what the API "
"actually said: a service's Details travel into notifications as "
"$LONGSERVICEOUTPUT$, and the person on call often cannot reach the endpoint "
"at all - wrong network, no credentials - while the endpoint's own service "
"stayed OK and notified nobody. Credentials are stripped exactly as they are "
"for the raw response. Note that this text is stored with every check result "
"of EVERY field service of this endpoint, so keep the byte budget small."
msgstr ""
"既定では無効です。上の設定はエンドポイント自身のサービスに応答を報告します"
"が、WARN や CRIT になって実際に通知するのはフィールドサービスであり、その詳細"
"にはどのパスを読んだかしか表示されません。この設定は JSON 自体もそこに載せる"
"ため、API が実際に何と答えたかがアラートに含まれます。サービスの詳細は "
"$LONGSERVICEOUTPUT$ として通知に届きます。オンコール担当者はネットワークや認"
"証情報の都合でエンドポイントに到達できないことが多く、一方でエンドポイント自"
"身のサービスは OK のままで誰にも通知しません。認証情報は生のレスポンスと同じ"
"ように取り除かれます。このテキストはこのエンドポイントの「すべての」フィール"
"ドサービスのチェック結果ごとに保存されるため、バイト数は小さく保ってくださ"
"い。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1983
msgid "What to report"
msgstr "報告する内容"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1987
msgid "The JSON this value was read from"
msgstr "この値を読み取った JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1991
msgid "The whole response body"
msgstr "レスポンスボディ全体"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1996
msgid ""
"'The JSON this value was read from' is the targeted form: for a '[*]' path "
"that element, otherwise the object holding the value - so the service that "
"alerted shows the element that failed with all its sibling fields, and "
"nothing else. An aggregation has no single element and a '@header.' path is "
"not in the body at all, so both report the whole response. 'The whole "
"response body' always does, repeated on every field service - which is why "
"the cap matters more here than on the endpoint's own service."
msgstr ""
"'この値を読み取った JSON' は的を絞った形式です。'[*]' パスならその要素を、そ"
"うでなければ値を含むオブジェクトを表示するため、アラートを出したサービスには"
"失敗した要素とその兄弟フィールドだけが表示されます。集約には単一の要素がな"
"く、'@header.' パスはそもそもボディにないため、どちらもレスポンス全体を報告し"
"ます。'レスポンスボディ全体' は常に全体を報告し、各フィールドサービスで繰り返"
"されます。上限がエンドポイント自身のサービスよりここで重要なのはそのためで"
"す。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2016
msgid ""
"Longer context is cut off at this many bytes and the service says so. Keep "
"it small: this text is stored with every check result of every field service "
"of this endpoint."
msgstr ""
"これより長いコンテキストはこのバイト数で切り捨てられ、サービスがその旨を示し"
"ます。小さく保ってください: このテキストはこのエンドポイントの各フィールド"
"サービスのチェック結果ごとに保存されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2033
msgid "Follow pagination"
msgstr "ページネーションをたどる"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2036
msgid ""
"Off by default: one request, one page. An API that answers a collection one "
"page at a time then leaves every service built from it describing the FIRST "
"page only - 'count' over a queue that pages at 25 reports 25 however long "
"the queue is, and a '[*]' wildcard creates services for the first page's "
"elements alone. Nothing says so, which is why this is worth configuring: the "
"answer is not missing, it is wrong. With this set the agent follows the "
"API's own next-page link - or, for an API without one, counts the pages "
"itself - and appends each page's collection to the first page's, so the "
"wildcards, the aggregations, the filters and the host labels all see the "
"whole thing. Every page is requested exactly like the first one (same "
"method, headers, authentication and timeout), and each one costs a request "
"inside the check - so cap the pages, and consider a cache TTL for a "
"collection that does not change every check interval. A page that cannot be "
"read fails the endpoint rather than silently truncating the collection; "
"where a further page exists but is not followed - a cap, or a link the agent "
"refuses - the endpoint's own service reports it and goes WARN."
msgstr ""
"既定では無効です (1 リクエスト = 1 ページ)。API がコレクションをページ単位で"
"返す場合、そこから作られるすべてのサービスは最初のページだけを表します。1 "
"ページ 25 件のキューに対する 'count' はキューがどれだけ長くても 25 と報告"
"し、'[*]' ワイルドカードは最初のページの要素だけにサービスを作成します。しか"
"もそのことはどこにも示されません。だからこそこの設定が重要です。答えが欠けて"
"いるのではなく、間違っているのです。この設定を有効にすると、エージェントは "
"API 自身の次ページリンクをたどり (リンクのない API ではページを自ら数え)、各"
"ページのコレクションを最初のページのものに追加します。これによりワイルドカー"
"ド、集約、条件、ホストラベルのすべてが全体を見ます。各ページは最初のページと"
"まったく同じ方法 (同じメソッド、ヘッダー、認証、タイムアウト) で要求され、1 "
"ページごとにチェック内で 1 リクエストを消費します。ページ数に上限を設け、"
"チェック間隔ごとに変化しないコレクションではキャッシュ TTL の利用も検討してく"
"ださい。読み取れないページはコレクションを黙って切り詰めるのではなくエンドポ"
"イントを失敗させます。さらにページが存在するのにたどらなかった場合 (上限に達"
"した、またはエージェントが拒否したリンク) は、エンドポイント自身のサービスが"
"それを報告し WARN になります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2063
msgid "Where the next page's URL comes from"
msgstr "次のページの URL の取得元"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2065
msgid ""
"The API's documentation says which form it uses. Where the API links to the "
"next page, a page that carries no next link (an absent field, a JSON 'null', "
"an empty string, no 'Link' header) is the last one, which is how pagination "
"ends. Where it offers no link and takes the position as a query parameter "
"instead, the agent counts: the page number goes up by one per page, the "
"offset by the number of elements the previous page carried. The parameter is "
"set on the first request too, replacing one of that name in the URL."
msgstr ""
"どの形式を使うかは API のドキュメントに記載されています。API が次ページへのリ"
"ンクを返す場合、次へのリンクを持たないページ (フィールドがない、JSON の "
"'null'、空文字列、'Link' ヘッダーがない) が最後のページで、これでページングが"
"終わります。リンクがなく位置をクエリパラメーターで受け取る API では、エージェ"
"ントが数えます。ページ番号は 1 ページごとに 1 ずつ、オフセットは直前のページ"
"の要素数だけ増えます。このパラメーターは最初のリクエストにも設定され、URL 内"
"の同名のパラメーターを置き換えます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2082
msgid "A field in the response body"
msgstr "レスポンス本文のフィールド"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2084
msgid "JSON path to the next page's URL"
msgstr "次のページの URL への JSON パス"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2086
msgid ""
"From the response root, e.g. 'links.next', 'next' or 'meta.next_page_url'. A "
"relative URL ('/api/v1/jobs?page=2') is resolved against the page it came "
"from."
msgstr ""
"レスポンスのルートからのパスで、たとえば 'links.next'、'next'、'meta."
"next_page_url' です。相対 URL ('/api/v1/jobs?page=2') は、それが含まれていた"
"ページを基準に解決されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2100
msgid "The 'Link' response header (rel=\"next\")"
msgstr "レスポンスの 'Link' ヘッダー (rel=\"next\")"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2104
msgid "Read from the 'Link' header, as RFC 8288 defines it"
msgstr "RFC 8288 で定義された 'Link' ヘッダーから読み取る"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2108
msgid ""
"The convention of the GitHub, GitLab and Jenkins style APIs: 'Link: <https://"
"host/jobs?page=2>; rel=\"next\"'. The link with rel=\"next\" is followed; "
"the others ('last', 'prev') are ignored."
msgstr ""
"GitHub、GitLab、Jenkins 系の API の慣例です: 'Link: <https://host/jobs?"
"page=2>; rel=\"next\"'。rel=\"next\" のリンクをたどり、それ以外 "
"('last'、'prev') は無視します。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2120
msgid "No link: count the pages ('?page=2')"
msgstr "リンクなし: ページを数える ('?page=2')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2126
msgid "Number of the first page"
msgstr "最初のページの番号"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2128
msgid "1 for most APIs; 0 where the API counts from zero."
msgstr "ほとんどの API では 1、API がゼロから数える場合は 0 です。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2141
msgid "No link: count the elements ('?offset=50')"
msgstr "リンクなし: 要素を数える ('?offset=50')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2147
msgid "Offset of the first element"
msgstr "最初の要素のオフセット"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2149
msgid ""
"Unset, counting starts at 0. Set 1 where the API numbers the elements from "
"one, such as SCIM's 'startIndex' - otherwise every page after the first "
"repeats one element."
msgstr ""
"未設定の場合、0 から数えます。SCIM の 'startIndex' のように API が要素を 1 か"
"ら番号付けする場合は 1 を設定してください。そうしないと、最初のページ以降の各"
"ページで要素が 1 つ重複します。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2170
msgid "JSON path to the collection to merge"
msgstr "マージするコレクションへの JSON パス"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2172
msgid ""
"The array (or object) each page carries a slice of - e.g. 'items', 'data."
"jobs' or 'results'. Use '$' where the response IS the array. Each page's "
"collection is appended to the first page's, and the rest of the document "
"stays as the first page sent it: a 'total' or a 'generated_at' next to the "
"collection still resolves, and every path configured below is unchanged. No "
"'[*]' wildcard here - this names the collection itself, not the elements in "
"it."
msgstr ""
"各ページが一部分を運ぶ配列 (またはオブジェクト) です。たとえば "
"'items'、'data.jobs'、'results' などです。レスポンス自体が配列である場合は "
"'$' を使います。各ページのコレクションは最初のページのものに追加され、ドキュ"
"メントの残りは最初のページが返したままになります。コレクションの隣にある "
"'total' や 'generated_at' は引き続き解決でき、下で設定するパスも変わりませ"
"ん。ここでは '[*]' ワイルドカードを使いません。これはコレクション自体を指し、"
"その中の要素ではありません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2190
msgid "Read at most this many pages"
msgstr "読み取る最大ページ数"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2192
msgid ""
"Including the first one, so '1' disables following entirely. Each page is a "
"request made while the check runs, and a special agent that overruns is "
"killed - so this is the setting that keeps a collection which grew a "
"hundredfold from turning the monitoring into the outage. When the limit is "
"reached while a further page still exists, the endpoint's own service says "
"so and goes WARN instead of quietly reporting part of the collection."
msgstr ""
"最初のページを含む数なので、'1' にするとページのたどりを完全に無効化します。"
"各ページはチェック実行中に発行されるリクエストであり、時間を超過したスペシャ"
"ルエージェントは停止させられます。つまりこの設定は、100 倍に増えたコレクショ"
"ンが監視自体を障害に変えてしまうのを防ぎます。さらにページが存在するのに上限"
"に達した場合、エンドポイント自身のサービスがそれを示して WARN になり、コレク"
"ションの一部を黙って報告することはありません。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2213
msgid "And at most this many elements"
msgstr "さらに要素数の上限"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2215
msgid ""
"Optional second cap, for a page size that is not known in advance. Checked "
"between pages, so a page is never cut in half and the collection can end "
"slightly above this. Like the page limit, reaching it while more pages exist "
"is reported on the endpoint's own service. Remember that a '[*]' wildcard "
"creates one SERVICE per element."
msgstr ""
"ページサイズが事前に分からない場合のための、任意の第 2 の上限です。ページの区"
"切りで判定するため、ページが途中で切られることはなく、コレクションはこの値を"
"少し超えることがあります。ページ数の上限と同様に、まだページが存在するのに上"
"限に達した場合はエンドポイント自身のサービスで報告されます。'[*]' ワイルド"
"カードは要素ごとに 1 つのサービスを作成することに注意してください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2234
msgid "HTTP proxy"
msgstr "HTTP プロキシ"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2236
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"このエンドポイントのリクエストを HTTP プロキシ経由でルーティングします。"
"Checkmk サーバーが企業の送信プロキシ経由でしか API に到達できない場合に便利で"
"す。環境変数 HTTP_PROXY / HTTPS_PROXY、明示的なプロキシ URL、または環境で設定"
"されたプロキシを回避する「プロキシなし」から選択します。この設定がない場合"
"は、環境のプロキシ変数が使用されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2250
msgid "Fields to monitor"
msgstr "監視するフィールド"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2252
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"各エントリは、指定した JSON パスで見つかった値から構築される 1 つの Checkmk "
"サービスになります。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2262
msgid "Host labels"
msgstr "ホストラベル"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2264
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Or classify the host from a "
"collection instead: a condition plus a literal value turns 'any element of "
"services[*] whose name matches ^MyApp' into the single label 'json_api/"
"MyApp: yes', which folder rules, thresholds, contact groups and views can "
"then target. Set at discovery, so pick stable, low-cardinality fields."
msgstr ""
"このエンドポイントの応答のフィールドから作成した Checkmk ホストラベルを監視対"
"象ホストに付与します。各キーには 'json_api/' の接頭辞が付き、値は応答のルート"
"から解決されます。したがって、これらはホスト全体に関する情報 (環境、リージョ"
"ン、バージョンなど) であり、サービスは不要です。パスには '[*]' ワイルドカー"
"ド (例: 'components[*]') を含めることができ、要素ごとに 1 つのラベルを "
"'<key>/<element>' というキーで生成してキーの一意性を保ちます。あるいはコレク"
"ションからホストを分類することもできます。条件とリテラル値を組み合わせる"
"と、'name が ^MyApp に一致する services[*] の要素がいずれか存在する' ことが "
"'json_api/MyApp: yes' という 1 つのラベルになり、フォルダールール、しきい値、"
"連絡先グループ、ビューからそれを対象にできます。サービス検出時に設定されるた"
"め、安定していてカーディナリティの低いフィールドを選んでください。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2287
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element. Can be left empty "
"only where a condition and a literal value describe the label on their own."
msgstr ""
"応答のルートから。例: 'version'、'cluster.region'、または要素ごとに 1 つのラ"
"ベルを付ける 'components[*]' のような '[*]' ワイルドカード。条件とリテラル値"
"だけでラベルを記述できる場合に限り、空のままにできます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2301
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"既定ではパスの最後のセグメント。'[*]' パスの場合は要素 ID が付加されます "
"('<key>/<element>')。接頭辞 'json_api/' は自動的に付加されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2311
msgid "Value field (for '[*]' wildcards)"
msgstr "値フィールド ('[*]' ワイルドカード用)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2313
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"'[*]' パスの場合: 各要素内のラベル値へのパス (例: 'status')。既定は "
"'true' (所属を示すタグ) です。ワイルドカードがない場合は無視されます。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2386
msgid "Endpoints"
msgstr "エンドポイント"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2388
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"1 つ以上の HTTP/JSON エンドポイント。各エンドポイントは独自の接続設定と抽出設"
"定で取得され、すべての結果は 1 つのセクションにマージされます。到達できないエ"
"ンドポイントは、それ自身のサービスにのみ影響します。"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:2403
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:149
msgid "Generic JSON API"
msgstr "汎用 JSON API"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:66
msgid "Upper levels for the response time"
msgstr "応答時間の上限レベル"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:68
msgid ""
"How long the request to this endpoint may take, in seconds. Measured from "
"sending the request to having read the whole response body. Without levels "
"the response time is only recorded as a metric."
msgstr ""
"このエンドポイントへのリクエストに許される時間 (秒)。リクエストの送信から 応"
"答本文をすべて読み終えるまでを計測します。レベルを設定しない場合、応答時間は "
"メトリックとして記録されるだけです。"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:81
msgid "Lower levels for the TLS certificate's remaining validity"
msgstr "TLS 証明書の残り有効期間の下限しきい値"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:83
msgid ""
"How many days the endpoint's TLS certificate must still be valid for. Read "
"from the connection the agent already makes, so no second check against the "
"same URL is needed. Only available for HTTPS endpoints with certificate "
"verification enabled; otherwise the certificate is not reported and these "
"levels never apply. Without levels the remaining validity is only recorded "
"as a metric."
msgstr ""
"エンドポイントの TLS 証明書が残り何日間有効である必要があるか。エージェントが"
"すでに確立している接続から読み取るため、同じ URL に対する 2 回目のチェックは"
"不要です。証明書の検証が有効な HTTPS エンドポイントでのみ利用できます。それ以"
"外の場合は証明書が報告されないため、このしきい値は適用されません。しきい値を"
"設定しない場合、残りの有効期間はメトリックとしてのみ記録されます。"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:99
msgid "State when the request needed a retry"
msgstr "リクエストに再試行が必要だったときのステータス"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:101
msgid ""
"Applies when the endpoint's retry policy absorbed a failed attempt: the "
"request did succeed, but not on the first try. OK by default - a retry doing "
"its job is not itself a problem. Raise it for an endpoint whose flakiness is "
"worth knowing about, so retries never quietly turn a degrading API into a "
"permanently green service."
msgstr ""
"エンドポイントの再試行設定が失敗した試行を吸収したときに適用されます。リクエ"
"ストは成功しましたが、1 回目ではありませんでした。既定は OK です。再試行が役"
"目を果たしているだけなら、それ自体は問題ではありません。不安定さを把握したい"
"エンドポイントでは引き上げてください。再試行によって、劣化しつつある API が常"
"時グリーンのサービスに見えてしまうことを防げます。"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:114
msgid "State when the collection was read incompletely"
msgstr "コレクションを不完全に読み取ったときのステータス"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:116
msgid ""
"Applies when the endpoint follows the API's pagination and a further page "
"existed that was not read - a page or element limit was reached, or the API "
"offered a link the agent refuses to follow (another host, or one it had "
"already fetched). Every service built from that collection - a count, an "
"aggregation, a '[*]' wildcard - is then describing part of it. WARN by "
"default, because a collection quietly missing its tail is exactly what "
"following the pages was meant to prevent. Lower it to OK for an endpoint "
"where reading the first N pages is deliberate."
msgstr ""
"エンドポイントが API のページネーションをたどり、読み取らなかった次のページが"
"存在した場合に適用されます。ページ数または要素数の上限に達した場合、あるいは"
"エージェントがたどることを拒否するリンク (別のホスト、または既に取得したリン"
"ク) が提示された場合です。そのコレクションから作られたサービス (件数、集"
"約、'[*]' ワイルドカード) はいずれも、その一部だけを表していることになりま"
"す。既定は WARN です。末尾が黙って欠けたコレクションこそ、ページをたどる機能"
"が防ごうとしているものだからです。最初の N ページだけを読むのが意図どおりであ"
"るエンドポイントでは OK に下げてください。"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:134
msgid "State when the endpoint cannot be read"
msgstr "エンドポイントを読み取れない場合の状態"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:136
msgid ""
"Applies when the request fails outright: connection refused, a TLS error, a "
"timeout, an HTTP status that is not accepted, or a response that is not JSON."
msgstr ""
"リクエストがまったく成功しない場合に適用されます: 接続拒否、TLS エラー、 タイ"
"ムアウト、許可されていない HTTP ステータス、または JSON ではない応答。"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:157
msgid "Generic JSON API endpoint"
msgstr "汎用 JSON API エンドポイント"

#: cmk_addons/plugins/json_api/graphing/json_api.py:23
msgid "Value"
msgstr "値"

#: cmk_addons/plugins/json_api/graphing/json_api.py:30
msgid "Count"
msgstr "カウント"

#: cmk_addons/plugins/json_api/graphing/json_api.py:37
msgid "Size"
msgstr "サイズ"

#: cmk_addons/plugins/json_api/graphing/json_api.py:44
msgid "Duration"
msgstr "期間"

#: cmk_addons/plugins/json_api/graphing/json_api.py:51
msgid "Percentage"
msgstr "割合"

#: cmk_addons/plugins/json_api/graphing/json_api.py:58
#: cmk_addons/plugins/json_api/graphing/json_api.py:65
msgid "Rate"
msgstr "レート"

#: cmk_addons/plugins/json_api/graphing/json_api.py:72
msgid "Throughput"
msgstr "スループット"

#: cmk_addons/plugins/json_api/graphing/json_api.py:79
msgid "Time per second"
msgstr "1 秒あたりの時間"

#: cmk_addons/plugins/json_api/graphing/json_api.py:86
msgid "Percentage per second"
msgstr "1 秒あたりの割合"

#: cmk_addons/plugins/json_api/graphing/json_api.py:97
msgid "Bandwidth"
msgstr "帯域幅"

#: cmk_addons/plugins/json_api/graphing/json_api.py:104
msgid "Temperature"
msgstr "温度"

#: cmk_addons/plugins/json_api/graphing/json_api.py:111
msgid "Voltage"
msgstr "電圧"

#: cmk_addons/plugins/json_api/graphing/json_api.py:118
msgid "Electric current"
msgstr "電流"

#: cmk_addons/plugins/json_api/graphing/json_api.py:125
msgid "Power"
msgstr "電力"

