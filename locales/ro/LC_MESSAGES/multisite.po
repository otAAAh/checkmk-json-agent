#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Expresie regulată invalidă: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "Niveluri superioare (pentru valori numerice)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "Niveluri inferioare (pentru valori numerice)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "Potrivire de șiruri de caractere"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr ""
"Cum se transformă o valoare șir de caractere într-o stare de serviciu "
"Checkmk."

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "Valoarea trebuie să corespundă unei expresii regulate"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "Valoare așteptată (regex)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Pentru valori șir de caractere: valoarea trebuie să corespundă complet "
"acestei expresii regulate (de ex. 'UP|ok')."

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "Starea când valoarea nu corespunde"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Asociază valoarea unei stări (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Pentru valori șir de caractere cu mai multe stări cunoscute: fiecare model "
"este o expresie regulată comparată cu întreaga valoare. Sunt încercate în "
"ordinea OK, WARN, CRIT și prima potrivire câștigă."

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "OK când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "WARN când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "CRIT când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "Starea când nimic nu corespunde"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:80
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "Expresie aritmetică invalidă: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:85
msgid ""
"Only the variable 'value', numbers, parentheses and + - * / are allowed."
msgstr "Sunt permise numai variabila 'value', numere, paranteze și + - * /."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:89
#, python-format
msgid "Unknown variable '%s' - only 'value' is available."
msgstr "Variabilă necunoscută '%s' - numai 'value' este disponibilă."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:94
msgid "Only numeric constants are allowed."
msgstr "Numai constante numerice sunt permise."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:110
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Fiecare URL de endpoint trebuie să fie unic. Duplicat: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:120
msgid "The URL must not contain whitespace."
msgstr "URL-ul nu trebuie să conțină spații albe."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:124
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Introduceți un URL http(s) valid, de ex. 'https://host/cale'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:130
msgid "Authentication"
msgstr "Autentificare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:135
msgid "Basic authentication (username / password)"
msgstr "Autentificare de bază (nume de utilizator / parolă)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:141
msgid "Username"
msgstr "Nume de utilizator"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:148
msgid "Password"
msgstr "Parolă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:157
msgid "Bearer token"
msgstr "Token Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:163
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:164
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Trimis ca 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:204
msgid "Field to monitor"
msgstr "Câmp de monitorizat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:210
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:51
msgid "Service name"
msgstr "Nume serviciu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:211
msgid "Becomes the Checkmk service description for this field."
msgstr "Devine descrierea serviciului Checkmk pentru acest câmp."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:218
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:274
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:712
msgid "JSON path"
msgstr "Cale JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:220
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\"."
msgstr ""
"Cale cu puncte în răspunsul JSON, de ex. 'status', 'components.db.status' "
"sau 'items[0].count'. Utilizați un metacaracter '[*]' (de ex. 'nodes[*]."
"health') pentru a crea câte un serviciu per element de matrice - sau, când "
"metacaracterul ajunge pe un obiect JSON (o hartă indexată după nume, precum "
"un '/health' de Spring Boot Actuator 'components[*].status'), câte un "
"serviciu per cheie. Mai multe metacaractere '[*]' (de ex. 'pods[*]."
"containers[*].ready') extind produsul cartezian, câte un serviciu per "
"combinație. Un prefix '$.' este opțional. Cheile care conțin ele însele '.' "
"sau '[' pot fi adresate cu segmente între paranteze și ghilimele, de ex. "
"\"data['foo.bar'].value\"."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:240
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "Sufix de nume per element (pentru metacaractere '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:242
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"Când calea JSON conține un metacaracter '[*]', este creat câte un serviciu "
"pentru fiecare element. Această cale opțională - relativă la fiecare "
"element, de ex. 'name' sau 'id' - este adăugată la numele serviciului pentru "
"a diferenția aceste servicii. NU înlocuiește numele serviciului. Implicit se "
"folosește indicele matricei (sau, pentru un obiect, cheia). Cu mai multe "
"metacaractere '[*]' este rezolvată la fiecare nivel, iar părțile sunt unite "
"cu ' / ' (de ex. '<pod> / <container>'). Alegeți un câmp care este unic și "
"stabil între rulări."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:257
msgid "Service labels"
msgstr "Etichete de serviciu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:259
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"Atașează etichete de serviciu Checkmk la ACEST serviciu, create din câmpuri "
"ale răspunsului. Fiecare cheie primește prefixul 'json_api/'. Pentru o cale "
"'[*]' valoarea este rezolvată în cadrul fiecărui element (de ex. 'name'), "
"astfel încât fiecare serviciu per element primește propria etichetă; pentru "
"o cale fără metacaractere este rezolvată din rădăcina răspunsului. Faptele "
"valabile pentru întreaga gazdă aparțin în schimb 'Etichetelor de gazdă' ale "
"punctului final. Etichetele sunt setate în timpul descoperirii, deci alegeți "
"câmpuri stabile și cu cardinalitate redusă - o valoare care se schimbă face "
"ca eticheta să varieze constant."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:276
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"Relativă la fiecare element '[*]' (ca sufixul de nume) sau rădăcina "
"răspunsului pentru o cale fără metacaractere."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:286
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:724
msgid "Label key (optional)"
msgstr "Cheia etichetei (opțional)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:288
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"Implicit, ultimul segment al căii. Prefixul 'json_api/' este adăugat automat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:300
msgid "Aggregate a collection into one value"
msgstr "Agregă o colecție într-o singură valoare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:302
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"Reduce o colecție de elemente la un singur număr în loc să monitorizeze o "
"singură valoare (sau, cu un metacaracter '[*]', un serviciu per element). "
"Calea JSON indică fie un tablou / obiect (de ex. 'jobs'), fie un "
"metacaracter '[*]' peste valorile de agregat (de ex. 'nodes[*].load'). "
"'Numărul de elemente' doar le numără; celelalte funcții necesită valori "
"numerice. Rezultatul este un număr, deci unitatea, nivelurile, transformarea "
"și metrica i se aplică. Împreună cu condiția de mai jos se agregă numai "
"elementele care corespund. O cale care nu conține nici tablou, nici obiect "
"face serviciul UNKNOWN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:315
msgid "Number of elements"
msgstr "Numărul de elemente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:316
msgid "Sum of the values"
msgstr "Suma valorilor"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:317
msgid "Average of the values"
msgstr "Media valorilor"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:318
msgid "Smallest of the values"
msgstr "Cea mai mică dintre valori"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:319
msgid "Largest of the values"
msgstr "Cea mai mare dintre valori"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:327
msgid "Only elements matching a condition"
msgstr "Doar elementele care îndeplinesc o condiție"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:329
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"Pentru un metacaracter '[*]' sau o cale agregată: se păstrează numai "
"elementele al căror subcâmp îndeplinește această condiție – de ex. un "
"serviciu pentru fiecare nod al cărui 'status' nu este 'ok', sau numărarea "
"doar a pod-urilor care nu sunt 'Running'. Calea câmpului este rezolvată în "
"interiorul fiecărui element; un element al cărui câmp lipsește sau nu este "
"scalar este eliminat. Fără un metacaracter '[*]' sau o agregare, acest lucru "
"nu are efect."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:341
msgid "Field path (within each element)"
msgstr "Calea câmpului (în cadrul fiecărui element)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:343
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr ""
"Rezolvat în cadrul fiecărui element, de ex. 'status' sau 'metadata.phase'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:352
msgid "Condition"
msgstr "Condiție"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:354
msgid "equals"
msgstr "este egal cu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:355
msgid "does not equal"
msgstr "nu este egal cu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:356
msgid "matches regex"
msgstr "se potrivește cu regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:357
msgid "does not match regex"
msgstr "nu se potrivește cu regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:365
msgid "Comparison value / pattern"
msgstr "Valoare de comparație / model"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:367
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr ""
"Valoarea cu care se compară sau expresia regulată pentru condițiile regex."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:378
msgid "Interpret the value as"
msgstr "Interpretează valoarea ca"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:380
msgid ""
"By default the extracted value is monitored as it stands. Two common API "
"values are worth deriving something else from: a counter that only ever "
"grows (its rate of change is what matters, not the total), and a timestamp "
"(its age is what matters, not the date). The derived number is what the "
"transform, the levels, the metric and the summary then use."
msgstr ""
"În mod implicit, valoarea extrasă este monitorizată așa cum este. Pentru "
"două valori API frecvente merită să derivi altceva: un contor care doar "
"crește (contează rata de variație, nu totalul) și o marcă temporală "
"(contează vechimea, nu data). Numărul derivat este cel folosit apoi de "
"transformare, niveluri, metrică și sumar."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:392
msgid "A counter - monitor its per-second rate"
msgstr "Un contor – monitorizează rata pe secundă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:395
msgid "Per-second rate"
msgstr "Rată pe secundă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:397
msgid "The difference to the previous check is divided by the elapsed time"
msgstr ""
"Diferența față de verificarea anterioară este împărțită la timpul scurs"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:401
msgid ""
"For monotonically growing counters such as 'requests_total' or 'bytes_sent': "
"the check monitors the change per second instead of the absolute total. The "
"first check after a restart of the counter cannot compute a rate yet and "
"keeps the service's previous state."
msgstr ""
"Pentru contoare care cresc monoton, precum 'requests_total' sau "
"'bytes_sent': verificarea monitorizează variația pe secundă în loc de "
"totalul absolut. Prima verificare după o repornire a contorului nu poate "
"calcula încă o rată și păstrează starea anterioară a serviciului."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:412
msgid "A timestamp - monitor its age"
msgstr "O marcă temporală – monitorizează vechimea"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:415
msgid ""
"For values such as 'last_backup' or 'updated_at': the check monitors the "
"number of seconds since that point in time, so upper levels alert on stale "
"data. A timestamp in the future yields a negative age. The age graphs and "
"reads as a duration on its own; choose a unit below only to override that (e."
"g. after a transform into hours)."
msgstr ""
"Pentru valori precum 'last_backup' sau 'updated_at': verificarea "
"monitorizează numărul de secunde scurse din acel moment, astfel încât "
"nivelurile superioare avertizează asupra datelor învechite. O marcă "
"temporală în viitor dă o vechime negativă. Vechimea este afișată și "
"reprezentată grafic ca durată de la sine; alegeți o unitate mai jos doar "
"pentru a suprascrie acest lucru (de ex. după o transformare în ore)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:428
msgid "Timestamp format"
msgstr "Formatul mărcii temporale"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:430
msgid ""
"'Detect automatically' reads a number as Unix epoch seconds (milliseconds "
"when it is far too large for seconds) and anything else as ISO 8601. A "
"timestamp without a time zone is read as UTC."
msgstr ""
"'Detectează automat' citește un număr ca secunde epoch Unix (milisecunde "
"când este mult prea mare pentru secunde) și orice altceva ca ISO 8601. O "
"marcă temporală fără fus orar este citită ca UTC."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:439
msgid "Detect automatically"
msgstr "Detectează automat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:442
msgid "Unix epoch seconds"
msgstr "Secunde epoch Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:446
msgid "Unix epoch milliseconds"
msgstr "Milisecunde epoch Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:451
msgid "ISO 8601 / RFC 3339, e.g. '2026-07-28T02:00:00Z'"
msgstr "ISO 8601 / RFC 3339, de ex. '2026-07-28T02:00:00Z'"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:468
msgid "Unit (for numeric values)"
msgstr "Unitate (pentru valori numerice)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:470
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Redă metrica și graficul cu această unitate. Lăsați nesetat pentru o valoare "
"simplă, fără unitate. Afectează doar valorile numerice."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:474
msgid "Count (integer)"
msgstr "Număr (întreg)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:475
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Octeți (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:476
msgid "Seconds (duration)"
msgstr "Secunde (durată)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:477
msgid "Percent"
msgstr "Procent"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:479
msgid "No unit"
msgstr "Fără unitate"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:493
msgid "Transform the numeric value"
msgstr "Transformă valoarea numerică"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:495
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius)."
msgstr ""
"O expresie aritmetică aplicată unei valori numerice înainte de niveluri și "
"de metrică, utilizând variabila 'value'. Sunt permise numai numere, "
"paranteze și + - * /. Exemple: 'value / 1024 / 1024' (octeți în MiB), 'value "
"* 1000' (secunde în milisecunde), '(value - 32) * 5 / 9' (Fahrenheit în "
"Celsius)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:516
msgid "Endpoint"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:521
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:523
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL complet al endpoint-ului JSON, inclusiv schema, de ex. 'https://app."
"example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:532
msgid "HTTP method"
msgstr "Metodă HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:534
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:535
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:543
msgid "Request body (for POST)"
msgstr "Corpul cererii (pentru POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:549
msgid "Additional request headers"
msgstr "Anteturi de cerere suplimentare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:554
msgid "Header name"
msgstr "Nume antet"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:558
msgid "Header value"
msgstr "Valoare antet"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:571
msgid "Verify the TLS certificate"
msgstr "Verifică certificatul TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:572
msgid "Disabling certificate verification is insecure."
msgstr "Dezactivarea verificării certificatului nu este sigură."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:579
msgid "Custom CA bundle file"
msgstr "Fișier bundle CA personalizat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:581
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"Calea pe serverul Checkmk către un fișier PEM cu certificatul/certificatele "
"CA față de care se verifică certificatul serverului. Folosiți-l pentru a "
"avea încredere într-o CA internă sau privată fără a dezactiva verificarea. "
"Ignorat când verificarea TLS este dezactivată."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:592
msgid "Client certificate (mutual TLS)"
msgstr "Certificat de client (TLS reciproc)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:594
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"Prezentați serverului un certificat de client (TLS reciproc). Fișierele "
"trebuie să existe pe serverul Checkmk. Cheia privată trebuie să fie "
"necriptată."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:602
msgid "Client certificate file"
msgstr "Fișier certificat de client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:604
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"Calea către certificatul de client (PEM). Dacă fișierul conține și cheia "
"privată, lăsați câmpul cheii gol."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:614
msgid "Private key file"
msgstr "Fișier cheie privată"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:616
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr ""
"Calea către cheia privată a clientului (PEM), dacă nu este inclusă în "
"certificat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:628
msgid "Follow HTTP redirects"
msgstr "Urmărește redirecționările HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:630
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Activat implicit. Dezactivați în medii securizate pentru a proteja împotriva "
"SSRF: o țintă care redirecționează (de ex. 3xx către o adresă internă) va "
"eșua atunci în loc să fie urmărită până la locația de redirecționare."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:641
msgid "Request timeout (seconds)"
msgstr "Timp de expirare a cererii (secunde)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:642
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Timp de expirare per cerere. Implicit 30 de secunde."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:650
msgid "Additional accepted HTTP status codes"
msgstr "Coduri de stare HTTP suplimentare acceptate"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:652
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"În mod implicit sunt citite doar răspunsurile 2xx; orice altă stare trece "
"serviciile endpointului pe UNKNOWN. Adăugați aici coduri de stare "
"suplimentare de acceptat – de exemplu 503 pentru un endpoint de sănătate "
"care își raportează problemele cu un 503 și un corp JSON. Corpul unui "
"răspuns acceptat este analizat și extras ca de obicei. 2xx este întotdeauna "
"acceptat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:660
msgid "Status code"
msgstr "Cod de stare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:668
msgid "HTTP proxy"
msgstr "Proxy HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:670
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"Direcționați cererea acestui endpoint printr-un proxy HTTP - util atunci "
"când serverul Checkmk ajunge la API doar printr-un proxy de ieșire "
"corporativ. Alegeți variabilele de mediu HTTP_PROXY / HTTPS_PROXY, un URL de "
"proxy explicit sau 'fără proxy' pentru a ocoli orice proxy setat în mediu. "
"Fără această setare, sunt respectate variabilele de proxy ale mediului."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:684
msgid "Fields to monitor"
msgstr "Câmpuri de monitorizat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:686
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Fiecare intrare devine un serviciu Checkmk, construit din valoarea găsită la "
"calea JSON dată."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:695
msgid "Host labels"
msgstr "Etichete de gazdă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:697
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Set at discovery, so pick stable, low-"
"cardinality fields."
msgstr ""
"Atașează etichete de gazdă Checkmk gazdei monitorizate, create din câmpuri "
"ale răspunsului acestui punct final. Fiecare cheie primește prefixul "
"'json_api/' și valoarea este rezolvată din rădăcina răspunsului - deci "
"acestea sunt informații valabile pentru întreaga gazdă (de ex. un mediu, o "
"regiune sau o versiune) și NU necesită niciun serviciu. O cale poate conține "
"un metacaracter '[*]' (de ex. 'components[*]') pentru a emite o etichetă per "
"element, cu cheia '<key>/<element>' astfel încât cheile să rămână unice. "
"Setate în timpul descoperirii, deci alegeți câmpuri stabile și cu "
"cardinalitate redusă."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:714
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element."
msgstr ""
"Din rădăcina răspunsului, de ex. 'version', 'cluster.region' sau un "
"metacaracter '[*]' precum 'components[*]' pentru o etichetă per element."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:726
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"Implicit, ultimul segment al căii. Pentru o cale '[*]' se adaugă id-ul "
"elementului ('<key>/<element>'). Prefixul 'json_api/' este adăugat automat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:736
msgid "Value field (for '[*]' wildcards)"
msgstr "Câmp de valoare (pentru metacaractere '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:738
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"Pentru o cale '[*]': o cale în cadrul fiecărui element pentru valoarea "
"etichetei (de ex. 'status'). Implicit 'true' (o etichetă de apartenență). "
"Ignorat fără metacaracter."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:771
msgid "Endpoints"
msgstr "Endpoint-uri"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:773
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Unul sau mai multe endpoint-uri HTTP/JSON. Fiecare este preluat cu propriile "
"setări de conexiune și extrageri; toate rezultatele sunt îmbinate într-o "
"singură secțiune. Un endpoint care nu poate fi accesat afectează doar "
"propriile servicii."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:788
