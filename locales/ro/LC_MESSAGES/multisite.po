#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Expresie regulată invalidă: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "Niveluri superioare (pentru valori numerice)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "Niveluri inferioare (pentru valori numerice)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "Potrivire de șiruri de caractere"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr ""
"Cum se transformă o valoare șir de caractere într-o stare de serviciu "
"Checkmk."

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "Valoarea trebuie să corespundă unei expresii regulate"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "Valoare așteptată (regex)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Pentru valori șir de caractere: valoarea trebuie să corespundă complet "
"acestei expresii regulate (de ex. 'UP|ok')."

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "Starea când valoarea nu corespunde"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Asociază valoarea unei stări (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Pentru valori șir de caractere cu mai multe stări cunoscute: fiecare model "
"este o expresie regulată comparată cu întreaga valoare. Sunt încercate în "
"ordinea OK, WARN, CRIT și prima potrivire câștigă."

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "OK când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "WARN când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "CRIT când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "Starea când nimic nu corespunde"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:81
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "Expresie aritmetică invalidă: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:87
msgid ""
"Only the variables 'value' and 'other', numbers, parentheses and + - * / are "
"allowed."
msgstr ""
"Sunt permise numai variabilele 'value' și 'other', numere, paranteze și + - "
"* /."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:93
#, python-format
msgid "Unknown variable '%s' - only 'value' and 'other' are available."
msgstr ""
"Variabilă necunoscută '%s' - numai 'value' și 'other' sunt disponibile."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:98
msgid "Only numeric constants are allowed."
msgstr "Numai constante numerice sunt permise."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:118
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Fiecare URL de endpoint trebuie să fie unic. Duplicat: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:127
#, python-format
msgid "Each endpoint name must be unique. Duplicated: %s"
msgstr "Fiecare nume de endpoint trebuie să fie unic. Duplicat: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:137
msgid "The URL must not contain whitespace."
msgstr "URL-ul nu trebuie să conțină spații albe."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:141
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Introduceți un URL http(s) valid, de ex. 'https://host/cale'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:157
msgid "Enter a valid HTTP header name, e.g. 'X-API-Key'."
msgstr "Introduceți un nume de antet HTTP valid, de ex. 'X-API-Key'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:166
msgid "Enter a valid query parameter name, e.g. 'api_key'."
msgstr ""
"Introduceți un nume de parametru de interogare valid, de ex. 'api_key'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:193
#, python-format
msgid ""
"The header '%s' carries the API key and must not also be set under "
"'Additional request headers'."
msgstr ""
"Antetul '%s' conține cheia API și nu trebuie setat și în 'Anteturi de cerere "
"suplimentare'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:231
msgid ""
"The transform uses 'other', so 'Second path for the transform' must be set "
"to say where that value comes from."
msgstr ""
"Transformarea folosește 'other', deci 'A doua cale pentru transformare' "
"trebuie setată pentru a indica de unde provine acea valoare."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:238
msgid ""
"'Second path for the transform' is only used through the variable 'other' - "
"add it to the transform (e.g. 'value / other * 100') or clear the path."
msgstr ""
"'A doua cale pentru transformare' este folosită numai prin variabila 'other' "
"- adaug-o în transformare (de exemplu 'value / other * 100') sau golește "
"calea."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:260
#, python-brace-format
msgid ""
"Use '{path}' to insert a field, e.g. '{message} (leader {leader})'. Braces "
"must be paired and cannot be nested or empty."
msgstr ""
"Folosiți '{path}' pentru a insera un câmp, de ex. '{message} (leader "
"{leader})'. Acoladele trebuie să fie perechi și nu pot fi imbricate sau "
"goale."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:281
msgid ""
"Enter a dotted inventory path of at least two segments, using lower-case "
"letters, digits and '_' - e.g. 'software.applications.json_api'."
msgstr ""
"Introduceți o cale de inventar cu puncte, de cel puțin două segmente, "
"folosind litere mici, cifre și '_' - de ex. 'software.applications.json_api'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:288
msgid ""
"The inventory path must start with 'hardware', 'software' or 'networking'."
msgstr ""
"Calea de inventar trebuie să înceapă cu 'hardware', 'software' sau "
"'networking'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:296
msgid ""
"Use lower-case letters, digits and '_' for the attribute name, e.g. "
"'version'."
msgstr ""
"Folosiți litere mici, cifre și '_' pentru numele atributului, de ex. "
"'version'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:303
msgid "Write into the HW/SW inventory"
msgstr "Scrie în inventarul HW/SW"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:305
msgid ""
"Put this field into the host's inventory tree instead of making it a "
"service. Meant for facts rather than states - a version, a build, a region, "
"a licence tier - which are not worth a service that is OK forever, and which "
"the inventory can do something with that services cannot: it is searchable "
"ACROSS hosts ('which hosts still run a version below 4.2?') and keeps a "
"history of its own. For a '[*]' wildcard the elements become one table row "
"each, keyed by the element's name. Point this at values that rarely change: "
"every change is recorded in the inventory history, so a counter here grows "
"those files without bound. Inventory runs on its own (slower) schedule, not "
"at every check interval."
msgstr ""
"Pune acest câmp în arborele de inventar al hostului în loc să facă din el un "
"serviciu. Este gândit pentru fapte, nu pentru stări - o versiune, un build, "
"o regiune, un nivel de licență -, care nu merită un serviciu veșnic OK și cu "
"care inventarul poate face ceva ce serviciile nu pot: poate fi căutat ÎNTRE "
"hosturi („ce hosturi mai rulează o versiune sub 4.2?”) și păstrează un "
"istoric propriu. La un metacaracter '[*]', fiecare element devine un rând de "
"tabel, identificat după numele elementului. Folosiți-l pentru valori care se "
"schimbă rar: fiecare modificare este consemnată în istoricul inventarului, "
"așa că un contor aici face acele fișiere să crească nelimitat. Inventarul "
"rulează după propriul program (mai lent), nu la fiecare interval de "
"verificare."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:321
msgid "Inventory tree node"
msgstr "Nodul din arborele de inventar"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:323
msgid ""
"Dotted path of the node the value is written to, e.g. 'software.applications."
"json_api'. Must start with 'hardware', 'software' or 'networking'."
msgstr ""
"Calea cu puncte a nodului în care se scrie valoarea, de ex. 'software."
"applications.json_api'. Trebuie să înceapă cu 'hardware', 'software' sau "
"'networking'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:334
msgid "Attribute name"
msgstr "Numele atributului"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:336
msgid ""
"Name of the attribute (or, for a '[*]' wildcard, the column). Defaults to "
"the JSON path's last segment."
msgstr ""
"Numele atributului (sau al coloanei, la un metacaracter '[*]'). Implicit, "
"ultimul segment al căii JSON."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:345
msgid "Also create a service for this field"
msgstr "Creează și un serviciu pentru acest câmp"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:347
msgid ""
"Off by default: an inventory field creates NO service, which is the point - "
"it does not consume a service slot or a check interval to report something "
"that changes twice a year. Turn it on for a value you want in the inventory "
"AND want to alert on, e.g. a version you also match against a regex."
msgstr ""
"Dezactivat implicit: un câmp de inventar NU creează niciun serviciu, iar "
"acesta este scopul - nu ocupă un loc de serviciu și nici un interval de "
"verificare pentru a raporta ceva ce se schimbă de două ori pe an. Activați-l "
"pentru o valoare pe care o vreți în inventar ȘI pentru care vreți alerte, de "
"ex. o versiune pe care o comparați și cu o expresie regulată."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:363
msgid "Authentication"
msgstr "Autentificare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:368
msgid "Basic authentication (username / password)"
msgstr "Autentificare de bază (nume de utilizator / parolă)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:374
msgid "Username"
msgstr "Nume de utilizator"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:381
msgid "Password"
msgstr "Parolă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:390
msgid "Bearer token"
msgstr "Token Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:396
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:397
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Trimis ca 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:406
msgid "API key in a request header"
msgstr "Cheie API într-un antet al cererii"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:412
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:958
msgid "Header name"
msgstr "Nume antet"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:414
msgid ""
"Name of the header carrying the key, e.g. 'X-API-Key', 'apikey' or 'PRIVATE-"
"TOKEN'. For 'Authorization: Bearer <token>' use the bearer token choice "
"instead."
msgstr ""
"Numele antetului care conține cheia, de ex. 'X-API-Key', 'apikey' sau "
"'PRIVATE-TOKEN'. Pentru 'Authorization: Bearer <token>' folosiți în schimb "
"opțiunea token Bearer."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:426
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:465
msgid "API key"
msgstr "Cheie API"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:428
msgid ""
"Kept in the Checkmk password store. Unlike a key typed into 'Additional "
"request headers' it is never written to the configuration or to the agent's "
"command line in clear text, and it can be rotated in one place."
msgstr ""
"Este păstrată în depozitul de parole Checkmk. Spre deosebire de o cheie "
"introdusă în 'Anteturi de cerere suplimentare', nu este scrisă niciodată în "
"clar în configurație sau în linia de comandă a agentului și poate fi rotită "
"într-un singur loc."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:442
msgid "API key in a query parameter"
msgstr "Cheie API într-un parametru de interogare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:448
msgid "Parameter name"
msgstr "Nume parametru"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:450
msgid ""
"Name of the query parameter carrying the key, e.g. 'api_key'. It is appended "
"to the URL for the request only: the key is redacted wherever the agent "
"reports a URL, and it never appears in the service name. Prefer a header "
"where the API offers one - a key in the URL is visible to proxies and server "
"logs along the way."
msgstr ""
"Numele parametrului de interogare care conține cheia, de ex. 'api_key'. Este "
"adăugat la URL doar pentru cerere: cheia este mascată oriunde agentul "
"raportează un URL și nu apare niciodată în numele serviciului. Preferați un "
"antet dacă API-ul oferă unul - o cheie din URL este vizibilă pentru proxy-"
"uri și pentru jurnalele serverelor de pe traseu."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:467
msgid ""
"Kept in the Checkmk password store, so it is not written to the "
"configuration or to the agent's command line in clear text - unlike a key "
"typed into the URL."
msgstr ""
"Este păstrată în depozitul de parole Checkmk, deci nu este scrisă în clar în "
"configurație sau în linia de comandă a agentului - spre deosebire de o cheie "
"introdusă în URL."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:511
msgid "Field to monitor"
msgstr "Câmp de monitorizat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:518
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:132
msgid "Service name"
msgstr "Nume serviciu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:519
msgid "Becomes the Checkmk service description for this field."
msgstr "Devine descrierea serviciului Checkmk pentru acest câmp."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:526
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:611
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1189
msgid "JSON path"
msgstr "Cale JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:528
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\". To monitor a RESPONSE HEADER instead of a field of the body, prefix "
"its name with '@header.', e.g. '@header.X-RateLimit-Remaining' for an API "
"quota or '@header.Last-Modified' with 'Interpret the value as' set to a "
"timestamp for the age of the data. Header names are matched case-"
"insensitively and none of the path syntax above applies to them."
msgstr ""
"Cale cu puncte în răspunsul JSON, de ex. 'status', 'components.db.status' "
"sau 'items[0].count'. Utilizați un metacaracter '[*]' (de ex. 'nodes[*]."
"health') pentru a crea câte un serviciu per element de matrice - sau, când "
"metacaracterul ajunge pe un obiect JSON (o hartă indexată după nume, precum "
"un '/health' de Spring Boot Actuator 'components[*].status'), câte un "
"serviciu per cheie. Mai multe metacaractere '[*]' (de ex. 'pods[*]."
"containers[*].ready') extind produsul cartezian, câte un serviciu per "
"combinație. Un prefix '$.' este opțional. Cheile care conțin ele însele '.' "
"sau '[' pot fi adresate cu segmente între paranteze și ghilimele, de ex. "
"\"data['foo.bar'].value\". Pentru a monitoriza un ANTET DE RĂSPUNS în loc de "
"un câmp din corp, adăugați prefixul '@header.' la numele său, de exemplu "
"'@header.X-RateLimit-Remaining' pentru o cotă API sau '@header.Last-"
"Modified' cu 'Interpretează valoarea ca' setat pe o marcă temporală pentru "
"vechimea datelor. Numele antetelor sunt comparate fără a ține cont de "
"majuscule și niciuna dintre sintaxele de cale de mai sus nu li se aplică."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:554
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "Sufix de nume per element (pentru metacaractere '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:556
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"Când calea JSON conține un metacaracter '[*]', este creat câte un serviciu "
"pentru fiecare element. Această cale opțională - relativă la fiecare "
"element, de ex. 'name' sau 'id' - este adăugată la numele serviciului pentru "
"a diferenția aceste servicii. NU înlocuiește numele serviciului. Implicit se "
"folosește indicele matricei (sau, pentru un obiect, cheia). Cu mai multe "
"metacaractere '[*]' este rezolvată la fiecare nivel, iar părțile sunt unite "
"cu ' / ' (de ex. '<pod> / <container>'). Alegeți un câmp care este unic și "
"stabil între rulări."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:571
msgid "Create one host per element, named by this field"
msgstr "Creează câte o gazdă pentru fiecare element, denumită după acest câmp"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:573
msgid ""
"When the JSON path contains a '[*]' wildcard, this turns every element into "
"a Checkmk host of its own instead of one more service on this host. Give a "
"path relative to each element that holds the host name, e.g. 'name' or "
"'hostname'. The service then keeps its plain name, because the host already "
"says which element it is. Set the same field on several fields of this "
"endpoint to collect them all on the same hosts. Only characters valid in a "
"Checkmk host name are kept (letters, digits, '-', '_', '.'); anything else "
"becomes '_'. An element whose field is missing keeps its service on this "
"host, so nothing is lost. IMPORTANT: Checkmk holds piggyback data for hosts "
"that do not exist yet - create the hosts (manually or with Dynamic host "
"management) or the data is never monitored."
msgstr ""
"Când calea JSON conține un metacaracter '[*]', fiecare element devine o "
"gazdă Checkmk proprie, în loc de încă un serviciu pe această gazdă. Indicați "
"o cale relativă la fiecare element care conține numele gazdei, de ex. 'name' "
"sau 'hostname'. Serviciul își păstrează astfel numele simplu, deoarece gazda "
"indică deja despre ce element este vorba. Setați același câmp la mai multe "
"câmpuri ale acestui endpoint pentru a le colecta pe toate pe aceleași gazde. "
"Sunt păstrate numai caracterele valide într-un nume de gazdă Checkmk "
"(litere, cifre, '-', '_', '.'); orice altceva devine '_'. Un element al "
"cărui câmp lipsește își păstrează serviciul pe această gazdă, astfel încât "
"nimic nu se pierde. IMPORTANT: Checkmk reține datele piggyback pentru "
"gazdele care nu există încă - creați gazdele (manual sau cu gestionarea "
"dinamică a gazdelor), altfel datele nu vor fi niciodată monitorizate."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:594
msgid "Service labels"
msgstr "Etichete de serviciu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:596
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"Atașează etichete de serviciu Checkmk la ACEST serviciu, create din câmpuri "
"ale răspunsului. Fiecare cheie primește prefixul 'json_api/'. Pentru o cale "
"'[*]' valoarea este rezolvată în cadrul fiecărui element (de ex. 'name'), "
"astfel încât fiecare serviciu per element primește propria etichetă; pentru "
"o cale fără metacaractere este rezolvată din rădăcina răspunsului. Faptele "
"valabile pentru întreaga gazdă aparțin în schimb 'Etichetelor de gazdă' ale "
"punctului final. Etichetele sunt setate în timpul descoperirii, deci alegeți "
"câmpuri stabile și cu cardinalitate redusă - o valoare care se schimbă face "
"ca eticheta să varieze constant."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:613
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"Relativă la fiecare element '[*]' (ca sufixul de nume) sau rădăcina "
"răspunsului pentru o cale fără metacaractere."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:623
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1201
msgid "Label key (optional)"
msgstr "Cheia etichetei (opțional)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:625
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"Implicit, ultimul segment al căii. Prefixul 'json_api/' este adăugat automat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:637
msgid "Aggregate a collection into one value"
msgstr "Agregă o colecție într-o singură valoare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:639
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"Reduce o colecție de elemente la un singur număr în loc să monitorizeze o "
"singură valoare (sau, cu un metacaracter '[*]', un serviciu per element). "
"Calea JSON indică fie un tablou / obiect (de ex. 'jobs'), fie un "
"metacaracter '[*]' peste valorile de agregat (de ex. 'nodes[*].load'). "
"'Numărul de elemente' doar le numără; celelalte funcții necesită valori "
"numerice. Rezultatul este un număr, deci unitatea, nivelurile, transformarea "
"și metrica i se aplică. Împreună cu condiția de mai jos se agregă numai "
"elementele care corespund. O cale care nu conține nici tablou, nici obiect "
"face serviciul UNKNOWN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:652
msgid "Number of elements"
msgstr "Numărul de elemente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:653
msgid "Sum of the values"
msgstr "Suma valorilor"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:654
msgid "Average of the values"
msgstr "Media valorilor"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:655
msgid "Smallest of the values"
msgstr "Cea mai mică dintre valori"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:656
msgid "Largest of the values"
msgstr "Cea mai mare dintre valori"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:664
msgid "Only elements matching a condition"
msgstr "Doar elementele care îndeplinesc o condiție"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:666
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"Pentru un metacaracter '[*]' sau o cale agregată: se păstrează numai "
"elementele al căror subcâmp îndeplinește această condiție – de ex. un "
"serviciu pentru fiecare nod al cărui 'status' nu este 'ok', sau numărarea "
"doar a pod-urilor care nu sunt 'Running'. Calea câmpului este rezolvată în "
"interiorul fiecărui element; un element al cărui câmp lipsește sau nu este "
"scalar este eliminat. Fără un metacaracter '[*]' sau o agregare, acest lucru "
"nu are efect."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:678
msgid "Field path (within each element)"
msgstr "Calea câmpului (în cadrul fiecărui element)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:680
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr ""
"Rezolvat în cadrul fiecărui element, de ex. 'status' sau 'metadata.phase'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:689
msgid "Condition"
msgstr "Condiție"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:691
msgid "equals"
msgstr "este egal cu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:692
msgid "does not equal"
msgstr "nu este egal cu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:693
msgid "matches regex"
msgstr "se potrivește cu regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:694
msgid "does not match regex"
msgstr "nu se potrivește cu regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:702
msgid "Comparison value / pattern"
msgstr "Valoare de comparație / model"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:704
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr ""
"Valoarea cu care se compară sau expresia regulată pentru condițiile regex."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:715
msgid "Interpret the value as"
msgstr "Interpretează valoarea ca"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:717
msgid ""
"By default the extracted value is monitored as it stands. Two common API "
"values are worth deriving something else from: a counter that only ever "
"grows (its rate of change is what matters, not the total), and a timestamp "
"(its age is what matters, not the date). The derived number is what the "
"transform, the levels, the metric and the summary then use."
msgstr ""
"În mod implicit, valoarea extrasă este monitorizată așa cum este. Pentru "
"două valori API frecvente merită să derivi altceva: un contor care doar "
"crește (contează rata de variație, nu totalul) și o marcă temporală "
"(contează vechimea, nu data). Numărul derivat este cel folosit apoi de "
"transformare, niveluri, metrică și sumar."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:729
msgid "A counter - monitor its per-second rate"
msgstr "Un contor – monitorizează rata pe secundă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:732
msgid "Per-second rate"
msgstr "Rată pe secundă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:734
msgid "The difference to the previous check is divided by the elapsed time"
msgstr ""
"Diferența față de verificarea anterioară este împărțită la timpul scurs"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:738
msgid ""
"For monotonically growing counters such as 'requests_total' or 'bytes_sent': "
"the check monitors the change per second instead of the absolute total. The "
"first check after a restart of the counter cannot compute a rate yet and "
"keeps the service's previous state."
msgstr ""
"Pentru contoare care cresc monoton, precum 'requests_total' sau "
"'bytes_sent': verificarea monitorizează variația pe secundă în loc de "
"totalul absolut. Prima verificare după o repornire a contorului nu poate "
"calcula încă o rată și păstrează starea anterioară a serviciului."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:749
msgid "A timestamp - monitor its age"
msgstr "O marcă temporală – monitorizează vechimea"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:752
msgid ""
"For values such as 'last_backup' or 'updated_at': the check monitors the "
"number of seconds since that point in time, so upper levels alert on stale "
"data. A timestamp in the future yields a negative age. The age graphs and "
"reads as a duration on its own; choose a unit below only to override that (e."
"g. after a transform into hours)."
msgstr ""
"Pentru valori precum 'last_backup' sau 'updated_at': verificarea "
"monitorizează numărul de secunde scurse din acel moment, astfel încât "
"nivelurile superioare avertizează asupra datelor învechite. O marcă "
"temporală în viitor dă o vechime negativă. Vechimea este afișată și "
"reprezentată grafic ca durată de la sine; alegeți o unitate mai jos doar "
"pentru a suprascrie acest lucru (de ex. după o transformare în ore)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:765
msgid "Timestamp format"
msgstr "Formatul mărcii temporale"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:767
msgid ""
"'Detect automatically' reads a number as Unix epoch seconds (milliseconds "
"when it is far too large for seconds) and anything else as ISO 8601. A "
"timestamp without a time zone is read as UTC."
msgstr ""
"'Detectează automat' citește un număr ca secunde epoch Unix (milisecunde "
"când este mult prea mare pentru secunde) și orice altceva ca ISO 8601. O "
"marcă temporală fără fus orar este citită ca UTC."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:776
msgid "Detect automatically"
msgstr "Detectează automat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:779
msgid "Unix epoch seconds"
msgstr "Secunde epoch Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:783
msgid "Unix epoch milliseconds"
msgstr "Milisecunde epoch Unix"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:788
msgid "ISO 8601 / RFC 3339, e.g. '2026-07-28T02:00:00Z'"
msgstr "ISO 8601 / RFC 3339, de ex. '2026-07-28T02:00:00Z'"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:805
msgid "Unit (for numeric values)"
msgstr "Unitate (pentru valori numerice)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:807
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Redă metrica și graficul cu această unitate. Lăsați nesetat pentru o valoare "
"simplă, fără unitate. Afectează doar valorile numerice."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:811
msgid "Count (integer)"
msgstr "Număr (întreg)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:812
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Octeți (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:813
msgid "Seconds (duration)"
msgstr "Secunde (durată)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:814
msgid "Percent"
msgstr "Procent"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:816
msgid "No unit"
msgstr "Fără unitate"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:830
msgid "Transform the numeric value"
msgstr "Transformă valoarea numerică"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:832
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius). A second field can be brought in as 'other' - see below - which is "
"what turns a used/total pair into a percentage: 'value / other * 100'."
msgstr ""
"O expresie aritmetică aplicată unei valori numerice înainte de niveluri și "
"de metrică, utilizând variabila 'value'. Sunt permise numai numere, "
"paranteze și + - * /. Exemple: 'value / 1024 / 1024' (octeți în MiB), 'value "
"* 1000' (secunde în milisecunde), '(value - 32) * 5 / 9' (Fahrenheit în "
"Celsius). Un al doilea câmp poate fi adus ca 'other' - vezi mai jos -, ceea "
"ce transformă o pereche utilizat/total într-un procent: 'value / other * "
"100'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:849
msgid "Second path for the transform ('other')"
msgstr "A doua cale pentru transformare ('other')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:851
msgid ""
"A second field, made available to the transform above as the variable "
"'other'. Most APIs report a used/total or current/limit pair rather than a "
"percentage, so this is what lets one service monitor the ratio: point the "
"JSON path at 'used', this at 'total', and use 'value / other * 100' with the "
"unit set to '%'. It is resolved in the SAME scope as the value - within each "
"'[*]' element, or the response root without a wildcard - so every element is "
"compared against its own total. The transform must actually use 'other', and "
"'other' requires this path; either one alone is rejected."
msgstr ""
"Un al doilea câmp, pus la dispoziția transformării de mai sus ca variabila "
"'other'. Majoritatea API-urilor raportează o pereche utilizat/total sau "
"curent/limită în loc de un procent, iar acest lucru permite unui serviciu să "
"monitorizeze raportul: îndreptați calea JSON către 'used', aceasta către "
"'total' și folosiți 'value / other * 100' cu unitatea '%'. Este rezolvată în "
"ACELAȘI domeniu ca valoarea - în interiorul fiecărui element '[*]' sau în "
"rădăcina răspunsului fără metacaracter - astfel încât fiecare element este "
"comparat cu propriul său total. Transformarea trebuie să folosească efectiv "
"'other', iar 'other' necesită această cale; oricare dintre ele singură este "
"respinsă."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:873
msgid "Extra text in the service summary"
msgstr "Text suplimentar în rezumatul serviciului"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:875
#, python-brace-format
msgid ""
"Appended to the summary, after the value. Write '{path}' to insert another "
"field of the same response - resolved within the current element for a '[*]' "
"wildcard, from the response root otherwise. So a service on 'status' can "
"show the reason the API gave next to it, e.g. '{message} (leader {leader})', "
"instead of needing a second service for it. A path that is not in the "
"response renders as '(n/a)'. This is presentation only: it never changes the "
"state, the levels or the metric. The text is put on one line and truncated "
"if it gets long."
msgstr ""
"Este adăugat la rezumat, după valoare. Scrieți '{path}' pentru a insera alt "
"câmp din același răspuns - rezolvat în interiorul elementului curent pentru "
"un metacaracter '[*]', altfel de la rădăcina răspunsului. Astfel, un "
"serviciu pe 'status' poate afișa alături motivul pe care API-ul l-a returnat "
"oricum, de ex. '{message} (leader {leader})', în loc să fie nevoie de un al "
"doilea serviciu. O cale care nu se află în răspuns este afișată ca '(n/a)'. "
"Aceasta este doar prezentare: nu schimbă niciodată starea, pragurile sau "
"metrica. Textul este pus pe un singur rând și trunchiat dacă devine lung."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:900
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:140
msgid "Endpoint"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:906
msgid "Endpoint name"
msgstr "Numele endpointului"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:908
msgid ""
"Optional short name for this endpoint, e.g. 'frontend'. It names the "
"endpoint's own service - 'JSON API <name>', which reports the HTTP status "
"and the response time of the request. Without a name the URL is used. It "
"does not change the field service names."
msgstr ""
"Nume scurt opțional pentru acest endpoint, de ex. 'frontend'. Denumește "
"serviciul propriu al endpointului – 'JSON API <nume>', care raportează "
"starea HTTP și timpul de răspuns al cererii. Fără nume se folosește URL-ul. "
"Nu schimbă numele serviciilor câmpurilor."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:920
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:922
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL complet al endpoint-ului JSON, inclusiv schema, de ex. 'https://app."
"example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:931
msgid "HTTP method"
msgstr "Metodă HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:933
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:934
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:942
msgid "Request body (for POST)"
msgstr "Corpul cererii (pentru POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:948
msgid "Additional request headers"
msgstr "Anteturi de cerere suplimentare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:950
msgid ""
"Sent with every request to this endpoint. Values are stored in clear text "
"and travel on the agent's command line, so an API key belongs under "
"'Authentication' - not here."
msgstr ""
"Trimise cu fiecare cerere către acest endpoint. Valorile sunt stocate în "
"clar și apar în linia de comandă a agentului, așa că o cheie API își are "
"locul la 'Autentificare' - nu aici."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:962
msgid "Header value"
msgstr "Valoare antet"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:975
msgid "Verify the TLS certificate"
msgstr "Verifică certificatul TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:976
msgid "Disabling certificate verification is insecure."
msgstr "Dezactivarea verificării certificatului nu este sigură."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:983
msgid "Custom CA bundle file"
msgstr "Fișier bundle CA personalizat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:985
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"Calea pe serverul Checkmk către un fișier PEM cu certificatul/certificatele "
"CA față de care se verifică certificatul serverului. Folosiți-l pentru a "
"avea încredere într-o CA internă sau privată fără a dezactiva verificarea. "
"Ignorat când verificarea TLS este dezactivată."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:996
msgid "Client certificate (mutual TLS)"
msgstr "Certificat de client (TLS reciproc)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:998
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"Prezentați serverului un certificat de client (TLS reciproc). Fișierele "
"trebuie să existe pe serverul Checkmk. Cheia privată trebuie să fie "
"necriptată."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1006
msgid "Client certificate file"
msgstr "Fișier certificat de client"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1008
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"Calea către certificatul de client (PEM). Dacă fișierul conține și cheia "
"privată, lăsați câmpul cheii gol."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1018
msgid "Private key file"
msgstr "Fișier cheie privată"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1020
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr ""
"Calea către cheia privată a clientului (PEM), dacă nu este inclusă în "
"certificat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1032
msgid "Follow HTTP redirects"
msgstr "Urmărește redirecționările HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1034
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Activat implicit. Dezactivați în medii securizate pentru a proteja împotriva "
"SSRF: o țintă care redirecționează (de ex. 3xx către o adresă internă) va "
"eșua atunci în loc să fie urmărită până la locația de redirecționare."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1045
msgid "Request timeout (seconds)"
msgstr "Timp de expirare a cererii (secunde)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1046
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Timp de expirare per cerere. Implicit 30 de secunde."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1054
msgid "Re-read at most every (seconds)"
msgstr "Recitește cel mult la fiecare (secunde)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1056
msgid ""
"Reuse the last response for this endpoint instead of requesting it again, as "
"long as it is younger than this. For APIs with a request quota, expensive "
"endpoints, or a rule shared across many hosts - anything where the request "
"RATE is the problem rather than the freshness of the data. Without it, every "
"check interval on every host issues a request, which can exhaust a quota and "
"turn the monitoring itself into the outage. Only a response that parsed as "
"JSON is cached, and a failing request is never answered from an expired "
"cache - a real outage must not hide behind stale data. While a cached body "
"is served the endpoint's own service says so and reports no response time, "
"because no request was made. Leave unset to always fetch fresh."
msgstr ""
"Reutilizează ultimul răspuns al acestui endpoint în loc să îl solicite din "
"nou, atât timp cât este mai recent decât această valoare. Pentru API-uri cu "
"o cotă de cereri, endpointuri costisitoare sau o regulă partajată între "
"multe gazde - oriunde problema este RITMUL cererilor și nu prospețimea "
"datelor. Fără această setare, fiecare interval de verificare pe fiecare "
"gazdă emite o cerere, ceea ce poate epuiza o cotă și poate transforma "
"monitorizarea însăși în defecțiune. Este pus în cache numai un răspuns care "
"a putut fi analizat ca JSON, iar o cerere eșuată nu este niciodată servită "
"dintr-un cache expirat - o defecțiune reală nu trebuie să se ascundă în "
"spatele datelor învechite. Cât timp este servit un conținut din cache, "
"serviciul propriu al endpointului semnalează acest lucru și nu raportează "
"niciun timp de răspuns, deoarece nu a fost făcută nicio cerere. Lăsați "
"nesetat pentru a interoga întotdeauna în direct."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1078
msgid "Retry a failed request"
msgstr "Reîncearcă o cerere eșuată"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1080
msgid ""
"Repeat this endpoint's request when it fails in a way a repeat could fix - a "
"connection error, a timeout, or an HTTP 429 / 5xx - so a load balancer "
"dropping connections for a second during a rolling restart does not become a "
"CRIT and a notification. A 4xx, a body that is not JSON and an oversized "
"response are never retried: repeating them would only burn time. Nothing is "
"hidden - the endpoint's own service reports that a retry was needed, and can "
"be told to go WARN when one is. Every attempt costs wall-clock time inside "
"the check: the worst case is (1 + retries) times the request timeout, plus "
"the waiting time between attempts. Off by default."
msgstr ""
"Repetă cererea către acest endpoint atunci când eșuează într-un mod pe care "
"o repetare îl poate rezolva - o eroare de conexiune, un timeout sau un HTTP "
"429 / 5xx -, astfel încât un echilibrator de încărcare care întrerupe "
"conexiunile pentru o secundă în timpul unei reporniri progresive să nu "
"devină un CRIT și o notificare. Un 4xx, un corp care nu este JSON și un "
"răspuns prea mare nu sunt niciodată reîncercate: repetarea lor ar consuma "
"doar timp. Nu se ascunde nimic - serviciul propriu al endpointului "
"raportează că a fost nevoie de o reîncercare și poate fi setat să treacă în "
"WARN atunci. Fiecare încercare consumă timp real în interiorul verificării: "
"în cel mai rău caz (1 + reîncercări) ori timeoutul cererii, plus așteptările "
"dintre încercări. Dezactivat implicit."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1097
msgid "Number of retries"
msgstr "Numărul de reîncercări"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1098
msgid "Extra attempts after the first one failed."
msgstr "Încercări suplimentare după eșuarea primeia."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1108
msgid "Wait before retrying (seconds)"
msgstr "Așteptare înainte de reîncercare (secunde)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1110
msgid ""
"Waiting time before the first retry, doubled for each further one. The total "
"waiting time is capped at 30 seconds however many retries are configured."
msgstr ""
"Timpul de așteptare înainte de prima reîncercare, dublat pentru fiecare "
"următoare. Așteptarea totală este limitată la 30 de secunde, oricâte "
"reîncercări ar fi configurate."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1127
msgid "Additional accepted HTTP status codes"
msgstr "Coduri de stare HTTP suplimentare acceptate"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1129
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"În mod implicit sunt citite doar răspunsurile 2xx; orice altă stare trece "
"serviciile endpointului pe UNKNOWN. Adăugați aici coduri de stare "
"suplimentare de acceptat – de exemplu 503 pentru un endpoint de sănătate "
"care își raportează problemele cu un 503 și un corp JSON. Corpul unui "
"răspuns acceptat este analizat și extras ca de obicei. 2xx este întotdeauna "
"acceptat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1137
msgid "Status code"
msgstr "Cod de stare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1145
msgid "HTTP proxy"
msgstr "Proxy HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1147
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"Direcționați cererea acestui endpoint printr-un proxy HTTP - util atunci "
"când serverul Checkmk ajunge la API doar printr-un proxy de ieșire "
"corporativ. Alegeți variabilele de mediu HTTP_PROXY / HTTPS_PROXY, un URL de "
"proxy explicit sau 'fără proxy' pentru a ocoli orice proxy setat în mediu. "
"Fără această setare, sunt respectate variabilele de proxy ale mediului."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1161
msgid "Fields to monitor"
msgstr "Câmpuri de monitorizat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1163
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Fiecare intrare devine un serviciu Checkmk, construit din valoarea găsită la "
"calea JSON dată."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1172
msgid "Host labels"
msgstr "Etichete de gazdă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1174
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Set at discovery, so pick stable, low-"
"cardinality fields."
msgstr ""
"Atașează etichete de gazdă Checkmk gazdei monitorizate, create din câmpuri "
"ale răspunsului acestui punct final. Fiecare cheie primește prefixul "
"'json_api/' și valoarea este rezolvată din rădăcina răspunsului - deci "
"acestea sunt informații valabile pentru întreaga gazdă (de ex. un mediu, o "
"regiune sau o versiune) și NU necesită niciun serviciu. O cale poate conține "
"un metacaracter '[*]' (de ex. 'components[*]') pentru a emite o etichetă per "
"element, cu cheia '<key>/<element>' astfel încât cheile să rămână unice. "
"Setate în timpul descoperirii, deci alegeți câmpuri stabile și cu "
"cardinalitate redusă."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1191
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element."
msgstr ""
"Din rădăcina răspunsului, de ex. 'version', 'cluster.region' sau un "
"metacaracter '[*]' precum 'components[*]' pentru o etichetă per element."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1203
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"Implicit, ultimul segment al căii. Pentru o cale '[*]' se adaugă id-ul "
"elementului ('<key>/<element>'). Prefixul 'json_api/' este adăugat automat."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1213
msgid "Value field (for '[*]' wildcards)"
msgstr "Câmp de valoare (pentru metacaractere '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1215
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"Pentru o cale '[*]': o cale în cadrul fiecărui element pentru valoarea "
"etichetei (de ex. 'status'). Implicit 'true' (o etichetă de apartenență). "
"Ignorat fără metacaracter."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1248
msgid "Endpoints"
msgstr "Endpoint-uri"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1250
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Unul sau mai multe endpoint-uri HTTP/JSON. Fiecare este preluat cu propriile "
"setări de conexiune și extrageri; toate rezultatele sunt îmbinate într-o "
"singură secțiune. Un endpoint care nu poate fi accesat afectează doar "
"propriile servicii."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:1265
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:129
msgid "Generic JSON API"
msgstr "API JSON generic"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:66
msgid "Upper levels for the response time"
msgstr "Niveluri superioare pentru timpul de răspuns"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:68
msgid ""
"How long the request to this endpoint may take, in seconds. Measured from "
"sending the request to having read the whole response body. Without levels "
"the response time is only recorded as a metric."
msgstr ""
"Cât poate dura cererea către acest endpoint, în secunde. Măsurat de la "
"trimiterea cererii până la citirea completă a corpului răspunsului. Fără "
"niveluri, timpul de răspuns este doar înregistrat ca metrică."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:81
msgid "Lower levels for the TLS certificate's remaining validity"
msgstr "Praguri inferioare pentru valabilitatea rămasă a certificatului TLS"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:83
msgid ""
"How many days the endpoint's TLS certificate must still be valid for. Read "
"from the connection the agent already makes, so no second check against the "
"same URL is needed. Only available for HTTPS endpoints with certificate "
"verification enabled; otherwise the certificate is not reported and these "
"levels never apply. Without levels the remaining validity is only recorded "
"as a metric."
msgstr ""
"Câte zile trebuie să mai fie valid certificatul TLS al endpointului. Este "
"citit din conexiunea pe care agentul o stabilește oricum, deci nu este "
"nevoie de o a doua verificare pe același URL. Disponibil numai pentru "
"endpointuri HTTPS cu verificarea certificatului activată; în caz contrar "
"certificatul nu este raportat și aceste praguri nu se aplică niciodată. Fără "
"praguri, valabilitatea rămasă este înregistrată doar ca metrică."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:99
msgid "State when the request needed a retry"
msgstr "Starea când cererea a avut nevoie de o reîncercare"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:101
msgid ""
"Applies when the endpoint's retry policy absorbed a failed attempt: the "
"request did succeed, but not on the first try. OK by default - a retry doing "
"its job is not itself a problem. Raise it for an endpoint whose flakiness is "
"worth knowing about, so retries never quietly turn a degrading API into a "
"permanently green service."
msgstr ""
"Se aplică atunci când politica de reîncercare a endpointului a absorbit o "
"încercare eșuată: cererea a reușit, dar nu din prima. Implicit OK - o "
"reîncercare care își face treaba nu este în sine o problemă. Ridicați-o "
"pentru un endpoint a cărui instabilitate merită cunoscută, astfel încât "
"reîncercările să nu transforme în tăcere un API care se degradează într-un "
"serviciu permanent verde."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:114
msgid "State when the endpoint cannot be read"
msgstr "Starea când endpointul nu poate fi citit"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:116
msgid ""
"Applies when the request fails outright: connection refused, a TLS error, a "
"timeout, an HTTP status that is not accepted, or a response that is not JSON."
msgstr ""
"Se aplică atunci când cererea eșuează complet: conexiune refuzată, o eroare "
"TLS, un timeout, un stare HTTP neacceptată sau un răspuns care nu este JSON."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:137
msgid "Generic JSON API endpoint"
msgstr "Endpoint API JSON generic"

