#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Expresie regulată invalidă: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "Niveluri superioare (pentru valori numerice)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "Niveluri inferioare (pentru valori numerice)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "Potrivire de șiruri de caractere"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr ""
"Cum se transformă o valoare șir de caractere într-o stare de serviciu "
"Checkmk."

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "Valoarea trebuie să corespundă unei expresii regulate"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "Valoare așteptată (regex)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Pentru valori șir de caractere: valoarea trebuie să corespundă complet "
"acestei expresii regulate (de ex. 'UP|ok')."

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "Starea când valoarea nu corespunde"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Asociază valoarea unei stări (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Pentru valori șir de caractere cu mai multe stări cunoscute: fiecare model "
"este o expresie regulată comparată cu întreaga valoare. Sunt încercate în "
"ordinea OK, WARN, CRIT și prima potrivire câștigă."

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "OK când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "WARN când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "CRIT când valoarea corespunde (regex)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "Starea când nimic nu corespunde"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:76
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "Expresie aritmetică invalidă: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:81
msgid ""
"Only the variable 'value', numbers, parentheses and + - * / are allowed."
msgstr "Sunt permise numai variabila 'value', numere, paranteze și + - * /."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:85
#, python-format
msgid "Unknown variable '%s' - only 'value' is available."
msgstr "Variabilă necunoscută '%s' - numai 'value' este disponibilă."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:90
msgid "Only numeric constants are allowed."
msgstr "Numai constante numerice sunt permise."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:106
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Fiecare URL de endpoint trebuie să fie unic. Duplicat: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:116
msgid "The URL must not contain whitespace."
msgstr "URL-ul nu trebuie să conțină spații albe."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:120
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Introduceți un URL http(s) valid, de ex. 'https://host/cale'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:126
msgid "Authentication"
msgstr "Autentificare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:131
msgid "Basic authentication (username / password)"
msgstr "Autentificare de bază (nume de utilizator / parolă)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:137
msgid "Username"
msgstr "Nume de utilizator"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:144
msgid "Password"
msgstr "Parolă"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:153
msgid "Bearer token"
msgstr "Token Bearer"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:159
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:160
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Trimis ca 'Authorization: Bearer <token>'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:192
msgid "Field to monitor"
msgstr "Câmp de monitorizat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:198
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:51
msgid "Service name"
msgstr "Nume serviciu"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:199
msgid "Becomes the Checkmk service description for this field."
msgstr "Devine descrierea serviciului Checkmk pentru acest câmp."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:206
msgid "JSON path"
msgstr "Cale JSON"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:208
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\"."
msgstr ""
"Cale cu puncte în răspunsul JSON, de ex. 'status', 'components.db.status' "
"sau 'items[0].count'. Utilizați un metacaracter '[*]' (de ex. 'nodes[*]."
"health') pentru a crea câte un serviciu per element de matrice - sau, când "
"metacaracterul ajunge pe un obiect JSON (o hartă indexată după nume, precum "
"un '/health' de Spring Boot Actuator 'components[*].status'), câte un "
"serviciu per cheie. Mai multe metacaractere '[*]' (de ex. 'pods[*]."
"containers[*].ready') extind produsul cartezian, câte un serviciu per "
"combinație. Un prefix '$.' este opțional. Cheile care conțin ele însele '.' "
"sau '[' pot fi adresate cu segmente între paranteze și ghilimele, de ex. "
"\"data['foo.bar'].value\"."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:228
msgid "Item label path (for '[*]' wildcards)"
msgstr "Cale etichetă element (pentru metacaractere '[*]')"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:230
msgid ""
"When the path contains a '[*]' wildcard, this optional path - relative to "
"each array element, e.g. 'name' or 'id' - provides the label appended to the "
"service name. Defaults to the array index (or, for an object, the key). With "
"multiple '[*]' wildcards it is resolved at every level and the labels are "
"joined with ' / ' (e.g. '<pod> / <container>'). Pick a field that is unique "
"and stable across runs."
msgstr ""
"Când calea conține un metacaracter '[*]', această cale opțională - relativă "
"la fiecare element de matrice, de ex. 'name' sau 'id' - furnizează eticheta "
"adăugată la numele serviciului. Implicit indicele matricei (sau, pentru un "
"obiect, cheia). Cu mai multe metacaractere '[*]' este rezolvată la fiecare "
"nivel, iar etichetele sunt unite cu ' / ' (de ex. '<pod> / <container>'). "
"Alegeți un câmp care este unic și stabil între rulări."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:247
msgid "Count the number of elements at this path"
msgstr "Numără elementele de la această cale"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:249
msgid ""
"When the path points at a JSON array or object, monitor the number of "
"elements it contains instead of the value itself. The count is a number, so "
"a unit, levels, a transform and a metric all apply to it. If the path does "
"not resolve to an array or object, the service becomes UNKNOWN."
msgstr ""
"Când calea indică o matrice sau un obiect JSON, monitorizează numărul de "
"elemente pe care le conține în loc de valoarea în sine. Numărătoarea este un "
"număr, așadar o unitate, niveluri, o transformare și o metrică se aplică "
"toate la aceasta. Dacă calea nu se rezolvă la o matrice sau un obiect, "
"serviciul devine UNKNOWN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:262
msgid "Unit (for numeric values)"
msgstr "Unitate (pentru valori numerice)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:264
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Redă metrica și graficul cu această unitate. Lăsați nesetat pentru o valoare "
"simplă, fără unitate. Afectează doar valorile numerice."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:268
msgid "Count (integer)"
msgstr "Număr (întreg)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:269
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Octeți (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:270
msgid "Seconds (duration)"
msgstr "Secunde (durată)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:271
msgid "Percent"
msgstr "Procent"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:273
msgid "No unit"
msgstr "Fără unitate"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:287
msgid "Transform the numeric value"
msgstr "Transformă valoarea numerică"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:289
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius)."
msgstr ""
"O expresie aritmetică aplicată unei valori numerice înainte de niveluri și "
"de metrică, utilizând variabila 'value'. Sunt permise numai numere, "
"paranteze și + - * /. Exemple: 'value / 1024 / 1024' (octeți în MiB), 'value "
"* 1000' (secunde în milisecunde), '(value - 32) * 5 / 9' (Fahrenheit în "
"Celsius)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:310
msgid "Endpoint"
msgstr "Endpoint"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:315
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:317
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"URL complet al endpoint-ului JSON, inclusiv schema, de ex. 'https://app."
"example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:326
msgid "HTTP method"
msgstr "Metodă HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:328
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:329
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:337
msgid "Request body (for POST)"
msgstr "Corpul cererii (pentru POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:343
msgid "Additional request headers"
msgstr "Anteturi de cerere suplimentare"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:348
msgid "Header name"
msgstr "Nume antet"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:352
msgid "Header value"
msgstr "Valoare antet"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:365
msgid "Verify the TLS certificate"
msgstr "Verifică certificatul TLS"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:366
msgid "Disabling certificate verification is insecure."
msgstr "Dezactivarea verificării certificatului nu este sigură."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:373
msgid "Follow HTTP redirects"
msgstr "Urmărește redirecționările HTTP"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:375
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Activat implicit. Dezactivați în medii securizate pentru a proteja împotriva "
"SSRF: o țintă care redirecționează (de ex. 3xx către o adresă internă) va "
"eșua atunci în loc să fie urmărită până la locația de redirecționare."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:386
msgid "Request timeout (seconds)"
msgstr "Timp de expirare a cererii (secunde)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:387
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Timp de expirare per cerere. Implicit 30 de secunde."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:395
msgid "Fields to monitor"
msgstr "Câmpuri de monitorizat"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:397
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Fiecare intrare devine un serviciu Checkmk, construit din valoarea găsită la "
"calea JSON dată."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:424
msgid "Endpoints"
msgstr "Endpoint-uri"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:426
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Unul sau mai multe endpoint-uri HTTP/JSON. Fiecare este preluat cu propriile "
"setări de conexiune și extrageri; toate rezultatele sunt îmbinate într-o "
"singură secțiune. Un endpoint care nu poate fi accesat afectează doar "
"propriile servicii."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:441
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:48
msgid "Generic JSON API"
msgstr "API JSON generic"

