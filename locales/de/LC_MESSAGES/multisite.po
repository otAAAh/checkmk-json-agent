#: cmk_addons/plugins/json_api/lib.py:40
#, python-format
msgid "Invalid regular expression: %s"
msgstr "Ungültiger regulärer Ausdruck: %s"

#: cmk_addons/plugins/json_api/lib.py:46
msgid "Upper levels (for numeric values)"
msgstr "Obergrenzen (für numerische Werte)"

#: cmk_addons/plugins/json_api/lib.py:55
msgid "Lower levels (for numeric values)"
msgstr "Untergrenzen (für numerische Werte)"

#: cmk_addons/plugins/json_api/lib.py:64
msgid "String matching"
msgstr "Zeichenketten-Abgleich"

#: cmk_addons/plugins/json_api/lib.py:65
msgid "How to turn a string value into a Checkmk service state."
msgstr ""
"Wie ein Zeichenketten-Wert in einen Checkmk-Dienstzustand umgewandelt wird."

#: cmk_addons/plugins/json_api/lib.py:70
msgid "Value must match a regular expression"
msgstr "Wert muss auf einen regulären Ausdruck passen"

#: cmk_addons/plugins/json_api/lib.py:76
msgid "Expected value (regex)"
msgstr "Erwarteter Wert (regulärer Ausdruck)"

#: cmk_addons/plugins/json_api/lib.py:78
msgid ""
"For string values: the value must fully match this regular expression (e.g. "
"'UP|ok')."
msgstr ""
"Für Zeichenketten-Werte: Der Wert muss vollständig auf diesen regulären "
"Ausdruck passen (z. B. 'UP|ok')."

#: cmk_addons/plugins/json_api/lib.py:87
msgid "State when the value does not match"
msgstr "Zustand, wenn der Wert nicht passt"

#: cmk_addons/plugins/json_api/lib.py:96
msgid "Map the value to a state (OK / WARN / CRIT)"
msgstr "Wert einem Zustand zuordnen (OK / WARN / CRIT)"

#: cmk_addons/plugins/json_api/lib.py:99
msgid ""
"For string values with several known states: each pattern is a regular "
"expression matched against the whole value. They are tried in the order OK, "
"WARN, CRIT and the first match wins."
msgstr ""
"Für Zeichenketten-Werte mit mehreren bekannten Zuständen: Jedes Muster ist "
"ein regulärer Ausdruck, der gegen den gesamten Wert abgeglichen wird. Sie "
"werden in der Reihenfolge OK, WARN, CRIT geprüft, und der erste Treffer "
"gewinnt."

#: cmk_addons/plugins/json_api/lib.py:108
msgid "OK when the value matches (regex)"
msgstr "OK, wenn der Wert passt (regulärer Ausdruck)"

#: cmk_addons/plugins/json_api/lib.py:115
msgid "WARN when the value matches (regex)"
msgstr "WARN, wenn der Wert passt (regulärer Ausdruck)"

#: cmk_addons/plugins/json_api/lib.py:122
msgid "CRIT when the value matches (regex)"
msgstr "CRIT, wenn der Wert passt (regulärer Ausdruck)"

#: cmk_addons/plugins/json_api/lib.py:129
msgid "State when nothing matches"
msgstr "Zustand, wenn nichts passt"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:80
#, python-format
msgid "Invalid arithmetic expression: %s"
msgstr "Ungültiger arithmetischer Ausdruck: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:85
msgid ""
"Only the variable 'value', numbers, parentheses and + - * / are allowed."
msgstr "Nur die Variable 'value', Zahlen, Klammern und + - * / sind erlaubt."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:89
#, python-format
msgid "Unknown variable '%s' - only 'value' is available."
msgstr "Unbekannte Variable '%s' - nur 'value' ist verfügbar."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:94
msgid "Only numeric constants are allowed."
msgstr "Nur numerische Konstanten sind erlaubt."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:114
#, python-format
msgid "Each endpoint URL must be unique. Duplicated: %s"
msgstr "Jede Endpunkt-URL muss eindeutig sein. Doppelt: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:123
#, python-format
msgid "Each endpoint name must be unique. Duplicated: %s"
msgstr "Jeder Endpunkt-Name muss eindeutig sein. Doppelt: %s"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:133
msgid "The URL must not contain whitespace."
msgstr "Die URL darf keine Leerzeichen enthalten."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:137
msgid "Enter a valid http(s) URL, e.g. 'https://host/path'."
msgstr "Geben Sie eine gültige http(s)-URL ein, z. B. 'https://host/pfad'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:143
msgid "Authentication"
msgstr "Authentifizierung"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:148
msgid "Basic authentication (username / password)"
msgstr "Basis-Authentifizierung (Benutzername / Passwort)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:154
msgid "Username"
msgstr "Benutzername"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:161
msgid "Password"
msgstr "Passwort"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:170
msgid "Bearer token"
msgstr "Bearer-Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:176
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:177
msgid "Sent as 'Authorization: Bearer <token>'."
msgstr "Wird als 'Authorization: Bearer <token>' gesendet."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:217
msgid "Field to monitor"
msgstr "Zu überwachendes Feld"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:223
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:117
msgid "Service name"
msgstr "Dienstname"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:224
msgid "Becomes the Checkmk service description for this field."
msgstr "Wird zur Checkmk-Dienstbeschreibung für dieses Feld."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:231
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:310
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:762
msgid "JSON path"
msgstr "JSON-Pfad"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:233
msgid ""
"Dotted path into the JSON response, e.g. 'status', 'components.db.status' or "
"'items[0].count'. Use a '[*]' wildcard (e.g. 'nodes[*].health') to create "
"one service per array element - or, when the wildcard lands on a JSON object "
"(a map keyed by name, such as a Spring Boot Actuator '/health' "
"'components[*].status'), one service per key. Multiple '[*]' wildcards (e.g. "
"'pods[*].containers[*].ready') expand the cartesian product, one service per "
"combination. A leading '$.' is optional. Keys that themselves contain '.' or "
"'[' can be addressed with bracket-quoted segments, e.g. \"data['foo.bar']."
"value\"."
msgstr ""
"Punktnotierter Pfad in die JSON-Antwort, z. B. 'status', 'components.db."
"status' oder 'items[0].count'. Verwenden Sie einen '[*]'-Platzhalter (z. B. "
"'nodes[*].health'), um einen Dienst pro Array-Element zu erzeugen - oder, "
"wenn der Platzhalter auf ein JSON-Objekt trifft (eine nach Namen indizierte "
"Map, z. B. ein Spring Boot Actuator '/health' 'components[*].status'), einen "
"Dienst pro Schlüssel. Mehrere '[*]'-Platzhalter (z. B. 'pods[*]."
"containers[*].ready') bilden das kartesische Produkt, also einen Dienst pro "
"Kombination. Ein führendes '$.' ist optional. Schlüssel, die selbst '.' oder "
"'[' enthalten, können mit in Anführungszeichen gesetzten Segmenten in "
"eckigen Klammern angesprochen werden, z. B. \"data['foo.bar'].value\"."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:253
msgid "Per-element name suffix (for '[*]' wildcards)"
msgstr "Namenssuffix pro Element (bei '[*]'-Platzhaltern)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:255
msgid ""
"When the JSON path contains a '[*]' wildcard, one service is created per "
"element. This optional path - relative to each element, e.g. 'name' or 'id' "
"- is appended to the service name to tell those services apart. It does NOT "
"replace the service name. Defaults to the array index (or, for an object, "
"the key). With multiple '[*]' wildcards it is resolved at every level and "
"the parts are joined with ' / ' (e.g. '<pod> / <container>'). Pick a field "
"that is unique and stable across runs."
msgstr ""
"Wenn der JSON-Pfad einen '[*]'-Platzhalter enthält, wird pro Element ein "
"Dienst erstellt. Dieser optionale Pfad - relativ zu jedem Element, z. B. "
"'name' oder 'id' - wird an den Dienstnamen angehängt, um diese Dienste zu "
"unterscheiden. Er ersetzt den Dienstnamen NICHT. Standardmäßig wird der "
"Array-Index verwendet (oder bei einem Objekt der Schlüssel). Bei mehreren "
"'[*]'-Platzhaltern wird er auf jeder Ebene aufgelöst und die Teile werden "
"mit ' / ' verbunden (z. B. '<pod> / <container>'). Wählen Sie ein Feld, das "
"eindeutig und über Läufe hinweg stabil ist."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:270
msgid "Create one host per element, named by this field"
msgstr "Einen Host pro Element anlegen, benannt nach diesem Feld"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:272
msgid ""
"When the JSON path contains a '[*]' wildcard, this turns every element into "
"a Checkmk host of its own instead of one more service on this host. Give a "
"path relative to each element that holds the host name, e.g. 'name' or "
"'hostname'. The service then keeps its plain name, because the host already "
"says which element it is. Set the same field on several fields of this "
"endpoint to collect them all on the same hosts. Only characters valid in a "
"Checkmk host name are kept (letters, digits, '-', '_', '.'); anything else "
"becomes '_'. An element whose field is missing keeps its service on this "
"host, so nothing is lost. IMPORTANT: Checkmk holds piggyback data for hosts "
"that do not exist yet - create the hosts (manually or with Dynamic host "
"management) or the data is never monitored."
msgstr ""
"Wenn der JSON-Pfad einen '[*]'-Platzhalter enthält, wird dadurch jedes "
"Element zu einem eigenen Checkmk-Host, anstatt zu einem weiteren Service auf "
"diesem Host. Geben Sie einen Pfad relativ zu jedem Element an, der den "
"Hostnamen enthält, z. B. 'name' oder 'hostname'. Der Service behält dann "
"seinen einfachen Namen, weil der Host bereits angibt, um welches Element es "
"sich handelt. Setzen Sie dasselbe Feld bei mehreren Feldern dieses "
"Endpunkts, um sie alle auf denselben Hosts zu sammeln. Es werden nur Zeichen "
"beibehalten, die in einem Checkmk-Hostnamen gültig sind (Buchstaben, "
"Ziffern, '-', '_', '.'); alles andere wird zu '_'. Ein Element, dessen Feld "
"fehlt, behält seinen Service auf diesem Host, sodass nichts verloren geht. "
"WICHTIG: Checkmk hält Piggyback-Daten für noch nicht existierende Hosts "
"zurück - legen Sie die Hosts an (manuell oder mit der dynamischen Host-"
"Verwaltung), sonst werden die Daten nie überwacht."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:293
msgid "Service labels"
msgstr "Service-Labels"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:295
msgid ""
"Attach Checkmk service labels to THIS service, built from fields in the "
"response. Each key is prefixed with 'json_api/'. For a '[*]' path the value "
"is resolved within each element (e.g. 'name'), so a per-element service gets "
"its own label; for a non-wildcard path it is resolved from the response "
"root. Host-wide facts belong in the endpoint's 'Host labels' instead. Labels "
"are set at discovery, so pick stable, low-cardinality fields - a value that "
"changes churns the label."
msgstr ""
"Hängt Checkmk-Service-Labels an DIESEN Service, gebildet aus Feldern der "
"Antwort. Jeder Schlüssel erhält das Präfix 'json_api/'. Bei einem '[*]'-Pfad "
"wird der Wert innerhalb jedes Elements aufgelöst (z. B. 'name'), sodass "
"jeder Element-Service sein eigenes Label erhält; bei einem Pfad ohne "
"Platzhalter wird er aus der Wurzel der Antwort aufgelöst. Hostweite Angaben "
"gehören stattdessen in die 'Host-Labels' des Endpunkts. Labels werden bei "
"der Service-Erkennung gesetzt; wählen Sie daher stabile Felder mit geringer "
"Kardinalität - ein sich ändernder Wert lässt das Label ständig wechseln."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:312
msgid ""
"Relative to each '[*]' element (like the name suffix), or the response root "
"for a non-wildcard path."
msgstr ""
"Relativ zu jedem '[*]'-Element (wie das Namenssuffix) oder, bei einem Pfad "
"ohne Platzhalter, zur Wurzel der Antwort."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:322
#: cmk_addons/plugins/json_api/rulesets/special_agent.py:774
msgid "Label key (optional)"
msgstr "Label-Schlüssel (optional)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:324
msgid ""
"Defaults to the path's last segment. The 'json_api/' prefix is added "
"automatically."
msgstr ""
"Standardmäßig das letzte Segment des Pfads. Das Präfix 'json_api/' wird "
"automatisch hinzugefügt."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:336
msgid "Aggregate a collection into one value"
msgstr "Eine Sammlung zu einem Wert zusammenfassen"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:338
msgid ""
"Collapse a collection of elements into a single number instead of monitoring "
"one value (or, with a '[*]' wildcard, one service per element). Point the "
"JSON path either at an array / object (e.g. 'jobs') or at a '[*]' wildcard "
"over the values to aggregate (e.g. 'nodes[*].load'). 'Number of elements' "
"just counts them; the other functions need numeric values. The result is a "
"number, so a unit, levels, a transform and a metric all apply to it. Combine "
"it with the condition below to aggregate only the matching elements. A path "
"that holds neither an array nor an object makes the service UNKNOWN."
msgstr ""
"Fasst eine Sammlung von Elementen zu einer einzigen Zahl zusammen, statt "
"einen einzelnen Wert zu überwachen (oder, mit einem '[*]'-Platzhalter, einen "
"Dienst pro Element). Der JSON-Pfad zeigt entweder auf ein Array / Objekt (z. "
"B. 'jobs') oder auf einen '[*]'-Platzhalter über die zu aggregierenden Werte "
"(z. B. 'nodes[*].load'). 'Anzahl der Elemente' zählt sie nur; die übrigen "
"Funktionen benötigen numerische Werte. Das Ergebnis ist eine Zahl, also "
"gelten Einheit, Grenzwerte, Umrechnung und Metrik dafür. In Kombination mit "
"der Bedingung unten werden nur die passenden Elemente aggregiert. Ein Pfad, "
"der weder Array noch Objekt enthält, macht den Dienst UNKNOWN."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:351
msgid "Number of elements"
msgstr "Anzahl der Elemente"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:352
msgid "Sum of the values"
msgstr "Summe der Werte"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:353
msgid "Average of the values"
msgstr "Durchschnitt der Werte"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:354
msgid "Smallest of the values"
msgstr "Kleinster der Werte"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:355
msgid "Largest of the values"
msgstr "Größter der Werte"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:363
msgid "Only elements matching a condition"
msgstr "Nur Elemente, die eine Bedingung erfüllen"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:365
msgid ""
"For a '[*]' wildcard or an aggregated path: keep only the elements whose sub-"
"field matches this condition - e.g. one service per node whose 'status' is "
"not 'ok', or count only the pods that are not 'Running'. The field path is "
"resolved within each element; an element whose field is missing or is not a "
"scalar is dropped. Without a '[*]' wildcard or an aggregation this has no "
"effect."
msgstr ""
"Für einen '[*]'-Platzhalter oder einen aggregierten Pfad: nur die Elemente "
"behalten, deren Unterfeld diese Bedingung erfüllt – z. B. ein Dienst pro "
"Knoten, dessen 'status' nicht 'ok' ist, oder nur die Pods zählen, die nicht "
"'Running' sind. Der Feldpfad wird innerhalb jedes Elements aufgelöst; ein "
"Element, dessen Feld fehlt oder kein Skalar ist, wird verworfen. Ohne '[*]'-"
"Platzhalter oder Aggregation hat dies keine Wirkung."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:377
msgid "Field path (within each element)"
msgstr "Feldpfad (innerhalb jedes Elements)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:379
msgid "Resolved within each element, e.g. 'status' or 'metadata.phase'."
msgstr ""
"Wird innerhalb jedes Elements aufgelöst, z. B. 'status' oder 'metadata."
"phase'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:388
msgid "Condition"
msgstr "Bedingung"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:390
msgid "equals"
msgstr "ist gleich"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:391
msgid "does not equal"
msgstr "ist ungleich"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:392
msgid "matches regex"
msgstr "entspricht Regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:393
msgid "does not match regex"
msgstr "entspricht nicht Regex"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:401
msgid "Comparison value / pattern"
msgstr "Vergleichswert / Muster"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:403
msgid ""
"The value to compare against, or the regular expression for the regex "
"conditions."
msgstr ""
"Der Wert, mit dem verglichen wird, oder der reguläre Ausdruck für die Regex-"
"Bedingungen."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:414
msgid "Interpret the value as"
msgstr "Wert interpretieren als"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:416
msgid ""
"By default the extracted value is monitored as it stands. Two common API "
"values are worth deriving something else from: a counter that only ever "
"grows (its rate of change is what matters, not the total), and a timestamp "
"(its age is what matters, not the date). The derived number is what the "
"transform, the levels, the metric and the summary then use."
msgstr ""
"Standardmäßig wird der ausgelesene Wert so überwacht, wie er ist. Bei zwei "
"häufigen API-Werten lohnt es sich, etwas anderes daraus abzuleiten: bei "
"einem Zähler, der nur wächst (entscheidend ist die Änderungsrate, nicht der "
"Gesamtwert), und bei einem Zeitstempel (entscheidend ist das Alter, nicht "
"das Datum). Die abgeleitete Zahl verwenden dann Umrechnung, Grenzwerte, "
"Metrik und Zusammenfassung."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:428
msgid "A counter - monitor its per-second rate"
msgstr "Ein Zähler – seine Rate pro Sekunde überwachen"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:431
msgid "Per-second rate"
msgstr "Rate pro Sekunde"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:433
msgid "The difference to the previous check is divided by the elapsed time"
msgstr ""
"Die Differenz zur vorherigen Prüfung wird durch die vergangene Zeit geteilt"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:437
msgid ""
"For monotonically growing counters such as 'requests_total' or 'bytes_sent': "
"the check monitors the change per second instead of the absolute total. The "
"first check after a restart of the counter cannot compute a rate yet and "
"keeps the service's previous state."
msgstr ""
"Für monoton wachsende Zähler wie 'requests_total' oder 'bytes_sent': die "
"Prüfung überwacht die Änderung pro Sekunde statt des absoluten Gesamtwerts. "
"Die erste Prüfung nach einem Neustart des Zählers kann noch keine Rate "
"berechnen und behält den vorherigen Zustand des Dienstes."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:448
msgid "A timestamp - monitor its age"
msgstr "Ein Zeitstempel – sein Alter überwachen"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:451
msgid ""
"For values such as 'last_backup' or 'updated_at': the check monitors the "
"number of seconds since that point in time, so upper levels alert on stale "
"data. A timestamp in the future yields a negative age. The age graphs and "
"reads as a duration on its own; choose a unit below only to override that (e."
"g. after a transform into hours)."
msgstr ""
"Für Werte wie 'last_backup' oder 'updated_at': die Prüfung überwacht die "
"Anzahl der Sekunden seit diesem Zeitpunkt, sodass Obergrenzen bei veralteten "
"Daten alarmieren. Ein Zeitstempel in der Zukunft ergibt ein negatives Alter. "
"Das Alter wird von sich aus als Dauer dargestellt und gezeichnet; wählen Sie "
"unten nur dann eine Einheit, wenn Sie das überschreiben wollen (z. B. nach "
"einer Umrechnung in Stunden)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:464
msgid "Timestamp format"
msgstr "Format des Zeitstempels"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:466
msgid ""
"'Detect automatically' reads a number as Unix epoch seconds (milliseconds "
"when it is far too large for seconds) and anything else as ISO 8601. A "
"timestamp without a time zone is read as UTC."
msgstr ""
"'Automatisch erkennen' liest eine Zahl als Unix-Epoch-Sekunden (als "
"Millisekunden, wenn sie für Sekunden viel zu groß ist) und alles andere als "
"ISO 8601. Ein Zeitstempel ohne Zeitzone wird als UTC gelesen."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:475
msgid "Detect automatically"
msgstr "Automatisch erkennen"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:478
msgid "Unix epoch seconds"
msgstr "Unix-Epoch-Sekunden"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:482
msgid "Unix epoch milliseconds"
msgstr "Unix-Epoch-Millisekunden"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:487
msgid "ISO 8601 / RFC 3339, e.g. '2026-07-28T02:00:00Z'"
msgstr "ISO 8601 / RFC 3339, z. B. '2026-07-28T02:00:00Z'"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:504
msgid "Unit (for numeric values)"
msgstr "Einheit (für numerische Werte)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:506
msgid ""
"Renders the metric and graph with this unit. Leave unset for a plain, unit-"
"less value. Only affects numeric values."
msgstr ""
"Stellt die Metrik und den Graphen mit dieser Einheit dar. Für einen "
"einfachen, einheitenlosen Wert leer lassen. Betrifft nur numerische Werte."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:510
msgid "Count (integer)"
msgstr "Anzahl (Ganzzahl)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:511
msgid "Bytes (IEC: KiB, MiB, ...)"
msgstr "Bytes (IEC: KiB, MiB, ...)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:512
msgid "Seconds (duration)"
msgstr "Sekunden (Dauer)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:513
msgid "Percent"
msgstr "Prozent"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:515
msgid "No unit"
msgstr "Keine Einheit"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:529
msgid "Transform the numeric value"
msgstr "Numerischen Wert transformieren"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:531
msgid ""
"An arithmetic expression applied to a numeric value before the levels and "
"the metric, using the variable 'value'. Only numbers, parentheses and + - "
"* / are allowed. Examples: 'value / 1024 / 1024' (bytes to MiB), 'value * "
"1000' (seconds to milliseconds), '(value - 32) * 5 / 9' (Fahrenheit to "
"Celsius)."
msgstr ""
"Ein arithmetischer Ausdruck, der auf einen numerischen Wert angewendet wird, "
"bevor die Grenzwerte und die Metrik ausgewertet werden, unter Verwendung der "
"Variablen 'value'. Nur Zahlen, Klammern und + - * / sind erlaubt. Beispiele: "
"'value / 1024 / 1024' (Bytes in MiB), 'value * 1000' (Sekunden in "
"Millisekunden), '(value - 32) * 5 / 9' (Fahrenheit in Celsius)."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:552
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:125
msgid "Endpoint"
msgstr "Endpunkt"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:557
msgid "Endpoint name"
msgstr "Name des Endpunkts"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:559
msgid ""
"Optional short name for this endpoint, e.g. 'frontend'. It names the "
"endpoint's own service - 'JSON API <name>', which reports the HTTP status "
"and the response time of the request. Without a name the URL is used. It "
"does not change the field service names."
msgstr ""
"Optionaler Kurzname für diesen Endpunkt, z. B. 'frontend'. Er benennt den "
"eigenen Dienst des Endpunkts – 'JSON API <Name>', der den HTTP-Status und "
"die Antwortzeit der Anfrage meldet. Ohne Namen wird die URL verwendet. Die "
"Namen der Feld-Dienste ändert er nicht."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:571
msgid "URL"
msgstr "URL"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:573
msgid ""
"Full URL of the JSON endpoint, including scheme, e.g. 'https://app.example."
"com/actuator/health'."
msgstr ""
"Vollständige URL des JSON-Endpunkts, einschließlich Schema, z. B. 'https://"
"app.example.com/actuator/health'."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:582
msgid "HTTP method"
msgstr "HTTP-Methode"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:584
msgid "GET"
msgstr "GET"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:585
msgid "POST"
msgstr "POST"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:593
msgid "Request body (for POST)"
msgstr "Anfrage-Body (für POST)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:599
msgid "Additional request headers"
msgstr "Zusätzliche Anfrage-Header"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:604
msgid "Header name"
msgstr "Header-Name"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:608
msgid "Header value"
msgstr "Header-Wert"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:621
msgid "Verify the TLS certificate"
msgstr "TLS-Zertifikat überprüfen"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:622
msgid "Disabling certificate verification is insecure."
msgstr "Das Deaktivieren der Zertifikatsprüfung ist unsicher."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:629
msgid "Custom CA bundle file"
msgstr "Eigene CA-Bundle-Datei"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:631
msgid ""
"Path on the Checkmk server to a PEM file holding the CA certificate(s) to "
"verify the server's certificate against. Use this to trust an internal or "
"private CA without turning verification off. Ignored when TLS verification "
"is disabled."
msgstr ""
"Pfad auf dem Checkmk-Server zu einer PEM-Datei mit dem/den CA-"
"Zertifikat(en), gegen die das Serverzertifikat geprüft wird. Damit vertrauen "
"Sie einer internen oder privaten CA, ohne die Prüfung abzuschalten. Wird "
"ignoriert, wenn die TLS-Zertifikatsprüfung deaktiviert ist."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:642
msgid "Client certificate (mutual TLS)"
msgstr "Client-Zertifikat (gegenseitiges TLS)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:644
msgid ""
"Present a client certificate to the server (mutual TLS). The files must "
"exist on the Checkmk server. The private key must be unencrypted."
msgstr ""
"Weisen Sie dem Server ein Client-Zertifikat vor (gegenseitiges TLS). Die "
"Dateien müssen auf dem Checkmk-Server vorhanden sein. Der private Schlüssel "
"muss unverschlüsselt sein."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:652
msgid "Client certificate file"
msgstr "Client-Zertifikatsdatei"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:654
msgid ""
"Path to the client certificate (PEM). If the file also contains the private "
"key, leave the key field empty."
msgstr ""
"Pfad zum Client-Zertifikat (PEM). Wenn die Datei auch den privaten Schlüssel "
"enthält, lassen Sie das Schlüsselfeld leer."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:664
msgid "Private key file"
msgstr "Datei mit privatem Schlüssel"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:666
msgid ""
"Path to the client private key (PEM), if it is not bundled with the "
"certificate."
msgstr ""
"Pfad zum privaten Schlüssel des Clients (PEM), falls er nicht im Zertifikat "
"enthalten ist."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:678
msgid "Follow HTTP redirects"
msgstr "HTTP-Weiterleitungen folgen"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:680
msgid ""
"On by default. Disable in locked-down environments to harden against SSRF: a "
"target that redirects (e.g. 3xx to an internal address) will then fail "
"instead of being followed to the redirect location."
msgstr ""
"Standardmäßig aktiviert. In abgesicherten Umgebungen deaktivieren, um gegen "
"SSRF zu härten: Ein Ziel, das weiterleitet (z. B. 3xx auf eine interne "
"Adresse), schlägt dann fehl, anstatt zum Weiterleitungsziel zu folgen."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:691
msgid "Request timeout (seconds)"
msgstr "Anfrage-Zeitüberschreitung (Sekunden)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:692
msgid "Per-request timeout. Defaults to 30 seconds."
msgstr "Zeitüberschreitung pro Anfrage. Standardwert: 30 Sekunden."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:700
msgid "Additional accepted HTTP status codes"
msgstr "Zusätzlich akzeptierte HTTP-Statuscodes"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:702
msgid ""
"By default only 2xx responses are read; any other status makes the "
"endpoint's services UNKNOWN. Add extra status codes to accept here - for "
"example 503 for a health endpoint that reports its problems with a 503 and a "
"JSON body. The body of an accepted response is parsed and extracted as "
"usual. 2xx is always accepted."
msgstr ""
"Standardmäßig werden nur 2xx-Antworten gelesen; jeder andere Status setzt "
"die Dienste des Endpunkts auf UNKNOWN. Fügen Sie hier zusätzliche zu "
"akzeptierende Statuscodes hinzu – zum Beispiel 503 für einen Health-"
"Endpunkt, der seine Probleme mit einem 503 und einem JSON-Body meldet. Der "
"Body einer akzeptierten Antwort wird wie gewohnt geparst und ausgewertet. "
"2xx wird immer akzeptiert."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:710
msgid "Status code"
msgstr "Statuscode"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:718
msgid "HTTP proxy"
msgstr "HTTP-Proxy"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:720
msgid ""
"Route this endpoint's request through an HTTP proxy - useful when the "
"Checkmk server reaches the API only via a corporate egress proxy. Choose the "
"environment's HTTP_PROXY / HTTPS_PROXY variables, an explicit proxy URL, or "
"'no proxy' to bypass any proxy set in the environment. Without this setting "
"the environment's proxy variables are honoured."
msgstr ""
"Leiten Sie die Anfrage dieses Endpunkts über einen HTTP-Proxy – nützlich, "
"wenn der Checkmk-Server die API nur über einen Unternehmens-Proxy erreicht. "
"Wählen Sie die Umgebungsvariablen HTTP_PROXY / HTTPS_PROXY, eine explizite "
"Proxy-URL oder 'kein Proxy', um einen in der Umgebung gesetzten Proxy zu "
"umgehen. Ohne diese Einstellung werden die Proxy-Variablen der Umgebung "
"berücksichtigt."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:734
msgid "Fields to monitor"
msgstr "Zu überwachende Felder"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:736
msgid ""
"Each entry becomes one Checkmk service, built from the value found at the "
"given JSON path."
msgstr ""
"Jeder Eintrag wird zu einem Checkmk-Dienst, gebildet aus dem Wert am "
"angegebenen JSON-Pfad."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:745
msgid "Host labels"
msgstr "Host-Labels"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:747
msgid ""
"Attach Checkmk host labels to the monitored host, built from fields in this "
"endpoint's response. Each key is prefixed with 'json_api/' and the value is "
"resolved from the response root - so these are host-wide facts (e.g. an "
"environment, region or version) and need NO service. A path may contain a "
"'[*]' wildcard (e.g. 'components[*]') to emit one label per element, keyed "
"'<key>/<element>' so keys stay unique. Set at discovery, so pick stable, low-"
"cardinality fields."
msgstr ""
"Hängt Checkmk-Host-Labels an den überwachten Host, gebildet aus Feldern der "
"Antwort dieses Endpunkts. Jeder Schlüssel erhält das Präfix 'json_api/' und "
"der Wert wird aus der Wurzel der Antwort aufgelöst - dies sind also "
"hostweite Angaben (z. B. eine Umgebung, Region oder Version) und benötigen "
"KEINEN Service. Ein Pfad kann einen '[*]'-Platzhalter enthalten (z. B. "
"'components[*]'), um ein Label pro Element zu erzeugen, mit dem Schlüssel "
"'<key>/<element>', damit die Schlüssel eindeutig bleiben. Wird bei der "
"Service-Erkennung gesetzt; wählen Sie daher stabile Felder mit geringer "
"Kardinalität."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:764
msgid ""
"From the response root, e.g. 'version', 'cluster.region', or a '[*]' "
"wildcard like 'components[*]' for one label per element."
msgstr ""
"Ausgehend von der Wurzel der Antwort, z. B. 'version', 'cluster.region' oder "
"ein '[*]'-Platzhalter wie 'components[*]' für ein Label pro Element."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:776
msgid ""
"Defaults to the path's last segment. For a '[*]' path the element id is "
"appended ('<key>/<element>'). The 'json_api/' prefix is added automatically."
msgstr ""
"Standardmäßig das letzte Segment des Pfads. Bei einem '[*]'-Pfad wird die "
"Element-ID angehängt ('<key>/<element>'). Das Präfix 'json_api/' wird "
"automatisch hinzugefügt."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:786
msgid "Value field (for '[*]' wildcards)"
msgstr "Wertfeld (bei '[*]'-Platzhaltern)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:788
msgid ""
"For a '[*]' path: a path within each element for the label value (e.g. "
"'status'). Defaults to 'true' (a set-membership tag). Ignored without a "
"wildcard."
msgstr ""
"Bei einem '[*]'-Pfad: ein Pfad innerhalb jedes Elements für den Label-Wert "
"(z. B. 'status'). Standardmäßig 'true' (ein Zugehörigkeits-Tag). Ohne "
"Platzhalter wird es ignoriert."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:821
msgid "Endpoints"
msgstr "Endpunkte"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:823
msgid ""
"One or more HTTP/JSON endpoints. Each is fetched with its own connection "
"settings and extractions; all results are merged into one section. An "
"endpoint that cannot be reached only affects its own services."
msgstr ""
"Ein oder mehrere HTTP/JSON-Endpunkte. Jeder wird mit eigenen "
"Verbindungseinstellungen und Extraktionen abgerufen; alle Ergebnisse werden "
"zu einem Abschnitt zusammengeführt. Ein nicht erreichbarer Endpunkt betrifft "
"nur seine eigenen Dienste."

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:838
#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:114
msgid "Generic JSON API"
msgstr "Generische JSON-API"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:66
msgid "Upper levels for the response time"
msgstr "Obergrenzen für die Antwortzeit"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:68
msgid ""
"How long the request to this endpoint may take, in seconds. Measured from "
"sending the request to having read the whole response body. Without levels "
"the response time is only recorded as a metric."
msgstr ""
"Wie lange die Anfrage an diesen Endpunkt dauern darf, in Sekunden. Gemessen "
"vom Senden der Anfrage bis zum vollständigen Lesen des Antwortkörpers. Ohne "
"Grenzwerte wird die Antwortzeit nur als Metrik aufgezeichnet."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:81
msgid "Lower levels for the TLS certificate's remaining validity"
msgstr "Untere Grenzwerte für die Restlaufzeit des TLS-Zertifikats"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:83
msgid ""
"How many days the endpoint's TLS certificate must still be valid for. Read "
"from the connection the agent already makes, so no second check against the "
"same URL is needed. Only available for HTTPS endpoints with certificate "
"verification enabled; otherwise the certificate is not reported and these "
"levels never apply. Without levels the remaining validity is only recorded "
"as a metric."
msgstr ""
"Wie viele Tage das TLS-Zertifikat des Endpunkts noch gültig sein muss. Es "
"wird aus der Verbindung gelesen, die der Agent ohnehin aufbaut, sodass keine "
"zweite Prüfung gegen dieselbe URL nötig ist. Nur für HTTPS-Endpunkte mit "
"aktivierter Zertifikatsprüfung verfügbar; andernfalls wird das Zertifikat "
"nicht gemeldet und diese Grenzwerte greifen nie. Ohne Grenzwerte wird die "
"Restlaufzeit nur als Metrik aufgezeichnet."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:99
msgid "State when the endpoint cannot be read"
msgstr "Zustand, wenn der Endpunkt nicht gelesen werden kann"

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:101
msgid ""
"Applies when the request fails outright: connection refused, a TLS error, a "
"timeout, an HTTP status that is not accepted, or a response that is not JSON."
msgstr ""
"Gilt, wenn die Anfrage vollständig fehlschlägt: Verbindung abgelehnt, TLS-"
"Fehler, Zeitüberschreitung, ein nicht akzeptierter HTTP-Status oder eine "
"Antwort, die kein JSON ist."

#: cmk_addons/plugins/json_api/rulesets/check_parameters.py:122
msgid "Generic JSON API endpoint"
msgstr "Generischer JSON-API-Endpunkt"

#: cmk_addons/plugins/json_api/graphing/json_api.py:23
