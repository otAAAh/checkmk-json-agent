msgstr "Basis-Authentifizierung (Benutzername / Passwort)"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:58
msgid "Username"
msgstr "Benutzername"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:65
msgid "Password"
msgstr "Passwort"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:74
msgid "Bearer token"
msgstr "Bearer-Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:80
msgid "Token"
msgstr "Token"

#: cmk_addons/plugins/json_api/rulesets/special_agent.py:81
