{
  "comment": [
    "Shared cases for what a '[*]' element is CALLED on the site, read by THREE",
    "sides: tests/test_label_path_parity.py drives the special agent's own",
    "_expand_wildcards / _element_labels (the only place the names are decided),",
    "frontend/src/lib/elementlabels.test.ts drives the wizard's port, and",
    "tests/test_explorer.py drives the standalone Explorer's mirror.",
    "'labels' is the ' / '-joined suffix of every FOUND leaf, in order. 'issues'",
    "is what the wizard and the Explorer warn about; the agent has no such notion",
    "and only answers 'labels'. Elements in 'issues' are named by position (index",
    "or key, ' / '-joined when nested).",
    "'piggyback_host' (optional) is the extraction's host-per-element field;",
    "'hosts' then lists the host each FOUND leaf becomes (null = it stays on the",
    "polling host), answered by the agent's own _piggyback_host. With a host",
    "field, 'issues' only concern the elements that stay on the polling host.",
    "'imprecise' (whole numbers beyond 2^53, rounded by the browser) is the",
    "ports' notion alone: the agent reads them exactly, so no case can hold",
    "both sides to one; elementlabels.test.ts and test_explorer.py cover it."
  ],
  "cases": [
    {
      "name": "unique names need no warning",
      "document": {"nodes": [{"name": "node-a", "up": true}, {"name": "node-b", "up": false}]},
      "path": "nodes[*].up",
      "label_path": "name",
      "labels": ["node-a", "node-b"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "without a label path the position names the element",
      "document": {"nodes": [{"name": "web", "up": true}, {"name": "web", "up": false}]},
      "path": "nodes[*].up",
      "label_path": "",
      "labels": ["0", "1"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "a repeated name is suffixed with its position, every occurrence",
      "document": {"nodes": [{"name": "web", "up": 1}, {"name": "db", "up": 1}, {"name": "cache", "up": 1}, {"name": "web", "up": 0}]},
      "path": "nodes[*].up",
      "label_path": "name",
      "labels": ["web [0]", "db", "cache", "web [3]"],
      "issues": {
        "duplicates": [{"label": "web", "elements": ["0", "3"], "names": ["web [0]", "web [3]"]}],
        "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []
      }
    },
    {
      "name": "a missing field falls back to the position",
      "document": {"nodes": [{"name": "web", "up": 1}, {"up": 0}]},
      "path": "nodes[*].up",
      "label_path": "name",
      "labels": ["web", "1"],
      "issues": {"duplicates": [], "missing": ["1"], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "a fallback position can clash with a real name",
      "document": {"nodes": [{"up": 1}, {"name": "0", "up": 0}]},
      "path": "nodes[*].up",
      "label_path": "name",
      "labels": ["0 [0]", "0 [1]"],
      "issues": {
        "duplicates": [{"label": "0", "elements": ["0", "1"], "names": ["0 [0]", "0 [1]"]}],
        "missing": ["0"], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []
      }
    },
    {
      "name": "an object map is suffixed by enumeration index, not by key",
      "document": {"components": {"db": {"kind": "sql", "status": "UP"}, "disk": {"kind": "fs", "status": "UP"}, "db2": {"kind": "sql", "status": "DOWN"}}},
      "path": "components[*].status",
      "label_path": "kind",
      "labels": ["sql [0]", "fs", "sql [2]"],
      "issues": {
        "duplicates": [{"label": "sql", "elements": ["db", "db2"], "names": ["sql [0]", "sql [2]"]}],
        "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []
      }
    },
    {
      "name": "names only have to be unique within their own container",
      "document": {"pods": [
        {"name": "p1", "containers": [{"name": "app", "ready": true}, {"name": "app", "ready": false}]},
        {"name": "p2", "containers": [{"name": "app", "ready": true}]}
      ]},
      "path": "pods[*].containers[*].ready",
      "label_path": "name",
      "labels": ["p1 / app [0]", "p1 / app [1]", "p2 / app"],
      "issues": {
        "duplicates": [{"label": "app", "elements": ["0 / 0", "0 / 1"], "names": ["app [0]", "app [1]"]}],
        "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []
      }
    },
    {
      "name": "a non-string name is rendered the way Python renders it",
      "document": {"items": [{"id": 7, "v": 1}, {"id": true, "v": 2}, {"id": null, "v": 3}, {"id": "it's", "v": 4}]},
      "path": "items[*].v",
      "label_path": "id",
      "labels": ["7", "True", "None", "it's"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "an object as the name lands in the service name whole",
      "document": {"items": [{"id": {"a": 1, "b": "x"}, "v": 1}, {"id": ["p", "q"], "v": 2}]},
      "path": "items[*].v",
      "label_path": "id",
      "labels": ["{'a': 1, 'b': 'x'}", "['p', 'q']"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": ["0", "1"], "fallback": [], "imprecise": []}
    },
    {
      "name": "one empty name gets no suffix at all",
      "document": {"items": [{"id": "", "v": 1}, {"id": "b", "v": 2}]},
      "path": "items[*].v",
      "label_path": "id",
      "labels": ["", "b"],
      "issues": {"duplicates": [], "missing": [], "empty": ["0"], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "two empty names are a repeat, reported once",
      "document": {"items": [{"id": "", "v": 1}, {"id": "", "v": 2}]},
      "path": "items[*].v",
      "label_path": "id",
      "labels": [" [0]", " [1]"],
      "issues": {
        "duplicates": [{"label": "", "elements": ["0", "1"], "names": [" [0]", " [1]"]}],
        "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []
      }
    },
    {
      "name": "an element whose value is missing still takes part in the naming",
      "document": {"items": [{"id": "a", "v": 1}, {"id": "a"}]},
      "path": "items[*].v",
      "label_path": "id",
      "labels": ["a [0]"],
      "issues": {
        "duplicates": [{"label": "a", "elements": ["0", "1"], "names": ["a [0]", "a [1]"]}],
        "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []
      }
    },
    {
      "name": "a blank label path names the element by its whole content",
      "document": {"items": [{"v": 1}]},
      "path": "items[*].v",
      "label_path": "  ",
      "labels": ["{'v': 1}"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": ["0"], "fallback": [], "imprecise": []}
    },
    {
      "name": "a nested label path is resolved within the element",
      "document": {"items": [{"meta": {"name": "x"}, "v": 1}, {"meta": {"name": "y"}, "v": 2}]},
      "path": "$.items[*].v",
      "label_path": "meta.name",
      "labels": ["x", "y"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "a label path is read as the agent scans it, junk between tokens skipped",
      "document": {"items": [{"meta": {"name": "x"}, "v": 1}, {"meta": {"name": "y"}, "v": 2}]},
      "path": "items[*].v",
      "label_path": "meta..name",
      "labels": ["x", "y"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "a built-in object property is not a field of the element",
      "document": {"items": [{"v": 1}, {"v": 2}]},
      "path": "items[*].v",
      "label_path": "constructor",
      "labels": ["0", "1"],
      "issues": {"duplicates": [], "missing": ["0", "1"], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "with a host per element, a repeat among elements that get a host is no concern",
      "document": {"nodes": [{"host": "a", "role": "web", "up": 1}, {"host": "b", "role": "web", "up": 1}]},
      "path": "nodes[*].up",
      "label_path": "role",
      "piggyback_host": "host",
      "labels": ["web [0]", "web [1]"],
      "hosts": ["a", "b"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": [], "imprecise": []}
    },
    {
      "name": "elements without a host stay on the polling host, where a repeat is warned about",
      "document": {"nodes": [{"host": "a", "role": "web", "up": 1}, {"role": "web", "up": 1}, {"host": "", "role": "web", "up": 0}, {"host": "c", "role": "db", "up": 1}, {"host": "!!", "up": 1}]},
      "path": "nodes[*].up",
      "label_path": "role",
      "piggyback_host": "host",
      "labels": ["web [0]", "web [1]", "web [2]", "db", "4"],
      "hosts": ["a", null, null, "c", null],
      "issues": {
        "duplicates": [{"label": "web", "elements": ["1", "2"], "names": ["web [1]", "web [2]"]}],
        "missing": ["4"], "empty": [], "nonScalar": [], "fallback": ["1", "2", "4"], "imprecise": []
      }
    },
    {
      "name": "one element on the polling host repeating a hosted one swaps with nothing",
      "document": {"nodes": [{"host": "a", "role": "web", "up": 1}, {"role": "web", "up": 1}]},
      "path": "nodes[*].up",
      "label_path": "role",
      "piggyback_host": "host",
      "labels": ["web [0]", "web [1]"],
      "hosts": ["a", null],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": ["1"], "imprecise": []}
    },
    {
      "name": "a host name is sanitised the way the agent does it",
      "document": {"nodes": [{"host": " web 01.example ", "up": 1}, {"host": 7, "up": 1}, {"host": true, "up": 1}, {"host": {"a": 1}, "up": 1}, {"host": "._x_.", "up": 1}]},
      "path": "nodes[*].up",
      "label_path": "",
      "piggyback_host": "host",
      "labels": ["0", "1", "2", "3", "4"],
      "hosts": ["web_01.example", "7", "true", null, "x"],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": ["3"], "imprecise": []}
    },
    {
      "name": "the host is read from the innermost element of a nested expansion",
      "document": {"pods": [{"name": "p1", "containers": [{"name": "app", "node": "n1", "up": 1}, {"name": "side", "up": 1}]}]},
      "path": "pods[*].containers[*].up",
      "label_path": "name",
      "piggyback_host": "node",
      "labels": ["p1 / app", "p1 / side"],
      "hosts": ["n1", null],
      "issues": {"duplicates": [], "missing": [], "empty": [], "nonScalar": [], "fallback": ["0 / 1"], "imprecise": []}
    }
  ]
}
